local function Tween(obj, props, duration)
	TweenService:Create(obj, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function setupButtonAnimations(button, normalColor, hoverColor, pressColor)
	local originalSize = button.Size

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = normalColor,
			Size = originalSize
		}, 0.12)
	end)

	button.MouseButton1Down:Connect(function()
		Tween(button, {
			BackgroundColor3 = pressColor,
			Size = originalSize - UDim2.new(0, 1, 0, 1)
		}, 0.08)
	end)

	button.MouseButton1Up:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.08)
	end)
end

-- ====================== SPECTATE STATE ======================
local playerList = {}
local currentIndex = 0
local isSpectating = false
local currentTarget = nil
local characterConnection = nil

local storedBlur = nil
local storedBlurParent = nil
local storedRoleSelector = nil
local storedRoleSelectorParent = nil

local function removeBlurAndRoleSelector()
	local blur = Lighting:FindFirstChild("Blur")
	if blur then
		storedBlur = blur
		storedBlurParent = blur.Parent
		blur.Parent = nil
	end

	local playerGui = LOCAL_PLAYER:FindFirstChild("PlayerGui")
	if playerGui then
		local hud2 = playerGui:FindFirstChild("HUD2")
		if hud2 then
			local rs = hud2:FindFirstChild("RoleSelector")
			if rs then
				storedRoleSelector = rs
				storedRoleSelectorParent = rs.Parent
				rs.Parent = nil
			end
		end
	end
end

local function restoreBlurAndRoleSelector()
	if storedBlur and storedBlurParent then
		storedBlur.Parent = storedBlurParent
	end
	storedBlur = nil
	storedBlurParent = nil

	if storedRoleSelector and storedRoleSelectorParent then
		storedRoleSelector.Parent = storedRoleSelectorParent
	end
	storedRoleSelector = nil
	storedRoleSelectorParent = nil
end

local function updatePlayerList()
	playerList = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LOCAL_PLAYER then
			table.insert(playerList, player)
		end
	end

	if currentIndex > #playerList then
		currentIndex = #playerList
	end
	if currentIndex < 1 and #playerList > 0 then
		currentIndex = 1
	end
end

local function setCameraToPlayer(player)
	if not player or not player.Character then
		return false
	end

	-- Prefer Head so the size-10 HumanoidRootPart doesn't lift the camera
	local head = player.Character:FindFirstChild("Head")
	if head then
		Camera.CameraSubject = head
		return true
	end

	-- Fallback to Humanoid if Head is missing
	local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		Camera.CameraSubject = humanoid
		return true
	end

	return false
end

local function startSpectate(player)
	if not player then return end

	if characterConnection then
		characterConnection:Disconnect()
		characterConnection = nil
	end

	currentTarget = player
	isSpectating = true

	setCameraToPlayer(player)

	characterConnection = player.CharacterAdded:Connect(function()
		task.wait(0.15)
		if isSpectating and currentTarget == player then
			setCameraToPlayer(player)
		end
	end)

	removeBlurAndRoleSelector()
	updateNameLabel()
end

local function stopSpectate()
	isSpectating = false
	currentTarget = nil
	currentIndex = 0

	if characterConnection then
		characterConnection:Disconnect()
		characterConnection = nil
	end

	-- Return camera to local player (prefer Head too for consistency)
	if LOCAL_PLAYER.Character then
		local head = LOCAL_PLAYER.Character:FindFirstChild("Head")
		if head then
			Camera.CameraSubject = head
		else
			local hum = LOCAL_PLAYER.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				Camera.CameraSubject = hum
			end
		end
	end

	restoreBlurAndRoleSelector()
	updateNameLabel()
end

local function spectateNext()
	updatePlayerList()
	if #playerList == 0 then
		stopSpectate()
		return
	end

	currentIndex = currentIndex % #playerList + 1
	startSpectate(playerList[currentIndex])
end

local function spectatePrevious()
	updatePlayerList()
	if #playerList == 0 then
		stopSpectate()
		return
	end

	currentIndex = (currentIndex - 2) % #playerList + 1
	startSpectate(playerList[currentIndex])
end

