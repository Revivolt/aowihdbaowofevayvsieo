-- Minimize / Restore
local minimized = false
local originalSize = UDim2.new(0, 260, 0, 200)
local minimizedSize = UDim2.new(0, 160, 0, 36)

local function setMinimized(state)
	minimized = state
	if minimized then
		TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = minimizedSize
		}):Play()
		inputBox.Visible = false
		bringButton.Visible = false
		disableButton.Visible = false
		minimizeBtn.Text = "+"
		titleLabel.Size = UDim2.new(1, -40, 1, 0)
		closeBtn.Visible = false
		minimizeBtn.Position = UDim2.new(1, -30, 0.5, -12)
	else
		TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = originalSize
		}):Play()
		inputBox.Visible = true
		bringButton.Visible = true
		disableButton.Visible = true
		minimizeBtn.Text = "–"
		titleLabel.Size = UDim2.new(1, -70, 1, 0)
		closeBtn.Visible = true
		minimizeBtn.Position = UDim2.new(1, -56, 0.5, -12)
	end
end

