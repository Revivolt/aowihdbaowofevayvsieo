local function Tween(obj, props, duration)
	TweenService:Create(obj, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function setupButtonAnimations(button, normalColor, hoverColor, pressColor)
	local originalSize = button.Size

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = normalColor,
			Size = originalSize
		}, 0.12)
	end)

	button.MouseButton1Down:Connect(function()
		Tween(button, {
			BackgroundColor3 = pressColor,
			Size = originalSize - UDim2.new(0, 1, 0, 1)
		}, 0.08)
	end)

	button.MouseButton1Up:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.08)
	end)
end

