-- Dragging
local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Core logic (unchanged)
local function getRootPart(player)
	if not player then return nil end
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function getFrontCFrame()
	local myCharacter = LOCAL_PLAYER.Character
	if not myCharacter then return nil end
	local myHRP = myCharacter:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end
	local direction = myHRP.CFrame.LookVector
	local newPosition = myHRP.Position + direction * FRONT_DISTANCE
	return CFrame.lookAt(newPosition, newPosition + direction)
end

local function movePlayerToFront(player)
	if not player or player == LOCAL_PLAYER then return end
	if not player.Character then return end
	local targetHRP = getRootPart(player)
	if not targetHRP then return end
	local frontCFrame = getFrontCFrame()
	if not frontCFrame then return end
	player.Character:PivotTo(frontCFrame)
end

local function setPlayerCollision(player, canCollide)
	if not player or not player.Character then return end
	for _, object in ipairs(player.Character:GetDescendants()) do
		if object:IsA("BasePart") then
			object.CanCollide = canCollide
		end
	end
end

local function trackPlayer(player)
	if not player or player == LOCAL_PLAYER then return end
	trackedPlayers[player] = true
	setPlayerCollision(player, false)
	movePlayerToFront(player)
end

local function disableBring()
	for player in pairs(trackedPlayers) do
		setPlayerCollision(player, true)
		trackedPlayers[player] = nil
	end
	KEEP_IN_FRONT = false
	disableButton.Text = "Bring Disabled"
	disableButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	task.delay(1.2, function()
		if disableButton and disableButton.Parent then
			disableButton.Text = "Disable Bring"
			disableButton.BackgroundColor3 = Theme.Danger
		end
	end)
end

local function findPlayers(target)
	local results = {}
	target = string.lower(target)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LOCAL_PLAYER then
			local playerName = string.lower(player.Name)
			local displayName = string.lower(player.DisplayName)
			if string.find(playerName, target, 1, true) or string.find(displayName, target, 1, true) then
				table.insert(results, player)
			end
		end
	end
	return results
end

local function bringPlayers(target)
	target = string.lower(string.gsub(target, "^%s*(.-)%s*$", "%1"))
	if target == "" then return end
	KEEP_IN_FRONT = true
	if target == "all" then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LOCAL_PLAYER then
				trackPlayer(player)
			end
		end
		return
	end
	local matchedPlayers = findPlayers(target)
	for _, player in ipairs(matchedPlayers) do
		trackPlayer(player)
	end
end

