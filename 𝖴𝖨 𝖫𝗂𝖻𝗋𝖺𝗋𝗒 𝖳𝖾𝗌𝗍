			overlayBtn.Activated:Connect(function()
				Set(not state)
			end)

			row.MouseEnter:Connect(function()
				Tween(row, { BackgroundColor3 = Theme.SurfaceHover }):Play()
			end)
			row.MouseLeave:Connect(function()
				Tween(row, { BackgroundColor3 = Theme.Elevated }):Play()
			end)

			local api = {}
			function api:Set(v) Set(v) end
			function api:Get() return state end
			return api
		end

