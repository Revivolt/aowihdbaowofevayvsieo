	function Window:AddTab(tabName)
		local isFirst = #self._tabs == 0

		local TBtn = New("TextButton", {
			Name = tabName .. "_Btn",
			Text = "  " .. tabName,
			Font = Enum.Font.GothamSemibold,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.TextSecondary,
			BackgroundColor3 = Theme.Elevated,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, 30),
			Parent = TabBtnList,
		})
		Corner(6, TBtn)
		setupButtonAnimations(TBtn, Theme.Elevated, Theme.SurfaceHover, Theme.AccentDim)

		local TBar = New("Frame", {
			Name = "ActiveBar",
			Size = UDim2.new(0, 3, 0, 14),
			Position = UDim2.new(0, 2, 0.5, -7),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			Parent = TBtn,
		})
		Corner(3, TBar)

		local TContent = New("ScrollingFrame", {
			Name = tabName .. "_Content",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Accent,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			Parent = ContentArea,
		})
		New("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 5),
			Parent = TContent,
		})
		Pad(4, 4, 8, 0, TContent)

		local Tab = { _order = 0, _content = TContent, _btn = TBtn, _window = self }

		local function Activate()
			for _, t in ipairs(self._tabs) do
				t._content.Visible = false
				Tween(t._btn, { BackgroundTransparency = 1, TextColor3 = Theme.TextSecondary }):Play()
				local ab = t._btn:FindFirstChild("ActiveBar")
				if ab then Tween(ab, { BackgroundTransparency = 1 }):Play() end
			end
			TContent.Visible = true
			Tween(TBtn, { BackgroundTransparency = 0.65, TextColor3 = Theme.TextPrimary }):Play()
			Tween(TBar, { BackgroundTransparency = 0 }):Play()
			self._activeTab = Tab
		end

		TBtn.Activated:Connect(Activate)
		table.insert(self._tabs, Tab)
		if isFirst then Activate() end

		local function Row(h)
			local r = New("Frame", {
				Size = UDim2.new(1, 0, 0, h or 36),
				BackgroundColor3 = Theme.Elevated,
				BackgroundTransparency = T,
				BorderSizePixel = 0,
				LayoutOrder = Tab._order,
				Parent = TContent,
			})
			Tab._order += 1
			Corner(7, r)
			return r
		end

		local function RowLabel(text, parent)
			New("TextLabel", {
				Text = text,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = Theme.TextPrimary,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(0.55, -12, 1, 0),
				Position = UDim2.new(0, 12, 0, 0),
				Parent = parent,
			})
		end

		-- BUTTON
		function Tab:AddButton(cfg)
			cfg = cfg or {}
			local callback = cfg.Callback or function() end

			local btn = New("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundColor3 = Theme.Elevated,
				BackgroundTransparency = T,
				BorderSizePixel = 0,
				LayoutOrder = Tab._order,
				Parent = TContent,
			})
			Tab._order += 1
			Corner(7, btn)
