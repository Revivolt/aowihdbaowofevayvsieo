local function Tween(inst, props, t, style, dir)
	return TweenService:Create(
		inst,
		TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
end

local function setupButtonAnimations(button, normalColor, hoverColor, pressColor)
	local originalSize = button.Size

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.12):Play()
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = normalColor,
			Size = originalSize
		}, 0.12):Play()
	end)

	button.MouseButton1Down:Connect(function()
		Tween(button, {
			BackgroundColor3 = pressColor,
			Size = originalSize - UDim2.new(0, 1, 0, 1)
		}, 0.08):Play()
	end)

	button.MouseButton1Up:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.08):Play()
	end)
end

local function New(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function Corner(r, p)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = p
end

local function Stroke(color, thick, p)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Border
	s.Thickness = thick or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
end

local function Pad(top, right, bottom, left, p)
	local u = Instance.new("UIPadding")
	u.PaddingTop = UDim.new(0, top or 0)
	u.PaddingRight = UDim.new(0, right or 0)
	u.PaddingBottom = UDim.new(0, bottom or 0)
	u.PaddingLeft = UDim.new(0, left or 0)
	u.Parent = p
end

local function MakeDraggable(handle, target)
	local dragging, start, origin = false, nil, nil

	local function isValidBegin(i)
		return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
	end
	local function isValidMove(i)
		return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
	end
	local function isValidEnd(i)
		return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
	end

	handle.InputBegan:Connect(function(i)
		if isValidBegin(i) then
			dragging = true
			start = i.Position
			origin = target.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(i)
		if dragging and isValidMove(i) then
			local d = i.Position - start
			target.Position = UDim2.new(
				origin.X.Scale, origin.X.Offset + d.X,
				origin.Y.Scale, origin.Y.Offset + d.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(i)
		if isValidEnd(i) then
			dragging = false
		end
	end)
end

local function GetGuiParent()
	if RunService:IsStudio() then
		return LocalPlayer:FindFirstChildOfClass("PlayerGui")
	end
	local ok, hui = pcall(gethui)
	if ok and hui then return hui end
	return LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

