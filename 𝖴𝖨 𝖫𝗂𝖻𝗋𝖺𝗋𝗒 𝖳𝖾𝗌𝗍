				Position = UDim2.new(0, 12, 0, 0),
				Parent = btn,
			})
			New("TextLabel", {
				Text = "›",
				Font = Enum.Font.GothamBold,
				TextSize = 18,
				TextColor3 = Theme.Accent,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 20, 1, 0),
				Position = UDim2.new(1, -28, 0, 0),
				Parent = btn,
			})

			btn.Activated:Connect(function()
				task.spawn(callback)
			end)

			local api = {}
			function api:SetLabel(t)
				btn:FindFirstChildWhichIsA("TextLabel").Text = t
			end
			return api
		end

		-- TOGGLE
		function Tab:AddToggle(cfg)
			cfg = cfg or {}
			local state = cfg.Default == true
			local callback = cfg.Callback or function() end

			local row = Row(36)
			RowLabel(cfg.Label or "Toggle", row)

			local Pill = New("Frame", {
				Size = UDim2.new(0, 44, 0, 22),
				Position = UDim2.new(1, -54, 0.5, -11),
				BackgroundColor3 = state and Theme.Accent or Theme.Border,
				BackgroundTransparency = T,
				BorderSizePixel = 0,
				Parent = row,
			})
			Corner(11, Pill)

			local Knob = New("Frame", {
				Size = UDim2.new(0, 16, 0, 16),
				Position = state and UDim2.new(0, 24, 0.5, -8) or UDim2.new(0, 4, 0.5, -8),
				BackgroundColor3 = Theme.White,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				Parent = Pill,
			})
			Corner(8, Knob)

			local function Set(v)
				state = v
				Tween(Pill, { BackgroundColor3 = v and Theme.Accent or Theme.Border }):Play()
				Tween(Knob, { Position = v and UDim2.new(0, 24, 0.5, -8) or UDim2.new(0, 4, 0.5, -8) }):Play()
				task.spawn(callback, v)
