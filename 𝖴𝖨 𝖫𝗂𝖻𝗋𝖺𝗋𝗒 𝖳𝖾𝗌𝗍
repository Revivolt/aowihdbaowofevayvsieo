	setupButtonAnimations(CloseBtn, Theme.CloseRed, Color3.fromRGB(50, 50, 50), Color3.fromRGB(15, 15, 15))

	local ToggleGui, ToggleBtn = CreateToggleButton(Gui, Main, originalSize)

	-- Close: collapse both UI + toggle, then destroy
	local function closeEverything()
		local CLOSE_T = 0.22
		local info = TweenInfo.new(CLOSE_T, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

		local scale = Instance.new("UIScale")
		scale.Scale = 1
		scale.Parent = Main

		TweenService:Create(scale, info, { Scale = 0.85 }):Play()
		TweenService:Create(Main, info, { BackgroundTransparency = 1 }):Play()

		if ToggleBtn and ToggleBtn.Parent then
			TweenService:Create(ToggleBtn, info, {
				Size = UDim2.fromOffset(8, 8),
				BackgroundTransparency = 1,
				ImageTransparency = 1
			}):Play()
		end

		for _, desc in ipairs(Main:GetDescendants()) do
			if desc:IsA("Frame") or desc:IsA("TextLabel") or desc:IsA("TextButton")
				or desc:IsA("ScrollingFrame") or desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
				pcall(function()
					TweenService:Create(desc, info, {
						BackgroundTransparency = 1,
						TextTransparency = 1,
						ImageTransparency = 1
					}):Play()
				end)
			end
		end

		task.delay(CLOSE_T + 0.06, function()
			if Gui then Gui:Destroy() end
			if ToggleGui then ToggleGui:Destroy() end
		end)
	end

	CloseBtn.MouseButton1Click:Connect(closeEverything)
	CloseBtn.Activated:Connect(closeEverything)

	MakeDraggable(TitleBar, Main)

