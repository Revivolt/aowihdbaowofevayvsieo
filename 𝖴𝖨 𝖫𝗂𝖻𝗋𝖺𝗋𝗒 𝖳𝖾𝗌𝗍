    -- ──────────────────────────────────────────────────────
    --  AddTab
    -- ──────────────────────────────────────────────────────
    function Window:AddTab(tabName)
        local isFirst = #self._tabs == 0

        local TBtn = New("TextButton", {
            Name                   = tabName .. "_Btn",
            Text                   = "  " .. tabName,
            Font                   = Enum.Font.GothamSemibold,
            TextSize               = 12,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextColor3             = Theme.TextSecondary,
            BackgroundColor3       = Theme.Elevated,
            BackgroundTransparency = 1,
            AutoButtonColor        = false,
            Size                   = UDim2.new(1, 0, 0, 30),
            Parent                 = TabBtnList,
        })
        Corner(6, TBtn)

        local TBar = New("Frame", {
            Name                   = "ActiveBar",
            Size                   = UDim2.new(0, 3, 0, 14),
            Position               = UDim2.new(0, 2, 0.5, -7),
            BackgroundColor3       = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
            Parent                 = TBtn,
        })
        Corner(3, TBar)

        local TContent = New("ScrollingFrame", {
            Name                   = tabName .. "_Content",
            Size                   = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel        = 0,
            ScrollBarThickness     = 3,
            ScrollBarImageColor3   = Theme.Accent,
            CanvasSize             = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize    = Enum.AutomaticSize.Y,
            Visible                = false,
            Parent                 = ContentArea,
        })
        New("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding   = UDim.new(0, 5),
            Parent    = TContent,
        })
        Pad(4, 4, 8, 0, TContent)

        local Tab = { _order = 0, _content = TContent, _btn = TBtn, _window = self }

        local function Activate()
            for _, t in ipairs(self._tabs) do
                t._content.Visible = false
                Tween(t._btn, { BackgroundTransparency = 1, TextColor3 = Theme.TextSecondary })
                local ab = t._btn:FindFirstChild("ActiveBar")
                if ab then Tween(ab, { BackgroundTransparency = 1 }) end
            end
            TContent.Visible = true
            Tween(TBtn, { BackgroundTransparency = 0.65, TextColor3 = Theme.TextPrimary })
            Tween(TBar, { BackgroundTransparency = 0 })
            self._activeTab = Tab
        end

        TBtn.MouseButton1Click:Connect(Activate)
        TBtn.MouseEnter:Connect(function()
            if self._activeTab ~= Tab then
                Tween(TBtn, { BackgroundTransparency = 0.78, TextColor3 = Theme.TextPrimary })
            end
        end)
        TBtn.MouseLeave:Connect(function()
            if self._activeTab ~= Tab then
                Tween(TBtn, { BackgroundTransparency = 1, TextColor3 = Theme.TextSecondary })
            end
        end)

        table.insert(self._tabs, Tab)
        if isFirst then Activate() end

        local function Row(h)
            local r = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, h or 36),
                BackgroundColor3       = Theme.Elevated,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                LayoutOrder            = Tab._order,
                Parent                 = TContent,
            })
            Tab._order += 1
            Corner(7, r)
            return r
        end

        local function RowLabel(text, parent)
            New("TextLabel", {
                Text                   = text,
                Font                   = Enum.Font.Gotham,
                TextSize               = 13,
                TextColor3             = Theme.TextPrimary,
                TextXAlignment         = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(0.55, -12, 1, 0),
                Position               = UDim2.new(0, 12, 0, 0),
                Parent                 = parent,
            })
        end

        -- ────────────────────────────────────────────────────
        --  BUTTON
        -- ────────────────────────────────────────────────────
        function Tab:AddButton(cfg)
            cfg = cfg or {}
            local callback = cfg.Callback or function() end

            local btn = New("TextButton", {
                Text                   = "",
                AutoButtonColor        = false,
                Size                   = UDim2.new(1, 0, 0, 36),
                BackgroundColor3       = Theme.Elevated,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                LayoutOrder            = Tab._order,
                Parent                 = TContent,
            })
            Tab._order += 1
            Corner(7, btn)

            New("TextLabel", {
                Text                   = cfg.Label or "Button",
                Font                   = Enum.Font.GothamSemibold,
                TextSize               = 13,
                TextColor3             = Theme.TextPrimary,
                TextXAlignment         = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(1, -40, 1, 0),
                Position               = UDim2.new(0, 12, 0, 0),
                Parent                 = btn,
            })

            New("TextLabel", {
                Text                   = "›",
                Font                   = Enum.Font.GothamBold,
                TextSize               = 18,
                TextColor3             = Theme.Accent,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(0, 20, 1, 0),
                Position               = UDim2.new(1, -28, 0, 0),
                Parent                 = btn,
            })

            btn.MouseEnter:Connect(function()
                Tween(btn, { BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = T })
            end)
            btn.MouseLeave:Connect(function()
                Tween(btn, { BackgroundColor3 = Theme.Elevated, BackgroundTransparency = T })
            end)
            btn.MouseButton1Click:Connect(function()
                Tween(btn, { BackgroundColor3 = Theme.AccentDim, BackgroundTransparency = T }, 0.07)
                task.delay(0.13, function()
                    Tween(btn, { BackgroundColor3 = Theme.Elevated, BackgroundTransparency = T })
                end)
                task.spawn(callback)
            end)

            local api = {}
            function api:SetLabel(t) btn:FindFirstChildWhichIsA("TextLabel").Text = t end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  TOGGLE
        -- ────────────────────────────────────────────────────
        function Tab:AddToggle(cfg)
            cfg = cfg or {}
            local state    = cfg.Default  == true
            local callback = cfg.Callback or function() end

            local row = Row(36)
            RowLabel(cfg.Label or "Toggle", row)

            local Pill = New("Frame", {
                Size                   = UDim2.new(0, 44, 0, 22),
                Position               = UDim2.new(1, -54, 0.5, -11),
                BackgroundColor3       = state and Theme.Accent or Theme.Border,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                Parent                 = row,
            })
            Corner(11, Pill)

            local Knob = New("Frame", {
                Size                   = UDim2.new(0, 16, 0, 16),
                Position               = state and UDim2.new(0, 24, 0.5, -8) or UDim2.new(0, 4, 0.5, -8),
                BackgroundColor3       = Theme.White,
                BackgroundTransparency = 0.2,
                BorderSizePixel        = 0,
                Parent                 = Pill,
            })
            Corner(8, Knob)

            local function Set(v)
                state = v
                Tween(Pill, { BackgroundColor3 = v and Theme.Accent or Theme.Border })
                Tween(Knob, { Position = v and UDim2.new(0, 24, 0.5, -8) or UDim2.new(0, 4, 0.5, -8) })
                task.spawn(callback, v)
            end

            New("TextButton", {
                Text                   = "",
                BackgroundTransparency = 1,
                Size                   = UDim2.new(1, 0, 1, 0),
                Parent                 = row,
            }).MouseButton1Click:Connect(function() Set(not state) end)

            row.MouseEnter:Connect(function() Tween(row, { BackgroundColor3 = Theme.SurfaceHover }) end)
            row.MouseLeave:Connect(function() Tween(row, { BackgroundColor3 = Theme.Elevated }) end)

            local api = {}
            function api:Set(v) Set(v) end
            function api:Get() return state end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  SLIDER
        -- ────────────────────────────────────────────────────
        function Tab:AddSlider(cfg)
            cfg = cfg or {}
            local min      = cfg.Min      or 0
            local max      = cfg.Max      or 100
            local step     = cfg.Step     or 1
            local suffix   = cfg.Suffix   or ""
            local value    = math.clamp(cfg.Default or min, min, max)
            local callback = cfg.Callback or function() end

            local row = Row(52)

            New("TextLabel", {
                Text                   = cfg.Label or "Slider",
                Font                   = Enum.Font.GothamSemibold,
                TextSize               = 13,
                TextColor3             = Theme.TextPrimary,
                TextXAlignment         = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(0.6, -12, 0, 26),
                Position               = UDim2.new(0, 12, 0, 6),
                Parent                 = row,
            })

            -- Editable value box — looks like a label at rest, becomes an
            -- input field on click. Suffix is stripped while typing so the
            -- user only deals with the raw number.
            local ValLbl = New("TextBox", {
                Text                   = tostring(value) .. suffix,
                PlaceholderText        = tostring(value),
                Font                   = Enum.Font.GothamBold,
                TextSize               = 13,
                TextColor3             = Theme.Accent,
                PlaceholderColor3      = Theme.AccentDim,
                TextXAlignment         = Enum.TextXAlignment.Right,
                BackgroundColor3       = Theme.InputBG,
                BackgroundTransparency = 1,   -- hidden until focused
                BorderSizePixel        = 0,
                ClearTextOnFocus       = false,
                Size                   = UDim2.new(0.38, -12, 0, 26),
                Position               = UDim2.new(0.62, 0, 0, 6),
                Parent                 = row,
            })
            Corner(5, ValLbl)
            local ValStroke = Instance.new("UIStroke")
            ValStroke.Color           = Theme.Accent
            ValStroke.Thickness       = 1
            ValStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            ValStroke.Enabled         = false
            ValStroke.Parent          = ValLbl
            Pad(0, 4, 0, 4, ValLbl)

            local Track = New("Frame", {
                Size                   = UDim2.new(1, -24, 0, 4),
                Position               = UDim2.new(0, 12, 0, 38),
                BackgroundColor3       = Theme.Border,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                Parent                 = row,
            })
            Corner(4, Track)

            local pct0 = (value - min) / (max - min)

            local Fill = New("Frame", {
                Size                   = UDim2.new(pct0, 0, 1, 0),
                BackgroundColor3       = Theme.SliderFill,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                Parent                 = Track,
            })
            Corner(4, Fill)

            local Thumb = New("Frame", {
                Size                   = UDim2.new(0, 14, 0, 14),
                Position               = UDim2.new(pct0, -7, 0.5, -7),
                BackgroundColor3       = Theme.White,
                BackgroundTransparency = 0,
                BorderSizePixel        = 0,
                Parent                 = Track,
            })
            Corner(7, Thumb)
            Stroke(Theme.Accent, 2, Thumb)

            local function SetValue(v)
                v = math.clamp(math.round(v / step) * step, min, max)
                value = v
                local p = (v - min) / (max - min)
                Tween(Fill,  { Size     = UDim2.new(p, 0, 1, 0)     }, 0.05)
                Tween(Thumb, { Position = UDim2.new(p, -7, 0.5, -7) }, 0.05)
                ValLbl.Text = tostring(v) .. suffix
                task.spawn(callback, v)
            end

            -- Wire up the editable value box now that SetValue exists
            ValLbl.Focused:Connect(function()
                ValLbl.Text = tostring(value)
                Tween(ValLbl, { BackgroundTransparency = T, TextColor3 = Theme.TextPrimary })
                ValStroke.Enabled = true
            end)

            ValLbl.FocusLost:Connect(function()
                ValStroke.Enabled = false
                Tween(ValLbl, { BackgroundTransparency = 1, TextColor3 = Theme.Accent })
                local num = tonumber(ValLbl.Text)
                if num then
                    SetValue(num)
                end
                ValLbl.Text = tostring(value) .. suffix
            end)

            local dragging = false
            local function Calc(inp)
                local ap = Track.AbsolutePosition
                local as = Track.AbsoluteSize
                SetValue(min + (max - min) * math.clamp((inp.Position.X - ap.X) / as.X, 0, 1))
            end

            Track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true; Calc(i)
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then Calc(i) end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)

            local api = {}
            function api:Set(v) SetValue(v) end
            function api:Get() return value end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  DROPDOWN
        -- ────────────────────────────────────────────────────
        function Tab:AddDropdown(cfg)
            cfg = cfg or {}
            local options  = cfg.Options  or {}
            local selected = cfg.Default  or (options[1] or "None")
            local callback = cfg.Callback or function() end
            local open     = false

            local Wrapper = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 36),
                BackgroundTransparency = 1,
                ClipsDescendants       = false,
                LayoutOrder            = Tab._order,
                ZIndex                 = 5,
                Parent                 = TContent,
            })
            Tab._order += 1

            local Header = New("TextButton", {
                Text                   = "",
                AutoButtonColor        = false,
                Size                   = UDim2.new(1, 0, 0, 36),
                BackgroundColor3       = Theme.Elevated,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                ZIndex                 = 5,
                Parent                 = Wrapper,
            })
            Corner(7, Header)

            RowLabel(cfg.Label or "Dropdown", Header)

            local SelLbl = New("TextLabel", {
                Text                   = selected,
                Font                   = Enum.Font.Gotham,
                TextSize               = 12,
                TextColor3             = Theme.TextSecondary,
                TextXAlignment         = Enum.TextXAlignment.Right,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(0.38, -30, 1, 0),
                Position               = UDim2.new(0.57, 0, 0, 0),
                ZIndex                 = 5,
                Parent                 = Header,
            })

            local Arrow = New("TextLabel", {
                Text                   = "⇌",
                Font                   = Enum.Font.GothamBold,
                TextSize               = 14,
                TextColor3             = Theme.Accent,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(0, 20, 1, 0),
                Position               = UDim2.new(1, -26, 0, 0),
                ZIndex                 = 5,
                Parent                 = Header,
            })

            local panelH = #options * 30 + 8

            local Panel = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, 0),
                Position               = UDim2.new(0, 0, 0, 39),
                BackgroundColor3       = Theme.DropBG,
                BackgroundTransparency = 0,
                BorderSizePixel        = 0,
                ClipsDescendants       = true,
                ZIndex                 = 20,
                Parent                 = Wrapper,
            })
            Corner(7, Panel)

            local PanelStroke = Instance.new("UIStroke")
            PanelStroke.Color           = Theme.Border
            PanelStroke.Thickness       = 1
            PanelStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            PanelStroke.Enabled         = false
            PanelStroke.Parent          = Panel

            local ItemList = New("Frame", {
                Size                   = UDim2.new(1, 0, 0, panelH),
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                ZIndex                 = 21,
                Parent                 = Panel,
            })
            New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding   = UDim.new(0, 2),
                Parent    = ItemList,
            })
            Pad(4, 4, 4, 4, ItemList)

            for i, opt in ipairs(options) do
                local OBtn = New("TextButton", {
                    Text                   = opt,
                    Font                   = Enum.Font.Gotham,
                    TextSize               = 13,
                    TextColor3             = (opt == selected) and Theme.Accent or Theme.TextPrimary,
                    TextXAlignment         = Enum.TextXAlignment.Left,
                    BackgroundColor3       = Theme.DropItem,
                    BackgroundTransparency = 0,
                    AutoButtonColor        = false,
                    Size                   = UDim2.new(1, 0, 0, 28),
                    LayoutOrder            = i,
                    ZIndex                 = 22,
                    Parent                 = ItemList,
                })
                Corner(5, OBtn)
                Pad(0, 0, 0, 8, OBtn)

                OBtn.MouseEnter:Connect(function()
                    Tween(OBtn, { BackgroundColor3 = Theme.SurfaceHover })
                end)
                OBtn.MouseLeave:Connect(function()
                    Tween(OBtn, { BackgroundColor3 = Theme.DropItem })
                end)
                OBtn.MouseButton1Click:Connect(function()
                    selected    = opt
                    SelLbl.Text = opt
                    for _, c in ipairs(ItemList:GetChildren()) do
                        if c:IsA("TextButton") then Tween(c, { TextColor3 = Theme.TextPrimary }) end
                    end
                    Tween(OBtn, { TextColor3 = Theme.Accent })
                    open = false
                    Tween(Panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.14)
                    Tween(Arrow, { Rotation = 0 })
                    task.delay(0.15, function() PanelStroke.Enabled = false end)
                    task.spawn(callback, opt)
                end)
            end

            Header.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    PanelStroke.Enabled = true
                    Tween(Panel, { Size = UDim2.new(1, 0, 0, panelH) }, 0.16)
                    Tween(Arrow, { Rotation = 180 })
                else
                    Tween(Panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.14)
                    Tween(Arrow, { Rotation = 0 })
                    task.delay(0.15, function() PanelStroke.Enabled = false end)
                end
            end)
            Header.MouseEnter:Connect(function()
                Tween(Header, { BackgroundColor3 = Theme.SurfaceHover })
            end)
            Header.MouseLeave:Connect(function()
                Tween(Header, { BackgroundColor3 = Theme.Elevated })
            end)

            local api = {}
            function api:Set(v)
                selected    = v
                SelLbl.Text = v
                task.spawn(callback, v)
            end
            function api:Get() return selected end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  TEXT INPUT
        -- ────────────────────────────────────────────────────
        function Tab:AddTextInput(cfg)
            cfg = cfg or {}
            local callback = cfg.Callback or function() end

            local row = Row(36)
            RowLabel(cfg.Label or "Input", row)

            local Box = New("TextBox", {
                Text                   = cfg.Default     or "",
                PlaceholderText        = cfg.Placeholder or "Type here...",
                Font                   = Enum.Font.Gotham,
                TextSize               = 12,
                TextColor3             = Theme.TextPrimary,
                PlaceholderColor3      = Theme.TextDisabled,
                TextXAlignment         = Enum.TextXAlignment.Left,
                BackgroundColor3       = Theme.InputBG,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                ClearTextOnFocus       = cfg.ClearOnFocus ~= false,
                Size                   = UDim2.new(0, 136, 0, 24),
                Position               = UDim2.new(1, -8, 0.5, -12),
                AnchorPoint            = Vector2.new(1, 0),
                Parent                 = row,
            })
            Corner(5, Box)
            Stroke(Theme.Border, 1, Box)
            Pad(0, 6, 0, 6, Box)

            Box.Focused:Connect(function()
                Tween(Box, { BackgroundColor3 = Theme.Elevated, BackgroundTransparency = T })
            end)
            Box.FocusLost:Connect(function(enter)
                Tween(Box, { BackgroundColor3 = Theme.InputBG, BackgroundTransparency = T })
                if enter then task.spawn(callback, Box.Text) end
            end)
            Box:GetPropertyChangedSignal("Text"):Connect(function()
                task.spawn(callback, Box.Text)
            end)

            local api = {}
            function api:Set(v) Box.Text = v end
            function api:Get() return Box.Text end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  KEYBIND
        -- ────────────────────────────────────────────────────
        function Tab:AddKeybind(cfg)
            cfg = cfg or {}
            local currentKey = cfg.Default  or Enum.KeyCode.Unknown
            local callback   = cfg.Callback or function() end
            local listening  = false

            local row = Row(36)
            RowLabel(cfg.Label or "Keybind", row)

            local KBtn = New("TextButton", {
                Text                   = "[" .. currentKey.Name .. "]",
                Font                   = Enum.Font.GothamBold,
                TextSize               = 12,
                TextColor3             = Theme.Accent,
                BackgroundColor3       = Theme.InputBG,
                BackgroundTransparency = T,
                AutoButtonColor        = false,
                BorderSizePixel        = 0,
                Size                   = UDim2.new(0, 100, 0, 24),
                Position               = UDim2.new(1, -108, 0.5, -12),
                Parent                 = row,
            })
            Corner(5, KBtn)
            Stroke(Theme.Border, 1, KBtn)

            local function StopListen()
                listening = false
                KBtn.Text = "[" .. currentKey.Name .. "]"
                Tween(KBtn, {
                    TextColor3             = Theme.Accent,
                    BackgroundColor3       = Theme.InputBG,
                    BackgroundTransparency = T,
                })
            end

            KBtn.MouseButton1Click:Connect(function()
                if listening then StopListen(); return end
                listening = true
                KBtn.Text = "[ ... ]"
                Tween(KBtn, {
                    TextColor3             = Theme.TextPrimary,
                    BackgroundColor3       = Theme.AccentDim,
                    BackgroundTransparency = T,
                })
            end)

            UserInputService.InputBegan:Connect(function(inp)
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = inp.KeyCode
                    StopListen()
                    task.spawn(callback, currentKey)
                end
            end)

            local api = {}
            function api:Set(key) currentKey = key; StopListen() end
            function api:Get() return currentKey end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  LABEL
        -- ────────────────────────────────────────────────────
        function Tab:AddLabel(text, style)
            style = style or "section"
            local lbl = New("TextLabel", {
                Text                   = text,
                Font                   = style == "section" and Enum.Font.GothamBold or Enum.Font.Gotham,
                TextSize               = style == "section" and 10 or 12,
                TextColor3             = style == "section" and Theme.TextDisabled or Theme.TextSecondary,
                TextXAlignment         = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size                   = UDim2.new(1, 0, 0, style == "section" and 16 or 26),
                LayoutOrder            = Tab._order,
                Parent                 = TContent,
            })
            Tab._order += 1
            Pad(0, 0, 0, 4, lbl)
            return lbl
        end

        -- ────────────────────────────────────────────────────
        --  SEPARATOR
        -- ────────────────────────────────────────────────────
        function Tab:AddSeparator()
            local sep = New("Frame", {
                Size                   = UDim2.new(1, -4, 0, 1),
                BackgroundColor3       = Theme.Border,
                BackgroundTransparency = T,
                BorderSizePixel        = 0,
                LayoutOrder            = Tab._order,
                Parent                 = TContent,
            })
            Tab._order += 1
            return sep
        end

        return Tab
    end -- AddTab

    return Window
end -- CreateWindow

NovaUI.Theme = Theme
return NovaUI
