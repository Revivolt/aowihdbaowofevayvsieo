    -- ── AddTab ──────────────────────────────────────────────
    function Window:AddTab(name, icon)
        -- Tab button
        local tabBtn = Create("TextButton", {
            Name             = "Tab_" .. name,
            Text             = "",
            BackgroundColor3 = THEME.Surface,
            BackgroundTransparency = 1,
            Size             = UDim2.new(1, 0, 0, 34),
            LayoutOrder      = #self._tabs + 1,
            Parent           = tabButtonList,
        })
        AddCorner(tabBtn, 6)

        local btnLayout = Create("Frame", {
            BackgroundTransparency = 1,
            Size   = UDim2.new(1, 0, 1, 0),
            Parent = tabBtn,
        })
        AddPadding(btnLayout, 0, 6, 0, 6)

        if icon and icon ~= "" then
            Create("ImageLabel", {
                Image            = icon,
                BackgroundTransparency = 1,
                Size             = UDim2.new(0, 16, 0, 16),
                Position         = UDim2.new(0, 0, 0.5, -8),
                Parent           = btnLayout,
            })
        end

        local btnLabel = Create("TextLabel", {
            Text             = name,
            TextColor3       = THEME.TextDim,
            Font             = Enum.Font.GothamMedium,
            TextSize         = 13,
            BackgroundTransparency = 1,
            Position         = UDim2.new(0, icon ~= "" and 22 or 0, 0, 0),
            Size             = UDim2.new(1, -(icon ~= "" and 22 or 0), 1, 0),
            TextXAlignment   = Enum.TextXAlignment.Left,
            Parent           = btnLayout,
        })

        -- Accent indicator
        local indicator = Create("Frame", {
            Size             = UDim2.new(0, 3, 0, 18),
            Position         = UDim2.new(0, -8, 0.5, -9),
            BackgroundColor3 = THEME.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Parent           = tabBtn,
        })
        AddCorner(indicator, 2)

        -- Tab content frame
        local tabFrame = Create("ScrollingFrame", {
            Name             = "Content_" .. name,
            BackgroundTransparency = 1,
            Size             = UDim2.new(1, 0, 1, 0),
            CanvasSize        = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = THEME.Accent,
            ScrollBarImageTransparency = 0.5,
            Visible          = false,
            ClipsDescendants = true,
            Parent           = contentArea,
        })
        AddPadding(tabFrame, 10, 12, 10, 12)
        local listLayout = Create("UIListLayout", {
            SortOrder  = Enum.SortOrder.LayoutOrder,
            Padding    = UDim.new(0, 6),
            Parent     = tabFrame,
        })

        local Tab = {
            _frame  = tabFrame,
            _layout = listLayout,
            _count  = 0,
        }

        -- Switch to this tab
        local function activate()
            -- Deactivate old tab
            if Window._activeTab then
                local old = Window._activeTab
                old._frame.Visible = false
                Tween(old._btn,       { BackgroundTransparency = 1 })
                Tween(old._btnLabel,  { TextColor3 = THEME.TextDim })
                Tween(old._indicator, { BackgroundTransparency = 1 })
            end
            Window._activeTab = Tab
            Tab._frame.Visible = true
            Tween(tabBtn,    { BackgroundTransparency = 0, BackgroundColor3 = THEME.SurfaceAlt })
            Tween(btnLabel,  { TextColor3 = THEME.TextPrimary })
            Tween(indicator, { BackgroundTransparency = 0 })
        end

        Tab._btn       = tabBtn
        Tab._btnLabel  = btnLabel
        Tab._indicator = indicator

        tabBtn.MouseButton1Click:Connect(activate)
        tabBtn.MouseEnter:Connect(function()
            if Window._activeTab ~= Tab then
                Tween(tabBtn, { BackgroundTransparency = 0.6, BackgroundColor3 = THEME.SurfaceAlt })
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if Window._activeTab ~= Tab then
                Tween(tabBtn, { BackgroundTransparency = 1 })
            end
        end)

        table.insert(self._tabs, Tab)
        if #self._tabs == 1 then activate() end

        -- ── Section ─────────────────────────────────────────
        function Tab:AddSection(sectionName)
            Tab._count += 1
            local sectionLabel = Create("TextLabel", {
                Text             = sectionName:upper(),
                TextColor3       = THEME.Accent,
                Font             = Enum.Font.GothamBold,
                TextSize         = 10,
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 0, 20),
                TextXAlignment   = Enum.TextXAlignment.Left,
                LayoutOrder      = Tab._count,
                Parent           = tabFrame,
            })
            local div = Create("Frame", {
                Size             = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = THEME.Border,
                BorderSizePixel  = 0,
                LayoutOrder      = Tab._count + 0.5,
                Parent           = tabFrame,
            })
        end

        -- ── Helper: Row container ────────────────────────────
        local function MakeRow(layoutOrder)
            Tab._count += 1
            local row = Create("Frame", {
                Name             = "Row" .. layoutOrder,
                Size             = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = THEME.SurfaceAlt,
                LayoutOrder      = Tab._count,
                Parent           = tabFrame,
            })
            AddCorner(row, 7)
            AddStroke(row, THEME.Border)
            return row
        end

        -- ══════════════════════════════════════════════════
        --                     BUTTON
        -- ══════════════════════════════════════════════════
