    -- ──────────────────────────────────────────────────────
    --  AddTab
    -- ──────────────────────────────────────────────────────
    function Window:AddTab(tabName)
        local isFirst = #self._tabs == 0

        -- Tab button
        local TBtn = New("TextButton", {
            Name             = tabName .. "_Btn",
            Text             = " " .. tabName,
            Font             = Enum.Font.GothamSemibold,
            TextSize         = 13,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextColor3       = Theme.TextSecondary,
            BackgroundColor3 = Theme.Surface,
            BackgroundTransparency = 1,
            AutoButtonColor  = false,
            Size             = UDim2.new(1, 0, 0, 32),
            Parent           = TabBtnList,
        })
        Corner(6, TBtn)
        Pad(0, 0, 0, 10, TBtn)

        local TBar = New("Frame", {
            Size             = UDim2.new(0, 3, 0, 14),
            Position         = UDim2.new(0, -1, 0.5, -7),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Parent           = TBtn,
        })
        Corner(3, TBar)

        -- Tab scroll frame (the content panel)
        local TContent = New("ScrollingFrame", {
            Name                  = tabName .. "_Content",
            Size                  = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency= 1,
            BorderSizePixel       = 0,
            ScrollBarThickness    = 3,
            ScrollBarImageColor3  = Theme.Accent,
            CanvasSize            = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize   = Enum.AutomaticSize.Y,
            Visible               = false,
            Parent                = ContentArea,
        })
        New("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding   = UDim.new(0, 5),
            Parent    = TContent,
        })
        Pad(6, 6, 10, 2, TContent)

        -- Tab object
        local Tab = { _order = 0, _content = TContent, _btn = TBtn, _window = self }

        local function Activate()
            for _, t in ipairs(self._tabs) do
                t._content.Visible = false
                Tween(t._btn, { BackgroundTransparency = 1, TextColor3 = Theme.TextSecondary })
                Tween(t._btn.ActiveBar or t._btn:FindFirstChildOfClass("Frame"),
                    { BackgroundTransparency = 1 })
            end
            TContent.Visible = true
            Tween(TBtn,  { BackgroundTransparency = 0.82, TextColor3 = Theme.TextPrimary })
            Tween(TBar,  { BackgroundTransparency = 0 })
            self._activeTab = Tab
        end

        -- Store the indicator bar with a unique name so we can find it
        TBar.Name = "ActiveBar"

        TBtn.MouseButton1Click:Connect(Activate)
        TBtn.MouseEnter:Connect(function()
            if self._activeTab ~= Tab then
                Tween(TBtn, { BackgroundTransparency = 0.9, TextColor3 = Theme.TextPrimary })
            end
        end)
        TBtn.MouseLeave:Connect(function()
            if self._activeTab ~= Tab then
                Tween(TBtn, { BackgroundTransparency = 1, TextColor3 = Theme.TextSecondary })
            end
        end)

        table.insert(self._tabs, Tab)
        if isFirst then Activate() end

