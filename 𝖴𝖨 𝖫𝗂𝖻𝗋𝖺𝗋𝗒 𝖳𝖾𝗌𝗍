local TOGGLE_ICON = "rbxassetid://82814787677913"
local TOGGLE_SIZE = 30

local function CreateToggleButton(mainGui, mainFrame, originalSize)
	local ToggleGui = New("ScreenGui", {
		Name = "NovaUI_Toggle",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
		DisplayOrder = 1000,
		Parent = GetGuiParent(),
	})

	local Btn = New("ImageButton", {
		Name = "ToggleBtn",
		Size = UDim2.fromOffset(TOGGLE_SIZE, TOGGLE_SIZE),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = T,
		BorderSizePixel = 0,
		Image = TOGGLE_ICON,
		ScaleType = Enum.ScaleType.Fit,
		ImageColor3 = Theme.Accent,
		AutoButtonColor = false,
		Parent = ToggleGui,
	})
	Corner(50, Btn)
	Stroke(Theme.Border, 1, Btn)

	setupButtonAnimations(Btn, Theme.Background, Theme.SurfaceHover, Color3.fromRGB(8, 8, 8))

	local visible = true
	local dragging, moved = false, false
	local dragStart, startPos = nil, nil
	local THRESHOLD = 6

	local function isPointerBegin(inp)
		return inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch
	end
	local function isPointerEnd(inp)
		return inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch
	end
	local function isPointerMove(inp)
		return inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch
	end

	Btn.InputBegan:Connect(function(inp)
		if isPointerBegin(inp) then
			dragging = true
			moved = false
			dragStart = inp.Position
			startPos = Btn.Position
		end
	end)

	UserInputService.InputEnded:Connect(function(inp)
		if not dragging then return end
		if isPointerEnd(inp) then
			dragging = false
			if not moved then
				visible = not visible

				if visible then
					-- Restore with expand animation
					mainFrame.Visible = true
					mainFrame.Size = UDim2.new(0, originalSize.X.Offset * 0.85, 0, originalSize.Y.Offset * 0.85)
					mainFrame.BackgroundTransparency = T + 0.15

					Tween(mainFrame, {
						Size = originalSize,
						BackgroundTransparency = T
					}, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out):Play()
				else
					-- Collapse animation then fully hide
					local collapse = Tween(mainFrame, {
						Size = UDim2.new(0, originalSize.X.Offset * 0.75, 0, originalSize.Y.Offset * 0.75),
						BackgroundTransparency = 1
					}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

					collapse:Play()
					collapse.Completed:Connect(function()
						mainFrame.Visible = false
						mainFrame.Size = originalSize
						mainFrame.BackgroundTransparency = T
					end)
				end

				-- Icon pulse
				Tween(Btn, { ImageColor3 = Theme.TextPrimary }, 0.07):Play()
				task.delay(0.15, function()
					Tween(Btn, { ImageColor3 = Theme.Accent }, 0.12):Play()
				end)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(inp)
		if dragging and isPointerMove(inp) then
			local delta = inp.Position - dragStart
			if math.abs(delta.X) > THRESHOLD or math.abs(delta.Y) > THRESHOLD then
				moved = true
			end
			if moved then
				Btn.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end
	end)

	mainGui.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			ToggleGui:Destroy()
		end
	end)

	return ToggleGui, Btn
end

