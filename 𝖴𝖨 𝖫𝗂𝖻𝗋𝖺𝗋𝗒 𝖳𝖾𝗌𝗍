-- ──────────────────────────────────────────────────────────
--  Floating toggle button
--  • Draggable (threshold 6 px) — drag moves it, click toggles
--  • Styled to match NovaUI theme
--  • Destroyed automatically when the main Gui is destroyed
-- ──────────────────────────────────────────────────────────
local TOGGLE_ICON = "rbxassetid://82814787677913"  -- swap as needed
local TOGGLE_SIZE = 30  -- px — compact to match the UI scale

local function CreateToggleButton(mainGui, mainFrame, visible)
    local ToggleGui = New("ScreenGui", {
        Name           = "NovaUI_Toggle",
        ResetOnSpawn   = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder   = 1000,
        Parent         = GetGuiParent(),
    })

    local Btn = New("ImageButton", {
        Name                   = "ToggleBtn",
        Size                   = UDim2.fromOffset(TOGGLE_SIZE, TOGGLE_SIZE),
        Position               = UDim2.fromOffset(10, 10),
        BackgroundColor3       = Theme.Background,
        BackgroundTransparency = T,
        BorderSizePixel        = 0,
        Image                  = TOGGLE_ICON,
        ScaleType              = Enum.ScaleType.Fit,
        ImageColor3            = Theme.Accent,
        AutoButtonColor        = false,
        Parent                 = ToggleGui,
    })
    Corner(8, Btn)
    Stroke(Theme.Border, 1, Btn)

    -- Hover highlight
    Btn.MouseEnter:Connect(function()
        Tween(Btn, { BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = T * 0.7 })
    end)
    Btn.MouseLeave:Connect(function()
        Tween(Btn, { BackgroundColor3 = Theme.Background, BackgroundTransparency = T })
    end)

    -- Drag-vs-click logic
    local dragging   = false
    local moved      = false
    local dragStart  = nil
    local startPos   = nil
    local THRESHOLD  = 6

    Btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            moved     = false
            dragStart = inp.Position
            startPos  = Btn.Position
        end
    end)

    Btn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if not moved then
                -- Toggle visibility with a small scale tween for feedback
                visible = not visible
                if visible then
                    mainFrame.Visible = true
                    Tween(mainFrame, { Size = mainFrame.Size }, 0.18)
                else
                    Tween(mainFrame, { BackgroundTransparency = T + 0.1 }, 0.1)
                    task.delay(0.12, function()
                        mainFrame.Visible = false
                        Tween(mainFrame, { BackgroundTransparency = T })
                    end)
                end
                -- Pulse the button icon on click
                Tween(Btn, { ImageColor3 = Theme.TextPrimary }, 0.07)
                task.delay(0.15, function()
                    Tween(Btn, { ImageColor3 = Theme.Accent })
                end)
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = inp.Position - dragStart
            if math.abs(delta.X) > THRESHOLD or math.abs(delta.Y) > THRESHOLD then
                moved = true
            end
            if moved then
                Btn.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    -- Auto-destroy when the main ScreenGui is removed
    mainGui.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            ToggleGui:Destroy()
        end
    end)

    return ToggleGui
end

