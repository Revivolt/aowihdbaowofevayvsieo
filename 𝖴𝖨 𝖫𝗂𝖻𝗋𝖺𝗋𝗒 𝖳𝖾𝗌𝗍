                    BackgroundTransparency = 1,
                    AutoButtonColor  = false,
                    Size             = UDim2.new(1, 0, 0, 28),
                    LayoutOrder      = i,
                    ZIndex           = 11,
                    Parent           = Panel,
                })
                Corner(5, OBtn)
                Pad(0, 0, 0, 8, OBtn)

                OBtn.MouseEnter:Connect(function() Tween(OBtn, { BackgroundTransparency = 0.72 }) end)
                OBtn.MouseLeave:Connect(function() Tween(OBtn, { BackgroundTransparency = 1 }) end)
                OBtn.MouseButton1Click:Connect(function()
                    selected = opt
                    SelLbl.Text = opt
                    for _, c in ipairs(Panel:GetChildren()) do
                        if c:IsA("TextButton") then Tween(c, { TextColor3 = Theme.TextPrimary }) end
                    end
                    Tween(OBtn, { TextColor3 = Theme.Accent })
                    open = false
                    Tween(Panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.14)
                    Tween(Arrow, { Rotation = 0 })
                    task.spawn(callback, opt)
                end)
            end

            Header.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    Panel.Size = UDim2.new(1, 0, 0, 0)
                    Tween(Panel, { Size = UDim2.new(1, 0, 0, panelH) }, 0.16)
                    Tween(Arrow, { Rotation = 180 })
                else
                    Tween(Panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.14)
                    Tween(Arrow, { Rotation = 0 })
                end
            end)
            Header.MouseEnter:Connect(function() Tween(Header, { BackgroundColor3 = Theme.SurfaceHover }) end)
            Header.MouseLeave:Connect(function() Tween(Header, { BackgroundColor3 = Theme.Elevated }) end)

            local api = {}
            function api:Set(v)
                selected = v; SelLbl.Text = v
                task.spawn(callback, v)
            end
            function api:Get() return selected end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  TEXT INPUT
        -- ────────────────────────────────────────────────────
        function Tab:AddTextInput(cfg)
            cfg = cfg or {}
            local callback = cfg.Callback or function() end

            local row = Row(36)
            RowLabel(cfg.Label or "Input", row)

            local Box = New("TextBox", {
                Text              = cfg.Default     or "",
                PlaceholderText   = cfg.Placeholder or "Type here...",
                Font              = Enum.Font.Gotham,
                TextSize          = 12,
                TextColor3        = Theme.TextPrimary,
                PlaceholderColor3 = Theme.TextDisabled,
                TextXAlignment    = Enum.TextXAlignment.Left,
                BackgroundColor3  = Theme.InputBG,
                BorderSizePixel   = 0,
                ClearTextOnFocus  = cfg.ClearOnFocus ~= false,
                Size              = UDim2.new(0, 140, 0, 24),
                Position          = UDim2.new(1, -8, 0.5, -12),
                AnchorPoint       = Vector2.new(1, 0),
                Parent            = row,
            })
            Corner(5, Box)
            Stroke(Theme.Border, 1, Box)
            Pad(0, 6, 0, 6, Box)

            Box.Focused:Connect(function()
                Tween(Box, { BackgroundColor3 = Theme.Elevated })
            end)
            Box.FocusLost:Connect(function(enter)
                Tween(Box, { BackgroundColor3 = Theme.InputBG })
                if enter then task.spawn(callback, Box.Text) end
            end)
            Box:GetPropertyChangedSignal("Text"):Connect(function()
                task.spawn(callback, Box.Text)
            end)

            local api = {}
            function api:Set(v) Box.Text = v end
            function api:Get() return Box.Text end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  KEYBIND
        -- ────────────────────────────────────────────────────
        function Tab:AddKeybind(cfg)
            cfg = cfg or {}
            local currentKey = cfg.Default or Enum.KeyCode.Unknown
            local callback   = cfg.Callback or function() end
            local listening  = false

            local row = Row(36)
            RowLabel(cfg.Label or "Keybind", row)

            local KBtn = New("TextButton", {
                Text             = "[" .. currentKey.Name .. "]",
                Font             = Enum.Font.GothamBold,
                TextSize         = 12,
                TextColor3       = Theme.Accent,
                BackgroundColor3 = Theme.InputBG,
                AutoButtonColor  = false,
                BorderSizePixel  = 0,
                Size             = UDim2.new(0, 100, 0, 24),
                Position         = UDim2.new(1, -108, 0.5, -12),
                Parent           = row,
            })
            Corner(5, KBtn)
            Stroke(Theme.Border, 1, KBtn)

            local function StopListen()
                listening = false
                KBtn.Text = "[" .. currentKey.Name .. "]"
                Tween(KBtn, { TextColor3 = Theme.Accent, BackgroundColor3 = Theme.InputBG })
            end

            KBtn.MouseButton1Click:Connect(function()
                if listening then StopListen(); return end
                listening = true
                KBtn.Text = "[  ...  ]"
                Tween(KBtn, { TextColor3 = Theme.White, BackgroundColor3 = Theme.AccentDim })
            end)

            UserInputService.InputBegan:Connect(function(inp, gpe)
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = inp.KeyCode
                    StopListen()
                    task.spawn(callback, currentKey)
                end
            end)

            local api = {}
            function api:Set(key) currentKey = key; StopListen() end
            function api:Get() return currentKey end
            return api
        end

        -- ────────────────────────────────────────────────────
        --  LABEL  (section title / description text)
        -- ────────────────────────────────────────────────────
        function Tab:AddLabel(text, style)
            style = style or "section" -- "section" | "info"
            local lbl = New("TextLabel", {
                Text             = text,
                Font             = style == "section" and Enum.Font.GothamBold or Enum.Font.Gotham,
                TextSize         = style == "section" and 11 or 12,
                TextColor3       = style == "section" and Theme.TextDisabled or Theme.TextSecondary,
                TextXAlignment   = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 0, style == "section" and 18 or 28),
                LayoutOrder      = Tab._order,
                Parent           = TContent,
            })
            Tab._order += 1
            Pad(0, 0, 0, 4, lbl)
            return lbl
        end

        -- ────────────────────────────────────────────────────
        --  SEPARATOR
        -- ────────────────────────────────────────────────────
        function Tab:AddSeparator()
            local sep = New("Frame", {
                Size             = UDim2.new(1, -4, 0, 1),
                BackgroundColor3 = Theme.Border,
                BorderSizePixel  = 0,
                LayoutOrder      = Tab._order,
                Parent           = TContent,
            })
            Tab._order += 1
            return sep
        end

        return Tab
    end -- AddTab

    return Window
end -- CreateWindow

-- Expose theme for external customisation
NovaUI.Theme = Theme

return NovaUI
