                BackgroundTransparency = 1,
                Size   = UDim2.new(1, 0, 1, 0),
                Parent = btn,
            })
            AddPadding(inner, 0, 10, 0, 12)

            local lbl = Create("TextLabel", {
                Text             = label,
                TextColor3       = THEME.TextPrimary,
                Font             = Enum.Font.GothamMedium,
                TextSize         = 13,
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, -24, 0, 18),
                Position         = UDim2.new(0, 0, 0, desc ~= "" and 6 or 0),
                TextXAlignment   = Enum.TextXAlignment.Left,
                Parent           = inner,
            })
            if desc ~= "" then
                Create("TextLabel", {
                    Text             = desc,
                    TextColor3       = THEME.TextDim,
                    Font             = Enum.Font.Gotham,
                    TextSize         = 11,
                    BackgroundTransparency = 1,
                    Size             = UDim2.new(1, 0, 0, 14),
                    Position         = UDim2.new(0, 0, 0, 24),
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    Parent           = inner,
                })
            end

            -- Arrow icon
            Create("TextLabel", {
                Text             = "›",
                TextColor3       = THEME.Accent,
                Font             = Enum.Font.GothamBold,
                TextSize         = 18,
                BackgroundTransparency = 1,
                Size             = UDim2.new(0, 18, 1, 0),
                Position         = UDim2.new(1, -18, 0, 0),
                TextXAlignment   = Enum.TextXAlignment.Right,
                Parent           = inner,
            })

            btn.MouseEnter:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.Surface })
            end)
            btn.MouseLeave:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.SurfaceAlt })
            end)
            btn.MouseButton1Click:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.AccentDim })
                task.delay(0.12, function()
                    Tween(row, { BackgroundColor3 = THEME.SurfaceAlt })
                end)
                callback()
            end)

            return { SetLabel = function(_, t) lbl.Text = t end }
        end

        -- ══════════════════════════════════════════════════
        --                     TOGGLE
        -- ══════════════════════════════════════════════════
        function Tab:AddToggle(cfg)
            cfg = cfg or {}
            local label    = cfg.Label    or "Toggle"
            local default  = cfg.Default  ~= nil and cfg.Default or false
            local callback = cfg.Callback or function() end

            local state = default
            local row   = MakeRow(Tab._count)

            local inner = Create("Frame", {
                BackgroundTransparency = 1,
                Size   = UDim2.new(1, 0, 1, 0),
                Parent = row,
            })
            AddPadding(inner, 0, 12, 0, 12)

            MakeLabel(label, 13, THEME.TextPrimary, inner)

            -- Toggle pill
            local pill = Create("Frame", {
                Name             = "Pill",
                AnchorPoint      = Vector2.new(1, 0.5),
                Size             = UDim2.new(0, 40, 0, 22),
                Position         = UDim2.new(1, 0, 0.5, 0),
                BackgroundColor3 = state and THEME.ToggleOn or THEME.ToggleOff,
                Parent           = inner,
            })
            AddCorner(pill, 11)

            local knob = Create("Frame", {
                AnchorPoint      = Vector2.new(0, 0.5),
                Size             = UDim2.new(0, 16, 0, 16),
                Position         = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = THEME.White,
                Parent           = pill,
            })
            AddCorner(knob, 8)

            local toggle_obj = { Value = state }

            local function setToggle(v, silent)
                state = v
                toggle_obj.Value = v
                Tween(pill, { BackgroundColor3 = v and THEME.ToggleOn or THEME.ToggleOff })
                Tween(knob, { Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
                if not silent then callback(v) end
            end

            local btn = Create("TextButton", {
                Text             = "",
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 1, 0),
                Parent           = row,
            })
            btn.MouseButton1Click:Connect(function()
                setToggle(not state)
            end)
            btn.MouseEnter:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.Surface })
            end)
            btn.MouseLeave:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.SurfaceAlt })
            end)

            function toggle_obj:Set(v) setToggle(v, true) end
            function toggle_obj:Get() return state end

            return toggle_obj
        end

        -- ══════════════════════════════════════════════════
        --                     SLIDER
        -- ══════════════════════════════════════════════════
        function Tab:AddSlider(cfg)
            cfg = cfg or {}
            local label    = cfg.Label    or "Slider"
            local min      = cfg.Min      or 0
            local max      = cfg.Max      or 100
            local default  = cfg.Default  ~= nil and cfg.Default or min
            local step     = cfg.Step     or 1
            local suffix   = cfg.Suffix   or ""
            local callback = cfg.Callback or function() end

            local value = math.clamp(default, min, max)
            local row   = MakeRow(Tab._count)
            row.Size    = UDim2.new(1, 0, 0, 52)

            local inner = Create("Frame", {
                BackgroundTransparency = 1,
                Size   = UDim2.new(1, 0, 1, 0),
                Parent = row,
            })
            AddPadding(inner, 8, 12, 8, 12)

            local topRow = Create("Frame", {
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 0, 16),
                Parent           = inner,
            })
            MakeLabel(label, 13, THEME.TextPrimary, topRow)

            local valLabel = Create("TextLabel", {
                Text             = tostring(value) .. suffix,
                TextColor3       = THEME.Accent,
                Font             = Enum.Font.GothamBold,
                TextSize         = 12,
                BackgroundTransparency = 1,
                Size             = UDim2.new(0, 60, 1, 0),
                Position         = UDim2.new(1, -60, 0, 0),
                TextXAlignment   = Enum.TextXAlignment.Right,
                Parent           = topRow,
            })

            -- Track
            local track = Create("Frame", {
                Size             = UDim2.new(1, 0, 0, 6),
                Position         = UDim2.new(0, 0, 1, 2),
                BackgroundColor3 = THEME.Border,
                Parent           = inner,
            })
            AddCorner(track, 3)

            local fill = Create("Frame", {
                Size             = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = THEME.SliderFill,
                Parent           = track,
            })
            AddCorner(fill, 3)

            -- Knob
            local knob = Create("Frame", {
                AnchorPoint      = Vector2.new(0.5, 0.5),
                Size             = UDim2.new(0, 14, 0, 14),
                Position         = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
                BackgroundColor3 = THEME.White,
                ZIndex           = 5,
                Parent           = track,
            })
            AddCorner(knob, 7)
            AddStroke(knob, THEME.Accent, 2)

            local slider_obj = { Value = value }
            local dragging = false

            local function setValue(v, silent)
                v = math.clamp(v, min, max)
                if step and step > 0 then
                    v = math.round((v - min) / step) * step + min
                end
                v = math.clamp(v, min, max)
                value = v
                slider_obj.Value = v
                local pct = (v - min) / (max - min)
                Tween(fill, { Size = UDim2.new(pct, 0, 1, 0) })
                Tween(knob, { Position = UDim2.new(pct, 0, 0.5, 0) })
                valLabel.Text = tostring(v) .. suffix
                if not silent then callback(v) end
            end

            local inputBtn = Create("TextButton", {
                Text             = "",
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 1, 0),
                ZIndex           = 6,
                Parent           = track,
            })
            inputBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            RunService.RenderStepped:Connect(function()
                if dragging then
                    local trackPos = track.AbsolutePosition.X
                    local trackSize = track.AbsoluteSize.X
                    local mouseX   = UserInputService:GetMouseLocation().X
                    local pct      = math.clamp((mouseX - trackPos) / trackSize, 0, 1)
                    setValue(min + pct * (max - min))
                end
            end)

            function slider_obj:Set(v) setValue(v, true) end
            function slider_obj:Get() return value end

            return slider_obj
        end

        -- ══════════════════════════════════════════════════
        --                    DROPDOWN
        -- ══════════════════════════════════════════════════
        function Tab:AddDropdown(cfg)
            cfg = cfg or {}
            local label    = cfg.Label    or "Dropdown"
            local options  = cfg.Options  or {}
            local default  = cfg.Default  or options[1] or ""
            local callback = cfg.Callback or function() end

            local selected = default
            local open     = false

            local wrapper = Create("Frame", {
                Name             = "DropdownWrapper",
                Size             = UDim2.new(1, 0, 0, 36),
                BackgroundTransparency = 1,
                LayoutOrder      = Tab._count,
                ZIndex           = 2,
                Parent           = tabFrame,
            })
            Tab._count += 1

            local row = Create("Frame", {
                Size             = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = THEME.SurfaceAlt,
                ZIndex           = 3,
                Parent           = wrapper,
            })
            AddCorner(row, 7)
            AddStroke(row, THEME.Border)

            local inner = Create("Frame", {
                BackgroundTransparency = 1,
                Size   = UDim2.new(1, 0, 1, 0),
                ZIndex = 4,
                Parent = row,
            })
            AddPadding(inner, 0, 12, 0, 12)

            MakeLabel(label, 13, THEME.TextSecondary, inner)

            local selLabel = Create("TextLabel", {
                Text             = selected,
                TextColor3       = THEME.TextPrimary,
                Font             = Enum.Font.GothamMedium,
                TextSize         = 12,
                BackgroundTransparency = 1,
                Size             = UDim2.new(0.5, 0, 1, 0),
                Position         = UDim2.new(0.5, -20, 0, 0),
                TextXAlignment   = Enum.TextXAlignment.Right,
                ZIndex           = 5,
                Parent           = inner,
            })

            local chevron = Create("TextLabel", {
                Text             = "▾",
                TextColor3       = THEME.Accent,
                Font             = Enum.Font.GothamBold,
                TextSize         = 12,
                BackgroundTransparency = 1,
                Size             = UDim2.new(0, 16, 1, 0),
                Position         = UDim2.new(1, -16, 0, 0),
                TextXAlignment   = Enum.TextXAlignment.Right,
                ZIndex           = 5,
                Parent           = inner,
            })

            -- Dropdown panel
            local panel = Create("Frame", {
                Name             = "Panel",
                Position         = UDim2.new(0, 0, 1, 3),
                Size             = UDim2.new(1, 0, 0, 0),
                BackgroundColor3 = THEME.Surface,
                ClipsDescendants = true,
                ZIndex           = 10,
                Visible          = false,
                Parent           = wrapper,
            })
            AddCorner(panel, 7)
            AddStroke(panel, THEME.Border)

            local panelList = Create("UIListLayout", {
                SortOrder  = Enum.SortOrder.LayoutOrder,
                Parent     = panel,
            })
            AddPadding(panel, 4, 0, 4, 0)

            local dropdown_obj = { Value = selected }

            local function closeDropdown()
                open = false
                chevron.Text = "▾"
                Tween(panel, { Size = UDim2.new(1, 0, 0, 0) }, TWEEN_FAST)
                task.delay(0.15, function()
                    if not open then panel.Visible = false end
                end)
                wrapper.Size = UDim2.new(1, 0, 0, 36)
            end

            local function selectOption(opt)
                selected = opt
                selLabel.Text = opt
                dropdown_obj.Value = opt
                callback(opt)
                closeDropdown()
            end

            -- Populate options
            for i, opt in ipairs(options) do
                local optBtn = Create("TextButton", {
                    Text             = opt,
                    TextColor3       = opt == selected and THEME.Accent or THEME.TextPrimary,
                    Font             = Enum.Font.GothamMedium,
                    TextSize         = 12,
                    BackgroundTransparency = 1,
                    Size             = UDim2.new(1, 0, 0, 28),
                    LayoutOrder      = i,
                    ZIndex           = 11,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    Parent           = panel,
                })
                AddPadding(optBtn, 0, 0, 0, 12)
                optBtn.MouseEnter:Connect(function()
                    Tween(optBtn, { BackgroundTransparency = 0, BackgroundColor3 = THEME.SurfaceAlt })
                end)
                optBtn.MouseLeave:Connect(function()
                    Tween(optBtn, { BackgroundTransparency = 1 })
                end)
                optBtn.MouseButton1Click:Connect(function()
                    for _, c in ipairs(panel:GetChildren()) do
                        if c:IsA("TextButton") then
                            c.TextColor3 = THEME.TextPrimary
                        end
                    end
                    optBtn.TextColor3 = THEME.Accent
                    selectOption(opt)
                end)
            end

            local panelHeight = #options * 28 + 8

            local openBtn = Create("TextButton", {
                Text             = "",
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 0, 36),
                ZIndex           = 6,
                Parent           = wrapper,
            })
            openBtn.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    chevron.Text = "▴"
                    panel.Visible = true
                    panel.Size = UDim2.new(1, 0, 0, 0)
                    Tween(panel, { Size = UDim2.new(1, 0, 0, panelHeight) }, TWEEN_FAST)
                    wrapper.Size = UDim2.new(1, 0, 0, 36 + panelHeight + 5)
                else
                    closeDropdown()
                end
            end)
            openBtn.MouseEnter:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.Surface })
            end)
            openBtn.MouseLeave:Connect(function()
                Tween(row, { BackgroundColor3 = THEME.SurfaceAlt })
            end)

            function dropdown_obj:Set(v)
                selected = v
                selLabel.Text = v
                self.Value = v
            end
            function dropdown_obj:Get() return selected end

            return dropdown_obj
        end

        -- ══════════════════════════════════════════════════
        --                   TEXT INPUT
        -- ══════════════════════════════════════════════════
        function Tab:AddInput(cfg)
            cfg = cfg or {}
            local label       = cfg.Label       or "Input"
            local placeholder = cfg.Placeholder or "Type here..."
            local default     = cfg.Default     or ""
            local callback    = cfg.Callback    or function() end
            local numeric     = cfg.Numeric     or false

            local row = MakeRow(Tab._count)
            row.Size  = UDim2.new(1, 0, 0, 52)

            local inner = Create("Frame", {
                BackgroundTransparency = 1,
                Size   = UDim2.new(1, 0, 1, 0),
                Parent = row,
            })
            AddPadding(inner, 6, 12, 6, 12)

            MakeLabel(label, 11, THEME.TextSecondary, inner)

            local inputBg = Create("Frame", {
                Size             = UDim2.new(1, 0, 0, 22),
                Position         = UDim2.new(0, 0, 1, -22),
                BackgroundColor3 = THEME.InputBg,
                Parent           = inner,
            })
            AddCorner(inputBg, 5)
            AddStroke(inputBg, THEME.Border)

            local textBox = Create("TextBox", {
                Text             = default,
                PlaceholderText  = placeholder,
                PlaceholderColor3 = THEME.TextDim,
                TextColor3       = THEME.TextPrimary,
                Font             = Enum.Font.Gotham,
                TextSize         = 12,
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, -8, 1, 0),
                Position         = UDim2.new(0, 6, 0, 0),
                TextXAlignment   = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Parent           = inputBg,
            })

            textBox.Focused:Connect(function()
                Tween(inputBg, { BackgroundColor3 = THEME.SurfaceAlt })
                AddStroke(inputBg, THEME.Accent)
            end)
            textBox.FocusLost:Connect(function(enterPressed)
                Tween(inputBg, { BackgroundColor3 = THEME.InputBg })
                AddStroke(inputBg, THEME.Border)
                if numeric then
                    local n = tonumber(textBox.Text)
                    textBox.Text = n and tostring(n) or "0"
                end
                callback(textBox.Text, enterPressed)
            end)

            local input_obj = { Value = default }
            function input_obj:Set(v) textBox.Text = v end
            function input_obj:Get() return textBox.Text end

            return input_obj
        end

        -- ══════════════════════════════════════════════════
        --                  KEYBIND INPUT
        -- ══════════════════════════════════════════════════
        function Tab:AddKeybind(cfg)
            cfg = cfg or {}
            local label    = cfg.Label    or "Keybind"
            local default  = cfg.Default  or Enum.KeyCode.E
            local callback = cfg.Callback or function() end

            local bound   = default
            local binding = false
            local row     = MakeRow(Tab._count)

            local inner = Create("Frame", {
                BackgroundTransparency = 1,
                Size   = UDim2.new(1, 0, 1, 0),
                Parent = row,
            })
            AddPadding(inner, 0, 12, 0, 12)

            MakeLabel(label, 13, THEME.TextPrimary, inner)

            local keyBtn = Create("TextButton", {
                Text             = "[" .. bound.Name .. "]",
                TextColor3       = THEME.Accent,
                Font             = Enum.Font.GothamBold,
                TextSize         = 12,
                BackgroundColor3 = THEME.Surface,
                Size             = UDim2.new(0, 90, 0, 22),
                Position         = UDim2.new(1, -90, 0.5, -11),
                AutoButtonColor  = false,
                Parent           = inner,
            })
            AddCorner(keyBtn, 5)
            AddStroke(keyBtn, THEME.Border)

            local function setKey(key, silent)
                bound = key
                keyBtn.Text = "[" .. key.Name .. "]"
                keyBtn.TextColor3 = THEME.Accent
                if not silent then callback(key) end
            end

            keyBtn.MouseButton1Click:Connect(function()
                if binding then return end
                binding = true
                keyBtn.Text = "[ ... ]"
                keyBtn.TextColor3 = THEME.Success
                Tween(keyBtn, { BackgroundColor3 = THEME.AccentDim })
            end)
            keyBtn.MouseEnter:Connect(function()
                Tween(keyBtn, { BackgroundColor3 = THEME.SurfaceAlt })
            end)
            keyBtn.MouseLeave:Connect(function()
                if not binding then
                    Tween(keyBtn, { BackgroundColor3 = THEME.Surface })
                end
            end)

            UserInputService.InputBegan:Connect(function(input, gp)
                if binding and input.UserInputType == Enum.UserInputType.Keyboard then
                    binding = false
                    Tween(keyBtn, { BackgroundColor3 = THEME.Surface })
                    setKey(input.KeyCode)
                end
            end)

            local keybind_obj = { Value = bound }
            function keybind_obj:Set(k) setKey(k, true) end
            function keybind_obj:Get() return bound end

            return keybind_obj
        end

        -- ══════════════════════════════════════════════════
        --                    LABEL
        -- ══════════════════════════════════════════════════
        function Tab:AddLabel(text, color)
            Tab._count += 1
            local lbl = Create("TextLabel", {
                Text             = text,
                TextColor3       = color or THEME.TextSecondary,
                Font             = Enum.Font.Gotham,
                TextSize         = 12,
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 0, 18),
                TextXAlignment   = Enum.TextXAlignment.Left,
                LayoutOrder      = Tab._count,
                Parent           = tabFrame,
            })
            return { SetText = function(_, t) lbl.Text = t end }
        end

        -- ══════════════════════════════════════════════════
        --                  SEPARATOR
        -- ══════════════════════════════════════════════════
        function Tab:AddSeparator()
            Tab._count += 1
            Create("Frame", {
                Size             = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = THEME.Border,
                BorderSizePixel  = 0,
                LayoutOrder      = Tab._count,
                Parent           = tabFrame,
            })
        end

        return Tab
    end

    return Window
end

-- Expose theme for advanced customization
function Nova:SetTheme(overrides)
    for k, v in pairs(overrides) do
        THEME[k] = v
    end
end

return Nova
