local function Tween(obj, props, duration)
	TweenService:Create(obj, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function setupButtonAnimations(button, normalColor, hoverColor, pressColor)
	local originalSize = button.Size

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = normalColor,
			Size = originalSize
		}, 0.12)
	end)

	button.MouseButton1Down:Connect(function()
		Tween(button, {
			BackgroundColor3 = pressColor,
			Size = originalSize - UDim2.new(0, 1, 0, 1)
		}, 0.08)
	end)

	button.MouseButton1Up:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.08)
	end)
end

-- ====================== CORE LOGIC ======================
local function isAnyPlayerOnTeam()
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Team then
			return true
		end
	end
	return false
end

local function getOpponentTeamColor(player)
	if player.Team and LocalPlayer.Team and player.Team ~= LocalPlayer.Team then
		return BrickColor.new(player.Team.TeamColor.Name)
	end
	return BrickColor.new("Really white")
end

local function shouldAffect(player)
	if player.UserId == LocalPlayer.UserId then
		return false
	end

	local teamBased = isAnyPlayerOnTeam()

	if not teamBased then
		return true
	end

	if player.Team and LocalPlayer.Team then
		return player.Team ~= LocalPlayer.Team
	end

	if not player.Team and not LocalPlayer.Team then
		return true
	end

	return false
end

RunService.RenderStepped:Connect(function()
	if not ENABLED then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if shouldAffect(player) then
			pcall(function()
				local character = player.Character
				if not character or character == LocalPlayer.Character then return end

				local part = character:FindFirstChild("HumanoidRootPart")
				if part then
					part.Size = Vector3.new(HEAD_SIZE, HEAD_SIZE, HEAD_SIZE)
					part.Transparency = 0.9
					part.BrickColor = getOpponentTeamColor(player)
					part.Material = Enum.Material.Neon
					part.CanCollide = false
				end
			end)
		end
	end
end)

