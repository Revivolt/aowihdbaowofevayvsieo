-- ══════════════════════════════════════════
-- STATE
-- ══════════════════════════════════════════

local recentSpawns = {}   -- { part, addedAt } ordered newest-first
local predictedSpawn = nil
local targetPlayer = nil
local MAX_TRACKED = 20
local RECENCY_WINDOW = 8  -- seconds: spawns added within this window are "hot"

-- ══════════════════════════════════════════
-- UTILITIES
-- ══════════════════════════════════════════

local function findPlayer(name)
	name = name:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer then
			if p.Name:lower():find(name, 1, true)
				or p.DisplayName:lower():find(name, 1, true) then
				return p
			end
		end
	end
	return nil
end

local function setTeleportReady(spawn)
	if spawn then
		tpButton.BackgroundColor3 = Color3.fromRGB(60, 180, 80)
		tpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		tpButton.Text = "⚡ Teleport to " .. spawn.Name
	else
		tpButton.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
		tpButton.TextColor3 = Color3.fromRGB(140, 140, 160)
		tpButton.Text = "⚡ Teleport to Predicted Spawn"
	end
end

-- ══════════════════════════════════════════
-- SPAWN LIST UI
-- ══════════════════════════════════════════

local function rebuildList()
	for _, c in ipairs(scrollFrame:GetChildren()) do
		if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
	end

	local now = tick()
	for i, data in ipairs(recentSpawns) do
		local age = now - data.addedAt
		local isHot = age <= RECENCY_WINDOW
		local isPredicted = (data.part == predictedSpawn)

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -4, 0, 24)
		row.BackgroundColor3 = isPredicted
			and Color3.fromRGB(70, 55, 10)
			or (isHot and Color3.fromRGB(35, 50, 35) or Color3.fromRGB(28, 28, 42))
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = scrollFrame
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

		local rowLabel = Instance.new("TextLabel")
		rowLabel.Size = UDim2.new(1, -8, 1, 0)
		rowLabel.Position = UDim2.new(0, 6, 0, 0)
		rowLabel.BackgroundTransparency = 1
		rowLabel.TextXAlignment = Enum.TextXAlignment.Left
		rowLabel.Font = Enum.Font.Gotham
		rowLabel.TextSize = 11
		rowLabel.TextColor3 = isPredicted
			and Color3.fromRGB(255, 210, 60)
			or (isHot and Color3.fromRGB(120, 220, 120) or Color3.fromRGB(150, 150, 170))

		local icon = isPredicted and "🎯 " or (isHot and "🟢 " or "⚫ ")
		local ageStr = string.format("%.1fs ago", age)
		rowLabel.Text = icon .. data.part.Name .. "  (" .. ageStr .. ")"
		rowLabel.Parent = row
	end

	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
end

-- ══════════════════════════════════════════
-- PREDICTION — purely recency based
-- ══════════════════════════════════════════

local function runPrediction()
	if #recentSpawns == 0 then
		predLabel.Text = "No spawns detected yet"
		predLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
		predictedSpawn = nil
		setTeleportReady(nil)
		rebuildList()
		return
	end

	-- Pick the most recently added spawn within the recency window
	-- If multiple spawns came in at nearly the same time (<0.3s apart),
	-- treat them as a "batch" and pick the one added last in the batch.
	local now = tick()
	local hotSpawns = {}
	for _, data in ipairs(recentSpawns) do
		if (now - data.addedAt) <= RECENCY_WINDOW then
			table.insert(hotSpawns, data)
		end
	end

	local chosen = nil
	if #hotSpawns > 0 then
		-- Among hot spawns, pick the very newest
		chosen = hotSpawns[1] -- list is newest-first
	else
		-- No hot spawns; fall back to the most recently added overall
		chosen = recentSpawns[1]
	end

	predictedSpawn = chosen.part

	local age = now - chosen.addedAt
	predLabel.Text = "✅  " .. chosen.part.Name
	predLabel.TextColor3 = Color3.fromRGB(255, 210, 70)
	statusLabel.Text = string.format(
		"Status: Predicted '%s'  (added %.1fs ago, %d tracked)",
		chosen.part.Name, age, #recentSpawns
	)
	statusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)

	setTeleportReady(predictedSpawn)
	rebuildList()
end

-- ══════════════════════════════════════════
-- SPAWN WATCHER
-- ══════════════════════════════════════════

local function onSpawnAdded(obj)
	if obj.Name ~= "Spawn" or not obj:IsA("BasePart") then return end

	local data = { part = obj, addedAt = tick() }
	table.insert(recentSpawns, 1, data) -- newest first

	-- Cap list size
	if #recentSpawns > MAX_TRACKED then
		table.remove(recentSpawns, #recentSpawns)
	end

	statusLabel.Text = "🔴 New Spawn added! Running prediction..."
	statusLabel.TextColor3 = Color3.fromRGB(255, 120, 80)

	runPrediction()

	-- Remove from tracking when it leaves the game
	obj.AncestryChanged:Connect(function()
		if not obj:IsDescendantOf(game) then
			for i, d in ipairs(recentSpawns) do
				if d.part == obj then
					table.remove(recentSpawns, i)
					break
				end
			end
			if predictedSpawn == obj then
				predictedSpawn = nil
				predLabel.Text = "Predicted spawn was removed"
				predLabel.TextColor3 = Color3.fromRGB(220, 100, 80)
				setTeleportReady(nil)
			end
			rebuildList()
		end
	end)
end

workspace.DescendantAdded:Connect(onSpawnAdded)

-- Pick up any Spawn parts already present
for _, obj in ipairs(workspace:GetDescendants()) do
	if obj.Name == "Spawn" and obj:IsA("BasePart") then
		local data = { part = obj, addedAt = tick() }
		table.insert(recentSpawns, data)
	end
end
if #recentSpawns > 0 then
	statusLabel.Text = "Status: Found " .. #recentSpawns .. " existing spawn(s)"
	runPrediction()
end

