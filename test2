local function loadOutfits()
    statusLabel.Text = "Fetching outfits..."
    task.spawn(function()
        allOutfits = fetchOutfits()
        populateRows(allOutfits)
        if #allOutfits > 0 then
            statusLabel.Text = string.format("%d outfit(s) loaded", #allOutfits)
        end
    end)
end

