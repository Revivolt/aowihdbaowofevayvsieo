-- FPS Booster by Fox
-- Paste into your executor and run as a LocalScript

local Config = {
    DisableShadows      = true,
    DisableLightingFX   = true,
    DisableAtmosphere   = true,
    DisableParticles    = true,
    FlattenTextures     = true,
    DisableTerrain      = true,
    LowQualityGraphics  = true,
    FPSCap              = false, -- set to a number like 60 to cap, or false to skip
}

local Lighting    = game:GetService("Lighting")
local RunService  = game:GetService("RunService")
local Players     = game:GetService("Players")
local Workspace   = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

-- ──────────────────────────────────────────
-- 1. GRAPHICS QUALITY
-- ──────────────────────────────────────────
if Config.LowQualityGraphics then
    settings().Rendering.QualityLevel          = Enum.QualityLevel.Level01
    settings().Rendering.MeshPartDetailLevel   = Enum.MeshPartDetailLevel.Disabled
    settings().Rendering.EagerBulkExecution    = false
    settings().Rendering.EnableFRM             = false
end

-- ──────────────────────────────────────────
-- 2. SHADOWS
-- ──────────────────────────────────────────
if Config.DisableShadows then
    Lighting.GlobalShadows = false
    Lighting.Technology    = Enum.Technology.Compatibility

    -- Kill CastShadow on every existing part
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CastShadow = false
        end
    end

    -- Handle future parts
    Workspace.DescendantAdded:Connect(function(v)
        if v:IsA("BasePart") then
            v.CastShadow = false
        end
    end)
end

-- ──────────────────────────────────────────
-- 3. LIGHTING POST-FX
-- ──────────────────────────────────────────
if Config.DisableLightingFX then
    local killClasses = {
        "BloomEffect", "BlurEffect", "SunRaysEffect",
        "DepthOfFieldEffect", "ColorCorrectionEffect"
    }
    for _, child in ipairs(Lighting:GetChildren()) do
        for _, cls in ipairs(killClasses) do
            if child:IsA(cls) then
                child.Enabled = false
            end
        end
    end
    -- Catch any added mid-session
    Lighting.ChildAdded:Connect(function(child)
        for _, cls in ipairs(killClasses) do
            if child:IsA(cls) then
                child.Enabled = false
            end
        end
    end)
end

-- ──────────────────────────────────────────
-- 4. ATMOSPHERE
-- ──────────────────────────────────────────
if Config.DisableAtmosphere then
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo then atmo:Destroy() end
    Lighting.FogEnd   = 100000
    Lighting.FogStart = 99999
end

-- ──────────────────────────────────────────
-- 5. PARTICLES
-- ──────────────────────────────────────────
if Config.DisableParticles then
    local particleClasses = {
        "ParticleEmitter", "Smoke", "Fire", "Sparkles"
    }

    local function killParticle(v)
        for _, cls in ipairs(particleClasses) do
            if v:IsA(cls) then
                if v:IsA("ParticleEmitter") then
                    v.Enabled = false
                    v.Rate    = 0
                else
                    v.Enabled = false
                end
            end
        end
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        killParticle(v)
    end

    Workspace.DescendantAdded:Connect(killParticle)
end

-- ──────────────────────────────────────────
-- 6. TEXTURES / MATERIALS
-- ──────────────────────────────────────────
if Config.FlattenTextures then
    local localChar = localPlayer.Character or localPlayer.CharacterAdded:Wait()

    local function isPlayerDescendant(obj)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and obj:IsDescendantOf(plr.Character) then
                return true
            end
        end
        return false
    end

    local function flattenPart(v)
        if isPlayerDescendant(v) then return end
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            -- Remove SurfaceAppearance for big texture savings
            local sa = v:FindFirstChildOfClass("SurfaceAppearance")
            if sa then sa:Destroy() end
        elseif v:IsA("Texture") or v:IsA("Decal") then
            v.Transparency = 1
        elseif v:IsA("SpecialMesh") then
            v.TextureId = ""
        elseif v:IsA("Model") then
            v.LevelOfDetail = Enum.ModelLevelOfDetail.Disabled
        end
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        flattenPart(v)
    end

    Workspace.DescendantAdded:Connect(flattenPart)
end

-- ──────────────────────────────────────────
-- 7. TERRAIN
-- ──────────────────────────────────────────
if Config.DisableTerrain then
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize       = 0
        terrain.WaterWaveSpeed      = 0
        terrain.WaterReflectance    = 0
        terrain.WaterTransparency   = 1
        terrain.Decoration          = false
    end
end

-- ──────────────────────────────────────────
-- 8. OPTIONAL FPS CAP
-- ──────────────────────────────────────────
if Config.FPSCap and type(Config.FPSCap) == "number" then
    local cap = Config.FPSCap
    RunService.RenderStepped:Connect(function()
        local frameTime = 1 / cap
        local start = tick()
        while tick() - start < frameTime do end
    end)
end

print("[FPS Booster] Done. Enjoy your frames, bitch.")
