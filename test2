-- ─── Utility Functions ────────────────────────────────────────────────────────

-- Calculate total mass of a character model
local function getCharacterWeight(character)
	if not character then return 0 end
	local totalMass = 0
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			totalMass = totalMass + part:GetMass()
		end
	end
	return totalMass
end

-- Format mass number nicely
local function formatWeight(mass)
	return string.format("%.2f kg", mass)
end

-- ─── Row Creation ─────────────────────────────────────────────────────────────

local function createPlayerRow(player)
	local isLocal = (player == LocalPlayer)

	local row = Instance.new("Frame")
	row.Name = player.Name
	row.Size = UDim2.new(1, -6, 0, 46)
	row.BackgroundColor3 = isLocal
		and Color3.fromRGB(30, 80, 140)
		or Color3.fromRGB(22, 22, 35)
	row.BackgroundTransparency = isLocal and 0.1 or 0.2
	row.BorderSizePixel = 0
	row.Parent = scrollFrame

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 7)
	rowCorner.Parent = row

	if isLocal then
		local rowStroke = Instance.new("UIStroke")
		rowStroke.Color = Color3.fromRGB(80, 180, 255)
		rowStroke.Thickness = 1
		rowStroke.Transparency = 0.3
		rowStroke.Parent = row
	end

	-- Avatar thumbnail
	local avatar = Instance.new("ImageLabel")
	avatar.Size = UDim2.new(0, 34, 0, 34)
	avatar.Position = UDim2.new(0, 6, 0.5, -17)
	avatar.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
	avatar.BorderSizePixel = 0
	avatar.Image = Players:GetUserThumbnailAsync(
		player.UserId,
		Enum.ThumbnailType.HeadShot,
		Enum.ThumbnailSize.Size48x48
	)
	avatar.Parent = row

	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(0.5, 0)
	avatarCorner.Parent = avatar

	-- Player name
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, -100, 0, 18)
	nameLabel.Position = UDim2.new(0, 48, 0, 6)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = isLocal and ("★ " .. player.Name) or player.Name
	nameLabel.TextColor3 = isLocal
		and Color3.fromRGB(120, 200, 255)
		or Color3.fromRGB(220, 220, 230)
	nameLabel.TextSize = 12
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = row

	-- Weight label
	local weightLabel = Instance.new("TextLabel")
	weightLabel.Name = "WeightLabel"
	weightLabel.Size = UDim2.new(1, -48, 0, 16)
	weightLabel.Position = UDim2.new(0, 48, 0, 24)
	weightLabel.BackgroundTransparency = 1
	weightLabel.Text = "Loading..."
	weightLabel.TextColor3 = Color3.fromRGB(160, 210, 160)
	weightLabel.TextSize = 11
	weightLabel.Font = Enum.Font.Gotham
	weightLabel.TextXAlignment = Enum.TextXAlignment.Left
	weightLabel.Parent = row

	return row
end

-- ─── Update Logic ─────────────────────────────────────────────────────────────

local rows = {}

local function updateWeights()
	for _, player in ipairs(Players:GetPlayers()) do
		local row = scrollFrame:FindFirstChild(player.Name)
		if row then
			local weightLabel = row:FindFirstChild("WeightLabel")
			if weightLabel then
				local char = player.Character
				if char then
					local mass = getCharacterWeight(char)
					weightLabel.Text = "Weight: " .. formatWeight(mass)
					weightLabel.TextColor3 = player == LocalPlayer
						and Color3.fromRGB(100, 230, 180)
						or Color3.fromRGB(160, 210, 160)
				else
					weightLabel.Text = "No character"
					weightLabel.TextColor3 = Color3.fromRGB(160, 100, 100)
				end
			end
		end
	end
end

local function addPlayer(player)
	if scrollFrame:FindFirstChild(player.Name) then return end
	local row = createPlayerRow(player)
	rows[player] = row

	-- Handle character loading
	local function onCharAdded(char)
		task.wait(1) -- Wait for character parts to load
		updateWeights()
	end
	player.CharacterAdded:Connect(onCharAdded)
end

local function removePlayer(player)
	local row = scrollFrame:FindFirstChild(player.Name)
	if row then
		row:Destroy()
	end
	rows[player] = nil
end

-- ─── Initialise ───────────────────────────────────────────────────────────────

-- Add all current players
for _, player in ipairs(Players:GetPlayers()) do
	addPlayer(player)
end

-- Listen for players joining/leaving
Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)

-- Update weights every 0.5 seconds
RunService.Heartbeat:Connect(function()
	updateWeights()
end)
