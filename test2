-- PCEmulatorInput.lua
-- LocalScript: Place inside StarterPlayerScripts
-- Purpose: Replaces mobile UI with full PC keyboard/mouse support on emulators.
-- Compatible with Roblox emulators that lack native K/M input.

local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local RunService        = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local StarterGui        = game:GetService("StarterGui")
local TweenService      = game:GetService("TweenService")

local LocalPlayer  = Players.LocalPlayer
local PlayerGui    = LocalPlayer:WaitForChild("PlayerGui")
local Camera       = workspace.CurrentCamera
local Character    = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid     = Character:WaitForChild("Humanoid")

-- ─────────────────────────────────────────────
-- 1.  REMOVE MOBILE CONTROLS
-- ─────────────────────────────────────────────
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)   -- hide all default UI
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, true) -- keep health bar

-- Kill the default TouchGui (joystick + jump button)
local function removeMobileGui()
    local tg = PlayerGui:FindFirstChild("TouchGui")
    if tg then tg:Destroy() end
end
removeMobileGui()
PlayerGui.ChildAdded:Connect(function(child)
    if child.Name == "TouchGui" then
        child:Destroy()
    end
end)

-- ─────────────────────────────────────────────
-- 2.  MOVEMENT STATE
-- ─────────────────────────────────────────────
local moveKeys = {
    W = Vector3.new( 0, 0,-1),
    A = Vector3.new(-1, 0, 0),
    S = Vector3.new( 0, 0, 1),
    D = Vector3.new( 1, 0, 0),
}
local keyDown = {}
local isSprinting = false
local isJumping   = false

-- ─────────────────────────────────────────────
-- 3.  MOUSE LOOK (camera)
-- ─────────────────────────────────────────────
local mouseSensitivity = 0.3   -- degrees per pixel
local cameraPitch = 0
local cameraYaw   = 0
local PITCH_LIMIT = 80

-- Lock mouse to centre
UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
UserInputService.MouseIconEnabled = false

RunService.RenderStepped:Connect(function()
    -- Camera follow
    local delta = UserInputService:GetMouseDelta()
    cameraYaw   = cameraYaw   - delta.X * mouseSensitivity
    cameraPitch = math.clamp(cameraPitch - delta.Y * mouseSensitivity, -PITCH_LIMIT, PITCH_LIMIT)

    local yawCF   = CFrame.Angles(0, math.rad(cameraYaw), 0)
    local pitchCF = CFrame.Angles(math.rad(cameraPitch), 0, 0)
    local rootCF  = HumanoidRootPart.CFrame

    Camera.CFrame = (rootCF * CFrame.new(0, 1.5, 0)) * yawCF * pitchCF * CFrame.new(0, 0, -0.5)
    Camera.CameraType = Enum.CameraType.Scriptable

    -- Movement
    local moveDir = Vector3.new(0, 0, 0)
    for key, dir in pairs(moveKeys) do
        if keyDown[key] then
            moveDir = moveDir + dir
        end
    end
    if moveDir.Magnitude > 0 then
        moveDir = moveDir.Unit
        local worldDir = yawCF * moveDir
        Humanoid:Move(worldDir, false)
        -- Face movement direction
        HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position,
            HumanoidRootPart.Position + Vector3.new(worldDir.X, 0, worldDir.Z))
    else
        Humanoid:Move(Vector3.new(0, 0, 0), false)
    end

    -- Sprint
    Humanoid.WalkSpeed = isSprinting and 22 or 16
end)

-- ─────────────────────────────────────────────
-- 4.  KEYBOARD INPUT
-- ─────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local kc = input.KeyCode
    if kc == Enum.KeyCode.W then keyDown["W"] = true
    elseif kc == Enum.KeyCode.A then keyDown["A"] = true
    elseif kc == Enum.KeyCode.S then keyDown["S"] = true
    elseif kc == Enum.KeyCode.D then keyDown["D"] = true
    elseif kc == Enum.KeyCode.Space then
        Humanoid.Jump = true
        isJumping = true
    elseif kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.RightShift then
        isSprinting = true
    elseif kc == Enum.KeyCode.LeftControl then
        -- Crouch / walk slow
        Humanoid.WalkSpeed = 8
    elseif kc == Enum.KeyCode.Escape then
        -- Release mouse lock
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    local kc = input.KeyCode
    if kc == Enum.KeyCode.W then keyDown["W"] = false
    elseif kc == Enum.KeyCode.A then keyDown["A"] = false
    elseif kc == Enum.KeyCode.S then keyDown["S"] = false
    elseif kc == Enum.KeyCode.D then keyDown["D"] = false
    elseif kc == Enum.KeyCode.Space then isJumping = false
    elseif kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.RightShift then
        isSprinting = false
    elseif kc == Enum.KeyCode.LeftControl then
        Humanoid.WalkSpeed = 16
    end
end)

-- Re-lock mouse on click after Escape
UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       and UserInputService.MouseBehavior == Enum.MouseBehavior.Default then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled = false
    end
end)

-- ─────────────────────────────────────────────
-- 5.  HUD OVERLAY  (keyboard + mouse visualiser)
-- ─────────────────────────────────────────────
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name        = "PCEmulatorHUD"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent      = PlayerGui

-- Colours
local C_BG     = Color3.fromRGB( 15,  15,  20)
local C_KEY    = Color3.fromRGB( 35,  38,  50)
local C_ACTIVE = Color3.fromRGB( 90, 160, 255)
local C_TEXT   = Color3.fromRGB(200, 210, 230)
local C_BORDER = Color3.fromRGB( 55,  65,  90)

-- Helper: make one key button
local function makeKey(parent, text, size, pos)
    local f = Instance.new("Frame")
    f.Size            = UDim2.new(0, size.X, 0, size.Y)
    f.Position        = UDim2.new(0, pos.X,  0, pos.Y)
    f.BackgroundColor3 = C_KEY
    f.BackgroundTransparency = 0.25
    f.BorderSizePixel = 0
    f.Parent          = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = f

    local stroke = Instance.new("UIStroke")
    stroke.Color     = C_BORDER
    stroke.Thickness = 1
    stroke.Transparency = 0.4
    stroke.Parent    = f

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.Text     = text
    lbl.TextColor3 = C_TEXT
    lbl.Font     = Enum.Font.GothamBold
    lbl.TextScaled = true
    lbl.Parent   = f

    return f
end

-- ── Keyboard panel ──────────────────────────
local KBD_W, KBD_H = 220, 90
local kbdFrame = Instance.new("Frame")
kbdFrame.Name  = "KeyboardDisplay"
kbdFrame.Size  = UDim2.new(0, KBD_W, 0, KBD_H)
kbdFrame.Position = UDim2.new(0, 16, 1, -KBD_H - 16)  -- bottom-left
kbdFrame.BackgroundColor3 = C_BG
kbdFrame.BackgroundTransparency = 0.35
kbdFrame.BorderSizePixel = 0
kbdFrame.Parent = ScreenGui

local kbdCorner = Instance.new("UICorner")
kbdCorner.CornerRadius = UDim.new(0, 8)
kbdCorner.Parent = kbdFrame

local kbdStroke = Instance.new("UIStroke")
kbdStroke.Color = C_BORDER
kbdStroke.Thickness = 1
kbdStroke.Parent = kbdFrame

-- Key layout  {label, size{x,y}, pos{x,y}}  (relative to kbdFrame, 4px padding)
local KS = 28   -- key size
local KG = 4    -- gap
local keyDefs = {
    -- Row 0: WASD + extras
    {l="W",    sx=KS,   sy=KS,   px=KS+KG+4,      py=4},
    {l="A",    sx=KS,   sy=KS,   px=4,             py=KS+KG+4},
    {l="S",    sx=KS,   sy=KS,   px=KS+KG+4,       py=KS+KG+4},
    {l="D",    sx=KS,   sy=KS,   px=(KS+KG)*2+4,   py=KS+KG+4},
    {l="SPC",  sx=KS*3+KG*2, sy=KS, px=4,          py=(KS+KG)*2+4},
    {l="SFT",  sx=KS+8, sy=KS,   px=(KS+KG)*3+KG+4, py=KS+KG+4},
    {l="CTL",  sx=KS+8, sy=KS,   px=(KS+KG)*3+KG+4, py=(KS+KG)*2+4},
}

-- Map label → Frame for highlight
local keyFrameMap = {}

for _, kd in ipairs(keyDefs) do
    local f = makeKey(kbdFrame, kd.l, Vector2.new(kd.sx, kd.sy), Vector2.new(kd.px, kd.py))
    keyFrameMap[kd.l] = f
end

-- Map KeyCode → label
local kcToLabel = {
    [Enum.KeyCode.W]            = "W",
    [Enum.KeyCode.A]            = "A",
    [Enum.KeyCode.S]            = "S",
    [Enum.KeyCode.D]            = "D",
    [Enum.KeyCode.Space]        = "SPC",
    [Enum.KeyCode.LeftShift]    = "SFT",
    [Enum.KeyCode.RightShift]   = "SFT",
    [Enum.KeyCode.LeftControl]  = "CTL",
    [Enum.KeyCode.RightControl] = "CTL",
}

local function setKeyHighlight(label, active)
    local f = keyFrameMap[label]
    if not f then return end
    TweenService:Create(f, TweenInfo.new(0.07), {
        BackgroundColor3 = active and C_ACTIVE or C_KEY,
        BackgroundTransparency = active and 0.0 or 0.25,
    }):Play()
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local lbl = kcToLabel[input.KeyCode]
    if lbl then setKeyHighlight(lbl, true) end
end)
UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    local lbl = kcToLabel[input.KeyCode]
    if lbl then setKeyHighlight(lbl, false) end
end)

