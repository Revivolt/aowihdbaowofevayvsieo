--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G

--// State
local enabled = false

--// Reset Function (no longer replaces the Humanoid)
local function testfunc()
    if not player.Character or not player.Character.Parent then return end
    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- Safely restart the Animate script without touching the Humanoid
    local animate = character:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
        task.wait(0.1)
        animate.Disabled = false
    end

    -- Re-point the camera (safe, non-destructive)
    workspace.CurrentCamera.CameraSubject = humanoid
end

--// Character handler
local function onCharacterAdded()
    task.wait(0.5)
    if enabled then
        pcall(testfunc)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)

--// Toggle input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        if enabled then
            pcall(testfunc)
        end
    end
end)
