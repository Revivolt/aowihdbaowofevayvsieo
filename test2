-- BodyScaleClient (improved)
-- LocalScript → StarterPlayerScripts
-- Client-only scale mutation via network ownership of own character.
-- test

local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")

local player = Players.LocalPlayer

--------------------------------------------------------------------------------
-- Constants
--------------------------------------------------------------------------------

local PANEL_W      = 280
local ROW_H        = 50
local HEADER_H     = 40
local PADDING      = 10
local TWEEN_INFO   = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Accent gradient stops (HSV-based blue → violet feel)
local COLOR_BG         = Color3.fromRGB(12, 13, 20)
local COLOR_HEADER     = Color3.fromRGB(20, 21, 34)
local COLOR_TRACK      = Color3.fromRGB(35, 37, 58)
local COLOR_FILL       = Color3.fromRGB(88, 166, 255)
local COLOR_THUMB      = Color3.fromRGB(230, 238, 255)
local COLOR_THUMB_HOT  = Color3.fromRGB(255, 255, 255)
local COLOR_LABEL      = Color3.fromRGB(140, 148, 190)
local COLOR_VALUE      = Color3.fromRGB(88, 166, 255)
local COLOR_TITLE      = Color3.fromRGB(210, 220, 255)
local COLOR_SHADOW     = Color3.fromRGB(0, 0, 0)

--------------------------------------------------------------------------------
-- Scale definitions
-- All six standard Roblox Humanoid NumberValue scale children.
--------------------------------------------------------------------------------

local SCALES = {
    { name = "BodyTypeScale",   label = "Body Type",   min = 0.00, max = 1.00, default = 0.30 },
    { name = "HeadScale",       label = "Head",        min = 0.95, max = 1.00, default = 1.00 },
    { name = "BodyHeightScale", label = "Height",      min = 0.90, max = 1.05, default = 1.00 },
    { name = "BodyWidthScale",  label = "Width",       min = 0.70, max = 1.00, default = 1.00 },
    { name = "BodyDepthScale",  label = "Depth",       min = 0.70, max = 1.00, default = 1.00 },
    { name = "ProportionScale", label = "Proportion",  min = 0.00, max = 1.00, default = 0.00 },
}

local currentValues = {}
for _, s in ipairs(SCALES) do
    currentValues[s.name] = s.default
end

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function invLerp(a, b, v)
    return math.clamp((v - a) / (b - a), 0, 1)
end

local function round3(n)
    return math.floor(n * 1000 + 0.5) / 1000
end

-- Retrieve the Humanoid scale NumberValue safely.
local function getScaleNV(scaleName)
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    return hum:FindFirstChild(scaleName)
end

-- Write one scale value to the character (clamp enforced).
local function writeScale(scaleDef, value)
    local nv = getScaleNV(scaleDef.name)
    if nv then
        nv.Value = math.clamp(value, scaleDef.min, scaleDef.max)
    end
end

-- Apply all current values (called on spawn / respawn).
local function applyAllScales()
    for _, s in ipairs(SCALES) do
        writeScale(s, currentValues[s.name])
    end
end

--------------------------------------------------------------------------------
-- UI helpers
--------------------------------------------------------------------------------

local function makeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
    return c
end

local function makeStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color        = color
    s.Thickness    = thickness
    s.Transparency = transparency or 0
    s.Parent       = parent
    return s
end

