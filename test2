-- ─── HTTP ABSTRACTION ────────────────────────────────────────────────────────
local function httpGet(url)
    local res
    if syn and syn.request then
        res = syn.request({ Url = url, Method = "GET" })
    elseif http and http.request then
        res = http.request({ Url = url, Method = "GET" })
    elseif request then
        res = request({ Url = url, Method = "GET" })
    elseif http_request then
        res = http_request({ Url = url, Method = "GET" })
    else
        error("[AvatarSwapper] No HTTP function found.")
    end
    return res.Body
end

-- ─── FETCH OUTFIT LIST ───────────────────────────────────────────────────────
local function fetchOutfits()
    local url = string.format(
        "https://avatar.roblox.com/v1/users/%d/outfits?page=1&itemsPerPage=50&isEditable=true",
        userId
    )
    local ok, body = pcall(httpGet, url)
    if not ok then warn("[AvatarSwapper] HTTP error:", body) return {} end
    local decoded = HttpService:JSONDecode(body)
    local list = {}
    if decoded and decoded.data then
        for _, entry in ipairs(decoded.data) do
            table.insert(list, { id = entry.id, name = entry.name })
        end
    end
    return list
end

-- ─── FETCH OUTFIT ASSET IDs ──────────────────────────────────────────────────
-- Returns a HumanoidDescription AND a flat list of assetIds for manual insertion.
local function fetchOutfitDetails(outfitId)
    -- 1. HumanoidDescription (used for body colours, scales, body part IDs)
    local ok1, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
    end)

    -- 2. Raw asset list from avatar API (accessories, clothing, etc.)
    local url = string.format(
        "https://avatar.roblox.com/v1/outfits/%d/details",
        outfitId
    )
    local ok2, body = pcall(httpGet, url)
    local assetIds = {}
    if ok2 then
        local decoded = pcall(function() return HttpService:JSONDecode(body) end) and HttpService:JSONDecode(body)
        if decoded and decoded.assets then
            for _, asset in ipairs(decoded.assets) do
                table.insert(assetIds, asset.id)
            end
        end
    end

    return (ok1 and desc or nil), assetIds
end

-- ─── LAYER 2: MANUAL ACCESSORY SWAP ─────────────────────────────────────────
-- Removes existing accessories, inserts new ones from asset IDs directly.
local function manualAccessorySwap(char, desc, assetIds)
    -- Apply colours and scales from description (these rarely get blocked)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and desc then
        -- Body colours are safe to set directly
        local bc = char:FindFirstChildOfClass("BodyColors")
        if bc then
            bc.HeadColor3   = desc.HeadColor
            bc.TorsoColor3  = desc.TorsoColor
            bc.LeftArmColor3  = desc.LeftArmColor
            bc.RightArmColor3 = desc.RightArmColor
            bc.LeftLegColor3  = desc.LeftLegColor
            bc.RightLegColor3 = desc.RightLegColor
        end
    end

    -- Remove existing accessories
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Shirt")
        or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        end
    end

    -- Insert each asset by ID
    for _, assetId in ipairs(assetIds) do
        local ok, model = pcall(function()
            return InsertService:LoadAsset(assetId)
        end)
        if ok and model then
            for _, child in ipairs(model:GetChildren()) do
                if child:IsA("Accessory") or child:IsA("Shirt")
                or child:IsA("Pants") or child:IsA("ShirtGraphic") then
                    child.Parent = char
                end
            end
            model:Destroy()
        end
    end
end

-- ─── APPLY OUTFIT (3-layer fallback) ─────────────────────────────────────────
local function applyOutfit(outfitId, statusCb)
    statusCb("Fetching outfit data...")

    local desc, assetIds = fetchOutfitDetails(outfitId)

    -- Refresh character reference
    character = lp.Character or lp.CharacterAdded:Wait()
    humanoid  = character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        statusCb("ERR: No Humanoid found")
        return
    end

    -- ── Layer 1: Standard ApplyDescriptionAsync ───────────────────────────
    if desc then
        statusCb("Trying ApplyDescriptionAsync...")
        local ok, err = pcall(function()
            humanoid:ApplyDescriptionAsync(desc)
        end)
        if ok then
            statusCb("Done! (Layer 1)")
            return
        end
        warn("[AvatarSwapper] Layer 1 blocked:", err)
    end

    -- ── Layer 2: Manual asset insertion ──────────────────────────────────
    statusCb("Trying manual asset swap (Layer 2)...")
    if #assetIds > 0 then
        local ok2, err2 = pcall(manualAccessorySwap, character, desc, assetIds)
        if ok2 then
            statusCb("Done! (Layer 2)")
            return
        end
        warn("[AvatarSwapper] Layer 2 failed:", err2)
    else
        warn("[AvatarSwapper] No asset IDs fetched, skipping Layer 2")
    end

    -- ── Layer 3: Force character reload with appearance ───────────────────
    -- This respawns the character; the server re-applies the saved avatar.
    -- Only works if the game allows LoadCharacter.
    statusCb("Trying character reload (Layer 3)...")
    local ok3, err3 = pcall(function()
        lp:LoadCharacter()
    end)
    if ok3 then
        statusCb("Done! (Layer 3 — respawned)")
    else
        warn("[AvatarSwapper] Layer 3 blocked:", err3)
        statusCb("All layers blocked by this game.")
    end
end

