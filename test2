-- Buttons manually anchored from the right edge of the title bar
-- Layout (right → left): [✕ Close] 6px [Clear] 6px [Copy] gap
-- Each button: 46px wide, 20px tall, vertically centred in 32px bar

local function makeBtn(labelText, bgColor, textColor, xFromRight)
    local btn = Instance.new("TextButton")
    btn.Text             = labelText
    btn.Size             = UDim2.new(0, 46, 0, 20)
    btn.Position         = UDim2.new(1, xFromRight, 0.5, -10)
    btn.BackgroundColor3 = bgColor
    btn.TextColor3       = textColor or Color3.fromRGB(215, 215, 215)
    btn.TextSize         = 10
    btn.Font             = Enum.Font.GothamBold
    btn.BorderSizePixel  = 0
    btn.AutoButtonColor  = false
    btn.Parent           = titleBar

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 3)
    c.Parent = btn

    local savedColor = bgColor
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = savedColor:Lerp(Color3.fromRGB(255, 255, 255), 0.10)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = savedColor
    end)

    return btn
end

-- xFromRight = -(button_width + right_margin) for each slot:
