-- Patch the action buttons to also update the mouse display
-- We do this by wrapping with a RunService check (simple approach)
UserInputService.InputBegan:Connect(function(i,g)
    if g then return end
    if i.UserInputType==Enum.UserInputType.MouseButton1 then hlMD(lmbD,true)
    elseif i.UserInputType==Enum.UserInputType.MouseButton2 then hlMD(rmbD,true) end
end)
UserInputService.InputEnded:Connect(function(i,g)
    if g then return end
    if i.UserInputType==Enum.UserInputType.MouseButton1 then hlMD(lmbD,false)
    elseif i.UserInputType==Enum.UserInputType.MouseButton2 then hlMD(rmbD,false) end
end)
UserInputService.InputChanged:Connect(function(i,g)
    if g then return end
    if i.UserInputType==Enum.UserInputType.MouseWheel then
        TweenService:Create(scrD,TweenInfo.new(0.05),{BackgroundColor3=C_ACTIVE}):Play()
        task.delay(0.2,function()
            TweenService:Create(scrD,TweenInfo.new(0.1),{BackgroundColor3=C_BORDER}):Play()
        end)
    end
end)

