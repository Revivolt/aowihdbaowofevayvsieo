-- ============================================================
--  FPS Booster LocalScript
--  Place inside: StarterPlayerScripts
--  Author: Generated Script
-- ============================================================

local RunService        = game:GetService("RunService")
local Players           = game:GetService("Players")
local Lighting          = game:GetService("Lighting")
local TweenService      = game:GetService("TweenService")
local StarterGui        = game:GetService("StarterGui")

local LocalPlayer       = Players.LocalPlayer
local Camera            = workspace.CurrentCamera

-- ============================================================
--  SETTINGS  (toggle features on/off here)
-- ============================================================
local Settings = {
    -- Rendering
    TargetFPS           = 60,       -- Pass to RenderFidelity hint (informational)
    MaxRenderDistance   = 256,      -- Camera far-plane distance (studs)

    -- Graphics quality
    QualityLevel        = 1,        -- 1–21 Roblox quality levels (1 = lowest)
    DisableShadows      = true,     -- Kill shadow maps
    DisablePostFX        = true,    -- Remove Bloom, Blur, ColorCorrection, SunRays
    SimplifyLighting    = true,     -- Switch to Compatibility lighting technology

    -- Particle / effect culling
    DisableParticles    = false,    -- Disable ALL particle emitters & beams in workspace
    DisableDecals       = false,    -- Hide all decals/textures on parts
    DisableAnimations   = false,    -- Stop non-character animations (WARNING: may break games)

    -- Misc
    HidePlayerNames     = false,    -- Removes overhead name/health bars (reduces UI draw calls)
    GUINotification     = true,     -- Show a small status message on screen
}

-- ============================================================
--  HELPERS
-- ============================================================
local function notify(msg)
    if not Settings.GUINotification then return end
    StarterGui:SetCore("SendNotification", {
        Title   = "FPS Booster",
        Text    = msg,
        Duration = 4,
    })
end

local function safeSet(obj, prop, value)
    local ok, err = pcall(function() obj[prop] = value end)
    if not ok then
        -- Silently skip read-only or protected properties
    end
end

-- ============================================================
--  1. RENDER DISTANCE
-- ============================================================
local function applyRenderDistance()
    Camera.FarPlaneDistance = Settings.MaxRenderDistance
end

-- ============================================================
--  2. GRAPHICS QUALITY
-- ============================================================
local function applyQuality()
    -- UserGameSettings quality level (client-side override)
    local ugs = UserSettings():GetService("UserGameSettings")
    safeSet(ugs, "SavedQualityLevel",
        Enum.SavedQualitySetting.QualityLevel1 -- always force level 1
    )
end

-- ============================================================
--  3. DISABLE SHADOW MAPS
-- ============================================================
local function applyLighting()
    if Settings.DisableShadows then
        safeSet(Lighting, "GlobalShadows", false)
        safeSet(Lighting, "ShadowSoftness", 0)
    end

    if Settings.SimplifyLighting then
        -- "Compatibility" is the cheapest lighting model
        safeSet(Lighting, "EnvironmentDiffuseScale", 0)
        safeSet(Lighting, "EnvironmentSpecularScale", 0)
    end
end

-- ============================================================
--  4. REMOVE POST-PROCESSING EFFECTS
-- ============================================================
local function removePostFX()
    if not Settings.DisablePostFX then return end

    local effectTypes = {
        "BloomEffect", "BlurEffect", "ColorCorrectionEffect",
        "SunRaysEffect", "DepthOfFieldEffect"
    }

    local function strip(parent)
        for _, child in ipairs(parent:GetChildren()) do
            for _, t in ipairs(effectTypes) do
                if child:IsA(t) then
                    child.Enabled = false
                end
            end
        end
    end

    strip(Lighting)
    strip(Camera)

    -- Watch for new effects being added at runtime
    Lighting.ChildAdded:Connect(function(child)
        for _, t in ipairs(effectTypes) do
            if child:IsA(t) then child.Enabled = false end
        end
    end)
end

-- ============================================================
--  5. CULL PARTICLES / BEAMS
-- ============================================================
local function applyParticleCulling()
    if not Settings.DisableParticles then return end

    local particleTypes = { "ParticleEmitter", "Beam", "Trail", "Fire", "Smoke", "Sparkles" }

    local function disableParticlesIn(parent)
        for _, desc in ipairs(parent:GetDescendants()) do
            for _, t in ipairs(particleTypes) do
                if desc:IsA(t) then desc.Enabled = false end
            end
        end
    end

    disableParticlesIn(workspace)

    workspace.DescendantAdded:Connect(function(desc)
        for _, t in ipairs(particleTypes) do
            if desc:IsA(t) then
                task.defer(function() desc.Enabled = false end)
            end
        end
    end)
end

-- ============================================================
--  6. HIDE DECALS
-- ============================================================
local function applyDecalCulling()
    if not Settings.DisableDecals then return end

    local function hideDecals(parent)
        for _, desc in ipairs(parent:GetDescendants()) do
            if desc:IsA("Decal") or desc:IsA("Texture") then
                desc.Transparency = 1
            end
        end
    end

    hideDecals(workspace)
end

-- ============================================================
--  7. ANIMATION CULLING (distant characters)
-- ============================================================
local ANIM_CULL_DISTANCE = 80   -- studs; beyond this animations are paused

local function setupAnimationCulling()
    RunService.Heartbeat:Connect(function()
        local camPos = Camera.CFrame.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - camPos).Magnitude
                        local hum  = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            -- Use WalkSpeed proxy to detect & pause/resume
                            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                                if dist > ANIM_CULL_DISTANCE then
                                    track:AdjustSpeed(0)
                                else
                                    track:AdjustSpeed(1)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- ============================================================
--  8. OVERHEAD GUI CULLING (name tags / health bars)
-- ============================================================
local function applyNameTagCulling()
    if not Settings.HidePlayerNames then return end

    local function hideOverheadGUI(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then hideOverheadGUI(player.Character) end
        player.CharacterAdded:Connect(hideOverheadGUI)
    end

    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(hideOverheadGUI)
    end)
end

-- ============================================================
--  9. REDUCE UNUSED SOUNDS (mute far-away sound sources)
-- ============================================================
local SOUND_CULL_DISTANCE = 120

local function setupSoundCulling()
    RunService.Heartbeat:Connect(function()
        local camPos = Camera.CFrame.Position
        for _, sound in ipairs(workspace:GetDescendants()) do
            if sound:IsA("Sound") and sound.Parent ~= nil then
                local part = sound.Parent
                if part:IsA("BasePart") then
                    local dist = (part.Position - camPos).Magnitude
                    sound.Volume = dist > SOUND_CULL_DISTANCE and 0 or sound.Volume
                end
            end
        end
    end)
end

-- ============================================================
--  10. FPS COUNTER (optional on-screen display)
-- ============================================================
local function createFPSDisplay()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name          = "FPSBoosterHUD"
    screenGui.ResetOnSpawn  = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent        = LocalPlayer.PlayerGui

    local label = Instance.new("TextLabel")
    label.Size              = UDim2.new(0, 100, 0, 26)
    label.Position          = UDim2.new(1, -108, 0, 6)
    label.BackgroundColor3  = Color3.fromRGB(0, 0, 0)
    label.BackgroundTransparency = 0.45
    label.TextColor3        = Color3.fromRGB(0, 255, 120)
    label.Font              = Enum.Font.Code
    label.TextSize          = 14
    label.Text              = "FPS: --"
    label.Parent            = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent       = label

    local frames, elapsed = 0, 0

    RunService.RenderStepped:Connect(function(dt)
        frames  = frames  + 1
        elapsed = elapsed + dt
        if elapsed >= 0.5 then
            local fps = math.round(frames / elapsed)
            label.Text = string.format("FPS: %d", fps)
            -- Color-code the display
            if fps >= 55 then
                label.TextColor3 = Color3.fromRGB(0, 255, 120)
            elseif fps >= 30 then
                label.TextColor3 = Color3.fromRGB(255, 200, 0)
            else
                label.TextColor3 = Color3.fromRGB(255, 60, 60)
            end
            frames, elapsed = 0, 0
        end
    end)
end

-- ============================================================
--  INIT — apply everything
-- ============================================================
local function init()
    applyRenderDistance()
    applyQuality()
    applyLighting()
    removePostFX()
    applyParticleCulling()
    applyDecalCulling()
    setupAnimationCulling()
    applyNameTagCulling()
    -- setupSoundCulling()  -- uncomment if desired (can affect gameplay feel)

    createFPSDisplay()

    -- Re-apply render distance whenever the camera is refreshed
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        Camera = workspace.CurrentCamera
        applyRenderDistance()
    end)

    notify("FPS Booster active! Shadows=" ..
        tostring(not Settings.DisableShadows) ..
        " | PostFX=" .. tostring(not Settings.DisablePostFX))

    print("[FPSBooster] Initialized. Good luck!")
end

-- Wait for character before starting
if LocalPlayer.Character then
    init()
else
    LocalPlayer.CharacterAdded:Wait()
    init()
end
