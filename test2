lmb.BorderSizePixel = 0
lmb.Parent = body
local lmbCorner = Instance.new("UICorner")
lmbCorner.CornerRadius = UDim.new(0, 10)
lmbCorner.Parent = lmb

-- RMB
local rmb = Instance.new("Frame")
rmb.Name = "RMB"
rmb.Size = UDim2.new(0.5, -1, 0, 26)
rmb.Position = UDim2.new(0.5, 1, 0, 0)
rmb.BackgroundTransparency = 1
rmb.BorderSizePixel = 0
rmb.Parent = body
local rmbCorner = Instance.new("UICorner")
rmbCorner.CornerRadius = UDim.new(0, 10)
rmbCorner.Parent = rmb

-- Scroll wheel
local scroll = Instance.new("Frame")
scroll.Name = "SCROLL"
scroll.Size = UDim2.new(0, 6, 0, 14)
scroll.Position = UDim2.new(0.5, -3, 0, 28)
scroll.BackgroundColor3 = C_BORDER
scroll.BorderSizePixel = 0
scroll.Parent = body
local scrollCorner = Instance.new("UICorner")
scrollCorner.CornerRadius = UDim.new(0, 3)
scrollCorner.Parent = scroll

-- Map mouse button → frame
local mousePartMap = {
    [Enum.UserInputType.MouseButton1] = lmb,
    [Enum.UserInputType.MouseButton2] = rmb,
    [Enum.UserInputType.MouseButton3] = scroll,
}

local function setMouseHighlight(part, active)
    TweenService:Create(part, TweenInfo.new(0.07), {
        BackgroundColor3 = active and C_ACTIVE or C_KEY,
        BackgroundTransparency = active and 0.0 or 1,
    }):Play()
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local part = mousePartMap[input.UserInputType]
    if part then setMouseHighlight(part, true) end
end)
UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    local part = mousePartMap[input.UserInputType]
    if part then setMouseHighlight(part, false) end
end)

-- Scroll flash
UserInputService.InputChanged:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        setMouseHighlight(scroll, true)
        task.delay(0.15, function() setMouseHighlight(scroll, false) end)
    end
end)

-- ─────────────────────────────────────────────
-- 6.  TOGGLE VISIBILITY  (press ` / tilde)
-- ─────────────────────────────────────────────
local hudVisible = true
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.BackQuote then
        hudVisible = not hudVisible
        kbdFrame.Visible   = hudVisible
        mouseFrame.Visible = hudVisible
    end
end)

