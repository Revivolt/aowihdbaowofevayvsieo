addML(lmb,"L"); addML(rmb,"R")

-- ══════════════════════════════════════════════════════════════
-- HIGHLIGHT LOGIC
-- ══════════════════════════════════════════════════════════════
local function hlKey(f, on)
    if not f then return end
    TweenService:Create(f, TweenInfo.new(0.06,Enum.EasingStyle.Quad), {
        BackgroundColor3      = on and C_ACTIVE or C_KEY,
        BackgroundTransparency= on and A_ON     or A_KEY,
    }):Play()
end
local function hlMouse(f, on)
    if not f then return end
    TweenService:Create(f, TweenInfo.new(0.06,Enum.EasingStyle.Quad), {
        BackgroundColor3      = on and C_ACTIVE or C_KEY,
        BackgroundTransparency= on and A_ON     or 1,
    }):Play()
end

-- ══════════════════════════════════════════════════════════════
-- INPUT DETECTION
-- We listen via BOTH UserInputService AND ContextActionService
-- to maximise the chance of catching events on the emulator.
-- ══════════════════════════════════════════════════════════════

-- UIS path (works on real PC and some emulators)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        hlKey(keyFrameByCode[input.KeyCode.Name], true)
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        hlMouse(lmb, true)
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        hlMouse(rmb, true)
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        hlMouse(scr, true)
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        hlKey(keyFrameByCode[input.KeyCode.Name], false)
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        hlMouse(lmb, false)
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        hlMouse(rmb, false)
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        hlMouse(scr, false)
    end
end)

UserInputService.InputChanged:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        TweenService:Create(scr,TweenInfo.new(0.05),{BackgroundColor3=C_ACTIVE}):Play()
        task.delay(0.18,function()
            TweenService:Create(scr,TweenInfo.new(0.10),{BackgroundColor3=C_BORDER}):Play()
        end)
    end
end)

-- CAS path – bind every key in our keyboard layout to also trigger HUD highlight
-- This fires even when UIS doesn't on Android emulators
local ALL_KEYS = {}
for _, row in ipairs(ROWS) do
    for _, kdef in ipairs(row) do
        if kdef[3] then
            local ok, kc = pcall(function()
                return Enum.KeyCode[kdef[3]]
            end)
            if ok and kc then
                table.insert(ALL_KEYS, kc)
            end
        end
    end
end

ContextActionService:BindAction("HUDKeyHighlight", function(_, state, inputObj)
    local codeName = inputObj.KeyCode.Name
    if state == Enum.UserInputState.Begin then
        hlKey(keyFrameByCode[codeName], true)
    elseif state == Enum.UserInputState.End then
        hlKey(keyFrameByCode[codeName], false)
    end
    return Enum.ContextActionResult.Pass
end, false, table.unpack(ALL_KEYS))

-- Mouse buttons via CAS
ContextActionService:BindAction("HUDMouseLeft", function(_, state, _)
    hlMouse(lmb, state == Enum.UserInputState.Begin)
    return Enum.ContextActionResult.Pass
end, false, Enum.UserInputType.MouseButton1)

ContextActionService:BindAction("HUDMouseRight", function(_, state, _)
    hlMouse(rmb, state == Enum.UserInputState.Begin)
    return Enum.ContextActionResult.Pass
end, false, Enum.UserInputType.MouseButton2)

-- ══════════════════════════════════════════════════════════════
-- TOGGLE HUD  (backtick)
-- ══════════════════════════════════════════════════════════════
local hudOn = true
ContextActionService:BindAction("ToggleHUD", function(_, state, _)
    if state ~= Enum.UserInputState.Begin then return end
    hudOn = not hudOn
    kbdFrame.Visible   = hudOn
    mouseFrame.Visible = hudOn
end, false, Enum.KeyCode.BackQuote)

print("[PCEmulatorInput] ✓ Ready. Backtick (`) toggles HUD.")
