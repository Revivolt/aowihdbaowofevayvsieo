--// Core: Humanoid replacement (the godmode engine)
local function replaceHumanoid(character)
    if not character or not character.Parent then
        return false, "Character nil or parentless"
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false, "No humanoid found"
    end

    -- Already replaced? Check for marker.
    if humanoid:GetAttribute("EVE_Replaced") then
        return true, "Already replaced"
    end

    -- Preserve health and state before mutation
    local currentHealth = humanoid.Health
    local maxHealth = humanoid.MaxHealth
    local walkSpeed = humanoid.WalkSpeed
    local jumpPower = humanoid.JumpPower

    if humanoid.Name ~= "OldHumanoid" then
        humanoid.Name = "OldHumanoid"

        local newHumanoid = humanoid:Clone()
        newHumanoid.Parent = character
        newHumanoid.Name = "Humanoid"

        -- Transfer preserved attributes
        newHumanoid.Health = currentHealth
        newHumanoid.MaxHealth = maxHealth
        newHumanoid.WalkSpeed = walkSpeed
        newHumanoid.JumpPower = jumpPower
        newHumanoid:SetAttribute("EVE_Replaced", true)

        -- Small yield to let engine register the new humanoid
        task.wait(0.1)

        local oldHumanoid = character:FindFirstChild("OldHumanoid")
        if oldHumanoid then
            oldHumanoid:Destroy()
        end

        workspace.CurrentCamera.CameraSubject = newHumanoid

        -- Reset Animate script without breaking existing animations
        local animate = character:FindFirstChild("Animate")
        if animate and animate.ClassName == "LocalScript" then
            animate.Disabled = true
            task.wait(0.1)
            animate.Disabled = false
        end

        logTelemetry("HUMANOID_REPLACE", "Success for character: " .. tostring(character))
        return true, "Replacement successful"
    end

    return false, "Humanoid already marked OldHumanoid (unexpected state)"
end

