                        connection = heartbeat:Connect(function()
                            if not enabled then
                                connection:Disconnect()
                                return
                            end
                            if not otherRoot.Parent or not rootPart.Parent then
                                connection:Disconnect()
                                return
                            end
                            -- Follow with slight offset behind subject
                            otherRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3)
                        end)

                        logTelemetry("ATTACH", "Attached player: " .. otherPlayer.Name .. " | Speed: " .. speed)

                        -- Cooldown to prevent spam attachment
                        attachmentCooldown = true
                        task.wait(0.5)
                        attachmentCooldown = false

                        return
                    end
                end
            end
        end
    end
end

