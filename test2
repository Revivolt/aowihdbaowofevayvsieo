-- ─── Slider factory (fixed) ───────────────────────────────────────────────────
-- Key fix: thumb uses frame.InputBegan (not MouseButton1Down) so the
-- Draggable frame does not swallow the event. Delta tracking via
-- UserInputService.InputChanged is guarded by a 'dragging' flag.
local function makeSlider(parent, labelText, yPos, minVal, maxVal, default)
    local currentValue = default
    local dragging     = false

    local container = Instance.new("Frame", parent)
    container.Size                   = UDim2.new(1, -16, 0, 48)
    container.Position               = UDim2.new(0, 8, 0, yPos)
    container.BackgroundTransparency = 1

    -- axis label
    local lbl = Instance.new("TextLabel", container)
    lbl.Size                   = UDim2.new(0, 20, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3             = Color3.fromRGB(220, 50, 50)
    lbl.TextSize               = 13
    lbl.Font                   = Enum.Font.GothamBold
    lbl.Text                   = labelText
    lbl.TextXAlignment         = Enum.TextXAlignment.Left

    -- numeric readout
    local valLbl = Instance.new("TextLabel", container)
    valLbl.Size                   = UDim2.new(1, -28, 0, 16)
    valLbl.Position               = UDim2.new(0, 24, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.TextColor3             = Color3.fromRGB(200, 200, 200)
    valLbl.TextSize               = 11
    valLbl.Font                   = Enum.Font.Code
    valLbl.Text                   = string.format("%.2f", default)
    valLbl.TextXAlignment         = Enum.TextXAlignment.Right

    -- track
    local track = Instance.new("Frame", container)
    track.Size             = UDim2.new(1, 0, 0, 6)
    track.Position         = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    track.BorderSizePixel  = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    fill.BorderSizePixel  = 0
    fill.Size             = UDim2.new((default - minVal) / (maxVal - minVal), 0, 1, 0)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame", track)   -- Frame, not Button!
    thumb.Size             = UDim2.new(0, 16, 0, 16)
    thumb.AnchorPoint      = Vector2.new(0.5, 0.5)
    thumb.Position         = UDim2.new((default - minVal) / (maxVal - minVal), 0, 0.5, 0)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel  = 0
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    -- reset button
    local resetBtn = Instance.new("TextButton", container)
    resetBtn.Size             = UDim2.new(0, 44, 0, 16)
    resetBtn.Position         = UDim2.new(1, -44, 0, 32)
    resetBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    resetBtn.BorderSizePixel  = 0
    resetBtn.Text             = "Reset"
    resetBtn.TextColor3       = Color3.fromRGB(180, 180, 180)
    resetBtn.TextSize         = 10
    resetBtn.Font             = Enum.Font.Gotham
    Instance.new("UICorner", resetBtn).CornerRadius = UDim.new(0, 4)

    local function applyRatio(ratio)
        ratio        = math.clamp(ratio, 0, 1)
        currentValue = minVal + ratio * (maxVal - minVal)
        fill.Size    = UDim2.new(ratio, 0, 1, 0)
        thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
        valLbl.Text  = string.format("%.2f", currentValue)
    end

    local function ratioFromX(absX)
        return (absX - track.AbsolutePosition.X) / track.AbsoluteSize.X
    end

    -- Use InputBegan on the thumb Frame — not swallowed by Draggable
    thumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    -- Clicking anywhere on the track also works
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            applyRatio(ratioFromX(input.Position.X))
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            applyRatio(ratioFromX(input.Position.X))
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    resetBtn.MouseButton1Click:Connect(function()
        applyRatio((0 - minVal) / (maxVal - minVal))
    end)

    return function() return currentValue end
end

local getX = makeSlider(frame, "X", 58,  -20, 20, 0)
local getY = makeSlider(frame, "Y", 110, -20, 20, 0)
local getZ = makeSlider(frame, "Z", 162, -20, 20, 0)

-- ─── Respawn ──────────────────────────────────────────────────────────────────
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart  = newChar:WaitForChild("HumanoidRootPart")
    sphere.Parent = workspace
    billboard.Adornee = sphere
end)

-- ─── Main loop ────────────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not character or not character.Parent then return end

    offset = Vector3.new(getX(), getY(), getZ())

    local com = getCoM(character) + offset

    -- move the neon sphere to the CoM world position
    sphere.CFrame = CFrame.new(com)

    -- update billboard label with live coords
    billLabel.Text = string.format("CoM\n%.1f, %.1f, %.1f", com.X, com.Y, com.Z)

    -- update screen GUI readout
    readout.Text = string.format("CoM: (%.2f, %.2f, %.2f)", com.X, com.Y, com.Z)
end)
