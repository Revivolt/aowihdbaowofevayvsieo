end

--// Retry wrapper with exponential backoff
local function withRetry(fn, ...)
    local lastError = nil
    for attempt = 1, RETRY_MAX_ATTEMPTS do
        local success, result = pcall(fn, ...)
        if success then
            if result == true then
                return true, nil
            else
                -- fn returned false but didn't error; treat as soft failure
                lastError = result
            end
        else
            lastError = result
        end

        if attempt < RETRY_MAX_ATTEMPTS then
            local delay = RETRY_BASE_DELAY * (2 ^ (attempt - 1))
            task.wait(delay)
        end
    end
    return false, lastError
end

