-- PCEmulatorInput.lua
-- LocalScript → StarterPlayerScripts
--
-- APPROACH: Since Android emulators don't pass keyboard/mouse events to Roblox,
-- we build a fully on-screen virtual controller using GUI buttons and Roblox's
-- own touch/VirtualUser APIs. No real keyboard input needed at all.
-- The on-screen keyboard lights up when YOU press the GUI buttons with your mouse.

local Players              = game:GetService("Players")
local UserInputService     = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService           = game:GetService("RunService")
local StarterGui           = game:GetService("StarterGui")
local TweenService         = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- ── Wait for character ──────────────────────────────────────
local Character, Humanoid, HRP, Camera

local function grabChar(char)
    Character = char
    HRP       = char:WaitForChild("HumanoidRootPart")
    Humanoid  = char:WaitForChild("Humanoid")
    Camera    = workspace.CurrentCamera
    Camera.CameraType = Enum.CameraType.Custom
end
if LocalPlayer.Character then grabChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(grabChar)

-- ── Kill mobile touch GUI ───────────────────────────────────
PlayerGui.ChildAdded:Connect(function(c)
    if c.Name == "TouchGui" then task.defer(function() c:Destroy() end) end
end)
local tg = PlayerGui:FindFirstChild("TouchGui")
if tg then tg:Destroy() end

pcall(function()
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, true)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
end)

-- ── Keep camera in Custom mode ──────────────────────────────
RunService:BindToRenderStep("CamLock", Enum.RenderPriority.Camera.Value+1, function()
    Camera = workspace.CurrentCamera
    if Camera.CameraType ~= Enum.CameraType.Custom then
        Camera.CameraType = Enum.CameraType.Custom
    end
end)

-- ════════════════════════════════════════════════════════════
-- MOVEMENT ENGINE
-- We move the character directly via Humanoid:Move() based on
-- which virtual buttons are held. No keyboard events needed.
-- ════════════════════════════════════════════════════════════
local held    = {W=false,A=false,S=false,D=false}
local sprint  = false
local BASE_SPEED = 16

RunService.Heartbeat:Connect(function()
    if not Humanoid or not HRP or not Camera then return end

    local x = (held.D and 1 or 0) - (held.A and 1 or 0)
    local z = (held.S and 1 or 0) - (held.W and 1 or 0)
    local dir = Vector3.new(x,0,z)

    if dir.Magnitude > 0 then
        dir = dir.Unit
        local lv  = Camera.CFrame.LookVector
        local yaw = CFrame.Angles(0, math.atan2(-lv.X, -lv.Z), 0)
        Humanoid:Move(yaw * dir, false)
    else
        Humanoid:Move(Vector3.zero, false)
    end
    Humanoid.WalkSpeed = sprint and 22 or BASE_SPEED
end)

