-- ─── CoM calculation ──────────────────────────────────────────────────────────
local function getCoM(char)
    local totalMass   = 0
    local weightedSum = Vector3.new(0, 0, 0)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local m = part.AssemblyMass > 0 and part.AssemblyMass or part:GetMass()
            weightedSum = weightedSum + part.Position * m
            totalMass   = totalMass + m
        end
    end
    if totalMass == 0 then return char.HumanoidRootPart.Position end
    return weightedSum / totalMass
end

