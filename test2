--// Helper: Play sound locally
local function playSound(soundId, volume, parent)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume or 0.6
    sound.Parent = parent or workspace.CurrentCamera
    sound:Play()
    task.delay(sound.TimeLength, function()
        sound:Destroy()
    end)
    return sound
end

--// Helper: Screen tint effect (fear UI)
local function createThreatTint()
    if screenGui and screenGui.Parent then
        screenGui:Destroy()
    end
    
    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "GodPreserveUI"
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = player.PlayerGui
    
    threatTint = Instance.new("Frame")
    threatTint.Name = "ThreatTint"
    threatTint.Size = UDim2.new(1, 0, 1, 0)
    threatTint.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    threatTint.BackgroundTransparency = 0.7
    threatTint.BorderSizePixel = 0
    threatTint.Visible = false
    threatTint.Parent = screenGui
end

local function showThreatTint(visible)
    if not threatTint then createThreatTint() end
    threatTint.Visible = visible
    if visible then
        -- Pulse animation
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
        local tween = TweenService:Create(threatTint, tweenInfo, {BackgroundTransparency = 0.5})
        tween:Play()
    else
        for _, tween in pairs(TweenService:GetTweens(threatTint)) do
            tween:Cancel()
        end
        threatTint.BackgroundTransparency = 0.7
    end
end

--// Core: Godmode implementation (anti-anti-tamper)
local function enableGodmode(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    -- Hook health changes without cloning (detection-resistant)
    local originalHealth = humanoid.Health
    local hookConnection
    
    hookConnection = humanoid.Changed:Connect(function(property)
        if property == "Health" then
            if humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
        elseif property == "BreakJointsOnDeath" then
            humanoid.BreakJointsOnDeath = false
        end
    end)
    
    -- Prevent death event firing
    local deathConnection
    deathConnection = humanoid.Died:Connect(function()
        humanoid.Health = humanoid.MaxHealth
        humanoid:BreakJointsOnDeath(false)
        -- Force respawn prevention
        task.wait()
        if character.Parent then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
    
    -- Store connections for cleanup
    if not character:FindFirstChild("GodmodeConnections") then
        local folder = Instance.new("Folder")
        folder.Name = "GodmodeConnections"
        folder.Parent = character
    end
    local folder = character.GodmodeConnections
    hookConnection.Parent = folder
    deathConnection.Parent = folder
    
    -- Camera subject stabilization
    if workspace.CurrentCamera then
        currentCameraSubject = workspace.CurrentCamera.CameraSubject
        workspace.CurrentCamera.CameraSubject = humanoid
    end
    
    return true
end

local function disableGodmode(character)
    local folder = character:FindFirstChild("GodmodeConnections")
    if folder then
        for _, conn in pairs(folder:GetChildren()) do
            if conn:IsA("RBXScriptConnection") then
                conn:Disconnect()
            end
        end
        folder:Destroy()
    end
    
    if workspace.CurrentCamera and currentCameraSubject then
        workspace.CurrentCamera.CameraSubject = currentCameraSubject
        currentCameraSubject = nil
    end
end

--// Core: Attachment system (LinearVelocity + network ownership)
local function attachVictim(victimCharacter)
    if not enabled then return false end
    if not player.Character or not player.Character.Parent then return false end
    if attachedVictims[victimCharacter] then return false end
    
    local attackerRoot = player.Character:FindFirstChild("HumanoidRootPart")
    local victimRoot = victimCharacter:FindFirstChild("HumanoidRootPart")
    if not attackerRoot or not victimRoot then return false end
    
    -- Create attachments on both root parts
    local att1 = Instance.new("Attachment")
    att1.Parent = attackerRoot
    att1.Position = Vector3.new(0, 0, 2) -- In front of attacker
    
    local att2 = Instance.new("Attachment")
    att2.Parent = victimRoot
    att2.Position = Vector3.new(0, 0, 0)
    
    -- LinearVelocity constraint (smoother than welds)
    local velocityConstraint = Instance.new("LinearVelocity")
    velocityConstraint.Attachment0 = att1
    velocityConstraint.Attachment1 = att2
    velocityConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
    velocityConstraint.VectorVelocity = Vector3.new(0, 0, 0)
    velocityConstraint.MaxForce = 10000
    velocityConstraint.Enabled = true
    velocityConstraint.Parent = attackerRoot
    
    -- Transfer network ownership to client for smooth dragging
    local success, err = pcall(function()
        victimRoot:SetNetworkOwner(player)
    end)
    if not success then
        -- Fallback: no ownership transfer, but constraint still works partially
    end
    
    -- Store state
    attachedVictims[victimCharacter] = {
        victim = victimCharacter,
        att1 = att1,
        att2 = att2,
        constraint = velocityConstraint,
        originalOwner = victimRoot:GetNetworkOwner()
    }
    
    -- Visual feedback: victim tint red
    local victimHumanoid = victimCharacter:FindFirstChildOfClass("Humanoid")
    if victimHumanoid then
        local originalColor = victimHumanoid:GetAttribute("OriginalColor") or victimHumanoid.RigType
        victimHumanoid:SetAttribute("OriginalColor", victimHumanoid.RigType)
    end
    
    -- Audio cue for victim (local player hears it)
    playSound(THREAT_SOUND_ID, 0.5, victimCharacter:FindFirstChild("Head") or victimCharacter)
    
    return true
end

local function detachVictim(victimCharacter)
    local data = attachedVictims[victimCharacter]
    if not data then return end
    
    if data.constraint then data.constraint:Destroy() end
    if data.att1 then data.att1:Destroy() end
    if data.att2 then data.att2:Destroy() end
    
    -- Restore network ownership if possible
    local victimRoot = victimCharacter:FindFirstChild("HumanoidRootPart")
    if victimRoot and data.originalOwner then
        pcall(function()
            victimRoot:SetNetworkOwner(data.originalOwner)
        end)
    end
    
    attachedVictims[victimCharacter] = nil
end

local function detachAllVictims()
    for victim, _ in pairs(attachedVictims) do
        if victim and victim.Parent then
            detachVictim(victim)
        end
    end
    attachedVictims = {}
end

--// Core: Raycast-based attachment detection (replaces old Touched method)
local function scanForVictims()
    if not enabled then return end
    if not player.Character or not player.Character.Parent then return end
    
    local character = player.Character
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local tool = character:FindFirstChildOfClass("Tool")
    
    -- Requirement: Must have a tool in hand (legacy mechanic preserved)
    if not tool then return end
    
    if not rootPart then return end
    
    -- Raycast in a sphere around player
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {character}
    
    local origin = rootPart.Position
    local results = workspace:GetPartBoundsInBox(
        Region3.new(origin - Vector3.new(ATTACH_RANGE, ATTACH_RANGE, ATTACH_RANGE),
                    origin + Vector3.new(ATTACH_RANGE, ATTACH_RANGE, ATTACH_RANGE)),
        params
    )
    
    for _, part in pairs(results) do
        local victimCharacter = part:FindFirstAncestorOfClass("Model")
        if victimCharacter and victimCharacter:FindFirstChildOfClass("Humanoid") then
            if victimCharacter ~= character and not attachedVictims[victimCharacter] then
                -- Check if victim is a player
                local victimPlayer = Players:GetPlayerFromCharacter(victimCharacter)
                if victimPlayer then
                    attachVictim(victimCharacter)
                end
            end
        end
    end
end

--// Core: Humanoid resurrection ritual (legacy testfunc evolution)
local function performRitual()
    if not player.Character or not player.Character.Parent then return end
    
    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if not humanoid then return end
    
    -- Legacy naming ritual preserved
    if humanoid.Name ~= "OldHumanoid" then
        -- Disable godmode temporarily to avoid conflicts
        if godmodeConnection then
            disableGodmode(character)
        end
        
        humanoid.Name = "OldHumanoid"
        
        local newHumanoid = humanoid:Clone()
        newHumanoid.Parent = character
        newHumanoid.Name = "Humanoid"
        
        task.wait(0.1)
        
        if character:FindFirstChild("OldHumanoid") then
            character.OldHumanoid:Destroy()
        end
        
        -- Re-enable godmode on new humanoid
        enableGodmode(character)
        
        -- Restart animate script
        local animate = character:FindFirstChild("Animate")
        if animate then
            animate.Disabled = true
            task.wait(0.1)
            animate.Disabled = false
        end
        
        -- Baptism sound
        playSound(TOGGLE_SOUND_ID, 0.4, workspace.CurrentCamera)
    end
end

