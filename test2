local Players = game:GetService("Players") local RunService = game:GetService("RunService") local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer local character = player.Character or player.CharacterAdded:Wait() local rootPart = character:WaitForChild("HumanoidRootPart")
-- ─── CoM Indicator (neon sphere) ────────────────────────────────────────────── local indicator = Instance.new("Part") indicator.Name = "CoM_Indicator" indicator.Size = Vector3.new(0.35, 0.35, 0.35) indicator.Shape = Enum.PartType.Ball indicator.Material = Enum.Material.Neon indicator.BrickColor = BrickColor.new("Bright red") indicator.CanCollide = false indicator.CanQuery = false indicator.CanTouch = false indicator.Anchored = true indicator.CastShadow = false indicator.Parent = workspace
-- ─── Offset state (studs) ───────────────────────────────────────────────────── local offset = Vector3.new(0, 0, 0)
-- ─── CoM calculation ────────────────────────────────────────────────────────── local function getCoM() local totalMass = 0 local weightedSum = Vector3.new(0, 0, 0) for _, part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") and not part:IsA("Terrain") then local m = part.AssemblyMass > 0 and part.AssemblyMass or part:GetMass() weightedSum = weightedSum + part.Position * m totalMass = totalMass + m end end if totalMass == 0 then return rootPart.Position end return weightedSum / totalMass end
