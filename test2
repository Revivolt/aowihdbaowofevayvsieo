-- ══════════════════════════════════════════════════════════════
-- 6.  HIGHLIGHT HELPERS
-- ══════════════════════════════════════════════════════════════
local function highlightKey(frame, on)
    if not frame then return end
    TweenService:Create(frame, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {
        BackgroundColor3       = on and C_ACTIVE or C_KEY,
        BackgroundTransparency = on and ALPHA_ON  or ALPHA_KEY,
    }):Play()
end

local function highlightMouse(frame, on)
    if not frame then return end
    TweenService:Create(frame, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {
        BackgroundColor3       = on and C_ACTIVE or C_KEY,
        BackgroundTransparency = on and ALPHA_ON  or 1,
    }):Play()
end

-- ══════════════════════════════════════════════════════════════
-- 7.  INPUT LISTENERS  (HUD visualisation only)
-- ══════════════════════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        highlightKey(keyFrameByCode[input.KeyCode.Name], true)
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        highlightMouse(lmb, true)
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        highlightMouse(rmb, true)
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        highlightMouse(scr, true)
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        highlightKey(keyFrameByCode[input.KeyCode.Name], false)
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        highlightMouse(lmb, false)
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        highlightMouse(rmb, false)
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        highlightMouse(scr, false)
    end
end)

UserInputService.InputChanged:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        TweenService:Create(scr, TweenInfo.new(0.05), {BackgroundColor3 = C_ACTIVE}):Play()
        task.delay(0.18, function()
            TweenService:Create(scr, TweenInfo.new(0.10), {BackgroundColor3 = C_BORDER}):Play()
        end)
    end
end)

