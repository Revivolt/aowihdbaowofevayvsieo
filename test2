--------------------------------------------------------------------------------
-- Drag logic (panel follows shadow)
--------------------------------------------------------------------------------

local dragging    = false
local dragStartMouse = Vector2.new()
local dragStartPanel = UDim2.new()

local function syncShadow()
    shadow.Position = UDim2.new(
        panel.Position.X.Scale, panel.Position.X.Offset - 8,
        panel.Position.Y.Scale, panel.Position.Y.Offset - 8
    )
end

header.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1
    or inp.UserInputType == Enum.UserInputType.Touch then
        dragging         = true
        dragStartMouse   = Vector2.new(inp.Position.X, inp.Position.Y)
        dragStartPanel   = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if not dragging then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseMovement
    and inp.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = Vector2.new(inp.Position.X, inp.Position.Y) - dragStartMouse
    panel.Position = UDim2.new(
        dragStartPanel.X.Scale, dragStartPanel.X.Offset + delta.X,
        dragStartPanel.Y.Scale, dragStartPanel.Y.Offset + delta.Y
    )
    syncShadow()
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1
    or inp.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

--------------------------------------------------------------------------------
-- Slider factory
--------------------------------------------------------------------------------

-- sliderRefresh[name](value) → visually syncs slider without writing to char.
local sliderRefresh = {}

for i, scaleDef in ipairs(SCALES) do
    local sName = scaleDef.name
    local sMin  = scaleDef.min
    local sMax  = scaleDef.max
    local yPos  = HEADER_H + PADDING + (i - 1) * ROW_H + 4

    -- Row frame
    local row = Instance.new("Frame")
    row.Size                  = UDim2.new(1, -PADDING * 2, 0, ROW_H - 6)
    row.Position              = UDim2.new(0, PADDING, 0, yPos)
    row.BackgroundTransparency = 1
    row.ZIndex                = 2
    row.Parent                = panel

    -- Label (left)
    local label = Instance.new("TextLabel")
    label.Size                = UDim2.new(0, 100, 0, 16)
    label.Position            = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text                = scaleDef.label
    label.TextColor3          = COLOR_LABEL
    label.TextSize            = 11
    label.Font                = Enum.Font.Gotham
    label.TextXAlignment      = Enum.TextXAlignment.Left
    label.ZIndex              = 3
    label.Parent              = row

    -- Value readout (right)
    local valLabel = Instance.new("TextLabel")
    valLabel.Size             = UDim2.new(0, 52, 0, 16)
    valLabel.Position         = UDim2.new(1, -52, 0, 0)
    valLabel.BackgroundTransparency = 1
    valLabel.TextColor3       = COLOR_VALUE
    valLabel.TextSize         = 11
    valLabel.Font             = Enum.Font.GothamMono
    valLabel.TextXAlignment   = Enum.TextXAlignment.Right
    valLabel.ZIndex           = 3
    valLabel.Parent           = row

    -- Track background
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, 0, 0, 6)
    track.Position         = UDim2.new(0, 0, 0, 26)
    track.BackgroundColor3 = COLOR_TRACK
    track.BorderSizePixel  = 0
    track.ZIndex           = 3
    track.Parent           = row
    makeCorner(track, 4)

    -- Track glow (faint, sits behind fill)
    local trackGlow = Instance.new("Frame")
    trackGlow.Size             = UDim2.new(1, 0, 1, 4)
    trackGlow.Position         = UDim2.new(0, 0, 0, -2)
    trackGlow.BackgroundColor3 = COLOR_FILL
    trackGlow.BackgroundTransparency = 0.88
    trackGlow.BorderSizePixel  = 0
    trackGlow.ZIndex           = 2
    trackGlow.Parent           = track
    makeCorner(trackGlow, 4)

    -- Fill bar
    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = COLOR_FILL
    fill.BorderSizePixel  = 0
    fill.ZIndex           = 4
    fill.Parent           = track
    makeCorner(fill, 4)

    -- Thumb button (interactive hitbox + visual)
    local thumb = Instance.new("TextButton")
    thumb.Size             = UDim2.new(0, 16, 0, 16)
    thumb.Position         = UDim2.new(0, -8, 0.5, -8)
    thumb.BackgroundColor3 = COLOR_THUMB
    thumb.Text             = ""
    thumb.BorderSizePixel  = 0
    thumb.AutoButtonColor  = false
    thumb.ZIndex           = 5
    thumb.Parent           = track
    makeCorner(thumb, 8)
    -- Subtle stroke on thumb
    makeStroke(thumb, Color3.fromRGB(120, 160, 255), 1.5, 0.3)

    -- Inner dot on thumb
    local dot = Instance.new("Frame")
    dot.Size             = UDim2.new(0, 6, 0, 6)
    dot.Position         = UDim2.new(0.5, -3, 0.5, -3)
    dot.BackgroundColor3 = COLOR_FILL
    dot.BorderSizePixel  = 0
    dot.ZIndex           = 6
    dot.Parent           = thumb
    makeCorner(dot, 3)

    ----------------------------------------------------------------------------
    -- Visual refresh (no character write)
    ----------------------------------------------------------------------------
    local function refresh(val, skipTween)
        local t = invLerp(sMin, sMax, val)
        valLabel.Text = string.format("%.3f", val)

        if skipTween then
            fill.Size      = UDim2.new(t, 0, 1, 0)
            thumb.Position = UDim2.new(t, -8, 0.5, -8)
        else
            TweenService:Create(fill,  TWEEN_INFO, { Size     = UDim2.new(t, 0, 1, 0)    }):Play()
            TweenService:Create(thumb, TWEEN_INFO, { Position = UDim2.new(t, -8, 0.5, -8) }):Play()
        end
    end

    refresh(currentValues[sName], true)
    sliderRefresh[sName] = refresh

    ----------------------------------------------------------------------------
    -- Thumb hover states
    ----------------------------------------------------------------------------
    thumb.MouseEnter:Connect(function()
        TweenService:Create(thumb, TWEEN_INFO, { BackgroundColor3 = COLOR_THUMB_HOT, Size = UDim2.new(0, 18, 0, 18) }):Play()
        thumb.Position = UDim2.new(thumb.Position.X.Scale, -9, 0.5, -9)
    end)
    thumb.MouseLeave:Connect(function()
        TweenService:Create(thumb, TWEEN_INFO, { BackgroundColor3 = COLOR_THUMB, Size = UDim2.new(0, 16, 0, 16) }):Play()
        thumb.Position = UDim2.new(thumb.Position.X.Scale, -8, 0.5, -8)
    end)

    ----------------------------------------------------------------------------
    -- Compute a clamped value from a raw screen X position
    ----------------------------------------------------------------------------
    local function valueFromScreenX(screenX)
        local trackX = track.AbsolutePosition.X
        local trackW = track.AbsoluteSize.X
        if trackW <= 0 then return currentValues[sName] end
        local t = math.clamp((screenX - trackX) / trackW, 0, 1)
        return round3(lerp(sMin, sMax, t))
    end

    ----------------------------------------------------------------------------
    -- Commit a value: update table, refresh UI, write to character
    ----------------------------------------------------------------------------
    local function commitValue(val)
        currentValues[sName] = val
        refresh(val, true)   -- instant during drag, feels snappier
        writeScale(scaleDef, val)
    end

    ----------------------------------------------------------------------------
    -- Input handling — unified for mouse + touch
    ----------------------------------------------------------------------------
    local held = false

    local function onPress(screenX)
        held = true
        commitValue(valueFromScreenX(screenX))
    end

    -- Clicking anywhere on the track
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            onPress(inp.Position.X)
        end
    end)

    -- Pressing the thumb directly
    thumb.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            held = true   -- don't snap position; just enable drag
        end
    end)

    -- Global drag listener (only active while held)
    UserInputService.InputChanged:Connect(function(inp)
        if not held then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            commitValue(valueFromScreenX(inp.Position.X))
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            if held then
                held = false
                -- Final smooth snap after release
                refresh(currentValues[sName], false)
            end
        end
    end)
end

--------------------------------------------------------------------------------
-- Respawn handling
-- Wait slightly longer than before (0.5s → 1 frame + 0.6s) to ensure
-- the engine has fully loaded the Humanoid NumberValue children.
--------------------------------------------------------------------------------

local function onCharacterAdded(character)
    -- Yield until the Humanoid exists
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    -- Yield until all scale NumberValues are present (they're added async)
    for _, s in ipairs(SCALES) do
        humanoid:WaitForChild(s.name, 5)
    end

    -- One extra tick so the engine finishes its own default writes
    task.wait(0.1)
    applyAllScales()
end

-- Handle character already in world on script start
if player.Character then
    task.spawn(onCharacterAdded, player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)
