-- summary  = short one-line label shown on the button
-- fullText = complete detail shown in the popup
local function appendEntry(summary, fullText, accentColor, bgColor)
    fireCount += 1
    logLines[#logLines + 1] = fullText
    counter.Text = fireCount .. " fires"

    local btn = Instance.new("TextButton")
    btn.LayoutOrder          = fireCount
    btn.Size                 = UDim2.new(1, -10, 0, 24)
    btn.Position             = UDim2.new(0, 5, 0, 0)
    btn.BackgroundColor3     = bgColor or Color3.fromRGB(22, 22, 22)
    btn.TextColor3           = accentColor or Color3.fromRGB(210, 210, 210)
    btn.TextSize             = 11
    btn.Font                 = Enum.Font.Code
    btn.TextXAlignment       = Enum.TextXAlignment.Left
    btn.TextTruncate         = Enum.TextTruncate.AtEnd
    btn.AutoButtonColor      = false
    btn.BorderSizePixel      = 0
    btn.Text                 = "  " .. summary
    btn.Parent               = scrollFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 3)
    btnCorner.Parent       = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color     = accentColor and accentColor:Lerp(Color3.fromRGB(0,0,0), 0.6) or Color3.fromRGB(40, 40, 40)
    btnStroke.Thickness = 1
    btnStroke.Parent    = btn

    -- Hover effect
    local normalBg = btn.BackgroundColor3
    local hoverBg  = normalBg:Lerp(Color3.fromRGB(255, 255, 255), 0.06)
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hoverBg end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = normalBg end)

    -- Click → open detail popup
    btn.MouseButton1Click:Connect(function()
        openDetail(fullText, accentColor)
    end)

    scrollToBottom()
end

