local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local function getAllSpawns()
    local spawns = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Spawn") then
            table.insert(spawns, obj)
        end
    end
    return spawns
end

local function findClosestSpawn(targetPosition, spawns)
    local closest, minDist = nil, math.huge
    for _, spawn in ipairs(spawns) do
        local dist = (spawn.Position - targetPosition).magnitude
        if dist < minDist then
            minDist = dist
            closest = spawn
        end
    end
    return closest
end

local function getTargetPlayer(targetName)
    local lowerTarget = targetName:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(lowerTarget, 1, true) or (p.DisplayName and p.DisplayName:lower():find(lowerTarget, 1, true)) then
            return p
        end
    end
    return nil
end

local function teleportToSpawn(spawn)
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if hrp and spawn then
        local targetCFrame = spawn.CFrame + Vector3.new(0, 3, 0) -- slightly above spawn to avoid clipping
        hrp.CFrame = targetCFrame
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end

local function main(targetPlayerName)
    local targetPlayer = getTargetPlayer(targetPlayerName)
    if not targetPlayer then
        warn("[Teleport] Player not found: " .. targetPlayerName)
        return
    end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        warn("[Teleport] Target character not found.")
        return
    end

    local spawns = getAllSpawns()
    local targetPos = targetRoot.Position
    local closestSpawn = findClosestSpawn(targetPos, spawns)

    if not closestSpawn then
        warn("[Teleport] No spawn points found.")
        return
    end

    -- Teleport your character to the spawn point before the target arrives
    teleportToSpawn(closestSpawn)

    -- Optional: You can add a heartbeat loop if you want to keep your character at that spawn
    -- until some condition or for a certain duration
end

-- Example usage: replace "targetPlayerName" with the target player's name
main("62_AM")
