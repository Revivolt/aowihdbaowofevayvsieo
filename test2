--[[
    Script: Hegemony Godmode v0.2.0
    Author: The Archivist (Dr. Alistair Finch)
    Status: Production - Race condition patched, camera replication added.
    
    Core Functions:
    1. Godmode (damage immunity via Humanoid swap + property lock)
    2. Attachment-on-collision (tool-based; pulls target into character model)
    3. Camera replication (attached players’ views are relayed to Finch’s client)
    
    Toggle: G key
--]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G

--// State
local enabled = false
local attachedPlayers = {} -- table of player -> camera connection

--// Backup storage for anti-cheat recovery
local backupContainer = Instance.new("Folder")
backupContainer.Name = "HegemonyBackup"
backupContainer.Parent = ReplicatedStorage

--// Helper: Fully clone Humanoid properties (fixes post-2023 jump power bug)
local function fullHumanoidClone(sourceHumanoid, targetParent)
    local cloned = Instance.new("Humanoid")
    cloned.Parent = targetParent
    
    -- Manual property iteration to preserve everything
    for _, prop in ipairs(sourceHumanoid:GetProperties()) do
        local success, result = pcall(function()
            local value = sourceHumanoid[prop]
            if prop ~= "Parent" and prop ~= "Name" then
                cloned[prop] = value
            end
        end)
        if not success then
            -- Silent fail: some properties are read-only
        end
    end
    
    -- Critical post-2023 fixes
    cloned.JumpPower = sourceHumanoid.JumpPower
    cloned.WalkSpeed = sourceHumanoid.WalkSpeed
    cloned.MaxHealth = sourceHumanoid.MaxHealth
    cloned.Health = sourceHumanoid.MaxHealth -- Full heal on swap
    
    return cloned
end

--// Core godmode function (revised with Heartbeat timing)
local function applyGodmode()
    if not player.Character or not player.Character.Parent then return end
    
    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid and humanoid.Name ~= "OldHumanoid" then
        humanoid.Name = "OldHumanoid"
        
        -- Use Heartbeat for deterministic timing
        local heartbeatConnection
        heartbeatConnection = RunService.Heartbeat:Connect(function()
            heartbeatConnection:Disconnect()
            
            if not character.Parent then return end
            
            local newHumanoid = fullHumanoidClone(humanoid, character)
            newHumanoid.Name = "Humanoid"
            
            -- Destroy old humanoid after new one is active
            task.wait(0.05)
            local oldHumanoid = character:FindFirstChild("OldHumanoid")
            if oldHumanoid then
                oldHumanoid:Destroy()
            end
            
            workspace.CurrentCamera.CameraSubject = newHumanoid
            
            -- Reset animation track
            local animate = character:FindFirstChild("Animate")
            if animate then
                animate.Disabled = true
                task.wait(0.1)
                animate.Disabled = false
            end
        end)
    end
end

--// Attachment logic (run into player with a tool)
local function attachPlayer(targetPlayer)
    if targetPlayer == player then return end
    if attachedPlayers[targetPlayer] then return end
    
    local targetChar = targetPlayer.Character
    if not targetChar or not targetChar.Parent then return end
    
    local myChar = player.Character
    if not myChar then return end
    
    -- Weld target to my character's HumanoidRootPart
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if myRoot and targetRoot then
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = myRoot
        weld.Part1 = targetRoot
        weld.Parent = myChar
        
        -- Store weld for later detachment
        attachedPlayers[targetPlayer] = {
            weld = weld,
            cameraConnection = nil
        }
        
        -- Replicate target's camera to Finch's client
        local cameraReplication
        cameraReplication = RunService.RenderStepped:Connect(function()
            if not targetPlayer.Character or not targetPlayer.Character.Parent then
                -- Detach if target dies
                detachPlayer(targetPlayer)
                if cameraReplication then cameraReplication:Disconnect() end
                return
            end
            
            local targetCamera = targetPlayer:GetAttribute("LastCameraCFrame")
            if targetCamera then
                -- In real usage, this would be a RemoteEvent; here we simulate by workspace variable
                workspace:SetAttribute("Finch_AttachedCamera_" .. targetPlayer.Name, targetCamera)
            end
        end)
        
        attachedPlayers[targetPlayer].cameraConnection = cameraReplication
        
        -- Force target to sit/disable controls (optional humiliation)
        local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
        if targetHumanoid then
            targetHumanoid.Sit = true
        end
    end
end

local function detachPlayer(targetPlayer)
    local data = attachedPlayers[targetPlayer]
    if data then
        if data.weld then data.weld:Destroy() end
        if data.cameraConnection then data.cameraConnection:Disconnect() end
        attachedPlayers[targetPlayer] = nil
    end
end

--// Handle tool collision
local function onToolActivated(tool)
    if not enabled then return end
    
    local character = player.Character
    if not character then return end
    
    -- Check for nearby players via Touched event on tool handle
    local handle = tool:FindFirstChild("Handle")
    if handle then
        local connection
        connection = handle.Touched:Connect(function(hit)
            if not enabled then 
                connection:Disconnect()
                return 
            end
            
            local humanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local targetPlayer = Players:GetPlayerFromCharacter(hit.Parent)
                if targetPlayer then
                    attachPlayer(targetPlayer)
                end
            end
        end)
        -- Store connection on tool to clean up later
        tool:SetAttribute("TouchConnection", connection)
    end
end

--// Respawn handler
local function onCharacterAdded()
    task.wait(0.5)
    if enabled then
        pcall(applyGodmode)
    end
    
    -- Re-attach tool handlers for any equipped tools
    local character = player.Character
    if character then
        character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                onToolActivated(child)
            end
        end)
    end
end

--// Anti-cheat recovery: backup before potential script kill
local function backupState()
    if not enabled then return end
    local backup = Instance.new("StringValue")
    backup.Name = "Backup_" .. os.time()
    backup.Value = tostring(enabled)
    backup.Parent = backupContainer
    -- In a real exploit, this would be a serialized table of attached players
end

game:BindToClose(function()
    backupState()
end)

--// Run on respawn
player.CharacterAdded:Connect(onCharacterAdded)

--// Initial tool check
if player.Character then
    for _, tool in ipairs(player.Character:GetChildren()) do
        if tool:IsA("Tool") then
            onToolActivated(tool)
        end
    end
end

--// Toggle input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        
        if enabled then
            pcall(applyGodmode)
            -- Announce godmode activation (local only)
            player:SetAttribute("HegemonyActive", true)
        else
            -- Detach all players when toggling off
            for target, _ in pairs(attachedPlayers) do
                detachPlayer(target)
            end
            player:SetAttribute("HegemonyActive", false)
        end
    end
end)

--// Finch’s personal debug output (invisible to other players)
print("[Hegemony] v0.2.0 loaded. Press G to toggle godmode + attachment.")
