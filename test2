-- Utility: Find player by partial name
local function findPlayer(name)
	name = name:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name) or p.DisplayName:lower():find(name) then
			return p
		end
	end
	return nil
end

-- Add a spawn entry to the scroll list
local function addSpawnEntry(spawnPart, highlighted)
	local entry = Instance.new("TextLabel")
	entry.Size = UDim2.new(1, -4, 0, 22)
	entry.BackgroundColor3 = highlighted
		and Color3.fromRGB(60, 40, 10)
		or Color3.fromRGB(35, 35, 55)
	entry.TextColor3 = highlighted
		and Color3.fromRGB(255, 200, 80)
		or Color3.fromRGB(180, 180, 200)
	entry.Font = Enum.Font.Gotham
	entry.TextSize = 11
	entry.TextXAlignment = Enum.TextXAlignment.Left
	entry.Text = "  📍 " .. spawnPart.Name .. " @ " .. tostring(spawnPart.Position)
	entry.BorderSizePixel = 0
	entry.Name = spawnPart.Name
	entry.Parent = scrollFrame

	local ec = Instance.new("UICorner")
	ec.CornerRadius = UDim.new(0, 4)
	ec.Parent = entry

	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
	return entry
end

-- Rebuild spawn list UI
local function rebuildSpawnList(predictedSpawn)
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for _, data in ipairs(trackedSpawns) do
		local isHighlighted = predictedSpawn and data.part == predictedSpawn
		addSpawnEntry(data.part, isHighlighted)
	end
end

-- Core prediction logic
local function predictSpawn(player)
	if #trackedSpawns == 0 then
		return nil, "No spawns tracked yet"
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	-- Score each spawn
	local bestSpawn = nil
	local bestScore = math.huge

	for _, data in ipairs(trackedSpawns) do
		local spawnPos = data.part.Position
		local score = 0

		-- Factor 1: Distance from player's current position (closer = more likely)
		if rootPart then
			local dist = (rootPart.Position - spawnPos).Magnitude
			score = score + dist
		end

		-- Factor 2: Recency — more recently added spawns get a bonus
		local age = tick() - data.addedAt
		score = score - (math.max(0, 5 - age) * 50) -- strong recency bonus within 5s

		-- Factor 3: Prefer spawns close to the map center (heuristic)
		local centerDist = spawnPos.Magnitude
		score = score + centerDist * 0.05

		if score < bestScore then
			bestScore = score
			bestSpawn = data.part
		end
	end

	return bestSpawn, nil
end

-- Update prediction display
local function updatePrediction()
	if not targetPlayer then
		predictionLabel.Text = "Predicted Spawn:\nNo target set"
		return
	end

	local predicted, err = predictSpawn(targetPlayer)
	if predicted then
		predictionLabel.Text = "Predicted Spawn:\n✅ " .. predicted.Name
		rebuildSpawnList(predicted)
	else
		predictionLabel.Text = "Predicted Spawn:\n⚠️ " .. (err or "Unknown")
		rebuildSpawnList(nil)
	end
end

-- Watch for new Spawn parts anywhere in the workspace
local function watchForSpawns(parent)
	parent.DescendantAdded:Connect(function(obj)
		if obj.Name == "Spawn" and obj:IsA("BasePart") then
			local data = { part = obj, addedAt = tick() }
			table.insert(trackedSpawns, data)

			statusLabel.Text = "Status: 🔴 Spawn detected! (" .. #trackedSpawns .. " total)"
			statusLabel.TextColor3 = Color3.fromRGB(255, 120, 80)

			updatePrediction()

			-- Clean up when removed
			obj.AncestryChanged:Connect(function()
				if not obj:IsDescendantOf(game) then
					for i, d in ipairs(trackedSpawns) do
						if d.part == obj then
							table.remove(trackedSpawns, i)
							break
						end
					end
					updatePrediction()
					statusLabel.Text = "Status: Monitoring... (" .. #trackedSpawns .. " spawns)"
					statusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
				end
			end)
		end
	end)
end

-- Handle target input
