-- test
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
end)

local TARGET_NAME = "62_AM"
local SCAN_INTERVAL = 0.05      -- How often to scan (seconds) - faster = more responsive
local TELEPORT_THRESHOLD = 10   -- Stud jump to confirm a teleport occurred
local PRE_TELEPORT_DIST = 50    -- How close target must be to a spawn to pre-teleport you there

local function getAllSpawns()
    local spawns = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Spawn" and obj:IsA("BasePart") then
            table.insert(spawns, obj)
        end
    end
    return spawns
end

local function findClosestSpawn(targetPosition, spawns)
    local closest, minDist = nil, math.huge
    for _, spawn in ipairs(spawns) do
        local dist = (spawn.Position - targetPosition).Magnitude
        if dist < minDist then
            minDist = dist
            closest = spawn
        end
    end
    return closest
end

local function getTargetPlayer(targetName)
    local lowerTarget = targetName:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(lowerTarget, 1, true) or
           (p.DisplayName and p.DisplayName:lower():find(lowerTarget, 1, true)) then
            return p
        end
    end
    return nil
end

local function teleportToSpawn(spawn)
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if hrp and spawn then
        hrp.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        print("[Teleport] Pre-teleported to spawn: " .. spawn:GetFullName())
    end
end

local lastScan = 0
local lastTargetPos = nil
local currentLockedSpawn = nil  -- The spawn we've already moved to
local posHistory = {}
local HISTORY_SIZE = 5

RunService.Heartbeat:Connect(function(dt)
    lastScan += dt
    if lastScan < SCAN_INTERVAL then return end
    lastScan = 0

    local targetPlayer = getTargetPlayer(TARGET_NAME)
    if not targetPlayer then return end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        -- Target respawned/character removed, reset state
        lastTargetPos = nil
        posHistory = {}
        currentLockedSpawn = nil
        return
    end

    local currentPos = targetRoot.Position

    -- Build position history
    table.insert(posHistory, currentPos)
    if #posHistory > HISTORY_SIZE then
        table.remove(posHistory, 1)
    end

    local spawns = getAllSpawns()

    -- === PREDICTION: Watch if target is being PULLED toward a spawn ===
    -- This works by checking if the target is consistently getting closer to a specific spawn
    if #posHistory == HISTORY_SIZE then
        local oldPos = posHistory[1]
        local newPos = posHistory[#posHistory]

        -- Find which spawn the target is converging toward
        local convergingSpawn = nil
        local bestConverge = 0

        for _, spawn in ipairs(spawns) do
            local distOld = (oldPos - spawn.Position).Magnitude
            local distNew = (newPos - spawn.Position).Magnitude
            local closing = distOld - distNew -- positive = getting closer

            -- They are actively closing in on this spawn
            if closing > bestConverge and distNew < PRE_TELEPORT_DIST then
                bestConverge = closing
                convergingSpawn = spawn
            end
        end

        if convergingSpawn and convergingSpawn ~= currentLockedSpawn then
            print(string.format("[Teleport] Target converging on spawn (%.1f studs away) — moving ahead!", (newPos - convergingSpawn.Position).Magnitude))
            teleportToSpawn(convergingSpawn)
            currentLockedSpawn = convergingSpawn
        end
    end

    -- === FALLBACK: Detect instant teleport (large position jump) ===
    -- In case prediction missed it, still catch the teleport after it happens
    if lastTargetPos then
        local delta = (currentPos - lastTargetPos).Magnitude
        if delta > TELEPORT_THRESHOLD then
            local closestSpawn = findClosestSpawn(currentPos, spawns)
            if closestSpawn and closestSpawn ~= currentLockedSpawn then
                print(string.format("[Teleport] Teleport detected (%.1f studs) — catching up to spawn!", delta))
                teleportToSpawn(closestSpawn)
                currentLockedSpawn = closestSpawn
            end
        end
    end

    -- Reset locked spawn if target moves far away from it (they left that spawn)
    if currentLockedSpawn then
        local distFromLocked = (currentPos - currentLockedSpawn.Position).Magnitude
        if distFromLocked > PRE_TELEPORT_DIST * 2 then
            currentLockedSpawn = nil
        end
    end

    lastTargetPos = currentPos
end)

print("[Teleport] Script running. Tracking: " .. TARGET_NAME)
