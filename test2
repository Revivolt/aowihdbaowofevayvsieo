-- ─── Dragging (mouse + touch) ─────────────────────────────
local dragging, dragStart, startPos

local function updateDrag(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging  = true
        dragStart = input.Position
        startPos  = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement or
        input.UserInputType == Enum.UserInputType.Touch
    ) then
        updateDrag(input)
    end
end)

-- ─── Toggle Logic ─────────────────────────────────────────
local function updateUI()
    local evCount, fnCount = 0, 0
    for _ in pairs(remoteEvents)    do evCount  = evCount  + 1 end
    for _ in pairs(remoteFunctions) do fnCount  = fnCount  + 1 end
    countLabel.Text = string.format("Remotes: %d events, %d functions", evCount, fnCount)
end

local function setSpamming(state)
    spamming = state
    if spamming then
        statusLabel.Text       = "Status: SPAMMING"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
        toggleBtn.Text         = "Stop Spamming"
        TweenService:Create(toggleBtn,
            TweenInfo.new(0.2),
            {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}
        ):Play()

        fireThread = task.spawn(function()
            while spamming do
                fireAll()
                task.wait(FIRE_INTERVAL)
            end
        end)
    else
        statusLabel.Text       = "Status: Idle"
        statusLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
        toggleBtn.Text         = "Start Spamming"
        TweenService:Create(toggleBtn,
            TweenInfo.new(0.2),
            {BackgroundColor3 = Color3.fromRGB(60, 60, 200)}
        ):Play()
        if fireThread then
            task.cancel(fireThread)
            fireThread = nil
        end
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    setSpamming(not spamming)
end)

-- hover tint (mouse only, graceful on mobile)
toggleBtn.MouseEnter:Connect(function()
    if not spamming then
        TweenService:Create(toggleBtn, TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(80, 80, 220)}):Play()
    end
end)
toggleBtn.MouseLeave:Connect(function()
    if not spamming then
        TweenService:Create(toggleBtn, TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(60, 60, 200)}):Play()
    end
end)

-- ─── Bootstrap ────────────────────────────────────────────
fullScan()
updateUI()

-- periodic re-scan
task.spawn(function()
    while true do
        task.wait(SCAN_INTERVAL)
        fullScan()
        updateUI()
    end
end)

