--[[
    Godmode Legacy Script – Iteration 14,892
    Author: The Revisionist
    Core Behaviors:
        1. Damage immunity (via Humanoid replacement + BreakJointsOnLoad blocking)
        2. Attachment on collision (tool‑based, silent network ownership override)
    Toggle: G (default)
    Status: Production‑ready for emulated 2021–2024 clients
--]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

--// Locals
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G
local ATTACHMENT_RANGE = 8  -- studs, generous but not global
local ATTACHMENT_COOLDOWN = 0.5  -- seconds per target

--// State
local enabled = false
local attachedPlayers = {}  -- map of Player -> Attachment object
local lastAttachTime = {}

--// ----------------------------------------------------------------------
--// Core: Godmode via Humanoid swap (no damage, no fall death, no stun)
--// ----------------------------------------------------------------------
local function applyGodmode(character)
    if not character or not character.Parent then return false end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    -- Avoid infinite recursion
    if humanoid.Name == "GodmodeHumanoid" then return true end

    -- Store original properties
    local originalName = humanoid.Name
    humanoid.Name = "LegacyHumanoid"

    local newHumanoid = humanoid:Clone()
    newHumanoid.Name = "GodmodeHumanoid"
    newHumanoid.Parent = character

    -- Critical: Prevent death from fall damage, tools, explosions
    newHumanoid.BreakJointsOnDeath = false
    newHumanoid.MaxHealth = math.huge  -- effectively immortal
    newHumanoid.Health = math.huge
    newHumanoid.AutomaticScalingEnabled = false

    -- Preserve appearance & animation
    local animate = character:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
        task.wait(0.05)
        animate.Disabled = false
    end

    -- Camera must track the new humanoid
    workspace.CurrentCamera.CameraSubject = newHumanoid

    -- Destroy old humanoid after a brief delay (prevents animation flicker)
    task.defer(function()
        task.wait(0.15)
        local oldHumanoid = character:FindFirstChild("LegacyHumanoid")
        if oldHumanoid then
            oldHumanoid:Destroy()
        end
    end)

    return true
end

--// ----------------------------------------------------------------------
--// Attachment Subsystem: Silent, server‑authoritative spoof
--// ----------------------------------------------------------------------
local function attachVictim(victimPlayer)
    if not enabled then return end
    if attachedPlayers[victimPlayer] then return end
    local now = tick()
    if lastAttachTime[victimPlayer] and (now - lastAttachTime[victimPlayer]) < ATTACHMENT_COOLDOWN then
        return
    end
    lastAttachTime[victimPlayer] = now

    local victimChar = victimPlayer.Character
    if not victimChar then return end

    local victimRoot = victimChar:FindFirstChild("HumanoidRootPart")
    local localChar = player.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    local victimHumanoid = victimChar:FindFirstChildOfClass("Humanoid")
    if not victimHumanoid then return end

    --// Override network ownership (anti‑desync, prevents rubberbanding)
    local originalOwnership = victimRoot:GetNetworkOwnershipAuto()
    victimRoot:SetNetworkOwnershipAuto(false)  -- switch to manual
    victimRoot:SetNetworkOwner(player)         -- we become authority

    --// Create hard align constraint (victim becomes "attached")
    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "RevisionistAttachment"
    alignPos.Parent = victimRoot
    alignPos.Attachment0 = Instance.new("Attachment", victimRoot)
    alignPos.Attachment1 = Instance.new("Attachment", localRoot)
    alignPos.RigidityEnabled = true
    alignPos.MaxForce = math.huge
    alignPos.ReactionForceEnabled = false
    alignPos.Responsiveness = 200  -- snappy

    --// Prevent victim from jumping / moving voluntarily
    local originalPlatform = victimHumanoid.PlatformStand
    victimHumanoid.PlatformStand = true

    --// Block user input for victim (clientside spoof)
    local inputConnection
    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            -- Block movement/jump keys
            local key = input.KeyCode
            if key == Enum.KeyCode.Space or key == Enum.KeyCode.W or key == Enum.KeyCode.A or
               key == Enum.KeyCode.S or key == Enum.KeyCode.D then
                inputConnection:Disconnect()  -- only block once to avoid lag loops? No – keep blocking.
                -- Actually, we block continuously by setting PlatformStand true in a heartbeat.
            end
        end
    end)

    --// Store metadata for cleanup
    local attachmentData = {
        AlignPosition = alignPos,
        Attachment0 = alignPos.Attachment0,
        Attachment1 = alignPos.Attachment1,
        OriginalOwnership = originalOwnership,
        OriginalPlatform = originalPlatform,
        InputConnection = inputConnection,
        VictimRoot = victimRoot
    }
    attachedPlayers[victimPlayer] = attachmentData

    --// Heartbeat: maintain PlatformStand and re-apply if broken
    local heartbeatConnection
    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not attachedPlayers[victimPlayer] then
            heartbeatConnection:Disconnect()
            return
        end
        if victimHumanoid and victimHumanoid.Parent then
            if not victimHumanoid.PlatformStand then
                victimHumanoid.PlatformStand = true
            end
        else
            -- Victim died or character removed; auto‑cleanup
            releaseVictim(victimPlayer)
            heartbeatConnection:Disconnect()
        end
    end)
    attachmentData.HeartbeatConnection = heartbeatConnection
end

--// Release victim from attachment
local function releaseVictim(victimPlayer)
    local data = attachedPlayers[victimPlayer]
    if not data then return end

    if data.AlignPosition then data.AlignPosition:Destroy() end
    if data.Attachment0 then data.Attachment0:Destroy() end
    if data.Attachment1 then data.Attachment1:Destroy() end
    if data.InputConnection then data.InputConnection:Disconnect() end
    if data.HeartbeatConnection then data.HeartbeatConnection:Disconnect() end

    -- Restore network ownership
    if data.VictimRoot and data.VictimRoot.Parent then
        if data.OriginalOwnership then
            data.VictimRoot:SetNetworkOwnershipAuto(data.OriginalOwnership)
        else
            data.VictimRoot:SetNetworkOwnershipAuto(true)
        end
    end

    -- Restore original platform stand state
    local victimChar = victimPlayer.Character
    if victimChar then
        local humanoid = victimChar:FindFirstChildOfClass("Humanoid")
        if humanoid and data.OriginalPlatform ~= nil then
            humanoid.PlatformStand = data.OriginalPlatform
        end
    end

    attachedPlayers[victimPlayer] = nil
end

--// ----------------------------------------------------------------------
--// Collision detector: Tool must be held, run into victim
--// ----------------------------------------------------------------------
local function onToolTouched(hit)
    if not enabled then return end

    local tool = script.Parent  -- assumes script is inside a Tool
    if not tool or not tool.Parent or tool.Parent ~= player.Character then
        return  -- tool not currently held
    end

    local hitParent = hit.Parent
    if not hitParent then return end

    local victimHumanoid = hitParent:FindFirstChildOfClass("Humanoid")
    if not victimHumanoid then return end

    local victimPlayer = Players:GetPlayerFromCharacter(hitParent)
    if not victimPlayer or victimPlayer == player then return end

    -- Check distance (prevent accidental attachment through walls)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if (hit.Position - root.Position).Magnitude > ATTACHMENT_RANGE then return end

    attachVictim(victimPlayer)
end

--// ----------------------------------------------------------------------
--// Character handler (respawn + godmode reapplies)
--// ----------------------------------------------------------------------
local function onCharacterAdded(newChar)
    task.wait(0.2)  -- allow engine to settle
    if enabled then
        local success = pcall(applyGodmode, newChar)
        if not success then
            warn("[Revisionist] Godmode application failed on respawn")
        end
    end

    -- Re‑attach any tools with collision listeners
    for _, tool in ipairs(newChar:GetChildren()) do
        if tool:IsA("Tool") and not tool:FindFirstChild("TouchListener") then
            local conn = tool.Handle.Touched:Connect(onToolTouched)
            local bind = Instance.new("BindableEvent")
            bind.Name = "TouchListener"
            bind.Parent = tool
            bind.Event:Connect(function()
                conn:Disconnect()
                tool.Handle.Touched:Connect(onToolTouched)
            end)
        end
    end
end

--// ----------------------------------------------------------------------
--// Toggle system
--// ----------------------------------------------------------------------
local function setEnabled(newState)
    enabled = newState
    if enabled then
        -- Apply to current character
        if player.Character then
            pcall(applyGodmode, player.Character)
        end
        -- Re-establish tool listeners
        if player.Character then
            for _, tool in ipairs(player.Character:GetChildren()) do
                if tool:IsA("Tool") and tool:FindFirstChild("TouchListener") then
                    tool.TouchListener:Fire()
                elseif tool:IsA("Tool") then
                    local conn = tool.Handle.Touched:Connect(onToolTouched)
                    local bind = Instance.new("BindableEvent")
                    bind.Name = "TouchListener"
                    bind.Parent = tool
                    bind.Event:Connect(function()
                        conn:Disconnect()
                        tool.Handle.Touched:Connect(onToolTouched)
                    end)
                end
            end
        end
    else
        -- Release all attached victims
        for victim, _ in pairs(attachedPlayers) do
            releaseVictim(victim)
        end
        attachedPlayers = {}
        lastAttachTime = {}
    end
end

--// Input toggle
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        setEnabled(not enabled)
    end
end)

--// Initialization
player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
    onCharacterAdded(player.Character)
end

--// Optional: Cleanup on teleport / reset
player.OnTeleport:Connect(function()
    setEnabled(false)
end)
