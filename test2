-- test
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local activeConnection = nil

local function startPermanentPhysics(character)
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")

    if activeConnection then activeConnection:Disconnect() end

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    root.CanCollide = false

    activeConnection = RunService.Heartbeat:Connect(function(dt)
        if not root or not root.Parent then
            if activeConnection then activeConnection:Disconnect() end
            return
        end

        local oldV = root.AssemblyLinearVelocity

        -- Spike only Y, leave XZ untouched so WASD works.
        root.AssemblyLinearVelocity = Vector3.new(
            oldV.X,
            oldV.Y * 500 + 500,
            oldV.Z
        )

        RunService.RenderStepped:Wait()

        -- Restore full original vector to kill the spike.
        root.AssemblyLinearVelocity = oldV

        RunService.Stepped:Wait()

        local curV = root.AssemblyLinearVelocity

        -- Only compensate gravity when Y velocity is negative (falling).
        -- If the player just jumped (curV.Y > 0), do nothing — let the
        -- arc play out naturally so jump feels normal and no float occurs.
        if curV.Y < 0 then
            local compensated = curV.Y + workspace.Gravity * dt
            -- Clamp so we never accidentally push Y above 0 here.
            root.AssemblyLinearVelocity = Vector3.new(
                curV.X,
                math.min(compensated, 0),
                curV.Z
            )
        end
    end)
end

player.CharacterAdded:Connect(function(newChar)
    task.wait(1.5)
    startPermanentPhysics(newChar)
end)

if player.Character then
    task.spawn(function() startPermanentPhysics(player.Character) end)
end
