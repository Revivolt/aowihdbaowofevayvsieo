local Lighting     = game:GetService("Lighting")
local Players      = game:GetService("Players")
local lp           = Players.LocalPlayer

-- ─────────────────────────────────────────
-- 1. UNLOCK FPS CAP
-- ─────────────────────────────────────────
local function unlockFPS()
    if setfpscap then
        setfpscap(0)
    elseif syn and syn.set_fps_cap then
        syn.set_fps_cap(0)
    end
end
unlockFPS()

-- ─────────────────────────────────────────
-- 2. RENDERING QUALITY — minimum
-- ─────────────────────────────────────────
settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

-- ─────────────────────────────────────────
-- 3. LIGHTING — kill expensive effects
-- ─────────────────────────────────────────
Lighting.GlobalShadows  = false
Lighting.FogEnd         = 100000
Lighting.FogStart       = 99999
Lighting.Brightness     = 2
Lighting.ClockTime      = 14
Lighting.Ambient        = Color3.fromRGB(178, 178, 178)
Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)

for _, effect in ipairs(Lighting:GetChildren()) do
    if effect:IsA("PostEffect") or effect:IsA("Sky") then
        effect:Destroy()
    end
end

-- ─────────────────────────────────────────
-- 4. TEXTURE QUALITY NUKER (NEW)
-- Strips texture IDs, SurfaceAppearances,
-- forces SmoothPlastic + lowest RenderFidelity
-- ─────────────────────────────────────────
local function degradeTextures(instance)
    for _, v in ipairs(instance:GetDescendants()) do

        -- Kill SurfaceAppearance (PBR textures — most expensive)
        if v:IsA("SurfaceAppearance") then
            v:Destroy()

        -- Strip Decal / Texture transparency
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1

        -- MeshPart: blank texture, lowest fidelity, smooth material
        elseif v:IsA("MeshPart") then
            pcall(function()
                v.TextureID      = ""
                v.RenderFidelity = Enum.RenderFidelity.Automatic
                v.Material       = Enum.Material.SmoothPlastic
                v.CastShadow     = false
            end)

        -- SpecialMesh: blank texture
        elseif v:IsA("SpecialMesh") then
            pcall(function()
                v.TextureId = ""
            end)

        -- All other BaseParts: smooth material, no shadow
        elseif v:IsA("BasePart") then
            pcall(function()
                v.Material       = Enum.Material.SmoothPlastic
                v.RenderFidelity = Enum.RenderFidelity.Automatic
                v.CastShadow     = false
            end)
        end
    end
end

degradeTextures(workspace)

-- Hook new instances as they stream/spawn in
workspace.DescendantAdded:Connect(function(v)
    if v:IsA("SurfaceAppearance") then
        v:Destroy()
    elseif v:IsA("Decal") or v:IsA("Texture") then
        v.Transparency = 1
    elseif v:IsA("MeshPart") then
        pcall(function()
            v.TextureID      = ""
            v.RenderFidelity = Enum.RenderFidelity.Automatic
            v.Material       = Enum.Material.SmoothPlastic
            v.CastShadow     = false
        end)
    elseif v:IsA("SpecialMesh") then
        pcall(function() v.TextureId = "" end)
    elseif v:IsA("BasePart") then
        pcall(function()
            v.Material       = Enum.Material.SmoothPlastic
            v.RenderFidelity = Enum.RenderFidelity.Automatic
            v.CastShadow     = false
        end)
    end
end)

-- ─────────────────────────────────────────
-- 5. PARTICLES & BEAMS
-- ─────────────────────────────────────────
local function killParticles(instance)
    for _, v in ipairs(instance:GetDescendants()) do
        if  v:IsA("ParticleEmitter")
         or v:IsA("Smoke")
         or v:IsA("Fire")
         or v:IsA("Sparkles")
        then
            v.Enabled = false
        elseif v:IsA("Trail") then
            v.Lifetime = NumberRange.new(0)
        elseif v:IsA("Beam") then
            v.Segments = 1
        end
    end
end

killParticles(workspace)

workspace.DescendantAdded:Connect(function(v)
    if  v:IsA("ParticleEmitter")
     or v:IsA("Smoke")
     or v:IsA("Fire")
     or v:IsA("Sparkles")
    then
        v.Enabled = false
    elseif v:IsA("Trail") then
        v.Lifetime = NumberRange.new(0)
    elseif v:IsA("Beam") then
        v.Segments = 1
    end
end)

-- ─────────────────────────────────────────
-- 6. CHARACTER — strip accessory textures
-- ─────────────────────────────────────────
local function optimizeChar(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Accessory") then
            local handle = v:FindFirstChild("Handle")
            if handle then
                local sa = handle:FindFirstChildOfClass("SurfaceAppearance")
                if sa then sa:Destroy() end
                local sp = handle:FindFirstChildOfClass("SpecialMesh")
                if sp then sp.TextureId = "" end
            end
        elseif v:IsA("MeshPart") then
            pcall(function()
                v.TextureID      = ""
                v.RenderFidelity = Enum.RenderFidelity.Automatic
                v.Material       = Enum.Material.SmoothPlastic
            end)
        end
    end
end

optimizeChar(lp.Character)
lp.CharacterAdded:Connect(optimizeChar)

-- ─────────────────────────────────────────
-- 7. SOUNDS — mute everything
-- ─────────────────────────────────────────
local function muteSounds(instance)
    for _, v in ipairs(instance:GetDescendants()) do
        if v:IsA("Sound") then v.Volume = 0 end
    end
end

muteSounds(workspace)

workspace.DescendantAdded:Connect(function(v)
    if v:IsA("Sound") then v.Volume = 0 end
end)

print("[FPS Boost] Done. Texture quality nuked + all optimizations applied.")
