--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G
local ATTACH_KEY = Enum.KeyCode.T          -- Manual attach on held tool
local AUTO_ATTACH = true                    -- Run into players to attach
local STUDIO_SAFE = false                   -- Set true to auto-disable in Studio
local PRESERVE_ANIMATIONS = true            -- Attempt to keep custom anims
local ATTACH_DISTANCE = 8                   -- Studs for auto-attach
local DEBRIS_CLEANUP_DELAY = 2              -- Seconds before old parts delete

--// State
local enabled = false
local attachedVictims = {}                  -- Table of attached player characters
local currentTool = nil
local attachmentConnection = nil
local humanoidSwapDebounce = false

--// Utility: Safe print (suppresses if game tries to log to console)
local function debugLog(msg)
    if not RunService:IsStudio() then
        -- In production, do nothing. Silence is survival.
        -- print("[Vellum] " .. msg)  -- Uncomment only for testing on dead servers
    end
end

--// Core: Humanoid Replacement (The Immortality Engine)
local function replaceHumanoid(character)
    if humanoidSwapDebounce then return false end
    humanoidSwapDebounce = true
    
    local success = false
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid and humanoid.Name ~= "OldHumanoid" and humanoid.Health > 0 then
        -- Preserve original health and properties
        local originalHealth = humanoid.Health
        local originalMaxHealth = humanoid.MaxHealth
        local originalWalkSpeed = humanoid.WalkSpeed
        local originalJumpPower = humanoid.JumpPower
        
        -- Rename original
        humanoid.Name = "OldHumanoid"
        
        -- Clone and configure new humanoid
        local newHumanoid = humanoid:Clone()
        newHumanoid.Parent = character
        newHumanoid.Name = "Humanoid"
        newHumanoid.Health = originalHealth
        newHumanoid.MaxHealth = originalMaxHealth
        newHumanoid.WalkSpeed = originalWalkSpeed
        newHumanoid.JumpPower = originalJumpPower
        newHumanoid.BreakJointsOnLoad = false  -- Critical: Prevents limb explosion
        
        -- Wait for engine to register new humanoid
        local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if rootPart then
            -- Force camera to attach to new humanoid
            workspace.CurrentCamera.CameraSubject = newHumanoid
        end
        
        task.wait(0.08)  -- Optimized from 0.1 to reduce desync window
        
        -- Destroy old humanoid
        if character:FindFirstChild("OldHumanoid") then
            character.OldHumanoid:Destroy()
        end
        
        -- Reset animation track if desired
        if PRESERVE_ANIMATIONS then
            local animate = character:FindFirstChild("Animate")
            if animate then
                animate.Disabled = true
                task.wait(0.05)
                animate.Disabled = false
            end
        end
        
        success = true
        debugLog("Humanoid replaced for " .. character.Name)
    end
    
    task.wait(0.1)
    humanoidSwapDebounce = false
    return success
end

--// Attachment System: Bind victim to attacker's character
local function attachPlayerToMe(targetCharacter)
    if not enabled or not player.Character then return false end
    if not targetCharacter or not targetCharacter.Parent then return false end
    if targetCharacter == player.Character then return false end
    if attachedVictims[targetCharacter] then return false end
    
    local victimHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    if not victimHumanoid or victimHumanoid.Health <= 0 then return false end
    
    local attackerRoot = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Torso")
    local victimRoot = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
    
    if not attackerRoot or not victimRoot then return false end
    
    -- Store original parent for later cleanup
    local originalParent = targetCharacter.Parent
    local originalCFrame = victimRoot.CFrame
    
    -- Reparent victim into attacker's character model
    targetCharacter.Parent = player.Character
    
    -- Weld victim to attacker's root part
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = attackerRoot
    weld.Part1 = victimRoot
    weld.Parent = targetCharacter
    
    -- Disable victim's controls (optional, prevents struggling)
    victimHumanoid.PlatformStand = true
    
    -- Store metadata
    attachedVictims[targetCharacter] = {
        weld = weld,
        originalParent = originalParent,
        originalCFrame = originalCFrame,
        humanoid = victimHumanoid,
        timestamp = tick()
    }
    
    debugLog("Attached " .. targetCharacter.Name .. " to " .. player.Character.Name)
    return true
end

--// Detach a specific victim
local function detachPlayer(targetCharacter)
    local data = attachedVictims[targetCharacter]
    if not data then return end
    
    -- Clean up weld
    if data.weld then
        data.weld:Destroy()
    end
    
    -- Restore victim to world
    if data.originalParent and targetCharacter.Parent == player.Character then
        targetCharacter.Parent = data.originalParent
        
        -- Restore position (slightly offset to prevent clipping)
        local root = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
        if root and data.originalCFrame then
            root.CFrame = data.originalCFrame * CFrame.new(0, 2, 3)
        end
        
        -- Restore controls
        if data.humanoid then
            data.humanoid.PlatformStand = false
        end
    end
    
    attachedVictims[targetCharacter] = nil
    debugLog("Detached " .. targetCharacter.Name)
end

--// Detach all victims
local function detachAll()
    for victim, _ in pairs(attachedVictims) do
        if victim and victim.Parent then
            detachPlayer(victim)
        end
    end
    attachedVictims = {}
end

--// Auto-Attach via collision (the classic "run into them with a tool")
local function setupToolAttachment(tool)
    if not tool or not tool:IsA("Tool") then return end
    
    -- Remove previous connection if exists
    if attachmentConnection then
        attachmentConnection:Disconnect()
        attachmentConnection = nil
    end
    
    -- Find handle or use tool itself
    local hitPart = tool:FindFirstChild("Handle") or tool
    
    attachmentConnection = hitPart.Touched:Connect(function(otherPart)
        if not enabled or not AUTO_ATTACH then return end
        if not player.Character or not player.Character.Parent then return end
        
        local otherCharacter = otherPart:FindFirstAncestorOfClass("Model")
        if not otherCharacter then return end
        
        local otherHumanoid = otherCharacter:FindFirstChildOfClass("Humanoid")
        if not otherHumanoid or otherHumanoid.Health <= 0 then return end
        
        -- Check distance
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - otherPart.Position).Magnitude > ATTACH_DISTANCE then return end
        
        attachPlayerToMe(otherCharacter)
    end)
end

--// Monitor equipped tool
local function onToolEquipped(tool)
    currentTool = tool
    if enabled then
        setupToolAttachment(tool)
    end
end

local function onToolUnequipped()
    if attachmentConnection then
        attachmentConnection:Disconnect()
        attachmentConnection = nil
    end
    currentTool = nil
end

--// Character handler (on respawn or initial spawn)
local function onCharacterAdded(character)
    debugLog("Character added: " .. character.Name)
    
    -- Wait for character to stabilize
    task.wait(0.5)
    
    if enabled then
        -- Replace humanoid for immortality
        pcall(replaceHumanoid, character)
        
        -- Re-attach any tools that might have been equipped before
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            onToolEquipped(tool)
        end
    end
    
    -- Reconnect tool events
    character.ChildAdded:Connect(function(child)
        if enabled and child:IsA("Tool") then
            onToolEquipped(child)
        end
    end)
end

--// Anti-reset persistence (prevents server-forced resets)
local function antiReset()
    if not enabled then return end
    if not player.Character then return end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        -- Player died? Force re-run of godmode on respawn
        debugLog("Death detected. Waiting for respawn.")
    end
end

--// Toggle godmode on/off
local function toggleGodmode()
    enabled = not enabled
    
    if enabled then
        debugLog("Godmode ENABLED")
        
        -- Apply to current character if exists
        if player.Character and player.Character.Parent then
            pcall(replaceHumanoid, player.Character)
            
            -- Setup attachment for currently held tool
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then
                setupToolAttachment(tool)
            end
        end
        
        -- Start anti-reset monitor
        if not antiResetConnection then
            antiResetConnection = game:GetService("Players").PlayerAdded:Connect(function()
                task.wait(1)
                if enabled and player.Character then
                    pcall(replaceHumanoid, player.Character)
                end
            end)
        end
    else
        debugLog("Godmode DISABLED")
        
        -- Detach all victims
        detachAll()
        
        -- Clean up attachment connections
        if attachmentConnection then
            attachmentConnection:Disconnect()
            attachmentConnection = nil
        end
        
        -- Restore original humanoid if possible? (Complex, requires storing original)
        -- For now, just leave as-is
    end
end

--// Manual attach keybind (T by default)
local function onManualAttach()
    if not enabled then return end
    if not player.Character then return end
    
    local target = mouse.Target
    if not target then return end
    
    local targetCharacter = target:FindFirstAncestorOfClass("Model")
    if targetCharacter and targetCharacter ~= player.Character then
        attachPlayerToMe(targetCharacter)
    end
end

--// Input handling
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == TOGGLE_KEY then
        toggleGodmode()
    elseif input.KeyCode == ATTACH_KEY then
        onManualAttach()
    end
end)

--// Character respawn listener
player.CharacterAdded:Connect(onCharacterAdded)

--// Tool events on current character
if player.Character then
    player.Character.ChildAdded:Connect(function(child)
        if enabled and child:IsA("Tool") then
            onToolEquipped(child)
        end
    end)
end

--// Studio safety (prevents accidental execution in Roblox Studio)
if STUDIO_SAFE and RunService:IsStudio() then
    enabled = false
    debugLog("Studio mode detected. Script disabled.")
    return
end

--// Initialization complete
debugLog("Godmode v5.0.0 loaded. Press " .. tostring(TOGGLE_KEY) .. " to toggle. Press " .. tostring(ATTACH_KEY) .. " to attach target.")

--// Optional: GUI notification (minimal, doesn't create visible UI unless StarterGui allows)
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Vector Online",
        Text = "Godmode ready. " .. tostring(TOGGLE_KEY.Name) .. " to toggle.",
        Duration = 2
    })
end)

--// Garbage collection for detached victims (prevents memory leak)
task.spawn(function()
    while true do
        task.wait(DEBRIS_CLEANUP_DELAY)
        for victim, data in pairs(attachedVictims) do
            -- Remove victims that have been attached for too long or are dead
            if not victim or not victim.Parent or (data.humanoid and data.humanoid.Health <= 0) then
                detachPlayer(victim)
            end
        end
    end
end)
