	if not enterPressed then return end
	local name = targetInput.Text
	local found = findPlayer(name)
	if found then
		targetPlayer = found
		targetLabel.Text = "Target: ✅ " .. found.Name
		statusLabel.Text = "Status: Monitoring..."
		statusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
		updatePrediction()
	else
		targetLabel.Text = "Target: ❌ Not found"
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	end
end)

