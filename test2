local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid    = Character:WaitForChild("Humanoid")

-- Re-grab humanoid on respawn
LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    Humanoid  = char:WaitForChild("Humanoid")
end)

-- ─── CONFIG ───────────────────────────────────────────────────────────────
local SCALES = {
    { name = "BodyHeightScale",     label = "Height",      min = 0.1, max = 3.0, default = 0.5  },
    { name = "BodyWidthScale",      label = "Width",       min = 0.1, max = 3.0, default = 2.0  },
    { name = "BodyDepthScale",      label = "Depth",       min = 0.1, max = 3.0, default = 1.0  },
    { name = "BodyProportionScale", label = "Proportion",  min = 0.1, max = 2.0, default = 1.0  },
    { name = "HeadScale",           label = "Head",        min = 0.1, max = 3.0, default = 1.0  },
}

local TRACK_W   = 200
local THUMB_W   = 14
local ROW_H     = 38
local PAD       = 12
local WIN_W     = TRACK_W + 90 + PAD * 2   -- label + track + value label
local WIN_H     = PAD * 2 + 30 + #SCALES * ROW_H + 10

-- ─── BUILD GUI ────────────────────────────────────────────────────────────
local screenGui = Instance.new("ScreenGui")
screenGui.Name            = "ScaleGUI"
screenGui.ResetOnSpawn    = false
screenGui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
screenGui.Parent          = LocalPlayer:WaitForChild("PlayerGui")

local win = Instance.new("Frame")
win.Size            = UDim2.fromOffset(WIN_W, WIN_H)
win.Position        = UDim2.fromOffset(20, 120)
win.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
win.BorderSizePixel = 0
win.Active          = true   -- needed for dragging
win.Parent          = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent       = win

-- Title bar
local titleBar = Instance.new("Frame")
titleBar.Size              = UDim2.new(1, 0, 0, 28)
titleBar.BackgroundColor3  = Color3.fromRGB(30, 30, 38)
titleBar.BorderSizePixel   = 0
titleBar.Parent            = win

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent       = titleBar

local titleLabel = Instance.new("TextLabel")
titleLabel.Size              = UDim2.new(1, -8, 1, 0)
titleLabel.Position          = UDim2.fromOffset(8, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text              = "Scale Editor"
titleLabel.TextColor3        = Color3.fromRGB(220, 220, 255)
titleLabel.TextSize          = 13
titleLabel.Font               = Enum.Font.GothamBold
titleLabel.TextXAlignment     = Enum.TextXAlignment.Left
titleLabel.Parent             = titleBar

-- Drag logic for the window
do
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = win.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            win.Position = UDim2.fromOffset(
                startPos.X.Offset + delta.X,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- ─── HELPER: apply scale ──────────────────────────────────────────────────
local function applyScale(scaleName, value)
    local obj = Humanoid and Humanoid:FindFirstChild(scaleName)
    if not obj then return end
    obj.Value = value
    -- flush engine pipeline
    local orig = Humanoid.HipHeight
    Humanoid.HipHeight = orig + 0.001
    task.defer(function()
        if Humanoid then
            Humanoid.HipHeight = orig
        end
    end)
end

-- ─── BUILD SLIDERS ────────────────────────────────────────────────────────
for i, entry in ipairs(SCALES) do
    local y = 30 + PAD + (i - 1) * ROW_H

    -- Label
    local lbl = Instance.new("TextLabel")
    lbl.Size                  = UDim2.fromOffset(80, ROW_H - 6)
    lbl.Position              = UDim2.fromOffset(PAD, y)
    lbl.BackgroundTransparency = 1
    lbl.Text                  = entry.label
    lbl.TextColor3            = Color3.fromRGB(180, 180, 210)
    lbl.TextSize              = 12
    lbl.Font                  = Enum.Font.Gotham
    lbl.TextXAlignment        = Enum.TextXAlignment.Left
    lbl.Parent                = win

    -- Track background
    local track = Instance.new("Frame")
    track.Size              = UDim2.fromOffset(TRACK_W, 6)
    track.Position          = UDim2.fromOffset(PAD + 82, y + (ROW_H - 6) / 2 - 3)
    track.BackgroundColor3  = Color3.fromRGB(50, 50, 65)
    track.BorderSizePixel   = 0
    track.Parent            = win
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    -- Fill bar
    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 140, 255)
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    -- Thumb
    local thumb = Instance.new("TextButton")
    thumb.Size              = UDim2.fromOffset(THUMB_W, THUMB_W)
    thumb.BackgroundColor3  = Color3.fromRGB(200, 210, 255)
    thumb.BorderSizePixel   = 0
    thumb.Text              = ""
    thumb.ZIndex            = 5
    thumb.Parent            = track
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    -- Value label
    local valLbl = Instance.new("TextLabel")
    valLbl.Size                   = UDim2.fromOffset(36, ROW_H - 6)
    valLbl.Position               = UDim2.fromOffset(PAD + 82 + TRACK_W + 6, y)
    valLbl.BackgroundTransparency = 1
    valLbl.TextColor3             = Color3.fromRGB(220, 220, 255)
    valLbl.TextSize               = 11
    valLbl.Font                   = Enum.Font.GothamMono
    valLbl.TextXAlignment         = Enum.TextXAlignment.Left
    valLbl.Parent                 = win

    -- ── set thumb position from a 0-1 alpha ──
    local function setAlpha(alpha)
        alpha = math.clamp(alpha, 0, 1)
        local value = entry.min + (entry.max - entry.min) * alpha
        local thumbX = alpha * (TRACK_W - THUMB_W)
        thumb.Position  = UDim2.fromOffset(thumbX, -(THUMB_W - 6) / 2)
        fill.Size       = UDim2.fromOffset(thumbX + THUMB_W / 2, 6)
        valLbl.Text     = string.format("%.2f", value)
        applyScale(entry.name, value)
    end

    -- init
    local initAlpha = (entry.default - entry.min) / (entry.max - entry.min)
    setAlpha(initAlpha)

    -- drag
    local sliding = false
    thumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            local trackAbs = track.AbsolutePosition
            local mouseX   = input.Position.X
            local alpha    = (mouseX - trackAbs.X - THUMB_W / 2) / (TRACK_W - THUMB_W)
            setAlpha(alpha)
        end
    end)

    -- click anywhere on track to jump
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local trackAbs = track.AbsolutePosition
            local alpha    = (input.Position.X - trackAbs.X - THUMB_W / 2) / (TRACK_W - THUMB_W)
            setAlpha(alpha)
        end
    end)
end
