-- UIListLayout for player buttons
local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.SortOrder = Enum.SortOrder.Name
listLayout.Parent = listFrame

-- Function to refresh player list UI
local function refreshPlayerList()
    -- Clear existing buttons
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    updatePlayerList()
    
    -- Create button for each player
    for _, player in ipairs(playerList) do
        local playerButton = Instance.new("TextButton")
        playerButton.Size = UDim2.new(1, -10, 0, 40)
        playerButton.Text = player.Name
        playerButton.BackgroundColor3 = Color3.new(0.3, 0.3, 0.8)
        playerButton.TextColor3 = Color3.new(1, 1, 1)
        playerButton.Font = Enum.Font.SourceSans
        playerButton.TextSize = 16
        playerButton.Parent = listFrame
        
        -- Store player reference
        playerButton.Player = player
        
        playerButton.MouseButton1Click:Connect(function()
            bringPlayerToMe(playerButton.Player)
            
            -- Visual feedback
            playerButton.BackgroundColor3 = Color3.new(0, 1, 0)
            task.wait(0.2)
            playerButton.BackgroundColor3 = Color3.new(0.3, 0.3, 0.8)
        end)
    end
    
    -- Update canvas size
    local count = #playerList
    listFrame.CanvasSize = UDim2.new(0, 0, 0, count * 45 + 10)
end

-- Refresh button
local refreshButton = Instance.new("TextButton")
refreshButton.Size = UDim2.new(1, -20, 0, 35)
refreshButton.Position = UDim2.new(0, 10, 1, -45)
refreshButton.Text = "Refresh Player List"
refreshButton.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
refreshButton.TextColor3 = Color3.new(1, 1, 1)
refreshButton.Font = Enum.Font.SourceSans
refreshButton.TextSize = 14
refreshButton.Parent = mainFrame

refreshButton.MouseButton1Click:Connect(refreshPlayerList)

-- Hotkey: Press 'B' to bring the nearest player to you
local userInputService = game:GetService("UserInputService")

userInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.B then
        updatePlayerList()
        if #playerList > 0 then
            -- Bring the first player in the list
            bringPlayerToMe(playerList[1])
        else
            print("No other players found to bring")
        end
    end
end)

-- Update player list when players join/leave
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

-- Initial refresh
refreshPlayerList()

print("Script loaded! Click a player name to bring them to your location, or press 'B' to bring the first player")
