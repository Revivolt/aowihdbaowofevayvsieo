-- test
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- Update character reference on respawn
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
end)

local TARGET_NAME = "62_AM"
local SCAN_INTERVAL = 0.1       -- How often to scan (seconds)
local TELEPORT_THRESHOLD = 10   -- Distance change to consider a teleport happening
local POSITION_HISTORY_SIZE = 3 -- Frames to track for movement prediction

local function getAllSpawns()
    local spawns = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Spawn" and obj:IsA("BasePart") then
            table.insert(spawns, obj)
        end
    end
    return spawns
end

local function findClosestSpawn(targetPosition, spawns)
    local closest, minDist = nil, math.huge
    for _, spawn in ipairs(spawns) do
        local dist = (spawn.Position - targetPosition).Magnitude
        if dist < minDist then
            minDist = dist
            closest = spawn
        end
    end
    return closest
end

local function getTargetPlayer(targetName)
    local lowerTarget = targetName:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(lowerTarget, 1, true) or
           (p.DisplayName and p.DisplayName:lower():find(lowerTarget, 1, true)) then
            return p
        end
    end
    return nil
end

local function teleportToSpawn(spawn)
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if hrp and spawn then
        hrp.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        print("[Teleport] Teleported to spawn: " .. spawn:GetFullName())
    end
end

-- Main loop
local lastTargetPos = nil
local lastScan = 0
local posHistory = {}
local lastTeleportedSpawn = nil

RunService.Heartbeat:Connect(function(dt)
    lastScan += dt
    if lastScan < SCAN_INTERVAL then return end
    lastScan = 0

    -- Refresh character reference
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Find target player (re-checks every loop in case they join late)
    local targetPlayer = getTargetPlayer(TARGET_NAME)
    if not targetPlayer then
        warn("[Teleport] Waiting for player: " .. TARGET_NAME)
        return
    end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local currentPos = targetRoot.Position

    -- Track position history for prediction
    table.insert(posHistory, currentPos)
    if #posHistory > POSITION_HISTORY_SIZE then
        table.remove(posHistory, 1)
    end

    -- Detect large position jump (teleport event)
    if lastTargetPos then
        local delta = (currentPos - lastTargetPos).Magnitude

        if delta > TELEPORT_THRESHOLD then
            -- Target was just teleported — find closest spawn to their NEW position
            print(string.format("[Teleport] Target jumped %.1f studs — intercepting spawn!", delta))
            local spawns = getAllSpawns()
            local closestSpawn = findClosestSpawn(currentPos, spawns)

            if closestSpawn and closestSpawn ~= lastTeleportedSpawn then
                teleportToSpawn(closestSpawn)
                lastTeleportedSpawn = closestSpawn
            end
        end
    end

    -- Also predict: if target is moving TOWARD a spawn, pre-teleport
    if #posHistory == POSITION_HISTORY_SIZE then
        local oldPos = posHistory[1]
        local velocity = (currentPos - oldPos) / (SCAN_INTERVAL * POSITION_HISTORY_SIZE)

        if velocity.Magnitude > 1 then
            -- Project position slightly ahead
            local predictedPos = currentPos + velocity * 0.5

            local spawns = getAllSpawns()
            local closestSpawn = findClosestSpawn(predictedPos, spawns)

            if closestSpawn and closestSpawn ~= lastTeleportedSpawn then
                local distToSpawn = (predictedPos - closestSpawn.Position).Magnitude
                if distToSpawn < 15 then
                    print("[Teleport] Predicting target heading to spawn — pre-teleporting!")
                    teleportToSpawn(closestSpawn)
                    lastTeleportedSpawn = closestSpawn
                end
            end
        end
    end

    lastTargetPos = currentPos
end)

print("[Teleport] Script running. Tracking: " .. TARGET_NAME)
