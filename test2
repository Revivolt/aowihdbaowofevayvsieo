targetInput.FocusLost:Connect(function(enter)
	if not enter then return end
	local found = findPlayer(targetInput.Text)
	if found then
		targetPlayer = found
		targetStatusLabel.Text = "Target: ✅  " .. found.Name .. " (" .. found.DisplayName .. ")"
		targetStatusLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
	else
		targetPlayer = nil
		targetStatusLabel.Text = "Target: ❌  Player not found"
		targetStatusLabel.TextColor3 = Color3.fromRGB(220, 100, 80)
	end
end)

-- ══════════════════════════════════════════
-- TELEPORT BUTTON
-- ══════════════════════════════════════════

tpButton.MouseButton1Click:Connect(function()
	if not predictedSpawn then
		statusLabel.Text = "No predicted spawn to teleport to!"
		statusLabel.TextColor3 = Color3.fromRGB(220, 100, 80)
		return
	end

	local char = localPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		statusLabel.Text = "Cannot teleport: no character found"
		statusLabel.TextColor3 = Color3.fromRGB(220, 100, 80)
		return
	end

	-- Offset slightly above the spawn so we land on top of it
	root.CFrame = CFrame.new(predictedSpawn.Position + Vector3.new(0, 5, 0))
	statusLabel.Text = "✈️  Teleported to " .. predictedSpawn.Name
	statusLabel.TextColor3 = Color3.fromRGB(80, 180, 255)
end)

