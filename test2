local logLines  = {}   -- plain-text copy for the Copy button
local fireCount = 0

local function scrollToBottom()
    task.defer(function()
        scrollFrame.CanvasPosition = Vector2.new(
            0, math.max(0, scrollFrame.AbsoluteCanvasSize.Y
                         - scrollFrame.AbsoluteSize.Y)
        )
    end)
end

local function appendLine(line, color)
    fireCount += 1
    logLines[#logLines + 1] = line
    counter.Text = fireCount .. " fires"

    -- Create a colored TextLabel for this entry
    local lbl = Instance.new("TextLabel")
    lbl.LayoutOrder          = fireCount
    lbl.Size                 = UDim2.new(1, -10, 0, 0)   -- height auto-set below
    lbl.AutomaticSize        = Enum.AutomaticSize.Y
    lbl.Position             = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3           = color or Color3.fromRGB(210, 210, 210)
    lbl.TextSize             = 11
    lbl.Font                 = Enum.Font.Code
    lbl.TextXAlignment       = Enum.TextXAlignment.Left
    lbl.TextYAlignment       = Enum.TextYAlignment.Top
    lbl.TextWrapped          = true
    lbl.Text                 = line
    lbl.Parent               = scrollFrame

    scrollToBottom()
end

