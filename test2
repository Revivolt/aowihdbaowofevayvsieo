-- Remote Spammer | LocalScript
-- Collects all RemoteEvents and RemoteFunctions in the game and fires them on a loop.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Config
local FIRE_INTERVAL = 0.1   -- seconds between each fire cycle
local SCAN_INTERVAL = 5.0   -- seconds between re-scanning for new remotes
local FIRE_ARGS    = {}     -- arguments to pass; tweak per-game as needed

-- Storage
local remoteEvents    = {}
local remoteFunctions = {}

-- Recursively collect all remotes under a given instance
local function scanForRemotes(root)
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            remoteEvents[obj] = true
        elseif obj:IsA("RemoteFunction") then
            remoteFunctions[obj] = true
        end
    end
end

-- Initial scan across the whole DataModel
local function fullScan()
    remoteEvents    = {}
    remoteFunctions = {}

    -- Common containers
    local targets = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        game:GetService("Workspace"),
        game:GetService("Players"),
        game:GetService("StarterGui"),
        game:GetService("StarterPack"),
        game:GetService("StarterPlayer"),
        game:GetService("Lighting"),
        game:GetService("SoundService"),
    }

    for _, container in ipairs(targets) do
        pcall(scanForRemotes, container)
    end

    -- Also try the raw game tree (executor-dependent)
    pcall(function()
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                remoteEvents[obj] = true
            elseif obj:IsA("RemoteFunction") then
                remoteFunctions[obj] = true
            end
        end
    end)

    local evCount  = 0
    local fnCount  = 0
    for _ in pairs(remoteEvents)    do evCount  = evCount  + 1 end
    for _ in pairs(remoteFunctions) do fnCount  = fnCount  + 1 end
    print(string.format("[RemoteSpammer] Scan complete — %d RemoteEvents, %d RemoteFunctions", evCount, fnCount))
end

-- Fire loop
local function fireAll()
    for remote in pairs(remoteEvents) do
        pcall(function()
            remote:FireServer(table.unpack(FIRE_ARGS))
        end)
    end

    for remote in pairs(remoteFunctions) do
        pcall(function()
            -- InvokeServer can yield; wrap in a new thread so we don't stall
            task.spawn(function()
                remote:InvokeServer(table.unpack(FIRE_ARGS))
            end)
        end)
    end
end

-- Bootstrap
fullScan()

-- Periodic re-scan (games load remotes dynamically)
task.spawn(function()
    while true do
        task.wait(SCAN_INTERVAL)
        fullScan()
    end
end)

-- Main fire loop
task.spawn(function()
    while true do
        task.wait(FIRE_INTERVAL)
        fireAll()
    end
end)

print("[RemoteSpammer] Running — interval:", FIRE_INTERVAL, "s")
