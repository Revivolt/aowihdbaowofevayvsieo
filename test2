-- PCEmulatorInput.lua
-- LocalScript → StarterPlayerScripts
-- Android emulator fix: forces PC input recognition + full keyboard/mouse HUD

local Players               = game:GetService("Players")
local UserInputService      = game:GetService("UserInputService")
local ContextActionService  = game:GetService("ContextActionService")
local RunService            = game:GetService("RunService")
local VirtualInputManager   = game:GetService("VirtualInputManager")
local StarterGui            = game:GetService("StarterGui")
local TweenService          = game:GetService("TweenService")

local LocalPlayer   = Players.LocalPlayer
local PlayerGui     = LocalPlayer:WaitForChild("PlayerGui")

-- ══════════════════════════════════════════════════════════════
-- FORCE ROBLOX INTO PC/DESKTOP INPUT MODE
-- This tricks the engine into treating the session as a keyboard+mouse device
-- even when running inside an Android emulator.
-- ══════════════════════════════════════════════════════════════
-- These pcall wrappers exist because some emulators throw on direct property writes
pcall(function() UserInputService.KeyboardEnabled   = true  end)
pcall(function() UserInputService.MouseEnabled      = true  end)
pcall(function() UserInputService.TouchEnabled      = false end)
pcall(function() UserInputService.GamepadEnabled    = false end)

-- ══════════════════════════════════════════════════════════════
-- CHARACTER REFS
-- ══════════════════════════════════════════════════════════════
local Character, Humanoid, HRP, Camera

local function grabCharacter(char)
    Character = char
    HRP       = char:WaitForChild("HumanoidRootPart")
    Humanoid  = char:WaitForChild("Humanoid")
    Camera    = workspace.CurrentCamera
    -- Standard Roblox 3rd-person camera — DO NOT set to Scriptable
    Camera.CameraType = Enum.CameraType.Custom
end

if LocalPlayer.Character then grabCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(grabCharacter)

-- ══════════════════════════════════════════════════════════════
-- REMOVE MOBILE TOUCH GUI
-- ══════════════════════════════════════════════════════════════
local function killTouch()
    local tg = PlayerGui:FindFirstChild("TouchGui")
    if tg then tg:Destroy() end
end
killTouch()
PlayerGui.ChildAdded:Connect(function(c)
    if c.Name == "TouchGui" then task.defer(function() c:Destroy() end) end
end)
-- Also disable mobile jump button & joystick via CoreGui
pcall(function()
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, true)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
end)

-- ══════════════════════════════════════════════════════════════
-- KEEP CAMERA IN CUSTOM MODE EVERY FRAME
-- ══════════════════════════════════════════════════════════════
RunService:BindToRenderStep("DesktopCamLock", Enum.RenderPriority.Camera.Value + 1, function()
    if Camera and Camera.CameraType ~= Enum.CameraType.Custom then
        Camera.CameraType = Enum.CameraType.Custom
    end
end)

-- ══════════════════════════════════════════════════════════════
-- MOVEMENT via ContextActionService
-- CAS works at a lower level than UserInputService and fires
-- even when UIS treats the device as a touch/gamepad device.
-- ══════════════════════════════════════════════════════════════
local moveState = { Forward=0, Backward=0, Left=0, Right=0 }
local sprinting = false
local baseSpeed = 16

local function updateMove()
    if not Humanoid or not HRP then return end
    local x = moveState.Right   - moveState.Left
    local z = moveState.Backward - moveState.Forward
    local dir = Vector3.new(x, 0, z)
    if dir.Magnitude > 0 then dir = dir.Unit end
    -- Move relative to camera yaw
    local camYaw = CFrame.Angles(0, math.atan2(-Camera.CFrame.LookVector.X,
                                               -Camera.CFrame.LookVector.Z), 0)
    Humanoid:Move(camYaw * dir, false)
    Humanoid.WalkSpeed = sprinting and 22 or baseSpeed
end

local function bindMove(name, stateKey, kc1, kc2)
    ContextActionService:BindAction(name, function(_, state, _)
        moveState[stateKey] = (state == Enum.UserInputState.Begin) and 1 or 0
        updateMove()
        return Enum.ContextActionResult.Pass   -- Pass so game can also handle it
    end, false, kc1, kc2 or kc1)
end

bindMove("MoveForward",  "Forward",  Enum.KeyCode.W, Enum.KeyCode.Up)
bindMove("MoveBackward", "Backward", Enum.KeyCode.S, Enum.KeyCode.Down)
bindMove("MoveLeft",     "Left",     Enum.KeyCode.A, Enum.KeyCode.Left)
bindMove("MoveRight",    "Right",    Enum.KeyCode.D, Enum.KeyCode.Right)

ContextActionService:BindAction("Sprint", function(_, state, _)
    sprinting = (state == Enum.UserInputState.Begin)
    return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)

ContextActionService:BindAction("Jump", function(_, state, _)
    if state == Enum.UserInputState.Begin and Humanoid then
        Humanoid.Jump = true
    end
    return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.Space)

-- ══════════════════════════════════════════════════════════════
-- MOUSE LOOK
-- VirtualInputManager.SendMouseWheelEvent fires zoom even on
-- emulators that don't send real scroll wheel events.
-- Camera rotation is handled by Roblox's own CameraScript when
-- CameraType = Custom, so we just ensure MouseBehavior is correct.
-- ══════════════════════════════════════════════════════════════
UserInputService.MouseBehavior    = Enum.MouseBehavior.Default
UserInputService.MouseIconEnabled = true

-- Re-inject scroll events so zoom works on emulator
-- (Some emulators send keyboard PageUp/Down instead of wheel)
ContextActionService:BindAction("ZoomIn", function(_, state, _)
    if state == Enum.UserInputState.Begin then
        pcall(function() VirtualInputManager:SendMouseWheelEvent(0, 0, true, game) end)
    end
    return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.PageUp, Enum.KeyCode.KeypadPlus)

ContextActionService:BindAction("ZoomOut", function(_, state, _)
    if state == Enum.UserInputState.Begin then
        pcall(function() VirtualInputManager:SendMouseWheelEvent(0, 0, false, game) end)
    end
    return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.PageDown, Enum.KeyCode.KeypadMinus)

-- ══════════════════════════════════════════════════════════════
-- HUD SCREEN GUI
-- ══════════════════════════════════════════════════════════════
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name           = "PCEmulatorHUD"
ScreenGui.ResetOnSpawn   = false
ScreenGui.DisplayOrder   = 100
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent         = PlayerGui

local C_BG     = Color3.fromRGB(10, 12, 18)
local C_KEY    = Color3.fromRGB(32, 36, 50)
local C_ACTIVE = Color3.fromRGB(80,150,255)
local C_TEXT   = Color3.fromRGB(190,205,230)
local C_BORDER = Color3.fromRGB(50, 60, 85)
local A_BG     = 0.30
local A_KEY    = 0.20
local A_ON     = 0.00

local function makeKey(parent, label, px, py, pw, ph)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,pw,0,ph)
    f.Position = UDim2.new(0,px,0,py)
    f.BackgroundColor3 = C_KEY
    f.BackgroundTransparency = A_KEY
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner",f).CornerRadius = UDim.new(0,3)
    local st = Instance.new("UIStroke",f)
    st.Color = C_BORDER; st.Thickness = 1; st.Transparency = 0.3
    local lbl = Instance.new("TextLabel",f)
    lbl.Size = UDim2.new(1,-2,1,-2)
    lbl.Position = UDim2.new(0,1,0,1)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C_TEXT
    lbl.Font = Enum.Font.GothamBold
    lbl.TextScaled = true
    return f
end

-- ── Full keyboard rows: { label, widthUnits, KeyCode.Name } ──
local KU,KH,KG = 26,22,3

local ROWS = {
    {{"Esc",1,"Escape"},{"F1",1,"F1"},{"F2",1,"F2"},{"F3",1,"F3"},
     {"F4",1,"F4"},{"F5",1,"F5"},{"F6",1,"F6"},{"F7",1,"F7"},
     {"F8",1,"F8"},{"F9",1,"F9"},{"F10",1,"F10"},{"F11",1,"F11"},{"F12",1,"F12"}},

    {{"`",1,"BackQuote"},{"1",1,"One"},{"2",1,"Two"},{"3",1,"Three"},
     {"4",1,"Four"},{"5",1,"Five"},{"6",1,"Six"},{"7",1,"Seven"},
     {"8",1,"Eight"},{"9",1,"Nine"},{"0",1,"Zero"},{"-",1,"Minus"},
     {"=",1,"Equals"},{"Bksp",1.5,"Backspace"}},

    {{"Tab",1.5,"Tab"},{"Q",1,"Q"},{"W",1,"W"},{"E",1,"E"},
     {"R",1,"R"},{"T",1,"T"},{"Y",1,"Y"},{"U",1,"U"},
     {"I",1,"I"},{"O",1,"O"},{"P",1,"P"},{"[",1,"LeftBracket"},
     {"]",1,"RightBracket"},{"\\",1,"BackSlash"}},

    {{"Caps",1.75,"CapsLock"},{"A",1,"A"},{"S",1,"S"},{"D",1,"D"},
     {"F",1,"F"},{"G",1,"G"},{"H",1,"H"},{"J",1,"J"},
     {"K",1,"K"},{"L",1,"L"},{";",1,"Semicolon"},{"'",1,"Quote"},
     {"Ent",1.75,"Return"}},

    {{"Shift",2.25,"LeftShift"},{"Z",1,"Z"},{"X",1,"X"},{"C",1,"C"},
     {"V",1,"V"},{"B",1,"B"},{"N",1,"N"},{"M",1,"M"},
     {",",1,"Comma"},{".",1,"Period"},{"/",1,"Slash"},{"Shift",2.25,"RightShift"}},

    {{"Ctrl",1.5,"LeftControl"},{"Win",1,"LeftSuper"},{"Alt",1,"LeftAlt"},
     {"Space",5.5,"Space"},
     {"Alt",1,"RightAlt"},{"Win",1,"RightSuper"},{"Ctrl",1.5,"RightControl"}},
}

local function rowTotalPx(row)
    local px = 0
    for i,k in ipairs(row) do
        px = px + math.floor(k[2]*(KU+KG)-KG)
        if i < #row then px = px + KG end
    end
    return px
end

local maxPx = 0
for _,row in ipairs(ROWS) do
    local w = rowTotalPx(row)
    if w > maxPx then maxPx = w end
end

local PAD   = 6
local KBD_W = maxPx + PAD*2
local KBD_H = #ROWS*(KH+KG) - KG + PAD*2

local kbdFrame = Instance.new("Frame")
kbdFrame.Name = "KBDPanel"
kbdFrame.Size = UDim2.new(0,KBD_W,0,KBD_H)
kbdFrame.Position = UDim2.new(0,12,1,-KBD_H-12)
kbdFrame.BackgroundColor3 = C_BG
kbdFrame.BackgroundTransparency = A_BG
kbdFrame.BorderSizePixel = 0
kbdFrame.Parent = ScreenGui
Instance.new("UICorner",kbdFrame).CornerRadius = UDim.new(0,6)
local kst = Instance.new("UIStroke",kbdFrame)
kst.Color = C_BORDER; kst.Thickness = 1; kst.Transparency = 0.4

local keyFrameByCode = {}  -- KeyCode.Name → Frame

for rowIdx, row in ipairs(ROWS) do
    local y       = PAD + (rowIdx-1)*(KH+KG)
    local rowPx   = rowTotalPx(row)
    local x       = PAD + math.floor((KBD_W - PAD*2 - rowPx) / 2)
    for _, kdef in ipairs(row) do
        local label,units,code = kdef[1],kdef[2],kdef[3]
        local w = math.floor(units*(KU+KG)-KG)
        local f = makeKey(kbdFrame, label, x, y, w, KH)
        if code then keyFrameByCode[code] = f end
        x = x + w + KG
    end
end

