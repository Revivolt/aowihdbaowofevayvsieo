-- ─────────────────────────────────────────
-- STATE
-- ─────────────────────────────────────────

local targetPlayer      = nil   -- Player object
local predictedSpawn    = nil   -- BasePart (the spawn we predict)
local trackingActive    = false
local spawnConnection   = nil   -- workspace.ChildAdded connection
local spawnList         = {}    -- all Spawn parts collected this round
local assignmentDone    = false

-- ─────────────────────────────────────────
-- HELPERS
-- ─────────────────────────────────────────

local function SetStatus(msg, color)
    StatusLabel.Text = msg
    StatusLabel.TextColor3 = color or Color3.fromRGB(255, 220, 50)
end

local function GetCharRoot(player)
    local char = player and player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

--[[
    MM2 assigns spawns in sorted order by Name ("Spawn1", "Spawn2", ...)
    then picks the index that corresponds to the player's position in the
    server's Players list (sorted by UserId ascending, which matches join order).
    We replicate that logic here.
]]
local function PredictSpawn(spawns, player)
    -- Sort spawns by their numeric suffix, fall back to alphabetical
    local sorted = {table.unpack(spawns)}
    table.sort(sorted, function(a, b)
        local na = tonumber(a.Name:match("%d+$")) or 0
        local nb = tonumber(b.Name:match("%d+$")) or 0
        if na ~= nb then return na < nb end
        return a.Name < b.Name
    end)

    -- Build sorted player list by UserId (join order approximation)
    local allPlayers = Players:GetPlayers()
    table.sort(allPlayers, function(a, b)
        return a.UserId < b.UserId
    end)

    -- Find target's 1-based index
    local idx = nil
    for i, p in ipairs(allPlayers) do
        if p == player then
            idx = i
            break
        end
    end

    if not idx then return nil end

    -- Wrap index into spawn list length
    local spawnIdx = ((idx - 1) % #sorted) + 1
    return sorted[spawnIdx]
end

local function StopTracking()
    trackingActive = false
    assignmentDone = false
    spawnList      = {}
    predictedSpawn = nil
    if spawnConnection then
        spawnConnection:Disconnect()
        spawnConnection = nil
    end
    TeleBtn.Visible = false
end

-- ─────────────────────────────────────────
-- SPAWN WATCHER
-- ─────────────────────────────────────────

local function OnChildAdded(child)
    if assignmentDone then return end

    -- MM2 spawn parts are named "Spawn" or "SpawnN"
    if not child.Name:match("^Spawn") then return end
    if not child:IsA("BasePart") and not child:IsA("Model") then return end

    table.insert(spawnList, child)
    SetStatus(("Collecting spawns... [%d found]"):format(#spawnList))
end

-- We detect "all spawns added" by watching for a brief pause in new
-- Spawn arrivals. MM2 adds them all in one batch, so 0.3 s silence = done.
local lastSpawnTime = 0

local function StartSpawnWatcher()
    spawnList      = {}
    assignmentDone = false
    lastSpawnTime  = 0

    -- Grab any Spawn parts already in workspace right now
    for _, child in ipairs(workspace:GetChildren()) do
        if child.Name:match("^Spawn") and
           (child:IsA("BasePart") or child:IsA("Model")) then
            table.insert(spawnList, child)
        end
    end

    spawnConnection = workspace.ChildAdded:Connect(function(child)
        OnChildAdded(child)
        lastSpawnTime = tick()
    end)

    -- Polling loop: once spawns stop arriving, run prediction
    task.spawn(function()
        while trackingActive do
            task.wait(0.1)

            if #spawnList > 0 and not assignmentDone then
                local elapsed = tick() - lastSpawnTime
                -- 0.35 s of silence after the last spawn = batch complete
                if elapsed >= 0.35 then
                    assignmentDone = true

                    local predicted = PredictSpawn(spawnList, targetPlayer)
                    if predicted then
                        predictedSpawn = predicted

                        -- Resolve position for Models
                        local pos
                        if predicted:IsA("Model") then
                            local root = predicted:FindFirstChild("HumanoidRootPart")
                                      or predicted.PrimaryPart
                            pos = root and root.Position or predicted:GetModelCFrame().Position
                        else
                            pos = predicted.Position
                        end

                        SetStatus(
                            ("Predicted: %s  (%.1f, %.1f, %.1f)"):format(
                                predicted.Name, pos.X, pos.Y, pos.Z),
                            Color3.fromRGB(80, 255, 120)
                        )
                        TeleBtn.Visible = true
                    else
                        SetStatus("Could not predict spawn (player not found).",
                                  Color3.fromRGB(255, 80, 80))
                    end

                    -- Keep connection alive so we can re-predict if a new
                    -- round starts (spawns re-added)
                    assignmentDone = false
                    spawnList      = {}
                end
            end
        end
    end)
end

-- ─────────────────────────────────────────
-- BUTTON LOGIC
-- ─────────────────────────────────────────

TrackBtn.MouseButton1Click:Connect(function()
    local username = UsernameBox.Text:match("^%s*(.-)%s*$")
    if username == "" then
        SetStatus("Enter a username first.", Color3.fromRGB(255, 80, 80))
        return
    end

    -- Resolve username -> Player
    local found = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == username:lower() then
            found = p
            break
        end
    end

    if not found then
        SetStatus(("Player '%s' not in server."):format(username),
                  Color3.fromRGB(255, 80, 80))
        return
    end

    StopTracking()
    targetPlayer   = found
    trackingActive = true
    SetStatus(("Tracking %s — waiting for round start..."):format(found.Name),
              Color3.fromRGB(255, 220, 50))
    StartSpawnWatcher()
end)

TeleBtn.MouseButton1Click:Connect(function()
    if not predictedSpawn then
        SetStatus("No spawn predicted yet.", Color3.fromRGB(255, 80, 80))
        return
    end

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        SetStatus("Your character isn't loaded.", Color3.fromRGB(255, 80, 80))
        return
    end

    local targetPos
    if predictedSpawn:IsA("Model") then
        local root = predictedSpawn:FindFirstChild("HumanoidRootPart")
                  or predictedSpawn.PrimaryPart
        targetPos = root and root.Position or predictedSpawn:GetModelCFrame().Position
    else
        targetPos = predictedSpawn.Position
    end

    -- Offset slightly upward so we land on top, not inside the part
    hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 4, 0))
    SetStatus(("Teleported to %s!"):format(predictedSpawn.Name),
              Color3.fromRGB(80, 255, 120))
end)
