-- ─── Config ───────────────────────────────────────────────
local FIRE_INTERVAL = 0.1   -- seconds between fire cycles
local SCAN_INTERVAL = 5.0   -- seconds between re-scans
local FIRE_ARGS     = {}    -- args sent to every remote; edit per-game
-- ──────────────────────────────────────────────────────────

local remoteEvents    = {}
local remoteFunctions = {}
local spamming        = false
local fireThread      = nil

-- ─── Remote Scanner ───────────────────────────────────────
local function scanForRemotes(root)
    local ok, descendants = pcall(function() return root:GetDescendants() end)
    if not ok then return end
    for _, obj in ipairs(descendants) do
        if obj:IsA("RemoteEvent") then
            remoteEvents[obj] = true
        elseif obj:IsA("RemoteFunction") then
            remoteFunctions[obj] = true
        end
    end
end

local function fullScan()
    remoteEvents    = {}
    remoteFunctions = {}

    local services = {
        "ReplicatedStorage", "ReplicatedFirst", "Workspace",
        "Players", "StarterGui", "StarterPack",
        "StarterPlayer", "Lighting", "SoundService"
    }
    for _, svc in ipairs(services) do
        pcall(function() scanForRemotes(game:GetService(svc)) end)
    end
    -- broad sweep (executor-dependent)
    pcall(function()
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                remoteEvents[obj] = true
            elseif obj:IsA("RemoteFunction") then
                remoteFunctions[obj] = true
            end
        end
    end)
end

-- ─── Fire Logic (fixed) ───────────────────────────────────
local function safeFireEvent(remote)
    -- unpack only when there are actual args to avoid iterator errors
    if #FIRE_ARGS > 0 then
        remote:FireServer(table.unpack(FIRE_ARGS))
    else
        remote:FireServer()
    end
end

local function safeInvokeFunction(remote)
    if #FIRE_ARGS > 0 then
        remote:InvokeServer(table.unpack(FIRE_ARGS))
    else
        remote:InvokeServer()
    end
end

local function fireAll()
    for remote in pairs(remoteEvents) do
        pcall(safeFireEvent, remote)
    end
    for remote in pairs(remoteFunctions) do
        -- spawn so InvokeServer yield doesn't stall the loop
        task.spawn(pcall, safeInvokeFunction, remote)
    end
end

