-- ─── Offset state (studs) ─────────────────────────────────────────────────────
local offset = Vector3.new(0, 0, 0)

-- ─── CoM calculation ──────────────────────────────────────────────────────────
local function getCoM()
    local totalMass   = 0
    local weightedSum = Vector3.new(0, 0, 0)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsA("Terrain") then
            local m = part.AssemblyMass > 0 and part.AssemblyMass or part:GetMass()
            weightedSum = weightedSum + part.Position * m
            totalMass   = totalMass + m
        end
    end
    if totalMass == 0 then return rootPart.Position end
    return weightedSum / totalMass
end

