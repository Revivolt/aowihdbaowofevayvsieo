-- AvatarSwapper.lua (v3 — Server-Side API Method)
-- Uses .ROBLOSECURITY to update avatar server-side, then respawns.
-- This is exactly what Roblox's own menu button does.
-- Requires executor with cookie access: Synapse X, KRNL, Fluxus, Wave, Solara

local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local HttpService      = game:GetService("HttpService")

local lp     = Players.LocalPlayer
local userId = lp.UserId

-- ─── GET .ROBLOSECURITY COOKIE ───────────────────────────────────────────────
-- Executors expose this differently. We try all known methods.
local function getRobloSecurity()
    -- Synapse X
    if syn and syn.get_cookie then
        return syn.get_cookie(".ROBLOSECURITY")
    end
    -- KRNL / Fluxus / most others
    if get_cookie then
        return get_cookie(".ROBLOSECURITY")
    end
    -- Wave / Solara style
    if getcookies then
        local cookies = getcookies()
        return cookies[".ROBLOSECURITY"]
    end
    -- Fallback: some executors expose it directly
    if ROBLOSECURITY then
        return ROBLOSECURITY
    end
    return nil
end

-- ─── HTTP ABSTRACTION ────────────────────────────────────────────────────────
local function httpRequest(options)
    if syn and syn.request then
        return syn.request(options)
    elseif http and http.request then
        return http.request(options)
    elseif request then
        return request(options)
    elseif http_request then
        return http_request(options)
    else
        error("[AvatarSwapper] No HTTP function found.")
    end
end

-- ─── FETCH OUTFIT LIST ───────────────────────────────────────────────────────
local function fetchOutfits()
    local res = httpRequest({
        Url    = string.format(
            "https://avatar.roblox.com/v1/users/%d/outfits?page=1&itemsPerPage=50&isEditable=true",
            userId
        ),
        Method = "GET"
    })
    if not res or res.StatusCode ~= 200 then
        warn("[AvatarSwapper] Failed to fetch outfits:", res and res.StatusCode)
        return {}
    end
    local decoded = HttpService:JSONDecode(res.Body)
    local list = {}
    if decoded and decoded.data then
        for _, entry in ipairs(decoded.data) do
            table.insert(list, { id = entry.id, name = entry.name })
        end
    end
    return list
end

-- ─── FETCH ASSET IDs FOR OUTFIT ──────────────────────────────────────────────
local function fetchOutfitAssetIds(outfitId)
    local res = httpRequest({
        Url    = string.format("https://avatar.roblox.com/v1/outfits/%d/details", outfitId),
        Method = "GET"
    })
    if not res or res.StatusCode ~= 200 then return nil end
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not ok or not decoded or not decoded.assets then return nil end
    local ids = {}
    for _, asset in ipairs(decoded.assets) do
        table.insert(ids, asset.id)
    end
    -- Also grab scale/body color data for the POST body
    return ids, decoded.scale, decoded.bodyColors
end

-- ─── GET CSRF TOKEN (required for POST to Roblox API) ────────────────────────
local function getCSRFToken(cookie)
    -- Roblox returns X-CSRF-Token in the 403 response to a tokenless POST
    local res = httpRequest({
        Url     = "https://auth.roblox.com/v2/logout",
        Method  = "POST",
        Headers = {
            ["Cookie"] = ".ROBLOSECURITY=" .. cookie,
            ["Content-Type"] = "application/json"
        },
        Body = "{}"
    })
    if res and res.Headers then
        return res.Headers["x-csrf-token"]
            or res.Headers["X-CSRF-Token"]
    end
    return nil
end

-- ─── CORE: SET WEARING ASSETS (server-side avatar update) ────────────────────
-- This is the exact call Roblox's CoreScript makes when you switch avatar.
-- It updates your account's current avatar, not just the in-game character.
local function setWearingAssets(assetIds, cookie, csrf)
    local body = HttpService:JSONEncode({ assetIds = assetIds })
    local res = httpRequest({
        Url    = "https://avatar.roblox.com/v1/avatar/set-wearing-assets",
        Method = "POST",
        Headers = {
            ["Cookie"]       = ".ROBLOSECURITY=" .. cookie,
            ["X-CSRF-Token"] = csrf,
            ["Content-Type"] = "application/json"
        },
        Body = body
    })
    return res and res.StatusCode == 200
end

-- ─── APPLY OUTFIT — THE REAL WAY ─────────────────────────────────────────────
local function applyOutfit(outfitId, statusCb)
    statusCb("Getting auth cookie...")
    local cookie = getRobloSecurity()
    if not cookie or cookie == "" then
        statusCb("ERR: Executor has no cookie access")
        warn("[AvatarSwapper] Could not get .ROBLOSECURITY — executor may not support it")
        return
    end

    statusCb("Fetching outfit assets...")
    local assetIds, scale, bodyColors = fetchOutfitAssetIds(outfitId)
    if not assetIds or #assetIds == 0 then
        statusCb("ERR: Could not fetch outfit assets")
        return
    end

    statusCb("Getting CSRF token...")
    local csrf = getCSRFToken(cookie)
    if not csrf then
        statusCb("ERR: Could not get CSRF token")
        warn("[AvatarSwapper] CSRF token fetch failed")
        return
    end

    statusCb("Updating avatar on Roblox servers...")
    local ok = setWearingAssets(assetIds, cookie, csrf)
    if not ok then
        statusCb("ERR: Avatar update rejected by Roblox API")
        warn("[AvatarSwapper] set-wearing-assets POST failed")
        return
    end

    -- Avatar is now updated server-side. Respawn to load it.
    statusCb("Respawning to apply...")
    task.wait(0.5)
    local respawnOk, respawnErr = pcall(function()
        lp:LoadCharacter()
    end)
    if respawnOk then
        statusCb("Done! Outfit applied.")
    else
        -- LoadCharacter blocked — tell user to manually respawn
        warn("[AvatarSwapper] LoadCharacter blocked:", respawnErr)
        statusCb("Avatar updated! Respawn manually to see it.")
    end
end

