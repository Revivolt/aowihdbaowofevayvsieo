-- ──────────────────────────────────────────
-- Helpers
-- ──────────────────────────────────────────

local function timestamp()
    return string.format("[%.3f]", tick())
end

local function serialize(v)
    local t = typeof(v)
    if t == "Instance" then
        return v:GetFullName()
    elseif t == "table" then
        local parts = {}
        for k, val in pairs(v) do
            parts[#parts+1] = tostring(k).."="..serialize(val)
        end
        return "{"..table.concat(parts, ", ").."}"
    else
        return tostring(v)
    end
end

local function fmtArgs(...)
    local args = {...}
    local out  = {}
    for i, v in ipairs(args) do
        out[i] = string.format("[%d](%s) %s", i, typeof(v), serialize(v))
    end
    return #out > 0 and table.concat(out, " | ") or "<no args>"
end

-- ──────────────────────────────────────────
-- Hook logic
-- ──────────────────────────────────────────

local hooked = {}

local REMOTE_CLASSES = {
    RemoteEvent           = true,
    RemoteFunction        = true,
    UnreliableRemoteEvent = true,
}

local function hookRemote(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    local path = remote:GetFullName()
    local kind = remote.ClassName

    -- ── Server → Client ──────────────────────────────────
    if kind == "RemoteEvent" or kind == "UnreliableRemoteEvent" then
        remote.OnClientEvent:Connect(function(...)
            appendLine(string.format(
                "%s [%s] ← SERVER\n  Path: %s\n  Args: %s",
                timestamp(), kind, path, fmtArgs(...)
            ), COLOR_SERVER)
        end)

    elseif kind == "RemoteFunction" then
        remote.OnClientInvoke = function(...)
            appendLine(string.format(
                "%s [RemoteFunction INVOKE] ← SERVER\n  Path: %s\n  Args: %s",
                timestamp(), path, fmtArgs(...)
            ), COLOR_SERVER)
        end
    end

    -- ── Client → Server ──────────────────────────────────
    -- Hook :FireServer / :InvokeServer via metatable __index replacement
    local mt = getrawmetatable and getrawmetatable(remote)
    if mt then
        local oldIndex = mt.__index
        local wasReadonly = isreadonly and isreadonly(mt)
        if wasReadonly then setreadonly(mt, false) end

        if kind == "RemoteEvent" or kind == "UnreliableRemoteEvent" then
            local origFire = (type(oldIndex) == "function" and oldIndex(remote, "FireServer"))
                          or (type(oldIndex) == "table"    and oldIndex["FireServer"])
                          or remote.FireServer  -- fallback

            mt.__index = newproxy and (function(self, key)  -- not standard; see note
                if key == "FireServer" and self == remote then
                    return function(_, ...)
                        appendLine(string.format(
                            "%s [%s] → SERVER\n  Path: %s\n  Args: %s",
                            timestamp(), kind, path, fmtArgs(...)
                        ), COLOR_CLIENT)
                        return origFire(self, ...)
                    end
                end
                return type(oldIndex) == "function" and oldIndex(self, key)
                    or type(oldIndex) == "table"    and oldIndex[key]
            end) or oldIndex  -- fallback if newproxy unavailable

        elseif kind == "RemoteFunction" then
            local origInvoke = (type(oldIndex) == "function" and oldIndex(remote, "InvokeServer"))
                            or (type(oldIndex) == "table"    and oldIndex["InvokeServer"])
                            or remote.InvokeServer

            mt.__index = (function(self, key)
                if key == "InvokeServer" and self == remote then
                    return function(_, ...)
                        appendLine(string.format(
                            "%s [RemoteFunction] → SERVER\n  Path: %s\n  Args: %s",
                            timestamp(), path, fmtArgs(...)
                        ), COLOR_CLIENT)
                        return origInvoke(self, ...)
                    end
                end
                return type(oldIndex) == "function" and oldIndex(self, key)
                    or type(oldIndex) == "table"    and oldIndex[key]
            end) or oldIndex
        end

        if wasReadonly then setreadonly(mt, true) end
    end
end

local function scanContainer(container)
    for _, obj in ipairs(container:GetDescendants()) do
        if REMOTE_CLASSES[obj.ClassName] then
            hookRemote(obj)
        end
    end
    container.DescendantAdded:Connect(function(obj)
        if REMOTE_CLASSES[obj.ClassName] then
            hookRemote(obj)
        end
    end)
end

