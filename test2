-- ════════════════════════════════════════════════════════════
-- 3. CAMERA LOOK JOYSTICK  (bottom-center)
-- A draggable thumb that rotates the camera by adjusting
-- Roblox's CameraScript angle via CFrame injection.
-- ════════════════════════════════════════════════════════════
local LOOK_SIZE   = 120
local THUMB_SIZE  = 44
local lookPanel   = panel(Gui, nil, -LOOK_SIZE-12, LOOK_SIZE, LOOK_SIZE)
lookPanel.Position = UDim2.new(0.5,-LOOK_SIZE/2,1,-LOOK_SIZE-12)
lookPanel.BackgroundTransparency = 0.5

local lookLabel = Instance.new("TextLabel", lookPanel)
lookLabel.Size = UDim2.new(1,0,1,0)
lookLabel.BackgroundTransparency = 1
lookLabel.Text = "LOOK"
lookLabel.TextColor3 = Color3.fromRGB(80,90,110)
lookLabel.Font = Enum.Font.GothamBold
lookLabel.TextScaled = true

local thumb = Instance.new("Frame", lookPanel)
thumb.Size = UDim2.new(0,THUMB_SIZE,0,THUMB_SIZE)
thumb.Position = UDim2.new(0.5,-THUMB_SIZE/2,0.5,-THUMB_SIZE/2)
thumb.BackgroundColor3 = C_ACTIVE
thumb.BackgroundTransparency = 0.3
thumb.BorderSizePixel = 0
Instance.new("UICorner",thumb).CornerRadius = UDim.new(1,0)

-- Camera state
local camYaw   = 0
local camPitch = 0
local SENS     = 1.8   -- degrees per pixel drag

-- Drag state
local dragging     = false
local dragStart    = Vector2.zero
local thumbCenter  = Vector2.zero

local detector = Instance.new("TextButton", lookPanel)
detector.Size = UDim2.new(1,0,1,0)
detector.BackgroundTransparency = 1
detector.Text = ""
detector.ZIndex = 5

detector.MouseButton1Down:Connect(function(mx, my)
    dragging = true
    dragStart = Vector2.new(mx, my)
end)
detector.MouseButton1Up:Connect(function()
    dragging = false
    thumb.Position = UDim2.new(0.5,-THUMB_SIZE/2,0.5,-THUMB_SIZE/2)
end)
detector.MouseMoved:Connect(function(mx, my)
    if not dragging then return end
    local delta = Vector2.new(mx, my) - dragStart
    -- Clamp thumb inside circle
    local maxR = LOOK_SIZE/2 - THUMB_SIZE/2 - 4
    if delta.Magnitude > maxR then delta = delta.Unit * maxR end
    thumb.Position = UDim2.new(0.5,delta.X-THUMB_SIZE/2, 0.5,delta.Y-THUMB_SIZE/2)
    -- Rotate camera
    camYaw   = camYaw   - delta.X * SENS * 0.05
    camPitch = math.clamp(camPitch - delta.Y * SENS * 0.05, -75, 75)
end)

-- Apply camera rotation every frame using Roblox Custom camera subject offset
RunService:BindToRenderStep("LookJoystick", Enum.RenderPriority.Camera.Value, function()
    if not dragging then return end
    if not HRP then return end
    -- Roblox Custom camera reads CameraSubject + angles set via CFrame
    -- We nudge HRP's orientation so Roblox's camera tracks it
    -- (doesn't fight physics because we only yaw HRP, not position)
    local newCF = CFrame.new(HRP.Position)
                * CFrame.Angles(0, math.rad(camYaw), 0)
    HRP.CFrame = CFrame.new(HRP.Position, newCF.LookVector + HRP.Position)
                * CFrame.Angles(0, 0, 0)
end)

-- ════════════════════════════════════════════════════════════
-- 4. KEYBOARD HUD DISPLAY  (visual only, full layout)
--    Sits above the WASD panel. Keys light up when GUI btns
--    above are pressed (mirrored via the held{} table).
-- ════════════════════════════════════════════════════════════
local KU,KH,KG2 = 18,15,2   -- smaller since it's just a display

local ROWS = {
    {{"Esc","Escape"},{"F1","F1"},{"F2","F2"},{"F3","F3"},{"F4","F4"},
     {"F5","F5"},{"F6","F6"},{"F7","F7"},{"F8","F8"},{"F9","F9"},
     {"F10","F10"},{"F11","F11"},{"F12","F12"}},
    {{"`","BackQuote"},{"1","One"},{"2","Two"},{"3","Three"},{"4","Four"},
     {"5","Five"},{"6","Six"},{"7","Seven"},{"8","Eight"},{"9","Nine"},
     {"0","Zero"},{"-","Minus"},{"=","Equals"},{"Bk","Backspace"}},
    {{"Tab","Tab"},{"Q","Q"},{"W","W"},{"E","E"},{"R","R"},{"T","T"},
     {"Y","Y"},{"U","U"},{"I","I"},{"O","O"},{"P","P"},{"[","LeftBracket"},
     {"]","RightBracket"},{"\\","BackSlash"}},
    {{"Cp","CapsLock"},{"A","A"},{"S","S"},{"D","D"},{"F","F"},{"G","G"},
     {"H","H"},{"J","J"},{"K","K"},{"L","L"},{";","Semicolon"},{"'","Quote"},
     {"Ent","Return"}},
    {{"Sh","LeftShift"},{"Z","Z"},{"X","X"},{"C","C"},{"V","V"},{"B","B"},
     {"N","N"},{"M","M"},{",","Comma"},{".",  "Period"},{"/","Slash"},{"Sh","RightShift"}},
    {{"Ct","LeftControl"},{"Al","LeftAlt"},{"        Space        ","Space"},
     {"Al","RightAlt"},{"Ct","RightControl"}},
}

-- Widths (units) for special keys
local WIDE = {Bk=1.5,Tab=1.5,Cp=1.75,Ent=1.75,
              Sh=2.0,[" Space "]=5.5,["        Space        "]=5.5,
              Ct=1.5,Al=1.25}

local function kw(lbl)
    return (WIDE[lbl] or 1) * (KU + KG2) - KG2
end

local function rowTotalPx(row)
    local px = 0
    for i,k in ipairs(row) do
        px = px + kw(k[1])
        if i < #row then px = px + KG2 end
    end
    return px
end

local maxPx = 0
for _,row in ipairs(ROWS) do
    local w = rowTotalPx(row)
    if w > maxPx then maxPx = w end
end

local PAD2  = 5
local HKBD_W = maxPx + PAD2*2
local HKBD_H = #ROWS*(KH+KG2)-KG2 + PAD2*2

-- Position: just above the WASD panel
local hkbdFrame = panel(Gui, 12, -(MOVE_H+12+HKBD_H+8), HKBD_W, HKBD_H, 0.45)

local keyFrameMap = {}  -- codeName → Frame

for ri,row in ipairs(ROWS) do
    local y     = PAD2 + (ri-1)*(KH+KG2)
    local rowPx = rowTotalPx(row)
    local x     = PAD2 + math.floor((HKBD_W - PAD2*2 - rowPx)/2)
    for _,kdef in ipairs(row) do
        local lbl, code = kdef[1], kdef[2]
        local w = kw(lbl)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0,w,0,KH)
        f.Position = UDim2.new(0,x,0,y)
        f.BackgroundColor3 = C_KEY
        f.BackgroundTransparency = 0.25
        f.BorderSizePixel = 0
        f.Parent = hkbdFrame
        Instance.new("UICorner",f).CornerRadius = UDim.new(0,2)
        local st = Instance.new("UIStroke",f)
        st.Color = C_BORDER; st.Thickness = 1; st.Transparency = 0.4
        local tl = Instance.new("TextLabel",f)
        tl.Size = UDim2.new(1,0,1,0)
        tl.BackgroundTransparency = 1
        tl.Text = lbl
        tl.TextColor3 = C_TEXT
        tl.Font = Enum.Font.GothamBold
        tl.TextScaled = true
        if code then keyFrameMap[code] = f end
        x = x + w + KG2
    end
end

-- Mirror WASD held state to keyboard HUD
local function setHudKey(code, on)
    local f = keyFrameMap[code]
    if not f then return end
    TweenService:Create(f, TweenInfo.new(0.06), {
        BackgroundColor3       = on and C_ACTIVE or C_KEY,
        BackgroundTransparency = on and 0 or 0.25,
    }):Play()
end

RunService.Heartbeat:Connect(function()
    setHudKey("W", held.W)
    setHudKey("A", held.A)
    setHudKey("S", held.S)
    setHudKey("D", held.D)
end)

-- Also listen to real keyboard for HUD (works on real PC / some emulators)
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.UserInputType == Enum.UserInputType.Keyboard then
        local c = inp.KeyCode.Name
        local f = keyFrameMap[c]
        if f then
            TweenService:Create(f,TweenInfo.new(0.06),{
                BackgroundColor3=C_ACTIVE, BackgroundTransparency=0}):Play()
        end
        -- Also drive movement from real keyboard if it works
        if c=="W" then held.W=true
        elseif c=="A" then held.A=true
        elseif c=="S" then held.S=true
        elseif c=="D" then held.D=true
        elseif c=="LeftShift" or c=="RightShift" then sprint=true
        elseif c=="Space" and Humanoid then Humanoid.Jump=true end
    end
end)
UserInputService.InputEnded:Connect(function(inp, gpe)
    if gpe then return end
    if inp.UserInputType == Enum.UserInputType.Keyboard then
        local c = inp.KeyCode.Name
        local f = keyFrameMap[c]
        if f then
            TweenService:Create(f,TweenInfo.new(0.06),{
                BackgroundColor3=C_KEY, BackgroundTransparency=0.25}):Play()
        end
        if c=="W" then held.W=false
        elseif c=="A" then held.A=false
        elseif c=="S" then held.S=false
        elseif c=="D" then held.D=false
        elseif c=="LeftShift" or c=="RightShift" then sprint=false end
    end
end)

