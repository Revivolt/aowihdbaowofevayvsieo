--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G

--// State
local enabled = false

--// test Function
local function testfunc()
    if not player.Character or not player.Character.Parent then return end
    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Name ~= "OldHumanoid" then
        humanoid.Name = "OldHumanoid"
        local newHumanoid = humanoid:Clone()
        newHumanoid.Parent = character
        newHumanoid.Name = "Humanoid"

        task.wait(0.1)

        if character:FindFirstChild("OldHumanoid") then
            character.OldHumanoid:Destroy()
        end

        workspace.CurrentCamera.CameraSubject = newHumanoid

        -- Fix animations for other players by waiting longer
        -- before restarting Animate so the server recognizes the new Humanoid
        local animate = character:FindFirstChild("Animate")
        if animate then
            task.wait(0.2)
            animate.Disabled = true
            task.wait(0.1)
            animate.Disabled = false
        end

        -- Fix jump by re-seating the Humanoid's jump state
        task.wait(0.1)
        newHumanoid.JumpPower = newHumanoid.JumpPower
    end
end

--// Character handler
local function onCharacterAdded()
    task.wait(0.5)
    if enabled then
        pcall(testfunc)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)

--// Toggle input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        if enabled then
            pcall(testfunc)
        end
    end
end)
