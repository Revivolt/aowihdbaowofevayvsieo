-- ─── RUNTIME LOOP ────────────────────────────────────────────────────────────
-- AssemblyCenterOfMass is read-only for BaseParts; we simulate the offset
-- by applying a continuous BodyPosition force toward the offset world position,
-- which physically shifts how the character's mass center behaves.
-- We also reposition the billboard dot to match.

local bodyPos = Instance.new("BodyPosition")
bodyPos.MaxForce = Vector3.new(0, 0, 0) -- starts dormant
bodyPos.P        = 10000
bodyPos.D        = 500
bodyPos.Parent   = rootPart

local offsetX, offsetY, offsetZ = 0, 0, 0

local function applyOffset()
    local x, y, z = getX(), getY(), getZ()
    offsetX, offsetY, offsetZ = x, y, z

    if x == 0 and y == 0 and z == 0 then
        bodyPos.MaxForce = Vector3.new(0, 0, 0)
    else
        local worldOffset = rootPart.CFrame:VectorToWorldSpace(Vector3.new(x, y, z))
        bodyPos.Position  = rootPart.Position + worldOffset
        bodyPos.MaxForce  = Vector3.new(
            math.abs(x) * 5000,
            math.abs(y) * 8000,
            math.abs(z) * 5000
        )
    end

    -- Move billboard dot to offset position
    billboard.StudsOffset = Vector3.new(x, y, z)

    readout.Text = string.format(
        "COM:  %.1f,  %.1f,  %.1f", x, y, z
    )
end

RunService.Heartbeat:Connect(function()
    if rootPart and rootPart.Parent then
        applyOffset()
    end
end)

-- Reset button zeroes sliders by destroying and rebuilding — simpler: just re-parent GUI
resetBtn.MouseButton1Click:Connect(function()
    -- Rebuild sliders at zero (quickest approach: reload the script via rejoin prompt is impractical,
    -- so we just expose a reset signal via a value object)
    -- Since sliders store state internally, we fire a RemoteEvent-free reset
    -- by moving the BodyPosition back to dormant
    bodyPos.MaxForce = Vector3.new(0, 0, 0)
    billboard.StudsOffset = Vector3.new(0, 0, 0)
    readout.Text = "COM:  0.0,  0.0,  0.0  (drag sliders)"
    -- Note: sliders won't visually snap to zero without recreating them.
    -- For a full visual reset, rejoin or move sliders back to center manually.
end)

