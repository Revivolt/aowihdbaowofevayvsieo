-- Local Script to bring a target player to your location

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Create RemoteEvent for teleport request
local teleportRequestEvent = Instance.new("RemoteEvent")
teleportRequestEvent.Name = "TeleportPlayerToMe"
teleportRequestEvent.Parent = ReplicatedStorage

local localPlayer = Players.LocalPlayer
local playerList = {}

-- Function to update player list
local function updatePlayerList()
    playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            table.insert(playerList, player)
        end
    end
end

-- Function to bring a target player to your location
local function bringPlayerToMe(targetPlayer)
    local myCharacter = localPlayer.Character
    local myRootPart = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    
    if not myRootPart then
        warn("Your character is not loaded or has no HumanoidRootPart")
        return false
    end
    
    if not targetPlayer or not targetPlayer.Character then
        warn("Target player not found or character not loaded")
        return false
    end
    
    local myPosition = myRootPart.Position
    
    -- Send request to server to teleport target player to your position
    teleportRequestEvent:FireServer(targetPlayer, myPosition)
    
    print("Requested to bring " .. targetPlayer.Name .. " to your location at " .. tostring(myPosition))
    return true
end

