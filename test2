-- ─── STATE ────────────────────────────────────────────────────────────────────
local allOutfits  = {}
local selectedId  = nil
local selectedBtn = nil
local SEL   = Color3.fromRGB(70, 130, 255)
local NORM  = Color3.fromRGB(28, 28, 38)
local HOVER = Color3.fromRGB(38, 38, 52)

-- ─── POPULATE ROWS ────────────────────────────────────────────────────────────
local function populateRows(list)
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    selectedId  = nil
    selectedBtn = nil

    if #list == 0 then
        statusLabel.Text = "No outfits found."
        return
    end

    for i, outfit in ipairs(list) do
        local btn = Instance.new("TextButton")
        btn.Text             = outfit.name
        btn.Size             = UDim2.new(1, 0, 0, 34)
        btn.BackgroundColor3 = NORM
        btn.TextColor3       = Color3.fromRGB(210, 210, 228)
        btn.TextSize         = 13
        btn.Font             = Enum.Font.Gotham
        btn.TextXAlignment   = Enum.TextXAlignment.Left
        btn.BorderSizePixel  = 0
        btn.LayoutOrder      = i
        btn.Parent           = scroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        local p = Instance.new("UIPadding")
        p.PaddingLeft = UDim.new(0, 10)
        p.Parent      = btn

        -- Hover tween
        btn.MouseEnter:Connect(function()
            if btn ~= selectedBtn then
                TweenService:Create(btn, TweenInfo.new(0.1), {
                    BackgroundColor3 = HOVER
                }):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if btn ~= selectedBtn then
                TweenService:Create(btn, TweenInfo.new(0.1), {
                    BackgroundColor3 = NORM
                }):Play()
            end
        end)

        local oid = outfit.id
        btn.MouseButton1Click:Connect(function()
            if selectedBtn then
                TweenService:Create(selectedBtn, TweenInfo.new(0.1), {
                    BackgroundColor3 = NORM
                }):Play()
            end
            TweenService:Create(btn, TweenInfo.new(0.1), {
                BackgroundColor3 = SEL
            }):Play()
            selectedBtn = btn
            selectedId  = oid
            statusLabel.Text = "Selected: " .. outfit.name
        end)
    end
end

-- ─── SEARCH FILTER ────────────────────────────────────────────────────────────
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = searchBox.Text:lower()
    if query == "" then
        populateRows(allOutfits)
        statusLabel.Text = string.format("%d outfit(s) loaded", #allOutfits)
        return
    end
    local filtered = {}
    for _, o in ipairs(allOutfits) do
        if o.name:lower():find(query, 1, true) then
            table.insert(filtered, o)
        end
    end
    populateRows(filtered)
    statusLabel.Text = string.format("%d result(s) for \"%s\"", #filtered, searchBox.Text)
end)

-- ─── APPLY CLICK ──────────────────────────────────────────────────────────────
applyBtn.MouseButton1Click:Connect(function()
    if not selectedId then
        statusLabel.Text = "Select an outfit first!"
        return
    end
    applyBtn.Active = false
    local oid = selectedId
    task.spawn(function()
        applyOutfit(oid, function(msg)
            statusLabel.Text = msg
            if msg == "Done!" then
                TweenService:Create(applyBtn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(50, 180, 100)
                }):Play()
                task.delay(1.5, function()
                    TweenService:Create(applyBtn, TweenInfo.new(0.2), {
                        BackgroundColor3 = SEL
                    }):Play()
                end)
            end
            applyBtn.Active = true
        end)
    end)
end)

