-- RemoteSpy: logs all server→client remote fires
-- LocalScript in StarterPlayerScripts

local Players       = game:GetService("Players")
local RunService    = game:GetService("RunService")
local LocalPlayer   = Players.LocalPlayer

-- ──────────────────────────────────────────
-- Helpers
-- ──────────────────────────────────────────

local hooked = {}   -- track already-hooked remotes

local function timestamp()
    return string.format("[%.3f]", tick())
end

local function serialize(v)
    local t = typeof(v)
    if t == "Instance"  then return v:GetFullName()
    elseif t == "table" then
        local parts = {}
        for k, val in pairs(v) do
            parts[#parts+1] = tostring(k).."="..serialize(val)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    else
        return tostring(v)
    end
end

local function fmtArgs(...)
    local args = {...}
    local out  = {}
    for i, v in ipairs(args) do
        out[i] = string.format("[%d] (%s) %s", i, typeof(v), serialize(v))
    end
    return table.concat(out, "  |  ")
end

-- ──────────────────────────────────────────
-- Hook a single remote
-- ──────────────────────────────────────────

local function hookRemote(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    local path = remote:GetFullName()
    local kind = remote.ClassName

    if kind == "RemoteEvent" then
        -- OnClientEvent  →  server fired this at us
        remote.OnClientEvent:Connect(function(...)
            print(string.format(
                "%s [RemoteEvent] %s\n  Args: %s",
                timestamp(), path, fmtArgs(...)
            ))
        end)

    elseif kind == "RemoteFunction" then
        -- OnClientInvoke is a write-only callback — never read it
        remote.OnClientInvoke = function(...)
            print(string.format(
                "%s [RemoteFunction INVOKE] %s\n  Args: %s",
                timestamp(), path, fmtArgs(...)
            ))
            -- return nil so the server's InvokeClient() resolves cleanly
        end

    elseif kind == "UnreliableRemoteEvent" then
        remote.OnClientEvent:Connect(function(...)
            print(string.format(
                "%s [UnreliableRemoteEvent] %s\n  Args: %s",
                timestamp(), path, fmtArgs(...)
            ))
        end)
    end
end

-- ──────────────────────────────────────────
-- Recursively scan a container
-- ──────────────────────────────────────────

local REMOTE_CLASSES = {
    RemoteEvent          = true,
    RemoteFunction       = true,
    UnreliableRemoteEvent = true,
}

local function scanContainer(container)
    for _, obj in ipairs(container:GetDescendants()) do
        if REMOTE_CLASSES[obj.ClassName] then
            hookRemote(obj)
        end
    end
    -- watch for new remotes added later
    container.DescendantAdded:Connect(function(obj)
        if REMOTE_CLASSES[obj.ClassName] then
            hookRemote(obj)
        end
    end)
end

-- ──────────────────────────────────────────
-- Entry point
-- ──────────────────────────────────────────

-- Scan the full game tree (catches remotes in
-- ServerStorage mirrors, custom folders, etc.)
scanContainer(game)

print("[RemoteSpy] Hooked. Listening for server→client fires...")
