-- GUI SETUP
-- ════════════════════════════════════════════════════════════
local Gui = Instance.new("ScreenGui")
Gui.Name           = "PCEmu"
Gui.ResetOnSpawn   = false
Gui.DisplayOrder   = 200
Gui.IgnoreGuiInset = true
Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
Gui.Parent         = PlayerGui

-- Colours
local C_BG     = Color3.fromRGB(10,  12,  18)
local C_KEY    = Color3.fromRGB(32,  36,  50)
local C_ACTIVE = Color3.fromRGB(80, 150, 255)
local C_RED    = Color3.fromRGB(220,  80,  80)
local C_TEXT   = Color3.fromRGB(190, 205, 230)
local C_BORDER = Color3.fromRGB(50,  60,  85)

local function panel(parent, x, y, w, h, alpha)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,w,0,h)
    f.Position = UDim2.new(0,x,1,y)   -- y is negative offset from bottom
    f.BackgroundColor3 = C_BG
    f.BackgroundTransparency = alpha or 0.30
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner",f).CornerRadius = UDim.new(0,8)
    local st = Instance.new("UIStroke",f)
    st.Color = C_BORDER; st.Thickness = 1; st.Transparency = 0.4
    return f
end

-- ────────────────────────────────────────────────────────────
-- VIRTUAL BUTTON factory
-- Returns the frame; onDown/onUp are callbacks.
-- Works with both Mouse and Touch (GuiButton handles both).
-- ────────────────────────────────────────────────────────────
local function vButton(parent, label, px, py, pw, ph, onDown, onUp, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,pw,0,ph)
    btn.Position = UDim2.new(0,px,0,py)
    btn.BackgroundColor3 = color or C_KEY
    btn.BackgroundTransparency = 0.15
    btn.BorderSizePixel = 0
    btn.Text = label
    btn.TextColor3 = C_TEXT
    btn.Font = Enum.Font.GothamBold
    btn.TextScaled = true
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner",btn).CornerRadius = UDim.new(0,5)
    local st = Instance.new("UIStroke",btn)
    st.Color = C_BORDER; st.Thickness = 1

    local function flash(on)
        TweenService:Create(btn, TweenInfo.new(0.06,Enum.EasingStyle.Quad),{
            BackgroundColor3      = on and C_ACTIVE or (color or C_KEY),
            BackgroundTransparency= on and 0 or 0.15,
        }):Play()
    end

    btn.MouseButton1Down:Connect(function() flash(true);  if onDown then onDown() end end)
    btn.MouseButton1Up:Connect(  function() flash(false); if onUp   then onUp()   end end)
    -- Also handle touch for the emulator's touch layer
    btn.TouchLongPress:Connect(function() end) -- suppress long-press menu

    return btn
end

