-- ─── HTTP ABSTRACTION ─────────────────────────────────────────────────────────
-- Detects whichever HTTP function your executor exposes.
local function httpGet(url)
    if syn and syn.request then
        local res = syn.request({ Url = url, Method = "GET" })
        return res.Body
    elseif http and http.request then
        local res = http.request({ Url = url, Method = "GET" })
        return res.Body
    elseif request then
        local res = request({ Url = url, Method = "GET" })
        return res.Body
    elseif http_request then
        local res = http_request({ Url = url, Method = "GET" })
        return res.Body
    else
        error("[AvatarSwapper] No HTTP function found in this executor.")
    end
end

-- ─── FETCH OUTFIT LIST ────────────────────────────────────────────────────────
local function fetchOutfits()
    local url = string.format(
        "https://avatar.roblox.com/v1/users/%d/outfits?page=1&itemsPerPage=50&isEditable=true",
        userId
    )
    local ok, body = pcall(httpGet, url)
    if not ok then
        warn("[AvatarSwapper] HTTP error:", body)
        return {}
    end
    local decoded = game:GetService("HttpService"):JSONDecode(body)
    local list = {}
    if decoded and decoded.data then
        for _, entry in ipairs(decoded.data) do
            table.insert(list, { id = entry.id, name = entry.name })
        end
    end
    return list
end

-- ─── APPLY OUTFIT ─────────────────────────────────────────────────────────────
-- Executors run in the client VM but some support ApplyDescriptionAsync
-- via the elevated identity level. Falls back to manual asset swapping
-- if the async method is blocked by the game.
local function applyOutfit(outfitId, statusCb)
    statusCb("Fetching description...")

    local ok, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
    end)

    if not ok or not desc then
        statusCb("ERR: Could not load description")
        warn("[AvatarSwapper] GetHumanoidDescriptionFromOutfitIdAsync failed:", desc)
        return
    end

    -- Refresh character reference in case of respawn
    character = lp.Character or lp.CharacterAdded:Wait()
    humanoid  = character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        statusCb("ERR: No Humanoid")
        return
    end

    statusCb("Applying...")
    local applyOk, applyErr = pcall(function()
        humanoid:ApplyDescriptionAsync(desc)
    end)

    if applyOk then
        statusCb("Done!")
    else
        -- Some games block ApplyDescriptionAsync — warn but don't crash
        warn("[AvatarSwapper] ApplyDescriptionAsync blocked:", applyErr)
        statusCb("Blocked by game")
    end
end

