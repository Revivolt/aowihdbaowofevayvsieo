-- ──────────────────────────────────────────
-- Helpers
-- ──────────────────────────────────────────

local function timestamp()
    return string.format("[%.3f]", tick())
end

local function serialize(v)
    local t = typeof(v)
    if t == "Instance" then
        return v:GetFullName()
    elseif t == "table" then
        local parts = {}
        for k, val in pairs(v) do
            parts[#parts+1] = tostring(k).."="..serialize(val)
        end
        return "{"..table.concat(parts, ", ").."}"
    else
        return tostring(v)
    end
end

local function fmtArgs(...)
    local args = {...}
    local out  = {}
    for i, v in ipairs(args) do
        out[i] = string.format("[%d](%s) %s", i, typeof(v), serialize(v))
    end
    return #out > 0 and table.concat(out, " | ") or "<no args>"
end

-- ──────────────────────────────────────────
-- Hook logic
-- ──────────────────────────────────────────

local hooked = {}

local REMOTE_CLASSES = {
    RemoteEvent           = true,
    RemoteFunction        = true,
    UnreliableRemoteEvent = true,
}

local function hookRemote(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    local path = remote:GetFullName()
    local kind = remote.ClassName

    if kind == "RemoteEvent" or kind == "UnreliableRemoteEvent" then
        remote.OnClientEvent:Connect(function(...)
            appendLine(string.format(
                "%s [%s]\n  Path: %s\n  Args: %s",
                timestamp(), kind, path, fmtArgs(...)
            ))
        end)

    elseif kind == "RemoteFunction" then
        remote.OnClientInvoke = function(...)
            appendLine(string.format(
                "%s [RemoteFunction INVOKE]\n  Path: %s\n  Args: %s",
                timestamp(), path, fmtArgs(...)
            ))
        end
    end
end

local function scanContainer(container)
    for _, obj in ipairs(container:GetDescendants()) do
        if REMOTE_CLASSES[obj.ClassName] then
            hookRemote(obj)
        end
    end
    container.DescendantAdded:Connect(function(obj)
        if REMOTE_CLASSES[obj.ClassName] then
            hookRemote(obj)
        end
    end)
end

