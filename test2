-- CursorGrab LocalScript
-- Place in: StarterPlayerScripts
--
-- Controls:
--   LeftCtrl + Left Click  →  Grab part under cursor
--   Left Click (again)     →  Drop part
--   E                      →  Drop part
--   Scroll Wheel           →  Push / pull part closer or farther

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")

local player  = Players.LocalPlayer
local mouse   = player:GetMouse()
local camera  = workspace.CurrentCamera

-- ─── CONFIG ────────────────────────────────────────────────────────────────
local MIN_DIST     = 3      -- studs (closest the part can be pulled)
local MAX_DIST     = 120    -- studs (furthest the part can be pushed)
local SCROLL_SPEED = 3      -- studs per scroll tick
-- ───────────────────────────────────────────────────────────────────────────

-- State
local heldPart     = nil
local heldModel    = nil
local holdDistance = 15

-- Invisible anchored part that follows the cursor — the part chases this
local cursorAnchor = nil

-- Constraints / attachments (stored so we can destroy them on release)
local AP, AO, A0, A1 = nil, nil, nil, nil

-- ─── CLEANUP ───────────────────────────────────────────────────────────────

local function releaseGrab()
    -- Destroy constraints and anchor
    if AP  then AP:Destroy()  AP  = nil end
    if AO  then AO:Destroy()  AO  = nil end
    if A0  then A0:Destroy()  A0  = nil end
    if A1  then A1:Destroy()  A1  = nil end
    if cursorAnchor then cursorAnchor:Destroy() cursorAnchor = nil end

    -- Restore collision on the grabbed model
    if heldModel then
        for _, v in ipairs(heldModel:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end

    heldPart  = nil
    heldModel = nil
end

-- ─── GRAB ──────────────────────────────────────────────────────────────────

mouse.Button1Down:Connect(function()
    -- Clicking while already holding → drop
    if heldPart then
        releaseGrab()
        return
    end

    -- Must be holding LeftCtrl and have a valid unanchored target
    if not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then return end
    if not mouse.Target then return end

    local target = mouse.Target
    if not target:IsA("BasePart") or target.Anchored then return end

    heldPart  = target
    heldModel = target.Parent

    -- Start hold distance = current distance to part (clamped)
    holdDistance = math.clamp(
        (camera.CFrame.Position - target.Position).Magnitude,
        MIN_DIST, MAX_DIST
    )

    -- ── Invisible cursor anchor ──────────────────────────────────────────
    cursorAnchor              = Instance.new("Part")
    cursorAnchor.Name         = "CursorAnchor"
    cursorAnchor.Size         = Vector3.new(0.05, 0.05, 0.05)
    cursorAnchor.Anchored     = true
    cursorAnchor.CanCollide   = false
    cursorAnchor.Transparency = 1
    cursorAnchor.CastShadow   = false
    cursorAnchor.CFrame       = target.CFrame
    cursorAnchor.Parent       = workspace

    -- ── Attachments ──────────────────────────────────────────────────────
    A0 = Instance.new("Attachment")
    A0.Parent = heldPart          -- lives on the grabbed part

    A1 = Instance.new("Attachment")
    A1.Parent = cursorAnchor      -- lives on the cursor anchor

    -- ── AlignPosition ────────────────────────────────────────────────────
    AP                 = Instance.new("AlignPosition")
    AP.Responsiveness  = 200
    AP.MaxForce        = math.huge
    AP.Attachment0     = A0
    AP.Attachment1     = A1
    AP.Parent          = heldPart

    -- ── AlignOrientation ─────────────────────────────────────────────────
    AO                 = Instance.new("AlignOrientation")
    AO.Responsiveness  = 200
    AO.MaxTorque       = math.huge
    AO.Attachment0     = A0
    AO.Attachment1     = A1
    AO.Parent          = heldPart

    -- ── Disable collision so it doesn't snag on the world ────────────────
    for _, v in ipairs(heldModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end
end)

-- ─── RELEASE WITH E ────────────────────────────────────────────────────────

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.E then
        releaseGrab()
    end
end)

-- ─── SCROLL: push / pull ───────────────────────────────────────────────────

mouse.WheelForward:Connect(function()
    holdDistance = math.clamp(holdDistance - SCROLL_SPEED, MIN_DIST, MAX_DIST)
end)

mouse.WheelBackward:Connect(function()
    holdDistance = math.clamp(holdDistance + SCROLL_SPEED, MIN_DIST, MAX_DIST)
end)

-- ─── FRAME LOOP: move cursor anchor along mouse ray ───────────────────────

RunService.RenderStepped:Connect(function()
    if not cursorAnchor or not heldPart then return end

    -- Safety: part was deleted externally
    if not heldPart:IsDescendantOf(workspace) then
        releaseGrab()
        return
    end

    -- Project mouse ray out to holdDistance and place the anchor there
    local ray       = camera:ScreenPointToRay(mouse.X, mouse.Y)
    local worldPos  = ray.Origin + ray.Direction * holdDistance
    cursorAnchor.CFrame = CFrame.new(worldPos)
end)
