-- // FPS BOOST — by Fox
-- // Executor: Synapse X / KRNL / Fluxus / etc.

local RunService    = game:GetService("RunService")
local Players       = game:GetService("Players")
local Lighting      = game:GetService("Lighting")
local StarterGui    = game:GetService("StarterGui")
local player        = Players.LocalPlayer

-- ─────────────────────────────────────────
--  1. UNCAP FPS
-- ─────────────────────────────────────────
if setfpscap then
    setfpscap(0)  -- 0 = fully uncapped
end

-- ─────────────────────────────────────────
--  2. FFLAGS — scheduler + renderer tweaks
-- ─────────────────────────────────────────
if setfflag then
    setfflag("DFIntTaskSchedulerTargetFps",        "9999")
    setfflag("FFlagDebugGraphicsDisableDirect3D11", "False")
    setfflag("FFlagEnableQuickGameLaunch",          "True")
    setfflag("FFlagGraphicsGLTextureReductionStep", "2")
    setfflag("UseOptimizedNetworkCompression",      "True")
    setfflag("FastNetworkReplication",              "True")
end

-- ─────────────────────────────────────────
--  3. GRAPHICS QUALITY → Level 1 (potato)
-- ─────────────────────────────────────────
settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

-- ─────────────────────────────────────────
--  4. LIGHTING — kill the heavy stuff
-- ─────────────────────────────────────────
Lighting.GlobalShadows    = false
Lighting.FogEnd           = 9e9   -- effectively disable fog
Lighting.FogStart         = 9e9
Lighting.Brightness       = 2
Lighting.Ambient          = Color3.fromRGB(128, 128, 128)  -- neutral, not pitch black
Lighting.ReflectionQuality = Enum.ReflectionQuality.NoReflection

-- kill post-processing effects
for _, fx in ipairs(Lighting:GetChildren()) do
    if fx:IsA("PostEffect") or fx:IsA("Sky") then
        fx:Destroy()
    end
end

-- ─────────────────────────────────────────
--  5. WORKSPACE — strip particles / beams
-- ─────────────────────────────────────────
local function stripEffects(root)
    for _, v in ipairs(root:GetDescendants()) do
        if v:IsA("ParticleEmitter")
        or v:IsA("Trail")
        or v:IsA("Beam")
        or v:IsA("Fire")
        or v:IsA("Smoke")
        or v:IsA("Sparkles") then
            v.Enabled = false
        elseif v:IsA("SpecialMesh") then
            -- leave meshes, they don't cost much
        elseif (v:IsA("Part") or v:IsA("MeshPart") or v:IsA("UnionOperation"))
               and v ~= workspace.Terrain then
            v.Reflectance = 0
            v.Material    = Enum.Material.SmoothPlastic
        end
    end
end

stripEffects(workspace)

-- also catch newly added stuff
workspace.DescendantAdded:Connect(function(v)
    if v:IsA("ParticleEmitter")
    or v:IsA("Trail")
    or v:IsA("Beam")
    or v:IsA("Fire")
    or v:IsA("Smoke")
    or v:IsA("Sparkles") then
        v.Enabled = false
    end
end)

-- ─────────────────────────────────────────
--  6. KILL IDLE RENDERSTEPPED CONNECTIONS
--     (executor-only: getconnections)
-- ─────────────────────────────────────────
if getconnections then
    for _, conn in ipairs(getconnections(RunService.RenderStepped)) do
        -- only disconnect foreign ones, not ours
        if conn.Function and not tostring(conn.Function):find("FPS_BOOST") then
            conn:Disable()
        end
    end
end

-- ─────────────────────────────────────────
--  7. CAMERA — tighten clip planes
-- ─────────────────────────────────────────
local cam = workspace.CurrentCamera
cam.NearPlaneZ = -0.1
-- don't touch FarPlane — can cause culling artifacts

-- ─────────────────────────────────────────
--  8. NOTIFY
-- ─────────────────────────────────────────
StarterGui:SetCore("SendNotification", {
    Title    = "FPS Boost",
    Text     = "Loaded. FPS uncapped, graphics stripped.",
    Duration = 5,
})

print("[FPS_BOOST] Done.")
