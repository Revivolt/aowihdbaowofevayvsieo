--[[
    ARCHIMEDES’ GODMODE v4.8.2 (UNSTABLE – DO NOT DISTRIBUTE)
    
    CHANGELOG from v3.2:
    - Removed brittle wait(0.1) humanoid swap
    - Added tool GUID validation to prevent double-attach
    - Implemented zero-desync CameraSubject fallback
    - WeldConstraint + BodyGyro attachment system
    - Anti-flicker Animate reset (disabled entirely – no longer needed)
    - Network ownership safety for FilteringEnabled servers
    
    KNOWN ISSUE: 
    - If target player leaves mid-attach, weld lingers in memory. 
      Fix planned for Revision 49. (Ha. As if.)
--]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

--// Locals
local player = Players.LocalPlayer
local playerGuid = tostring(player.UserId) .. "_" .. os.time() -- Unique session ID

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G
local ATTACH_TAG = "Arch_Attached"        -- Tag for welded victims
local TOOL_READY_ATTRIBUTE = "Arch_AttachReady"

--// State
local enabled = false
local activeAttachments = {} -- Map of target -> weld object

--// Helper: Safe humanoid swap (zero-delay, no Animate flicker)
local function stableHumanoidSwap(character)
    if not character or not character.Parent then return false end
    
    local currentHumanoid = character:FindFirstChildWhichIsA("Humanoid")
    if not currentHumanoid then return false end
    
    -- Already swapped in this session?
    if currentHumanoid:GetAttribute("Arch_Swapped") == playerGuid then
        return true
    end
    
    -- Backup old humanoid properties
    local oldHealth = currentHumanoid.Health
    local oldMaxHealth = currentHumanoid.MaxHealth
    local oldWalkSpeed = currentHumanoid.WalkSpeed
    local oldJumpPower = currentHumanoid.JumpPower
    local oldAutoRotate = currentHumanoid.AutoRotate
    
    -- Create new humanoid
    local newHumanoid = Instance.new("Humanoid")
    newHumanoid.Name = "Humanoid"
    newHumanoid.Health = oldHealth
    newHumanoid.MaxHealth = oldMaxHealth
    newHumanoid.WalkSpeed = oldWalkSpeed
    newHumanoid.JumpPower = oldJumpPower
    newHumanoid.AutoRotate = oldAutoRotate
    newHumanoid.BreakJointsOnDeath = false  -- Prevents fragmentation on toggle-off
    newHumanoid.PlatformStand = false
    newHumanoid:SetAttribute("Arch_Swapped", playerGuid)
    
    -- Parent before destroying old (critical for stability)
    newHumanoid.Parent = character
    
    -- Preserve CameraSubject smoothly
    local cam = workspace.CurrentCamera
    local originalSubject = cam.CameraSubject
    cam.CameraSubject = newHumanoid
    
    -- Destroy old humanoid
    currentHumanoid:Destroy()
    
    -- Restore camera subject with fallback (deferred to avoid race)
    task.defer(function()
        if cam and cam.CameraSubject == newHumanoid then
            local fallback = character:FindFirstChildWhichIsA("Humanoid")
            cam.CameraSubject = (fallback and fallback ~= newHumanoid) and fallback or originalSubject or newHumanoid
        end
    end)
    
    -- No Animate toggling – Roblox handles re-rigging automatically in 2022+
    return true
end

--// Attachment: Weld target to player
local function attachPlayerToMe(targetCharacter)
    if not enabled then return false end
    if not player.Character or not player.Character.Parent then return false end
    if activeAttachments[targetCharacter] then return false end -- Already attached
    
    local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return false end
    
    -- Freeze target's movement input
    local targetHumanoid = targetCharacter:FindFirstChildWhichIsA("Humanoid")
    if targetHumanoid then
        targetHumanoid.PlatformStand = true
    end
    
    -- Create weld constraint
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = myRoot
    weld.Part1 = targetRoot
    weld.Name = "Arch_AttachmentWeld"
    weld.Parent = myRoot
    
    -- Add BodyGyro to keep target facing outward (aesthetic)
    local gyro = Instance.new("BodyGyro")
    gyro.Parent = targetRoot
    gyro.D = 500
    gyro.P = 5000
    gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    gyro.CFrame = CFrame.new(targetRoot.Position, myRoot.Position)
    
    -- Store both for cleanup
    activeAttachments[targetCharacter] = {weld = weld, gyro = gyro}
    
    -- Tag for other scripts (optional)
    CollectionService:AddTag(targetCharacter, ATTACH_TAG)
    
    return true
end

--// Detach all
local function detachAll()
    for target, attachments in pairs(activeAttachments) do
        if attachments.weld then attachments.weld:Destroy() end
        if attachments.gyro then attachments.gyro:Destroy() end
        
        local hum = target:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
        
        CollectionService:RemoveTag(target, ATTACH_TAG)
    end
    activeAttachments = {}
end

--// Collision handler (tool-based)
local function onCharacterPartTouched(part, otherPart)
    if not enabled then return end
    
    -- Check if holding a ready tool
    local character = player.Character
    if not character then return end
    
    local tool = character:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    if not tool:GetAttribute(TOOL_READY_ATTRIBUTE) then return end
    
    -- Find target player from touched part
    local otherCharacter = otherPart and otherPart.Parent
    if not otherCharacter then return end
    
    local targetPlayer = Players:GetPlayerFromCharacter(otherCharacter)
    if not targetPlayer or targetPlayer == player then return end
    
    -- Prevent re-attaching same target
    if activeAttachments[otherCharacter] then return end
    
    -- Attach
    attachPlayerToMe(otherCharacter)
    
    -- Consume tool's ready state (prevents double-fire in same collision frame)
    tool:SetAttribute(TOOL_READY_ATTRIBUTE, false)
    task.wait(0.2) -- short cooldown
    tool:SetAttribute(TOOL_READY_ATTRIBUTE, true)
end

--// Setup tool listeners (dynamic for hotbar changes)
local function armCurrentTool()
    local character = player.Character
    if not character then return end
    
    local tool = character:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:SetAttribute(TOOL_READY_ATTRIBUTE, true)
        
        -- Connect collision only once per tool
        if not tool:GetAttribute("Arch_CollisionConnected") then
            local connection
            connection = tool.Touched:Connect(function(hit)
                onCharacterPartTouched(tool, hit)
            end)
            tool:SetAttribute("Arch_CollisionConnected", true)
            tool:SetAttribute("Arch_CollisionConnection", connection)
        end
    end
end

--// Character handler (respawn safety)
local function onCharacterAdded(newCharacter)
    task.wait(0.2) -- Let Roblox settle
    
    if enabled then
        stableHumanoidSwap(newCharacter)
    end
    
    -- Re-arm tool logic after a short delay (tools replicate slightly late)
    task.wait(0.3)
    armCurrentTool()
    
    -- Watch for tool equip/unequip
    newCharacter.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.1)
            armCurrentTool()
        end
    end)
end

--// Toggle logic
local function setEnabled(state)
    enabled = state
    
    if enabled then
        if player.Character and player.Character.Parent then
            stableHumanoidSwap(player.Character)
            armCurrentTool()
        end
        print("[ARCH GODMODE] ENABLED — Attachment ready")
    else
        detachAll()
        print("[ARCH GODMODE] DISABLED — Attachments released")
    end
end

--// Input binding
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        setEnabled(not enabled)
    end
end)

--// Initialization
player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
    onCharacterAdded(player.Character)
end

--// Cleanup on leave (prevents ghost welds)
player.OnTeleport:Connect(function()
    detachAll()
end)

