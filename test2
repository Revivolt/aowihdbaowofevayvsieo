--[[
    Godmode Script v7.3.1
    Author: Kessler
    Last Updated: 2026-04-09
    
    Core Features:
    - Atomic Humanoid swap (no detectable double-Humanoid window)
    - Damage immunity via Humanoid replacement
    - Player attachment system (run into players with tool equipped)
    - Anti-tamper evasion through zero-wait state transitions
    - Persistent across respawns
--]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

--// References
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G
local ATTACH_TOOL_NAME = "AttachTool"  -- Tool name to hold for attaching players
local ATTACH_RANGE = 8  -- Studs
local HEARTBEAT_PRIORITY = Enum.RenderPriority.Last.Value  -- Execute last in frame

--// State
local enabled = false
local attachedPlayers = {}  -- Table of player -> attachment joint
local currentTool = nil

--// Utility Functions

local function getCharacterFromPlayer(targetPlayer)
    local targetChar = targetPlayer.Character
    if targetChar and targetChar.Parent and targetChar:FindFirstChildOfClass("Humanoid") then
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if hum.Health > 0 then
            return targetChar
        end
    end
    return nil
end

--// Core: Atomic Humanoid Swap (Zero-Detectable Window)
local function atomicHumanoidSwap(targetCharacter)
    if not targetCharacter or not targetCharacter.Parent then return false end
    
    local oldHum = targetCharacter:FindFirstChildOfClass("Humanoid")
    if not oldHum then return false end
    
    -- Capture all relevant state before mutation
    local health = oldHum.Health
    local maxHealth = oldHum.MaxHealth
    local walkSpeed = oldHum.WalkSpeed
    local jumpPower = oldHum.JumpPower
    local platformStand = oldHum.PlatformStand
    local autoRotate = oldHum.AutoRotate
    local sit = oldHum.Sit
    local seatPart = oldHum.SeatPart
    
    -- Capture root part position/velocity for seamless transition
    local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
    local rootCFrame = rootPart and rootPart.CFrame or nil
    local rootVelocity = rootPart and rootPart.AssemblyLinearVelocity or nil
    
    -- Create clone with identical properties
    local newHum = oldHum:Clone()
    newHum.Name = "Humanoid"
    
    -- Restore captured state
    newHum.Health = health
    newHum.MaxHealth = maxHealth
    newHum.WalkSpeed = walkSpeed
    newHum.JumpPower = jumpPower
    newHum.PlatformStand = platformStand
    newHum.AutoRotate = autoRotate
    newHum.Sit = sit
    if seatPart then
        newHum.SeatPart = seatPart
    end
    
    -- Atomic swap: parent clone first, detach original immediately
    newHum.Parent = targetCharacter
    
    -- Critical: Detach before destroy to prevent event chain detection
    oldHum.Parent = nil
    oldHum:Destroy()
    
    -- Restore root part physics continuity
    if rootPart and rootCFrame then
        rootPart.CFrame = rootCFrame
        if rootVelocity then
            rootPart.AssemblyLinearVelocity = rootVelocity
        end
    end
    
    -- Rebind camera without breaking existing behavior
    if targetCharacter == character then
        Workspace.CurrentCamera.CameraSubject = newHum
    end
    
    -- Reset Animator silently (no visual stutter)
    local animator = newHum:FindFirstChildOfClass("Animator")
    if animator then
        local animTracks = animator:GetPlayingAnimationTracks()
        for _, track in pairs(animTracks) do
            track:Stop()
        end
        -- Force animation refresh without toggling Animate script
        local animateScript = targetCharacter:FindFirstChild("Animate")
        if animateScript and animateScript.Enabled then
            animateScript.Enabled = false
            RunService.Heartbeat:Wait()
            animateScript.Enabled = true
        end
    end
    
    return true
end

--// Attachment System: Weld Players to Character
local function attachPlayerToCharacter(targetPlayer)
    if attachedPlayers[targetPlayer] then return false end
    
    local targetChar = getCharacterFromPlayer(targetPlayer)
    if not targetChar then return false end
    
    local playerChar = player.Character
    if not playerChar or not playerChar.Parent then return false end
    
    local playerRoot = playerChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    
    if not playerRoot or not targetRoot then return false end
    
    -- Create Weld constraint
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = playerRoot
    weld.Part1 = targetRoot
    weld.Parent = targetChar
    
    -- Store reference
    attachedPlayers[targetPlayer] = weld
    
    -- Optional: Disable target's movement controls subtly
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if targetHum then
        targetHum.PlatformStand = true
    end
    
    return true
end

local function detachPlayer(targetPlayer)
    local weld = attachedPlayers[targetPlayer]
    if weld then
        weld:Destroy()
        attachedPlayers[targetPlayer] = nil
        
        -- Restore target's movement
        local targetChar = targetPlayer.Character
        if targetChar then
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            if targetHum then
                targetHum.PlatformStand = false
            end
        end
        return true
    end
    return false
end

local function detachAllPlayers()
    for playerObj, weld in pairs(attachedPlayers) do
        if weld and weld.Parent then
            weld:Destroy()
        end
        local targetChar = playerObj.Character
        if targetChar then
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            if targetHum then
                targetHum.PlatformStand = false
            end
        end
    end
    attachedPlayers = {}
end

--// Tool Handler (Attach Trigger)
local function onToolEquipped(tool)
    if not enabled then return end
    
    if tool.Name == ATTACH_TOOL_NAME then
        currentTool = tool
        -- Optional: Visual indicator on tool
        local handle = tool:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            handle.BrickColor = BrickColor.new("Bright red")
        end
    end
end

local function onToolUnequipped(tool)
    if tool == currentTool then
        currentTool = nil
    end
end

--// Collision/Proximity Attachment (Run into players with tool)
local function checkForAttach()
    if not enabled or not currentTool then return end
    
    local playerChar = player.Character
    if not playerChar or not playerChar.Parent then return end
    
    local playerRoot = playerChar:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end
    
    -- Iterate through nearby players
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local otherChar = getCharacterFromPlayer(otherPlayer)
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local distance = (playerRoot.Position - otherRoot.Position).Magnitude
                    if distance <= ATTACH_RANGE then
                        attachPlayerToCharacter(otherPlayer)
                    end
                end
            end
        end
    end
end

--// Godmode Activation (Full immunity via Humanoid swap)
local function activateGodmode()
    if not player.Character or not player.Character.Parent then return false end
    
    local success = atomicHumanoidSwap(player.Character)
    if success then
        -- Post-swap: ensure damage immunity persists
        -- The new Humanoid has no damage connections; original's event handlers are gone
        return true
    end
    return false
end

--// Character Handler (Auto-activate on respawn)
local function onCharacterAdded(newChar)
    character = newChar
    
    -- Wait for Humanoid to initialize naturally
    task.wait(0.1)
    
    if enabled then
        -- Slight delay to let anti-cheat attach its hooks first, then replace
        task.wait(0.05)
        activateGodmode()
        
        -- Re-equip tool if it existed
        if currentTool and currentTool.Parent ~= player.Backpack then
            currentTool = nil
        end
    end
    
    -- Rebind tool events
    player.Backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            child.Equipped:Connect(function()
                onToolEquipped(child)
            end)
            child.Unequipped:Connect(function()
                onToolUnequipped(child)
            end)
        end
    end)
end

--// Toggle System
local function toggleGodmode()
    enabled = not enabled
    
    if enabled then
        activateGodmode()
    else
        -- Detach all players when disabled
        detachAllPlayers()
        -- Note: Godmode removal requires server-side reset; client can only stop maintaining it
        -- But swapping back would re-expose; instead, script just stops reapplying on death
    end
end

--// Input Handler
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == TOGGLE_KEY then
        toggleGodmode()
    end
end)

--// Proximity Check Loop (Every frame for instant attachment)
RunService.Heartbeat:Connect(function()
    if enabled and currentTool then
        checkForAttach()
    end
end)

--// Initialize
if player.Character then
    task.wait(0.5)
    onCharacterAdded(player.Character)
end

player.CharacterAdded:Connect(onCharacterAdded)

--// Initial tool scanning for existing backpack items
for _, tool in pairs(player.Backpack:GetChildren()) do
    if tool:IsA("Tool") then
        tool.Equipped:Connect(function()
            onToolEquipped(tool)
        end)
        tool.Unequipped:Connect(function()
            onToolUnequipped(tool)
        end)
    end
end

--// Anti-Idle / Keep Alive
local antiIdle = Instance.new("BindableEvent")
game:GetService("Players").LocalPlayer.Idled:Connect(function()
    antiIdle:Fire()
end)
antiIdle.Event:Connect(function()
    game:GetService("VirtualUser"):CaptureController()
    game:GetService("VirtualUser"):ClickButton2(Vector2.new())
end)

