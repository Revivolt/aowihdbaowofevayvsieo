--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

--// Settings
local TOGGLE_KEY = Enum.KeyCode.G
local ATTACH_TOOL_NAME = "GodCollar"  -- Tool name to hold for attachment mechanic
local MAX_HUMANOID_WAIT = 0.2         -- Seconds to wait for Humanoid to stabilize

--// State
local enabled = false
local activeAttachments = {}           -- table of {targetRoot, alignPos, lineVel}

--// Helper: Adaptive Humanoid wait (replaces hardcoded task.wait(0.5))
local function waitForStableHumanoid(character)
    local startTime = tick()
    local humanoid = nil
    repeat
        humanoid = character:FindFirstChildWhichIsA("Humanoid")
        if humanoid and humanoid.Parent then
            -- Extra check: Humanoid must have a valid RootPart
            local rootPart = humanoid.RootPart
            if rootPart and rootPart.Parent then
                return humanoid
            end
        end
        task.wait()
    until (tick() - startTime) > MAX_HUMANOID_WAIT
    return nil  -- Fallback: let pcall handle
end

--// Core: Replace Humanoid without animation stutter (deparenting ghost method)
local function replaceHumanoidSmooth(character)
    local oldHumanoid = character:FindFirstChildWhichIsA("Humanoid")
    if not oldHumanoid then return false end
    
    -- Already replaced once this session? Avoid loops
    if character:FindFirstChild("_CipherPatched") then return false end
    
    -- Rename old one to preserve it temporarily
    oldHumanoid.Name = "OldHumanoid"
    
    -- Clone and insert new
    local newHumanoid = oldHumanoid:Clone()
    newHumanoid.Name = "Humanoid"
    newHumanoid.Parent = character
    
    -- Wait one frame for engine to register new Humanoid
    task.wait()
    
    -- Ghost the old one (deparent, don't destroy)
    oldHumanoid.Parent = nil
    
    -- Reassign camera
    if workspace.CurrentCamera then
        workspace.CurrentCamera.CameraSubject = newHumanoid
    end
    
    -- Reset Animate without double-flip (just restart if needed)
    local animate = character:FindFirstChild("Animate")
    if animate and animate:IsA("LocalScript") then
        local wasEnabled = animate.Disabled
        animate.Disabled = true
        task.wait(0.05)
        animate.Disabled = wasEnabled
    end
    
    -- Mark as patched to prevent infinite loops
    local marker = Instance.new("BoolValue")
    marker.Name = "_CipherPatched"
    marker.Parent = character
    
    -- Schedule old humanoid cleanup after 2 seconds (engine fully migrated)
    task.spawn(function()
        task.wait(2)
        local ghost = character:FindFirstChild("OldHumanoid")
        if ghost then ghost:Destroy() end
    end)
    
    return true
end

--// Godmode execution
local function applyGodmode()
    if not player.Character or not player.Character.Parent then return end
    
    local character = player.Character
    local humanoid = waitForStableHumanoid(character)
    
    if not humanoid then return end
    
    -- Only run replacement if not already patched
    if not character:FindFirstChild("_CipherPatched") then
        local success = replaceHumanoidSmooth(character)
        if not success then
            -- Fallback: legacy method (destroy old)
            local old = character:FindFirstChild("OldHumanoid")
            if old then old:Destroy() end
        end
    end
    
    -- Make humanoid invincible (godmode core)
    humanoid.BreakJointsOnDeath = false
    humanoid.MaxHealth = math.huge
    humanoid.Health = math.huge
    
    -- Disable damage events
    local debounce = Instance.new("BoolValue")
    debounce.Name = "GodmodeActive"
    debounce.Parent = character
    
    humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if humanoid.Health < humanoid.MaxHealth and enabled then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
end

--// ATTACHMENT MECHANISM (2026 physics: AlignPosition + LinearVelocity)
local function attachPlayerToMe(targetPlayer)
    if not enabled then return end
    if not player.Character or not player.Character.PrimaryPart then return end
    
    local targetChar = targetPlayer.Character
    if not targetChar or not targetChar.PrimaryPart then return end
    
    local myRoot = player.Character.PrimaryPart
    local targetRoot = targetChar.PrimaryPart
    
    -- Create AlignPosition (keeps target at exact offset relative to me)
    local alignPos = Instance.new("AlignPosition")
    alignPos.Parent = targetRoot
    alignPos.Attachment0 = Instance.new("Attachment", targetRoot)
    alignPos.Attachment1 = Instance.new("Attachment", myRoot)
    alignPos.Attachment0.Position = Vector3.new(0, 0, 2) -- 2 studs in front of me
    alignPos.RigidityEnabled = true
    alignPos.MaxForce = 1000000
    alignPos.Responsiveness = 200
    
    -- Create LinearVelocity to kill target's independent movement
    local lineVel = Instance.new("LinearVelocity")
    lineVel.Parent = targetRoot
    lineVel.MaxForce = 1000000
    lineVel.VectorVelocity = Vector3.new(0, 0, 0)
    lineVel.Attachment = alignPos.Attachment0
    
    -- Disable target's normal movement
    local targetHumanoid = targetChar:FindFirstChildWhichIsA("Humanoid")
    if targetHumanoid then
        targetHumanoid.PlatformStand = true
        targetHumanoid.WalkSpeed = 0
        targetHumanoid.JumpPower = 0
    end
    
    -- Store for cleanup
    table.insert(activeAttachments, {
        root = targetRoot,
        alignPos = alignPos,
        lineVel = lineVel,
        humanoid = targetHumanoid,
        oldWalkSpeed = targetHumanoid and targetHumanoid.WalkSpeed or 16,
        oldJumpPower = targetHumanoid and targetHumanoid.JumpPower or 50
    })
    
    -- Heartbeat update: reposition Attachment1 to my current CFrame
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not enabled or not myRoot.Parent or not targetRoot.Parent then
            connection:Disconnect()
            return
        end
        if alignPos and alignPos.Attachment1 then
            alignPos.Attachment1.CFrame = myRoot.CFrame
        end
    end)
    
    -- Store connection too
    activeAttachments[#activeAttachments].heartbeatConnection = connection
end

--// Detach all players
local function detachAllPlayers()
    for _, data in pairs(activeAttachments) do
        if data.alignPos then data.alignPos:Destroy() end
        if data.lineVel then data.lineVel:Destroy() end
        if data.heartbeatConnection then data.heartbeatConnection:Disconnect() end
        if data.humanoid then
            data.humanoid.PlatformStand = false
            data.humanoid.WalkSpeed = data.oldWalkSpeed
            data.humanoid.JumpPower = data.oldJumpPower
        end
    end
    activeAttachments = {}
end

--// Collision handler for tool-based attachment
local function onToolEquipped(tool)
    if not enabled then return end
    if tool.Name ~= ATTACH_TOOL_NAME then return end
    
    -- Connect touch event on tool's handle
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    
    local touchConn
    touchConn = handle.Touched:Connect(function(hit)
        if not enabled then return end
        local character = hit.Parent
        if not character then return end
        
        local humanoid = character:FindFirstChildWhichIsA("Humanoid")
        if not humanoid then return end
        
        local targetPlayer = Players:GetPlayerFromCharacter(character)
        if targetPlayer and targetPlayer ~= player then
            attachPlayerToMe(targetPlayer)
        end
    end)
    
    -- Store connection on tool for cleanup
    tool._touchConnection = touchConn
end

--// Character handler (respawn-safe)
local function onCharacterAdded()
    -- Wait for character to fully load
    local character = player.Character
    if not character then return end
    
    -- Remove any leftover attachments from previous life
    detachAllPlayers()
    
    -- Apply godmode if enabled
    if enabled then
        local success, err = pcall(applyGodmode)
        if not success then
            warn("Godmode apply failed:", err)
        end
    end
    
    -- Re-bind tool equip handler
    player.Backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and child.Name == ATTACH_TOOL_NAME then
            onToolEquipped(child)
        end
    end)
    
    -- Also check currently held tool
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool and currentTool.Name == ATTACH_TOOL_NAME then
        onToolEquipped(currentTool)
    end
end

--// Toggle input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        
        if enabled then
            detachAllPlayers()  -- Clean old attachments on re-enable
            pcall(applyGodmode)
        else
            -- Disable godmode: restore normal health limits
            if player.Character then
                local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
                if humanoid then
                    humanoid.MaxHealth = 100
                    humanoid.BreakJointsOnDeath = true
                end
            end
            detachAllPlayers()
        end
    end
end)

--// Initialization
if player.Character then
    onCharacterAdded()
end
player.CharacterAdded:Connect(onCharacterAdded)

--// Cleanup on leave (good practice)
player.AncestryChanged:Connect(function()
    if not player.Parent then
        detachAllPlayers()
    end
end)
