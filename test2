-- ──────────────────────────────────────────
-- Log state
-- ──────────────────────────────────────────

local logLines  = {}   -- string[]
local fireCount = 0

local function scrollToBottom()
    -- defer one frame so AutomaticCanvasSize has updated
    task.defer(function()
        scrollFrame.CanvasPosition = Vector2.new(
            0, math.max(0, scrollFrame.AbsoluteCanvasSize.Y
                         - scrollFrame.AbsoluteSize.Y)
        )
    end)
end

local function appendLine(line)
    fireCount += 1
    logLines[#logLines + 1] = line
    logBox.Text    = table.concat(logLines, "\n")
    counter.Text   = fireCount .. " fires"
    scrollToBottom()
end

