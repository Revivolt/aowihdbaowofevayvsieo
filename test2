-- Remote Logger | LocalScript
-- Hooks all RemoteEvents & RemoteFunctions, logs server->client traffic

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local hooked = {} -- track what we already hooked so we don't double-hook

local function serialize(value, depth)
    depth = depth or 0
    if depth > 4 then return "<too deep>" end

    local t = typeof(value)
    if t == "string" then
        return '"' .. value .. '"'
    elseif t == "number" or t == "boolean" then
        return tostring(value)
    elseif t == "nil" then
        return "nil"
    elseif t == "Instance" then
        return value:GetFullName()
    elseif t == "Vector3" or t == "Vector2" or t == "CFrame" or t == "Color3"
        or t == "UDim2" or t == "UDim" or t == "BrickColor" or t == "Enum" then
        return tostring(value)
    elseif t == "table" then
        local parts = {}
        local isArray = (#value > 0)
        for k, v in pairs(value) do
            if isArray then
                table.insert(parts, serialize(v, depth + 1))
            else
                table.insert(parts, "[" .. serialize(k, depth + 1) .. "] = " .. serialize(v, depth + 1))
            end
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    else
        return "<" .. t .. ">" -- userdata, function, etc
    end
end

local function formatArgs(args)
    if not args or #args == 0 then return "(no args)" end
    local out = {}
    for i, v in ipairs(args) do
        table.insert(out, "  [" .. i .. "] " .. typeof(v) .. " = " .. serialize(v))
    end
    return table.concat(out, "\n")
end

local function hookRemoteEvent(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    remote.OnClientEvent:Connect(function(...)
        local args = {...}
        print(string.rep("=", 60))
        print("[REMOTE EVENT] " .. remote:GetFullName())
        print("[TIME] " .. os.clock())
        print("[ARGS]")
        print(formatArgs(args))
        print(string.rep("=", 60))
    end)
end

local function hookRemoteFunction(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    local originalInvoke = remote.OnClientInvoke

    remote.OnClientInvoke = function(...)
        local args = {...}
        print(string.rep("=", 60))
        print("[REMOTE FUNCTION] " .. remote:GetFullName())
        print("[TIME] " .. os.clock())
        print("[ARGS]")
        print(formatArgs(args))
        print(string.rep("=", 60))

        if originalInvoke then
            return originalInvoke(...)
        end
    end
end

local function hookRemote(obj)
    if obj:IsA("RemoteEvent") then
        hookRemoteEvent(obj)
    elseif obj:IsA("RemoteFunction") then
        hookRemoteFunction(obj)
    end
end

local function scanDescendants(root)
    for _, obj in ipairs(root:GetDescendants()) do
        hookRemote(obj)
    end
end

local function watchForNew(root)
    root.DescendantAdded:Connect(function(obj)
        task.defer(function()
            hookRemote(obj)
        end)
    end)
end

-- main
scanDescendants(game)
watchForNew(game)

print("[REMOTE LOGGER] Active — monitoring all RemoteEvents & RemoteFunctions")
