-- WAIT FOR CHARACTER
-- ══════════════════════════════════════════════════════════════
local Character, HumanoidRootPart, Humanoid, Camera

local function initCharacter()
    Character         = LocalPlayer.Character
    HumanoidRootPart  = Character and Character:FindFirstChild("HumanoidRootPart")
    Humanoid          = Character and Character:FindFirstChildOfClass("Humanoid")
    Camera            = workspace.CurrentCamera
end

initCharacter()
LocalPlayer.CharacterAdded:Connect(function(char)
    Character         = char
    HumanoidRootPart  = char:WaitForChild("HumanoidRootPart")
    Humanoid          = char:WaitForChild("Humanoid")
    Camera            = workspace.CurrentCamera
    Camera.CameraType = Enum.CameraType.Custom
end)

-- ══════════════════════════════════════════════════════════════
-- 1.  REMOVE MOBILE UI
-- ══════════════════════════════════════════════════════════════
local function killTouchGui()
    local tg = PlayerGui:FindFirstChild("TouchGui")
    if tg then tg:Destroy() end
end
killTouchGui()
PlayerGui.ChildAdded:Connect(function(c)
    if c.Name == "TouchGui" then task.defer(function() c:Destroy() end) end
end)

