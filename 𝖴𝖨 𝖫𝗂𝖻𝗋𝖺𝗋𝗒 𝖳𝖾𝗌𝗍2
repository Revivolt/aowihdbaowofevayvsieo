-- Heartbeats 8 studs below the target player for the given duration
local function doUnderTargetPhase(targetPlayer, duration)
    local elapsed = 0
    local conn
    conn = nanRun.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt

        local myChar = nanLocal.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            conn:Disconnect()
            return
        end

        if elapsed >= duration then
            conn:Disconnect()
            return
        end

        local tgtChar = targetPlayer.Character
        local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
        if not tgtRoot then return end

        pcall(function()
            local underPos = tgtRoot.Position - Vector3.new(0, 20, 0)
            myRoot.CFrame = CFrame.new(underPos)
            myRoot.AssemblyLinearVelocity  = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
        end)
    end)

    -- Block until this phase finishes
    while elapsed < duration do
        task.wait()
        if not cycleActive then break end
    end
end

