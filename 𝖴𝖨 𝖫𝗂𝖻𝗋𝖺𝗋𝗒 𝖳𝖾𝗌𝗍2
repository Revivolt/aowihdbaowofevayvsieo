                    task.wait(0.5)
                    if cycleActive then
                        stopCpConn()
                        if cycleThread then
                            task.cancel(cycleThread)
                            cycleThread = nil
                        end
                        -- keep cycleActive = true so applyAll's defer triggers startCycle
                        pcall(applyAll)
                    end
                end)
            else
                if charConnection then charConnection:Disconnect() charConnection = nil end
                stopCycle()
                resetCharacter()
            end
        end,
    })
end



