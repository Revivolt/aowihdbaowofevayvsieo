        camera.CameraSubject = cpSavedCamSubject
        cpSavedCamSubject = nil
    else
        local realChar = weldLocal.Character
        local realHum  = realChar and realChar:FindFirstChild("Humanoid")
        if realHum then camera.CameraSubject = realHum end
    end

    if cpFakeChar and cpRealChar then
        local fakeRoot = cpFakeChar:FindFirstChild("HumanoidRootPart")
        local realRoot = cpRealChar:FindFirstChild("HumanoidRootPart")
        if fakeRoot and realRoot then
            realRoot.CFrame = fakeRoot.CFrame
        end
    end

    cpRestoreTracks(cpRealChar)
    cpCleanupFakeChar()
end

local function cpSpawnFakeChar()
    local char = weldLocal.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    cpRealChar = char
    char.Archivable = true

    cpFakeChar = char:Clone()
    cpFakeChar.Name = "WallClone"
    cpFakeChar.Parent = workspace

    local fakeHum  = cpFakeChar:FindFirstChild("Humanoid")
    local fakeRoot = cpFakeChar:FindFirstChild("HumanoidRootPart")
    if not fakeHum or not fakeRoot then return end

    for _, v in pairs(cpFakeChar:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("Script") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.Anchored   = false
            v.CanCollide = (v.Name == "HumanoidRootPart")
            if v.Name == "HumanoidRootPart" then
                v.Transparency = 1
            end
        end
    end

    local cloneAnimate = cpFakeChar:FindFirstChild("Animate")
    if cloneAnimate then cloneAnimate.Disabled = true end

    local realRoot = char:FindFirstChild("HumanoidRootPart")
    if realRoot then
        fakeRoot.CFrame = realRoot.CFrame
    end

    local charAnims = cpGetCharAnims(char)
    local function LoadAnim(id)
        if not id then return nil end
        local a = Instance.new("Animation")
        a.AnimationId = id
        return fakeHum:LoadAnimation(a)
    end

    cpFakeAnimTracks.Idle = LoadAnim(charAnims.Idle)
    cpFakeAnimTracks.Walk = LoadAnim(charAnims.Walk)
    cpFakeAnimTracks.Run  = LoadAnim(charAnims.Run)
    cpFakeAnimTracks.Jump = LoadAnim(charAnims.Jump)
    cpFakeAnimTracks.Fall = LoadAnim(charAnims.Fall)

    if cpFakeAnimTracks.Idle then cpFakeAnimTracks.Idle:Play() end

    -- Set camera to fake humanoid
    local camera = workspace.CurrentCamera
    cpSavedCamSubject    = camera.CameraSubject
    camera.CameraSubject = fakeHum

    -- Re-enforce camera subject whenever any game script tries to override it
    cpCamConn = camera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
        if not cpFakeChar then return end
        local fHum = cpFakeChar:FindFirstChild("Humanoid")
        if fHum and camera.CameraSubject ~= fHum then
            camera.CameraSubject = fHum
        end
    end)

    fakeHum.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Jumping then
            cpStopFakeAnims()
            if cpFakeAnimTracks.Jump then cpFakeAnimTracks.Jump:Play() end
        elseif newState == Enum.HumanoidStateType.Freefall then
            cpStopFakeAnims()
            if cpFakeAnimTracks.Fall then cpFakeAnimTracks.Fall:Play() end
        elseif newState == Enum.HumanoidStateType.Landed then
            cpStopFakeAnims()
            if cpFakeAnimTracks.Idle then cpFakeAnimTracks.Idle:Play() end
        end
    end)

    cpTransparencyConn = RunService.RenderStepped:Connect(function()
        if not cpFakeChar then return end
        local cam   = workspace.CurrentCamera
        local fakeH = cpFakeChar:FindFirstChild("Head")
        local inFirstPerson = fakeH and cam and
            (cam.CFrame.Position - fakeH.Position).Magnitude < 2.5

        for _, part in pairs(cpFakeChar:GetDescendants()) do
            if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = inFirstPerson and 1 or 0
            end
        end
    end)

    cpRenderConn = RunService.RenderStepped:Connect(function()
        if not cpFakeChar or not fakeHum or not fakeRoot then return end

        local UIS = game:GetService("UserInputService")

        local inputVector = Vector3.zero
        if cpControls then
            inputVector = cpControls:GetMoveVector()
        else
            if UIS:IsKeyDown(Enum.KeyCode.W) then inputVector += Vector3.new(0, 0, -1) end
            if UIS:IsKeyDown(Enum.KeyCode.S) then inputVector += Vector3.new(0, 0,  1) end
            if UIS:IsKeyDown(Enum.KeyCode.A) then inputVector += Vector3.new(-1, 0, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.D) then inputVector += Vector3.new( 1, 0, 0) end
        end

        local currentState = fakeHum:GetState()
        if UIS:IsKeyDown(Enum.KeyCode.Space) and
            currentState ~= Enum.HumanoidStateType.Jumping and
            currentState ~= Enum.HumanoidStateType.Freefall then
            fakeHum.Jump = true
        end

        local camCF    = workspace.CurrentCamera.CFrame
        local finalDir = (camCF.RightVector * inputVector.X) + (camCF.LookVector * -inputVector.Z)
        finalDir = Vector3.new(finalDir.X, 0, finalDir.Z)

        local isGrounded =
            currentState == Enum.HumanoidStateType.Running or
            currentState == Enum.HumanoidStateType.RunningNoPhysics

        if finalDir.Magnitude > 0.01 then
            fakeHum:Move(finalDir.Unit, false)
            if isGrounded then
                if cpFakeAnimTracks.Run and not cpFakeAnimTracks.Run.IsPlaying then
                    cpStopFakeAnims()
                    cpFakeAnimTracks.Run:Play(0.1)
                end
            end
        else
            fakeHum:Move(Vector3.zero, false)
            if isGrounded then
                if cpFakeAnimTracks.Idle and not cpFakeAnimTracks.Idle.IsPlaying then
                    cpStopFakeAnims()
                    cpFakeAnimTracks.Idle:Play(0.1)
                end
            end
        end
    end)
end

Tab:AddToggle({
    Label   = "Wall (Layered Clothing)",
    Default = false,
    Callback = function(state)
        cpEnabled = state

        if not cpEnabled then
            activeFlingCount = math.max(0, activeFlingCount - 1)
            cleanupToggle(cpConn, cpTrack, cpNoCollide, nil)
            cpConn       = nil
            cpTrack      = nil
            lastChar     = nil
            cpRespawning = false
            cpDestroyFakeChar()
            return
        end

        if not selectedTarget then return end
        activeFlingCount = activeFlingCount + 1

        local initChar = weldLocal.Character
        if initChar then
            lastChar = initChar
            cpTrack  = cpLoadEmote(initChar)
            cpSpawnFakeChar()
        end

        cpConn = weldRun.Heartbeat:Connect(function()
            if not cpEnabled then return end
            if cpRespawning then return end

            if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                cpEnabled = false
                activeFlingCount = math.max(0, activeFlingCount - 1)
                cleanupToggle(cpConn, cpTrack, cpNoCollide, "Wall (Layered Clothing)")
                cpConn       = nil
                cpTrack      = nil
                lastChar     = nil
                cpRespawning = false
                cpDestroyFakeChar()
                return
            end

            local myChar = weldLocal.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myChar or not myRoot then return end

            local tgtChar = selectedTarget.Character
            local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
            if not tgtChar or not tgtRoot then return end

            if myChar ~= lastChar then
                lastChar     = myChar
                cpRespawning = true

                cpCleanupFakeChar()
                local newHum = myChar:FindFirstChild("Humanoid")
                if newHum then
                    workspace.CurrentCamera.CameraSubject = newHum
                    cpSavedCamSubject = newHum
                end

                if cpTrack then
                    cpTrack:Stop()
                    cpTrack:Destroy()
                    cpTrack = nil
                end
                cpSavedTracks = {}

                task.spawn(function()
                    task.wait(0.5)
                    if not cpEnabled then return end
                    cpTrack = cpLoadEmote(myChar)
                    cpSpawnFakeChar()
                    cpRespawning = false
                end)

                return
            end

            pcall(function()
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") and cpNoCollide then
                        part.CanCollide = false
                    end
                end

                local hum      = myChar:FindFirstChildOfClass("Humanoid")
                local animator = hum and hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        if track ~= cpTrack then
                            track:Stop(0)
                        end
                    end
                end

                local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                local yaw = cpFaceBack and (tgtYaw + math.pi) or tgtYaw
                myRoot.CFrame =
                    CFrame.new(tgtRoot.Position)
                    * CFrame.Angles(0, yaw, 0)
                    * CFrame.new(cpSide, cpUp, -cpForward)
                    * CFrame.Angles(math.rad(cpTiltX), math.rad(cpTiltY), math.rad(cpTiltZ))
                myRoot.AssemblyLinearVelocity  = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
            end)
        end)
    end,
})




