    local backCounter  = 0
    local frontCounter = 0
    local wasAirborne  = false

    local cpAnimId    = 136924276934156
    local cpFreezeAt  = 4.1
    local MOVE_THRESH = 0.5

Tab:AddToggle({
        Label    = "Slow Down",
        Default  = false,
        Callback = function(state)
            cpEnabled = state
            if not cpEnabled then
                cleanupToggle(cpConn, cpTrack, false, nil)
                cpConn        = nil
                cpTrack       = nil
                lastChar      = nil
                lastState     = "front"
                backCounter   = 0
                frontCounter  = 0
                wasAirborne   = false
                return
            end
            if not selectedTarget then return end

            cpConn = weldRun.Heartbeat:Connect(function()
                if not cpEnabled then return end
                if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                    cpEnabled = false
                    cleanupToggle(cpConn, cpTrack, false, "Slow Down")
                    cpConn        = nil
                    cpTrack       = nil
                    lastChar      = nil
                    lastState     = "front"
                    backCounter   = 0
                    frontCounter  = 0
                    wasAirborne   = false
                    return
                end

                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot then return end

                local tgtChar = selectedTarget.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not tgtChar or not tgtRoot then return end

                if myChar ~= lastChar then
                    lastChar = myChar
                    if cpTrack then cpTrack:Stop() cpTrack:Destroy() end
                    cpTrack = loadAnim(myChar, cpAnimId, cpFreezeAt, true)

                    if cpTrack then
                        cpTrack:Play()
                        cpTrack.TimePosition = cpFreezeAt
                        cpTrack:AdjustSpeed(0)
                    end
                end

                pcall(function()
                    local vel        = tgtRoot.AssemblyLinearVelocity
                    local tgtForward = Vector3.new(tgtRoot.CFrame.LookVector.X, 0, tgtRoot.CFrame.LookVector.Z).Unit
                    local tgtHuman   = tgtChar:FindFirstChildOfClass("Humanoid")
                    local moveDir    = tgtHuman and tgtHuman.MoveDirection or Vector3.zero
                    local isMoving   = moveDir.Magnitude > 0.1

                    local dot        = moveDir:Dot(tgtForward)

                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    local baseCF = CFrame.new(tgtRoot.Position) * CFrame.Angles(0, tgtYaw, 0)

                    local isAirborne = math.abs(vel.Y) > 15

                    if not isAirborne then
                        if isMoving and dot < 0 then
                            backCounter  = backCounter + 1
                            frontCounter = 0
                        elseif isMoving and dot >= 0 then
                            frontCounter = frontCounter + 1
                            backCounter  = 0
                        else
                            backCounter  = 0
                            frontCounter = 0
                        end

                        if backCounter >= 5 then
                            lastState    = "back"
                            frontCounter = 0
                        elseif frontCounter >= 5 then
                            lastState   = "front"
                            backCounter = 0
                        end
                    end

                    local offsetCF
                    if lastState == "back" then
                        offsetCF = baseCF * CFrame.new(0, 2.2, -0.3)
                    else
                        offsetCF = baseCF * CFrame.new(0, 2.5, 0)
                    end

                    myRoot.CFrame                  = offsetCF
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
        end,
    })
end

