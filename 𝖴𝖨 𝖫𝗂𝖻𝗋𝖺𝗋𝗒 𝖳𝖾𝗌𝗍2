    Callback = function()
        executePermaDeathLogic(player.Character)
    end,
})

-- 2. The Auto-Reapply Toggle
-- This simply listens for respawns and triggers the exact same function
local autoApplyConnection = nil

Tab:AddToggle({
    Label   = "Loop Perma Death",
    Default = false,
    Callback = function(value)
        if value then
            -- Connect to character respawns
            autoApplyConnection = player.CharacterAdded:Connect(function(char)
                -- Wait a moment to ensure the character is fully setup by the server
                task.wait(0.5) 
                executePermaDeathLogic(char)
            end)
            
            -- Apply immediately if already spawned
            if player.Character then
                executePermaDeathLogic(player.Character)
            end
        else
            -- Disconnect the listener
