local function cpLoadEmote(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local size = 1678
    local hi = (4096^3 * 1024) + (999^2 * 516158) + (37^4 * 43) - (123^3 * 7) + (8888 * 9) - 314159 - 66^4 - 47471589

    cpSavedTracks = {}
    for _, t in pairs(hum:GetPlayingAnimationTracks()) do
        table.insert(cpSavedTracks, {
            track        = t,
            speed        = t.Speed,
            timePosition = t.TimePosition,
        })
        t:Stop()
    end

    local animateScript = char:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = true end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. hi
    local track = hum:LoadAnimation(anim)
    track:Play()
    track:AdjustSpeed(0)
    track.TimePosition = size * 0.00000323

    return track
end

local function cpRestoreTracks(char)
    if not char then return end
    local animateScript = char:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = false end
    for _, saved in pairs(cpSavedTracks) do
        if saved.track and not saved.track.IsPlaying then
            saved.track:Play()
            saved.track:AdjustSpeed(saved.speed)
            saved.track.TimePosition = saved.timePosition
        end
    end
    cpSavedTracks = {}
end

local function cpGetCharAnims(char)
    local animate = char:FindFirstChild("Animate")
    if not animate then return {} end
    local function getAnim(name)
        local folder = animate:FindFirstChild(name)
        if folder then
            local anim = folder:FindFirstChildWhichIsA("Animation")
            if anim then return anim.AnimationId end
        end
        return nil
    end
    return {
        Idle = getAnim("idle"),
        Walk = getAnim("walk"),
        Run  = getAnim("run"),
        Jump = getAnim("jump"),
        Fall = getAnim("fall"),
    }
end

local function cpStopFakeAnims()
    for _, track in pairs(cpFakeAnimTracks) do
        if track and track.IsPlaying then track:Stop(0.1) end
    end
end

local function cpCleanupFakeChar()
