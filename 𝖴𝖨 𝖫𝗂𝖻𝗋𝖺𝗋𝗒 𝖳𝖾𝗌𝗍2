                myRoot.CFrame = CFrame.new(tgtRoot.Position) * CFrame.Angles(0, yaw, 0)
                    * CFrame.new(cpSide, cpUp, -cpForward)
                    * CFrame.Angles(math.rad(cpTiltX), math.rad(cpTiltY), math.rad(cpTiltZ))
                myRoot.Velocity    = Vector3.new(500, 500, 500)
                myRoot.RotVelocity = Vector3.new(500, 500, 500)
                sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
            end)
        end)
