-- Anti-fall / safety system
local floor = math.floor
local random = math.random
local tremove = table.remove
local schar = string.char

local seed = 0
local stepA = 2
local charMap = {}
local encTable = {}

local tempList = {}
for i = 1, 256 do tempList[i] = i end
repeat
    local idx = random(1, #tempList)
    local val = tremove(tempList, idx)
    encTable[val] = schar(val - 1)
until #tempList == 0

local ibuf = {}

local function nextByte()
    if #ibuf == 0 then
        seed = (seed * 14911595048824) % 35184372088832
        repeat stepA = (stepA * 188) % 257 until stepA ~= 1
        local E = stepA % 32
        local M = (floor(seed / 2 ^ (13 - (stepA - E) / 32)) % 4294967296) / 2 ^ E
        local C = floor((M % 1) * 4294967296) + floor(M)
        local J = C % 65536
        local F = (C - J) / 65536
        local U = J % 256
        local v = (J - U) / 256
        local e = F % 256
        local R = (F - e) / 256
        ibuf = { U, v, e, R }
    end
    return table.remove(ibuf)
end

local cache = {}
local encMeta = setmetatable({}, { __index = cache, __metatable = nil })

local function encrypt(str, key)
    if not cache[key] then
        ibuf = {}
        seed = key % 35184372088832
        stepA = key % 257
        local len = string.len(str)
        cache[key] = ""
        local U = 128
        for i = 1, len do
            U = ((string.byte(str, i) + nextByte()) + U) % 256
            cache[key] = cache[key] .. encTable[U + 1]
        end
    end
    return key
end

