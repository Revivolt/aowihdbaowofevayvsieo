Tab:AddButton({
        Label    = "Perma Death",
        Callback = function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local activeConnection = nil
local initialCharacter = player.Character  -- snapshot at load time

local function startPermanentPhysics(character)
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")

    if activeConnection then
        activeConnection:Disconnect()
        activeConnection = nil
    end

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    root.CanCollide = false

    activeConnection = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent then
            if activeConnection then activeConnection:Disconnect() end
            activeConnection = nil
            return
        end

        local oldV = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = oldV * 0 + Vector3.new(0, 0, 0)
        RunService.RenderStepped:Wait()
        root.AssemblyLinearVelocity = oldV
        RunService.Stepped:Wait()
        root.AssemblyLinearVelocity = oldV + Vector3.new(0, 0.1, 0)
    end)
end

-- CharacterAdded fires on respawn/refresh — we ignore it entirely
-- State overrides and physics only run on the character present at script load
if initialCharacter then
    task.spawn(function()
        startPermanentPhysics(initialCharacter)
    end)
end

end,
    })


local Players = game:GetService("Players")
