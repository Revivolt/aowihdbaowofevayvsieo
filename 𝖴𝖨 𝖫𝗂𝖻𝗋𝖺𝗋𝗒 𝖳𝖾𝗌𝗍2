local ANIMATION_ID = 102940155040466
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local humanoid, animator
local animTrack = nil
local emote1Track = nil
local savedTracks = {}
local toggleEnabled = false
local transparencyConnection = nil

-- Fake stand-in vars
local FakeChar = nil
local fakeConnections = {}
local AnimTracks = {}

local function getCharAnims(char)
    local animate = char:FindFirstChild("Animate")
    if not animate then return {} end
    local function getAnim(name)
        local folder = animate:FindFirstChild(name)
        if folder then
            local anim = folder:FindFirstChildWhichIsA("Animation")
            if anim then return anim.AnimationId end
        end
        return nil
    end
    return {
        Idle = getAnim("idle"),
        Walk = getAnim("walk"),
        Run  = getAnim("run"),
        Jump = getAnim("jump"),
        Fall = getAnim("fall"),
    }
end

local function updateCharacter()
    local character = player.Character or player.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    animator = humanoid:WaitForChild("Animator")
end
updateCharacter()

local function isValidId(id)
    return typeof(id) == "number" and id > 0
end

local function loadAnimation(assetId, looped, priority)
    if not isValidId(assetId) then return nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. assetId
    local track = animator:LoadAnimation(anim)
    track.Looped = looped
    track.Priority = priority
    return track
end

local function destroyTrack(track)
    if track then
        track:Stop()
        track:Destroy()
    end
end

local function playAnim()
    destroyTrack(animTrack)
    animTrack = nil
    animTrack = loadAnimation(ANIMATION_ID, true, Enum.AnimationPriority.Action)
    if animTrack then
        animTrack:Play()
        animTrack:AdjustSpeed(0)
        animTrack.TimePosition = 0
    end
end

local function saveTracks()
    savedTracks = {}
    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
        table.insert(savedTracks, {
            track = track,
            speed = track.Speed,
            timePosition = track.TimePosition,
        })
    end
end

local function restoreTracks()
    local char = player.Character
    if char then
        local animateScript = char:FindFirstChild("Animate")
        if animateScript then animateScript.Disabled = false end
    end
    for _, saved in pairs(savedTracks) do
        if saved.track and not saved.track.IsPlaying then
            saved.track:Play()
            saved.track:AdjustSpeed(saved.speed)
            saved.track.TimePosition = saved.timePosition
        end
    end
    savedTracks = {}
end

local function setRealCharTransparency(alpha)
    local char = player.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("MeshPart") or part:IsA("SpecialMesh") then
            part.LocalTransparencyModifier = alpha
        end
    end
end

local function startTransparencyEnforcer()
    if transparencyConnection then transparencyConnection:Disconnect() end
    transparencyConnection = RunService.RenderStepped:Connect(function()
        local char = player.Character
        if not char then return end

        -- Always keep real character invisible
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("MeshPart") then
                part.LocalTransparencyModifier = 1
            end
        end

        -- Hide fake character in first person, show in third person
        if FakeChar then
            local camera = workspace.CurrentCamera
            local head = char:FindFirstChild("Head")
            local inFirstPerson = head and camera and
                (camera.CFrame.Position - head.Position).Magnitude < 1

            for _, part in pairs(FakeChar:GetDescendants()) do
                if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Name ~= "HumanoidRootPart" then
                    part.LocalTransparencyModifier = inFirstPerson and 1 or 0
                end
            end
        end
    end)
end

local function stopTransparencyEnforcer()
    if transparencyConnection then
        transparencyConnection:Disconnect()
        transparencyConnection = nil
    end
end

local function StopFakeAnims()
    for _, track in pairs(AnimTracks) do
        if track and track.IsPlaying then track:Stop(0.1) end
    end
end

local function spawnFakeChar()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    char.Archivable = true
    FakeChar = char:Clone()
    FakeChar.Name = "InvisClone"
    FakeChar.Parent = workspace

    local fakeRoot = FakeChar:FindFirstChild("HumanoidRootPart")
    if not fakeRoot then return end

    local fakeHum = FakeChar:FindFirstChild("Humanoid")
    if fakeHum then fakeHum:Destroy() end

    for _, v in pairs(FakeChar:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("Script") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.CanCollide = false
            v.Massless = true
            v.Anchored = false
            if v.Name == "HumanoidRootPart" then
                v.Transparency = 1
                v.Anchored = true
            end
        end
    end

    local animController = Instance.new("AnimationController")
    animController.Parent = FakeChar
    local fakeAnimator = Instance.new("Animator")
    fakeAnimator.Parent = animController

    local function LoadFakeAnim(id)
        local a = Instance.new("Animation")
        a.AnimationId = id
        return fakeAnimator:LoadAnimation(a)
    end

    local charAnims = getCharAnims(char)

    if charAnims.Idle then AnimTracks.Idle = LoadFakeAnim(charAnims.Idle) end
    if charAnims.Walk then AnimTracks.Walk = LoadFakeAnim(charAnims.Walk) end
    if charAnims.Run  then AnimTracks.Run  = LoadFakeAnim(charAnims.Run)  end
    if charAnims.Jump then AnimTracks.Jump = LoadFakeAnim(charAnims.Jump) end
    if charAnims.Fall then AnimTracks.Fall = LoadFakeAnim(charAnims.Fall) end

    if AnimTracks.Idle then AnimTracks.Idle:Play() end

    table.insert(fakeConnections, RunService.RenderStepped:Connect(function()
        local realChar = player.Character
        if not realChar or not FakeChar then return end

        local realRoot = realChar:FindFirstChild("HumanoidRootPart")
        local realHum = realChar:FindFirstChild("Humanoid")
        if not realRoot or not realHum then return end

        fakeRoot.CFrame = realRoot.CFrame

        local state = realHum:GetState()
        local isMoving = realHum.MoveDirection.Magnitude > 0.01
        local grounded =
            state == Enum.HumanoidStateType.Running or
            state == Enum.HumanoidStateType.RunningNoPhysics

        if grounded then
            if isMoving then
                if AnimTracks.Run and not AnimTracks.Run.IsPlaying then
                    StopFakeAnims()
                    AnimTracks.Run:Play(0.1)
                end
            else
                if AnimTracks.Idle and not AnimTracks.Idle.IsPlaying then
                    StopFakeAnims()
                    AnimTracks.Idle:Play(0.1)
                end
            end
        elseif state == Enum.HumanoidStateType.Jumping then
            if AnimTracks.Jump and not AnimTracks.Jump.IsPlaying then
                StopFakeAnims()
                AnimTracks.Jump:Play(0.1)
            end
        elseif state == Enum.HumanoidStateType.Freefall then
            if AnimTracks.Fall and not AnimTracks.Fall.IsPlaying then
                StopFakeAnims()
                AnimTracks.Fall:Play(0.1)
            end
        end
    end))
end

local function destroyFakeChar()
    for _, conn in pairs(fakeConnections) do conn:Disconnect() end
    fakeConnections = {}
    AnimTracks = {}
    if FakeChar then
        FakeChar:Destroy()
        FakeChar = nil
    end
end

