end

Tab:AddToggle({
    Label   = "Trampoline",
    Default = false,
    Callback = function(value)
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        if value then
            applyStateOverrides(char)
            setNoclip(char, true)
            stopAnimations(char)
            lockedY = root.Position.Y - 5
            isLocked = true
            root.CFrame = CFrame.new(root.Position.X, lockedY, root.Position.Z)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            heartbeat = RunService.Heartbeat:Connect(function()
                if not root or not root.Parent then stopAll() return end

                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end

                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local animator = humanoid:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            track:Stop(0)
                        end
                    end
                end

                if isLocked and lockedY ~= nil then
                    local pos = root.Position
                    if math.abs(pos.Y - lockedY) > 0.01 then
                        root.CFrame = CFrame.new(pos.X, lockedY, pos.Z)
                    end
                    local v = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                end

                oldV = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = oldV * 500 + Vector3.new(0, 500, 0)
            end)

            rendered = RunService.RenderStepped:Connect(function()
                if not root or not root.Parent then return end
                root.AssemblyLinearVelocity = oldV
            end)

            stepped = RunService.Stepped:Connect(function()
                if not root or not root.Parent then return end
                root.AssemblyLinearVelocity = oldV + Vector3.new(0, 0.1, 0)
            end)

        else
            isLocked = false
            lockedY = nil
            stopAll()
            setNoclip(char, false)
            removeStateOverrides(char)
            restoreAnimations(char)
            root.CFrame = CFrame.new(root.Position.X, root.Position.Y, root.Position.Z)
        end
    end,
})



