local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- This variable will hold the connection so we can kill it later
local activeConnection = nil

-- This function contains the exact logic from your original "Perma Death" button
local function executePermaDeathLogic(character)
    if not character then return end
    
    local root = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if not root or not humanoid then return end

    -- Clean up any previous loop before starting a new one
    if activeConnection then
        activeConnection:Disconnect()
        activeConnection = nil
    end

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    root.CanCollide = false

    activeConnection = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent then
            if activeConnection then activeConnection:Disconnect() end
            activeConnection = nil
            return
        end

        local oldV = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.zero
        RunService.RenderStepped:Wait()
        root.AssemblyLinearVelocity = oldV
        RunService.Stepped:Wait()
        root.AssemblyLinearVelocity = oldV + Vector3.new(0, 0.1, 0)
    end)
end

