            inputVector = cp2Controls:GetMoveVector()
        else
            if UIS:IsKeyDown(Enum.KeyCode.W) then inputVector += Vector3.new(0, 0, -1) end
            if UIS:IsKeyDown(Enum.KeyCode.S) then inputVector += Vector3.new(0, 0,  1) end
            if UIS:IsKeyDown(Enum.KeyCode.A) then inputVector += Vector3.new(-1, 0, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.D) then inputVector += Vector3.new( 1, 0, 0) end
        end

        local currentState = fakeHum:GetState()
        if UIS:IsKeyDown(Enum.KeyCode.Space) and
            currentState ~= Enum.HumanoidStateType.Jumping and
            currentState ~= Enum.HumanoidStateType.Freefall then
            fakeHum.Jump = true
        end

        local camCF    = workspace.CurrentCamera.CFrame
        local finalDir = (camCF.RightVector * inputVector.X) + (camCF.LookVector * -inputVector.Z)
        finalDir = Vector3.new(finalDir.X, 0, finalDir.Z)

        local isGrounded =
            currentState == Enum.HumanoidStateType.Running or
            currentState == Enum.HumanoidStateType.RunningNoPhysics

        if finalDir.Magnitude > 0.01 then
            fakeHum:Move(finalDir.Unit, false)
            if isGrounded then
                if cp2FakeAnimTracks.Run and not cp2FakeAnimTracks.Run.IsPlaying then
                    cp2StopFakeAnims()
                    cp2FakeAnimTracks.Run:Play(0.1)
                end
            end
        else
            fakeHum:Move(Vector3.zero, false)
            if isGrounded then
                if cp2FakeAnimTracks.Idle and not cp2FakeAnimTracks.Idle.IsPlaying then
                    cp2StopFakeAnims()
                    cp2FakeAnimTracks.Idle:Play(0.1)
                end
            end
        end
    end)
end

