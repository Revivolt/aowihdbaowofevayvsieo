local function runCycle()
    local loadingMapRemote = game:GetService("ReplicatedStorage")
        :WaitForChild("Remotes")
        :WaitForChild("Gameplay")
        :WaitForChild("LoadingMap")

    while cycleActive do
        -- Wait for LoadingMap to fire
        loadingMapRemote.OnClientEvent:Wait()
        if not cycleActive then break end

        -- Resolve target player now so all phases use the same one
        local targetPlayer = nil
        local lowerTarget = nanTarget:lower()
        for _, p in ipairs(nanPlayers:GetPlayers()) do
            if p.Name:lower():find(lowerTarget, 1, true) or
               p.DisplayName:lower():find(lowerTarget, 1, true) then
                targetPlayer = p
                break
            end
        end

        if not targetPlayer then
            warn("[Cycle] Player not found: " .. nanTarget)
            task.wait(0.5)
            continue
        end

        -- Grab character refs
        local myChar = nanLocal.Character or nanLocal.CharacterAdded:Wait()
        local myHum  = myChar:WaitForChild("Humanoid")
        local myRoot = myChar:WaitForChild("HumanoidRootPart")

        -- Save position BEFORE NaN phase so we can return here after teleport
        returnCFrame = myRoot.CFrame

        -- 1. NaN + animate phase
        doNanPhase(myChar, myHum, myRoot)

        -- 2. Rename phase (after original 0.2s delay)
        task.wait(0.2)
        doRenamePhase(myChar)

        if not cycleActive then break end

        -- 3-second delay, counted against the 10.9s window
        task.wait(3)

        if not cycleActive then break end

        -- Remaining 7.9 seconds under target (3 + 7.9 = 10.9 total)
        doUnderTargetPhase(targetPlayer, 6.4)

        if not cycleActive then break end

        -- 4. 0.25s heartbeat snap to target player, then return to saved CFrame
        doTeleportPhase(targetPlayer)

        -- Small cooldown before looping back
        task.wait(0.5)
    end
end

