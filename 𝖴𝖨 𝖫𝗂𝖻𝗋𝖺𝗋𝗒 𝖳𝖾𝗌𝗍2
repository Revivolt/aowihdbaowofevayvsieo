local function updateCharacter()
    local character = player.Character or player.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    animator = humanoid:WaitForChild("Animator")
end

updateCharacter()

local function isValidId(id)
    return typeof(id) == "number" and id > 0
end

local function loadAnimation(assetId, looped, priority)
    if not isValidId(assetId) then return nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. assetId
    local track = animator:LoadAnimation(anim)
    track.Looped = looped
    track.Priority = priority
    return track
end

local function destroyTrack(track)
    if track then
        track:Stop()
        track:Destroy()
    end
end

local function playAnim()
    destroyTrack(animTrack)
    animTrack = nil

    animTrack = loadAnimation(ANIMATION_ID, true, Enum.AnimationPriority.Action)
    if animTrack then
        animTrack:Play()
        animTrack:AdjustSpeed(0)
        animTrack.TimePosition = 0
    end
end

player.CharacterAdded:Connect(function(character)
    humanoid = character:WaitForChild("Humanoid")
    animator = humanoid:WaitForChild("Animator")
    animTrack = nil -- old track is gone after reset

    if toggleEnabled then
        task.wait(0.1) -- small wait for character to fully load
        playAnim()
    end
end)

