local nanLoopTask    = nil

Tab:AddToggle({
    Label    = "Loop Force Kill",
    Default  = false,
    Callback = function(state)
        nanLoopEnabled = state
        if not nanLoopEnabled then
            if nanLoopTask then task.cancel(nanLoopTask) nanLoopTask = nil end
            if nanConn then nanConn:Disconnect() nanConn = nil end
            local myChar = nanLocal.Character
            local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHum then myHum.PlatformStand = false end
            if myRoot then
                myRoot.AssemblyLinearVelocity  = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                myRoot.RotVelocity             = Vector3.zero
                pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", nil)
            end
            if myHum then myHum.Health = myHum.MaxHealth end
            return
        end

        nanLoopTask = task.spawn(function()
            local function getTargets()
                local targets = {}
                if nanTarget == "-" then
                    for _, plr in ipairs(nanPlayers:GetPlayers()) do
                        if plr ~= nanLocal then table.insert(targets, plr) end
                    end
                else
                    for _, plr in ipairs(nanPlayers:GetPlayers()) do
                        if plr ~= nanLocal
                        and (plr.Name:lower():find(nanTarget:lower())
                             or (plr.DisplayName and plr.DisplayName:lower():find(nanTarget:lower()))) then
                            table.insert(targets, plr)
                            break
                        end
                    end
                end
                return targets
            end

            local function doDoubleTap(firstTarget)
                if not firstTarget or not firstTarget.Character then return end
                for _ = 1, 2 do
                    local myChar  = nanLocal.Character or nanLocal.CharacterAdded:Wait()
                    local myHum   = myChar:WaitForChild("Humanoid")
                    local myRoot  = myChar:WaitForChild("HumanoidRootPart")
                    local tgtRoot = firstTarget.Character and firstTarget.Character:FindFirstChild("HumanoidRootPart")
                    if not tgtRoot then break end

                    local savedCF       = myRoot.CFrame
                    local savedVel      = myRoot.Velocity
                    local savedPlatform = myHum.PlatformStand
                    local nan           = 0 / 0
                    local nanVec        = Vector3.new(nan, nan, nan)

                    myHum.PlatformStand = true
                    local startTime = tick()

                    nanCounter = nanCounter + 1
                    local localID = nanCounter
                    if nanConn then nanConn:Disconnect() nanConn = nil end

                    nanConn = nanRun.Heartbeat:Connect(function()
                        if nanCounter ~= localID then return end
                        if tick() - startTime >= 1.5 then
                            nanConn:Disconnect()
                            nanConn = nil
                            task.defer(function()
                                if nanCounter ~= localID then return end
                                myHum.PlatformStand               = savedPlatform
                                myRoot.AssemblyLinearVelocity     = Vector3.zero
                                myRoot.AssemblyAngularVelocity    = Vector3.zero
                                myRoot.CFrame                     = savedCF
                                myRoot.Velocity                   = savedVel
                                myRoot.RotVelocity                = Vector3.zero
                                pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", nil)
                            end)
                            return
                        end
                        myRoot.CFrame                  = tgtRoot.CFrame
                        myRoot.AssemblyLinearVelocity  = nanVec
                        myRoot.AssemblyAngularVelocity = nanVec
                        pcall(function() myHum:Move(nanVec) end)
                        pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", tgtRoot)
                    end)
                end
                task.wait(0)
            end

            local function doNanUntilDead(target, maxTime)
                local myChar  = nanLocal.Character or nanLocal.CharacterAdded:Wait()
                local myHum   = myChar:WaitForChild("Humanoid")
                local myRoot  = myChar:WaitForChild("HumanoidRootPart")
                local tgtChar = target.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                local tgtHum  = tgtChar and tgtChar:FindFirstChildOfClass("Humanoid")
                if not tgtRoot or not tgtHum then return end

                local savedCF       = myRoot.CFrame
                local savedVel      = myRoot.Velocity
                local savedPlatform = myHum.PlatformStand
                local nan           = 0 / 0
                local nanVec        = Vector3.new(nan, nan, nan)

                myHum.PlatformStand = true
                local startTime = tick()

                nanCounter = nanCounter + 1
                local localID = nanCounter
                if nanConn then nanConn:Disconnect() nanConn = nil end

                nanConn = nanRun.Heartbeat:Connect(function()
                    if nanCounter ~= localID then return end

                    local isDead   = tgtHum.Health <= 0 or not tgtHum.Parent
                    local timedOut = tick() - startTime >= maxTime

                    if isDead or timedOut then
                        nanConn:Disconnect()
                        nanConn = nil
                        task.defer(function()
                            if nanCounter ~= localID then return end
                            myHum.PlatformStand               = savedPlatform
                            myRoot.AssemblyLinearVelocity     = Vector3.zero
                            myRoot.AssemblyAngularVelocity    = Vector3.zero
                            myRoot.CFrame                     = savedCF
                            myRoot.Velocity                   = savedVel
                            myRoot.RotVelocity                = Vector3.zero
                            pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", nil)
                        end)
                        return
                    end

                    myRoot.CFrame                  = tgtRoot.CFrame
                    myRoot.AssemblyLinearVelocity  = nanVec
                    myRoot.AssemblyAngularVelocity = nanVec
                    pcall(function() myHum:Move(nanVec) end)
                    pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", tgtRoot)
                end)

                while nanLoopEnabled and nanConn do
                    if not tgtHum.Parent or tgtHum.Health <= 0 then break end
                    if tick() - startTime >= maxTime then break end
                    task.wait(0)
                end
            end

            while nanLoopEnabled do
                pcall(function()
                    local targets = getTargets()
                    local firstTarget = targets[1]

                    doDoubleTap(firstTarget)

                    for _, target in ipairs(targets) do
                        if not nanLoopEnabled then break end
                        if not target.Character then continue end

                        if firstTarget and firstTarget.Character and firstTarget ~= target then
                            doDoubleTap(firstTarget)
                        end

                        if not nanLoopEnabled then break end
                        doNanUntilDead(target, 2)
                        task.wait(0)
                    end
                end)

                task.wait(0)
            end
        end)
    end,
})


