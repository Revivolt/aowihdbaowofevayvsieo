    local lastChar  = nil
    local cpUp        =  2.5
    local cpForward   =  0
    local cpSide      =  0
    local cpTiltX     =  0
    local cpTiltY     =  0
    local cpTiltZ     =  0
    local cpFaceBack  = false
    local cpNoCollide = true
    local cpFreezeAt  = 4.1
    local cpAnimId    = 136924276934156

    local UIS    = game:GetService("UserInputService")
    local Camera = workspace.CurrentCamera

    Tab:AddToggle({
        Label    = "test",
        Default  = false,
        Callback = function(state)
            cpEnabled = state
            if not cpEnabled then
                cleanupToggle(cpConn, cpTrack, cpNoCollide, nil)
                cpConn = nil cpTrack = nil lastChar = nil
                return
            end
            if not selectedTarget then return end
            cpConn = weldRun.Heartbeat:Connect(function()
                if not cpEnabled then return end
                if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                    cpEnabled = false
                    cleanupToggle(cpConn, cpTrack, cpNoCollide, "test")
                    cpConn = nil cpTrack = nil lastChar = nil
                    return
                end
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot then return end
                local tgtChar = selectedTarget.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not tgtChar or not tgtRoot then return end
                if myChar ~= lastChar then
                    lastChar = myChar
                    if cpTrack then cpTrack:Stop() cpTrack:Destroy() end
                    cpTrack = loadAnim(myChar, cpAnimId, cpFreezeAt, true)
                end
                pcall(function()
                    -- No collide self
                    for _, part in ipairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") and cpNoCollide then
                            part.CanCollide = false
                        end
                    end

                    local tgtHum = tgtChar:FindFirstChildOfClass("Humanoid")

                    -- Force target into climbing state every frame
                    if tgtHum then
                        tgtHum:ChangeState(Enum.HumanoidStateType.Climbing)
                    end

                    -- Read WASD and drive the target's humanoid
                    if tgtHum then
                        local moveVec = Vector3.zero
                        if UIS:IsKeyDown(Enum.KeyCode.W) then moveVec += Vector3.new(0, 0, -100) end
                        if UIS:IsKeyDown(Enum.KeyCode.S) then moveVec += Vector3.new(0, 0,  100) end
                        if UIS:IsKeyDown(Enum.KeyCode.A) then moveVec += Vector3.new(-100, 0,  0) end
                        if UIS:IsKeyDown(Enum.KeyCode.D) then moveVec += Vector3.new( 100, 0,  0) end

                        -- Rotate input relative to camera
                        local camFlat = Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)
                        local forward = camFlat.Magnitude > 0 and camFlat.Unit or Vector3.zAxis
                        local right   = Camera.CFrame.RightVector
                        right         = Vector3.new(right.X, 0, right.Z)
                        right         = right.Magnitude > 0 and right.Unit or Vector3.xAxis

                        local worldDir = (forward * -moveVec.Z) + (right * moveVec.X)

                        -- Move target in world space
                        tgtHum:Move(worldDir, false)
                    end

                    -- Snap self onto target
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    local yaw = cpFaceBack and (tgtYaw + math.pi) or tgtYaw
                    myRoot.CFrame = CFrame.new(tgtRoot.Position)
                        * CFrame.Angles(0, yaw, 0)
                        * CFrame.new(cpSide, cpUp, -cpForward)
                        * CFrame.Angles(math.rad(cpTiltX), math.rad(cpTiltY), math.rad(cpTiltZ))

                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
        end,
    })
end


