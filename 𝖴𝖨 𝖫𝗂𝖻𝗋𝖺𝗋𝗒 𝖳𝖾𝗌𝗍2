local function cleanupToggle(cpConn, cpTrack, cpNoCollide)
    if cpConn then cpConn:Disconnect() end
    if cpTrack then cpTrack:Stop() cpTrack:Destroy() end
    local mc = weldLocal.Character
    if mc then
        for _, part in ipairs(mc:GetDescendants()) do
            if part:IsA("BasePart") then
                if cpNoCollide then part.CanCollide = true end
            end
        end
        local mr = mc:FindFirstChild("HumanoidRootPart")
        if mr then
            mr.AssemblyLinearVelocity  = Vector3.zero
            mr.AssemblyAngularVelocity = Vector3.zero
            pcall(sethiddenproperty, mr, "PhysicsRepRootPart", mr)
        end
    end
end

local function loadAnim(myChar, animId, freezeAt, freeze)
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHum then return nil end
    local track
    pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(animId)
        track = myHum:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track.TimePosition = freezeAt or 0
        if freeze then track:AdjustSpeed(0) end
    end)
    return track
end

-- p
do
    local UIS = game:GetService("UserInputService")

    local ghostEnabled  = false
    local ghostFlying   = false
    local camModel      = nil
    local camPart       = nil
    local camHumanoid   = nil
    local ghostConn     = nil
    local inputConn     = nil
    local inputEndConn  = nil
    local GHOST_BEHIND  = 5
    local GHOST_SPEED   = 30
    local GHOST_JUMP    = 55      -- upward impulse on jump
    local GHOST_GRAVITY = 120     -- studs/s^2 pull-down in walk mode
    local HRP_HEIGHT    = 3       -- studs from floor to HRP center
    local ghostVelY     = 0       -- vertical velocity tracked manually
    local ghostOnGround = false
    local ghostControl  = {F=0, B=0, R=0, L=0, U=0, D=0}

    local function destroyGhost()
        if ghostConn    then ghostConn:Disconnect()    ghostConn    = nil end
        if inputConn    then inputConn:Disconnect()    inputConn    = nil end
        if inputEndConn then inputEndConn:Disconnect() inputEndConn = nil end
        if camModel and camModel.Parent then camModel:Destroy() end
        camModel     = nil
        camPart      = nil
        camHumanoid  = nil
        ghostFlying  = false
        ghostVelY    = 0
        ghostOnGround = false
        ghostControl = {F=0, B=0, R=0, L=0, U=0, D=0}

        pcall(function()
            local myChar = weldLocal and weldLocal.Character
            local hum = myChar and myChar:FindFirstChildWhichIsA("Humanoid")
            if hum then
                workspace.CurrentCamera.CameraSubject = hum
            end
        end)
    end

    local function createGhost()
        destroyGhost()

        local myChar = weldLocal and weldLocal.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local tgtChar = selectedTarget and selectedTarget.Character
        local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
        if not tgtRoot then return end

        camModel    = Instance.new("Model")
        camPart     = Instance.new("Part")
        camHumanoid = Instance.new("Humanoid")

        camPart.Name         = "HumanoidRootPart"
        camPart.Size         = Vector3.new(2, 2, 1)
        camPart.Transparency = 1
        camPart.CanCollide   = false
        camPart.Anchored     = false
        camPart.CFrame       = tgtRoot.CFrame * CFrame.new(0, 0, GHOST_BEHIND)
        camPart.Parent       = camModel

        camHumanoid.MaxHealth = 0
        camHumanoid.Health    = 0
        camHumanoid.Parent    = camModel

        -- Always full force — we control Y velocity manually in walk mode
        local bv = Instance.new("BodyVelocity")
        local bg = Instance.new("BodyGyro")
        bv.MaxForce  = Vector3.new(9e4, 9e4, 9e4)
        bv.Velocity  = Vector3.new(0, 0, 0)
        bg.CFrame    = camPart.CFrame
        bg.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
        bg.P         = 9e4
        bv.Parent    = camPart
        bg.Parent    = camPart

        -- Raycast params: exclude ghost and real character so they don't self-hit
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {camModel, myChar}

        local partMap = {}
        for _, orig in ipairs(myChar:GetDescendants()) do
            if orig:IsA("BasePart") and orig.Name ~= "HumanoidRootPart" then
                local copy = orig:Clone()
                for _, v in ipairs(copy:GetDescendants()) do
                    if v:IsA("Script") or v:IsA("LocalScript")
                    or v:IsA("Motor6D") or v:IsA("Weld") then
                        v:Destroy()
                    end
                end
                copy.Anchored     = true
                copy.CanCollide   = false
                copy.CanTouch     = false
                copy.CastShadow   = false
                copy.Transparency = math.clamp(orig.Transparency + 0.85, 0.85, 0.85)
                copy.Color        = Color3.fromRGB(180, 210, 255)
                local relCF = myHRP.CFrame:ToObjectSpace(orig.CFrame)
                copy.CFrame = camPart.CFrame * relCF
                copy.Parent = camModel
                table.insert(partMap, {ghost = copy, name = orig.Name})
            end
        end

        camModel.Parent = workspace
        workspace.CurrentCamera.CameraSubject = camHumanoid

        inputConn = UIS.InputBegan:Connect(function(inp, gp)
            if gp then return end
            local k = inp.KeyCode.Name:lower()

            if k == "l" then
                ghostFlying = not ghostFlying
                if ghostFlying then
                    -- Entering fly: carry current ghostVelY into flight naturally
                else
                    -- Entering walk: zero out vertical so gravity takes over cleanly
                    ghostVelY = 0
                    ghostControl.U = 0
                    ghostControl.D = 0
                end
                return
            end

            -- Space: jump in walk mode, ascend in fly mode
            if k == "space" then
                if not ghostFlying then
                    if ghostOnGround then
                        ghostVelY    = GHOST_JUMP
                        ghostOnGround = false
                    end
                else
                    ghostControl.U = 1
                end
                return
            end

            local keyMap = {
                w = "F", s = "B", d = "R", a = "L", leftcontrol = "D"
            }
            if keyMap[k] then ghostControl[keyMap[k]] = 1 end
        end)

        inputEndConn = UIS.InputEnded:Connect(function(inp, gp)
            if gp then return end
            local k = inp.KeyCode.Name:lower()
            if k == "space" and ghostFlying then
                ghostControl.U = 0
                return
            end
            local keyMap = {
                w = "F", s = "B", d = "R", a = "L", leftcontrol = "D"
            }
            if keyMap[k] then ghostControl[keyMap[k]] = 0 end
        end)

        ghostConn = weldRun.Heartbeat:Connect(function(dt)
            if not ghostEnabled then return end
            if not camPart or not camPart.Parent then return end

            local cam = workspace.CurrentCamera

            if ghostFlying then
                bv.Velocity = (cam.CoordinateFrame.LookVector  * ((ghostControl.F - ghostControl.B) * GHOST_SPEED))
                            + (cam.CoordinateFrame.RightVector  * ((ghostControl.R - ghostControl.L) * GHOST_SPEED))
                            + (cam.CoordinateFrame.UpVector     * ((ghostControl.U - ghostControl.D) * GHOST_SPEED))
                bg.CFrame = cam.CoordinateFrame
            else
                -- Raycast straight down from camPart to find the floor
                local result = workspace:Raycast(
                    camPart.Position,
                    Vector3.new(0, -(HRP_HEIGHT + 2.5), 0),
                    rayParams
                )

                if result then
                    local targetY = result.Position.Y + HRP_HEIGHT
                    if ghostVelY <= 0 then
                        -- Planted: snap Y to floor and kill downward velocity
                        ghostOnGround = true
                        ghostVelY     = 0
                        -- Directly correct the position so there's no sinking
                        camPart.CFrame = CFrame.new(
                            camPart.Position.X,
                            targetY,
                            camPart.Position.Z
                        )
                    end
                else
                    ghostOnGround = false
                end

                -- Apply gravity when airborne
                if not ghostOnGround then
                    ghostVelY = ghostVelY - GHOST_GRAVITY * dt
                end

                -- Flatten horizontal movement to XZ plane
                local look  = cam.CoordinateFrame.LookVector
                local right = cam.CoordinateFrame.RightVector
                local flatLook  = Vector3.new(look.X,  0, look.Z)
                local flatRight = Vector3.new(right.X, 0, right.Z)
                if flatLook.Magnitude  > 0 then flatLook  = flatLook.Unit  end
                if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

                local horizVel = (flatLook  * ((ghostControl.F - ghostControl.B) * GHOST_SPEED))
                               + (flatRight * ((ghostControl.R - ghostControl.L) * GHOST_SPEED))

                bv.Velocity = Vector3.new(horizVel.X, ghostVelY, horizVel.Z)

                -- Only yaw so ghost stays upright while walking
                local _, yaw, _ = cam.CoordinateFrame:ToEulerAnglesYXZ()
                bg.CFrame = CFrame.Angles(0, yaw, 0)
            end

            -- Mirror real character pose onto ghost body parts
            local realHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if realHRP then
                for _, entry in ipairs(partMap) do
                    local realPart = myChar:FindFirstChild(entry.name)
                    if realPart and entry.ghost and entry.ghost.Parent then
                        local relCF = realHRP.CFrame:ToObjectSpace(realPart.CFrame)
                        entry.ghost.CFrame = camPart.CFrame * relCF
                    end
                end
            end
        end)
    end

    Tab:AddToggle({
        Label    = "Ghost",
        Default  = false,
        Callback = function(state)
            ghostEnabled = state
            if not ghostEnabled then
                destroyGhost()
                return
            end
            if not selectedTarget then return end
            createGhost()
        end,
    })
end


    -- ── CP / Hover toggle ─────────────────────────────────────────
    local cpConn       = nil
    local cpEnabled    = false
    local HOVER_UP     = -80
    local CLOSE_DIST   = 25
    local BELOW_OFF    = -1
    local NEARBY_DURATION = 0.5
    local nearbyLatchRoot = nil
    local nearbyLatchTime = 0

    local function stopConn()
        activeFlingCount = math.max(0, activeFlingCount - 1)
        if cpConn then cpConn:Disconnect() cpConn = nil end
    end

    local function findNearbyPlayer(tgtRoot)
        local closest, closestDist = nil, CLOSE_DIST
        for _, plr in ipairs(weldPlayers:GetPlayers()) do
            if plr == weldLocal or plr == selectedTarget then continue end
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            local dist = (root.Position - tgtRoot.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = root
            end
        end
        return closest
    end

    local function startConn()
        if cpConn then cpConn:Disconnect() cpConn = nil end
        nearbyLatchRoot = nil
        nearbyLatchTime = 0
        activeFlingCount = activeFlingCount + 1
        cpConn = weldRun.Heartbeat:Connect(function()
            if not cpEnabled then return end
            if not selectedTarget then return end
            local myChar = weldLocal.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myChar or not myRoot then return end
            local tgtChar = selectedTarget.Character
            local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
            if not tgtChar or not tgtRoot then return end
            pcall(function()
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                local now = tick()
                if nearbyLatchRoot then
                    if (now - nearbyLatchTime) >= NEARBY_DURATION then
                        nearbyLatchRoot = nil
                        nearbyLatchTime = 0
                    end
                end
                if not nearbyLatchRoot then
                    local found = findNearbyPlayer(tgtRoot)
                    if found then
                        nearbyLatchRoot = found
                        nearbyLatchTime = now
                    end
                end
                local anchorRoot, offsetY
                if nearbyLatchRoot then
                    anchorRoot = nearbyLatchRoot
                    offsetY    = BELOW_OFF
                else
                    anchorRoot = tgtRoot
                    offsetY    = HOVER_UP
                end
                myRoot.CFrame      = CFrame.new(anchorRoot.Position + Vector3.new(0, offsetY, 0))
                myRoot.Velocity    = Vector3.new(500, 500, 500)
                myRoot.RotVelocity = Vector3.new(500, 500, 500)
                sethiddenproperty(myRoot, "PhysicsRepRootPart", anchorRoot)
            end)
        end)
    end

    Tab:AddToggle({
        Label    = "Fling Aura",
        Default  = false,
        Callback = function(state)
            cpEnabled = state
            if not cpEnabled then
                stopConn()
                nearbyLatchRoot = nil
                nearbyLatchTime = 0
                return
            end
            if not selectedTarget then return end
            startConn()
        end,
    })
end
