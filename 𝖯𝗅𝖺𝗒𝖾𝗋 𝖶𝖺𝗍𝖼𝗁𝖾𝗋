-- ================================
-- FILE SYSTEM (Executor Workspace)
-- ================================
local FOLDER_NAME = "PlayerWatcher"
local FILE_PATH = FOLDER_NAME .. "/watched.txt"

local watchSet = {}

local function ensureFolder()
	pcall(function()
		if isfolder and not isfolder(FOLDER_NAME) then
			makefolder(FOLDER_NAME)
		end
	end)
end

local function loadWatchedFromFile()
	watchSet = {}
	ensureFolder()

	local success, content = pcall(function()
		if isfile and isfile(FILE_PATH) then
			return readfile(FILE_PATH)
		end
		return nil
	end)

	if success and content then
		for line in content:gmatch("[^\r\n]+") do
			local name = line:match("^%s*(.-)%s*$")
			if name and name ~= "" then
				watchSet[string.lower(name)] = true
			end
		end
	end
end

local function saveUsernameToFile(username)
	if not username or username == "" then return false end

	local lower = string.lower(username)
	if watchSet[lower] then
		return false -- already saved
	end

	watchSet[lower] = true
	ensureFolder()

	local success = pcall(function()
		local existing = ""
		if isfile and isfile(FILE_PATH) then
			existing = readfile(FILE_PATH)
			if existing ~= "" and not existing:match("\n$") then
				existing = existing .. "\n"
			end
		end
		writefile(FILE_PATH, existing .. username .. "\n")
	end)

	return success
end

local function removeUsernameFromFile(username)
	if not username or username == "" then return false end

	local lower = string.lower(username)
	if not watchSet[lower] then
		return false -- not in list
	end

	watchSet[lower] = nil

	local success = pcall(function()
		local lines = {}
		if isfile and isfile(FILE_PATH) then
			local content = readfile(FILE_PATH)
			for line in content:gmatch("[^\r\n]+") do
				local name = line:match("^%s*(.-)%s*$")
				if name and name ~= "" and string.lower(name) ~= lower then
					table.insert(lines, name)
				end
			end
		end
		writefile(FILE_PATH, table.concat(lines, "\n") .. (#lines > 0 and "\n" or ""))
	end)

	return success
end

