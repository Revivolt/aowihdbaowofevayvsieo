local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local function setMinimized(state)
	minimized = state
	if minimized then
		closePopup()
		TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = minimizedSize
		}):Play()
		scroll.Visible = false
		statusLabel.Visible = false
		minimizeBtn.Text = "+"
		titleLabel.Size = UDim2.new(1, -40, 1, 0)
		closeBtn.Visible = false
		minimizeBtn.Position = UDim2.new(1, -30, 0.5, -12)
	else
		TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = originalSize
		}):Play()
		scroll.Visible = true
		statusLabel.Visible = true
		minimizeBtn.Text = "–"
		titleLabel.Size = UDim2.new(1, -70, 1, 0)
		closeBtn.Visible = true
		minimizeBtn.Position = UDim2.new(1, -56, 0.5, -12)
	end
end

minimizeBtn.MouseButton1Click:Connect(function()
	setMinimized(not minimized)
end)

titleBar.InputBegan:Connect(function(input)
	if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		task.delay(0.05, function()
			if not dragging then
				setMinimized(false)
			end
		end)
	end
end)

