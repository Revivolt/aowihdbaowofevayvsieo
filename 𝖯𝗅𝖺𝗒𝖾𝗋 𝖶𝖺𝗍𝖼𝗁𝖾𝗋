-- Popup logic
local currentPopupUsername = nil
local popupOpen = false
local minimized = false
local originalSize = UDim2.new(0, 260, 0, 340)
local minimizedSize = UDim2.new(0, 160, 0, 36)

local function updatePopupPosition()
	if not popupOpen then return end
	local mainPos = mainFrame.AbsolutePosition
	local mainSize = mainFrame.AbsoluteSize
	local offsetX = 12
	local newX = mainPos.X + mainSize.X + offsetX
	local newY = mainPos.Y
	local viewport = workspace.CurrentCamera.ViewportSize
	if newX + 220 > viewport.X then
		newX = mainPos.X - 220 - offsetX
	end
	popup.Position = UDim2.new(0, newX, 0, newY)
end

local function closePopup()
	if not popupOpen then return end
	popupOpen = false
	local tween = TweenService:Create(popup, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 200, 0, 280),
		BackgroundTransparency = 1
	})
	tween:Play()
	tween.Completed:Connect(function()
		popup.Visible = false
		popup.BackgroundTransparency = T
		popup.Size = UDim2.new(0, 220, 0, 310)
	end)
end

local function openPopup(userId, displayName, username)
	if minimized then return end
	currentPopupUsername = username
	displayNameLabel.Text = displayName
	usernameLabel.Text = "@" .. username
	avatarImage.Image = ""

	task.spawn(function()
		local content = nil
		local ok1, result1 = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.AvatarFullBody, Enum.ThumbnailSize.Size420x420)
		end)
		if ok1 and result1 and result1 ~= "" then content = result1 end

		if not content then
			local ok2, result2 = pcall(function()
				return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)
			end)
			if ok2 and result2 and result2 ~= "" then content = result2 end
		end

		if not content then
			content = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=420&height=420&format=png"
		end

		if currentPopupUsername == username then
			avatarImage.Image = content
		end
	end)

	popup.Visible = true
	popup.Size = UDim2.new(0, 200, 0, 280)
	popup.BackgroundTransparency = 1
	popupOpen = true
	updatePopupPosition()

	TweenService:Create(popup, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 220, 0, 310),
		BackgroundTransparency = T
	}):Play()
end

popupClose.MouseButton1Click:Connect(closePopup)
copyBtn.MouseButton1Click:Connect(function()
	if currentPopupUsername then
		copyToClipboard(currentPopupUsername)
	end
end)

mainFrame:GetPropertyChangedSignal("Position"):Connect(updatePopupPosition)

-- ================================
-- Player Entries
-- ================================
local playerEntries = {}

local function updateStatus()
	local total, online = 0, 0
	for _, data in pairs(playerEntries) do
		total += 1
		if data.online then online += 1 end
	end
	statusLabel.Text = string.format("Current: %d  •  Logged: %d", online, total)
end

local function createOrUpdatePlayerEntry(player, isOnline)
	local username = player.Name
	local displayName = player.DisplayName
	local userId = player.UserId
	local isWatched = watchSet[string.lower(username)]

	if playerEntries[username] then
		local data = playerEntries[username]
		data.online = isOnline
		data.displayName = displayName

		local entry = data.frame
		local nameLabel = entry:FindFirstChild("NameLabel")
		local userLabel = entry:FindFirstChild("UserLabel")

		if isOnline then
			entry.BackgroundColor3 = isWatched and Color3.fromRGB(40, 15, 15) or Theme.Elevated
			if nameLabel then
				nameLabel.Text = displayName
				nameLabel.TextColor3 = Theme.TextPrimary
			end
			if userLabel then
				userLabel.Text = "@" .. username
				userLabel.TextColor3 = isWatched and Color3.fromRGB(255, 140, 140) or Theme.TextSecondary
			end
		else
			entry.BackgroundColor3 = Theme.Surface
			if nameLabel then
				nameLabel.Text = displayName .. " (Left)"
				nameLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
			end
			if userLabel then
				userLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
			end
		end
		updateStatus()
		return
	end

	local entry = Instance.new("Frame")
	entry.Name = username
	entry.Size = UDim2.new(1, -2, 0, 32)
	entry.BackgroundColor3 = isWatched and Color3.fromRGB(40, 15, 15) or Theme.Elevated
	entry.BackgroundTransparency = T
	entry.BorderSizePixel = 0
	entry.Parent = scroll

	local entryCorner = Instance.new("UICorner")
	entryCorner.CornerRadius = UDim.new(0, 5)
	entryCorner.Parent = entry

	if isWatched then
		local watchStroke = Instance.new("UIStroke")
		watchStroke.Color = Color3.fromRGB(200, 50, 50)
		watchStroke.Thickness = 1.2
		watchStroke.Parent = entry
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, -10, 0, 16)
	nameLabel.Position = UDim2.new(0, 7, 0, 2)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = displayName
	nameLabel.TextColor3 = Theme.TextPrimary
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = entry

	local userLabel = Instance.new("TextLabel")
	userLabel.Name = "UserLabel"
	userLabel.Size = UDim2.new(1, -10, 0, 12)
	userLabel.Position = UDim2.new(0, 7, 0, 17)
	userLabel.BackgroundTransparency = 1
	userLabel.Text = "@" .. username
	userLabel.TextColor3 = isWatched and Color3.fromRGB(255, 140, 140) or Theme.TextSecondary
	userLabel.TextSize = 11
	userLabel.Font = Enum.Font.Gotham
	userLabel.TextXAlignment = Enum.TextXAlignment.Left
	userLabel.TextTruncate = Enum.TextTruncate.AtEnd
	userLabel.Parent = entry

	local clickButton = Instance.new("TextButton")
	clickButton.Size = UDim2.new(1, 0, 1, 0)
	clickButton.BackgroundTransparency = 1
	clickButton.Text = ""
	clickButton.Parent = entry

	clickButton.MouseButton1Click:Connect(function()
		openPopup(userId, displayName, username)
	end)

	clickButton.MouseEnter:Connect(function()
		if isOnline then
			Tween(entry, {
				BackgroundColor3 = isWatched and Color3.fromRGB(55, 20, 20) or Theme.SurfaceHover
			}, 0.12)
		end
	end)

	clickButton.MouseLeave:Connect(function()
		if isOnline then
			Tween(entry, {
				BackgroundColor3 = isWatched and Color3.fromRGB(40, 15, 15) or Theme.Elevated
			}, 0.12)
		end
	end)

	playerEntries[username] = {
		frame = entry,
		online = isOnline,
		userId = userId,
		displayName = displayName
	}

	if isWatched and isOnline then
		sendNotification("Target Spotted!", string.format("%s (%s) is in the server", displayName, username), 8)
	end

	updateStatus()
end

