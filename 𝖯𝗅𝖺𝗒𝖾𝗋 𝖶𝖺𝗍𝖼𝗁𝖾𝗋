local function updateStatus()
	local total, online = 0, 0
	for _, data in pairs(playerEntries) do
		total += 1
		if data.online then online += 1 end
	end
	statusLabel.Text = string.format("Current: %d  •  Logged: %d", online, total)
end

local function createOrUpdatePlayerEntry(player, isOnline)
	local username = player.Name
	local displayName = player.DisplayName
	local userId = player.UserId
	local isWatched = watchSet[string.lower(username)]

	if playerEntries[username] then
		local data = playerEntries[username]
		data.online = isOnline
		data.displayName = displayName

		local entry = data.frame
		local nameLabel = entry:FindFirstChild("NameLabel")
		local userLabel = entry:FindFirstChild("UserLabel")

		if isOnline then
			entry.BackgroundColor3 = isWatched and Color3.fromRGB(40, 15, 15) or Theme.Elevated
			if nameLabel then
				nameLabel.Text = displayName
				nameLabel.TextColor3 = Theme.TextPrimary
			end
			if userLabel then
				userLabel.Text = "@" .. username
				userLabel.TextColor3 = isWatched and Color3.fromRGB(255, 140, 140) or Theme.TextSecondary
			end
		else
			entry.BackgroundColor3 = Theme.Surface
			if nameLabel then
				nameLabel.Text = displayName .. " (Left)"
				nameLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
			end
			if userLabel then
				userLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
			end
		end
		updateStatus()
		return
	end

	local entry = Instance.new("Frame")
	entry.Name = username
	entry.Size = UDim2.new(1, -2, 0, 32)
	entry.BackgroundColor3 = isWatched and Color3.fromRGB(40, 15, 15) or Theme.Elevated
	entry.BackgroundTransparency = T
	entry.BorderSizePixel = 0
	entry.Parent = scroll

	local entryCorner = Instance.new("UICorner")
	entryCorner.CornerRadius = UDim.new(0, 5)
	entryCorner.Parent = entry

	if isWatched then
		local watchStroke = Instance.new("UIStroke")
		watchStroke.Color = Color3.fromRGB(200, 50, 50)
		watchStroke.Thickness = 1.2
		watchStroke.Parent = entry
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, -10, 0, 16)
	nameLabel.Position = UDim2.new(0, 7, 0, 2)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = displayName
	nameLabel.TextColor3 = Theme.TextPrimary
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = entry

	local userLabel = Instance.new("TextLabel")
	userLabel.Name = "UserLabel"
	userLabel.Size = UDim2.new(1, -10, 0, 12)
	userLabel.Position = UDim2.new(0, 7, 0, 17)
	userLabel.BackgroundTransparency = 1
	userLabel.Text = "@" .. username
	userLabel.TextColor3 = isWatched and Color3.fromRGB(255, 140, 140) or Theme.TextSecondary
	userLabel.TextSize = 11
	userLabel.Font = Enum.Font.Gotham
	userLabel.TextXAlignment = Enum.TextXAlignment.Left
	userLabel.TextTruncate = Enum.TextTruncate.AtEnd
	userLabel.Parent = entry

	local clickButton = Instance.new("TextButton")
	clickButton.Size = UDim2.new(1, 0, 1, 0)
	clickButton.BackgroundTransparency = 1
	clickButton.Text = ""
	clickButton.Parent = entry

	clickButton.MouseButton1Click:Connect(function()
		openPopup(userId, displayName, username)
	end)

	clickButton.MouseEnter:Connect(function()
		if isOnline then
			Tween(entry, {
				BackgroundColor3 = isWatched and Color3.fromRGB(55, 20, 20) or Theme.SurfaceHover
			}, 0.12)
		end
	end)

	clickButton.MouseLeave:Connect(function()
		if isOnline then
			Tween(entry, {
				BackgroundColor3 = isWatched and Color3.fromRGB(40, 15, 15) or Theme.Elevated
			}, 0.12)
		end
	end)

	playerEntries[username] = {
		frame = entry,
		online = isOnline,
		userId = userId,
		displayName = displayName
	}

	if isWatched and isOnline then
		sendNotification("Target Spotted!", string.format("%s (%s) is in the server", displayName, username), 8)
	end

	updateStatus()
end

-- ================================
-- Events + Dragging + Minimize
-- ================================
for _, player in ipairs(Players:GetPlayers()) do
	createOrUpdatePlayerEntry(player, true)
end

Players.PlayerAdded:Connect(function(player)
	createOrUpdatePlayerEntry(player, true)
end)

Players.PlayerRemoving:Connect(function(player)
	createOrUpdatePlayerEntry(player, false)
end)

local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

local function setMinimized(state)
	minimized = state
	if minimized then
		closePopup()
		TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = minimizedSize
		}):Play()
		scroll.Visible = false
		statusLabel.Visible = false
		minimizeBtn.Text = "+"
		titleLabel.Size = UDim2.new(1, -40, 1, 0)
		closeBtn.Visible = false
		minimizeBtn.Position = UDim2.new(1, -30, 0.5, -12)
	else
		TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = originalSize
		}):Play()
		scroll.Visible = true
		statusLabel.Visible = true
		minimizeBtn.Text = "–"
		titleLabel.Size = UDim2.new(1, -70, 1, 0)
		closeBtn.Visible = true
		minimizeBtn.Position = UDim2.new(1, -56, 0.5, -12)
	end
end

minimizeBtn.MouseButton1Click:Connect(function()
	setMinimized(not minimized)
end)

titleBar.InputBegan:Connect(function(input)
	if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		task.delay(0.05, function()
			if not dragging then
				setMinimized(false)
			end
		end)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	screenGui:Destroy()
end)
