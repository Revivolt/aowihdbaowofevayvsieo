local function Tween(obj, props, duration)
	TweenService:Create(obj, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function setupButtonAnimations(button, normalColor, hoverColor, pressColor)
	local originalSize = button.Size

	button.MouseEnter:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {
			BackgroundColor3 = normalColor,
			Size = originalSize
		}, 0.12)
	end)

	button.MouseButton1Down:Connect(function()
		Tween(button, {
			BackgroundColor3 = pressColor,
			Size = originalSize - UDim2.new(0, 1, 0, 1)
		}, 0.08)
	end)

	button.MouseButton1Up:Connect(function()
		Tween(button, {
			BackgroundColor3 = hoverColor,
			Size = originalSize + UDim2.new(0, 2, 0, 2)
		}, 0.08)
	end)
end

-- ================================
-- Notification + Clipboard
-- ================================
local function sendNotification(title, text, duration)
	duration = duration or 8
	task.spawn(function()
		for _ = 1, 40 do
			local success = pcall(function()
				StarterGui:SetCore("SendNotification", {
					Title = title,
					Text = text,
					Duration = duration,
				})
			end)
			if success then return end
			task.wait(0.1)
		end
	end)
end

local function copyToClipboard(text)
	local success = pcall(function()
		if setclipboard then
			setclipboard(text)
		elseif toclipboard then
			toclipboard(text)
		else
			error("No clipboard function")
		end
	end)

	if success then
		sendNotification("Copied!", text, 3)
	else
		sendNotification("Clipboard Error", "Could not copy username", 4)
	end
end

