local function updatePopupPosition()
	if not popupOpen then return end
	local mainPos = mainFrame.AbsolutePosition
	local mainSize = mainFrame.AbsoluteSize
	local offsetX = 12
	local newX = mainPos.X + mainSize.X + offsetX
	local newY = mainPos.Y
	local viewport = workspace.CurrentCamera.ViewportSize
	if newX + 220 > viewport.X then
		newX = mainPos.X - 220 - offsetX
	end
	popup.Position = UDim2.new(0, newX, 0, newY)
end

local function closePopup()
	if not popupOpen then return end
	popupOpen = false
	local tween = TweenService:Create(popup, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 200, 0, 370),
		BackgroundTransparency = 1
	})
	tween:Play()
	tween.Completed:Connect(function()
		popup.Visible = false
		popup.BackgroundTransparency = T
		popup.Size = UDim2.new(0, 220, 0, 400)
	end)
end

local function updateSaveRemoveButtons()
	if not currentPopupUsername then return end

	local isSaved = watchSet[string.lower(currentPopupUsername)]

