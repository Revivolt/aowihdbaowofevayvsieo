if Config.ForceNight then
    -- Kill Sky and Clouds immediately
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") or child:IsA("Clouds") then
            child:Destroy()
        end
    end

    -- Block any re-added Sky/Clouds mid-session
    Lighting.ChildAdded:Connect(function(child)
        if child:IsA("Sky") or child:IsA("Clouds") then
            task.defer(function() if child and child.Parent then child:Destroy() end end)
        end
    end)

    -- Set ambient values once
    Lighting.Brightness        = 0
    Lighting.Ambient           = Color3.fromRGB(80, 80, 100)
    Lighting.OutdoorAmbient    = Color3.fromRGB(80, 80, 100)
    Lighting.ColorShift_Top    = Color3.new(0, 0, 0)
    Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)

    -- Force ClockTime every heartbeat — overrides any game lighting script
    RunService.Heartbeat:Connect(function()
        Lighting.ClockTime = 0
    end)
end

