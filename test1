    tab:AddToggle({
        Label   = label,
        Default = false,
        Callback = function(state)
            enabled = state
            if not enabled then
                cleanupToggle(conn, track, false)
                conn = nil; track = nil; lastChar = nil
                lastState = "front"; backCounter = 0; frontCounter = 0
                return
            end
            if not selectedTarget then return end
            conn = weldRun.Heartbeat:Connect(function()
                if not enabled then return end
                if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                    enabled = false
                    cleanupToggle(conn, track, false)
                    conn = nil; track = nil; lastChar = nil
                    lastState = "front"; backCounter = 0; frontCounter = 0
                    return
                end
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot then return end
                local tgtChar = selectedTarget.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not tgtChar or not tgtRoot then return end
                if myChar ~= lastChar then
                    lastChar = myChar
                    if track then track:Stop(); track:Destroy() end
                    track = loadAnim(myChar, animId, freezeAt, true)
                    if track then track:Play(); track.TimePosition = freezeAt; track:AdjustSpeed(0) end
                end
                pcall(function()
                    local vel      = tgtRoot.AssemblyLinearVelocity
                    local tgtHuman = tgtChar:FindFirstChildOfClass("Humanoid")
                    local moveDir  = tgtHuman and tgtHuman.MoveDirection or Vector3.zero
                    local isMoving = moveDir.Magnitude > 0.1
                    local tgtFwd   = Vector3.new(tgtRoot.CFrame.LookVector.X, 0, tgtRoot.CFrame.LookVector.Z).Unit
                    local dot      = moveDir:Dot(tgtFwd)
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    local baseCF   = CFrame.new(tgtRoot.Position) * CFrame.Angles(0, tgtYaw, 0)
                    local isAirborne = math.abs(vel.Y) > 15
                    if not isAirborne then
                        if isMoving and dot < 0 then
                            backCounter = backCounter + 1; frontCounter = 0
                        elseif isMoving and dot >= 0 then
                            frontCounter = frontCounter + 1; backCounter = 0
                        else
                            backCounter = 0; frontCounter = 0
                        end
                        if backCounter >= 5 then
                            lastState = "back"; frontCounter = 0
                        elseif frontCounter >= 5 then
                            lastState = "front"; backCounter = 0
                        end
                    end
                    local off = (lastState == "back") and backOff or frontOff
                    myRoot.CFrame = baseCF * CFrame.new(off[1], off[2], off[3])
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
        end,
    })
end

