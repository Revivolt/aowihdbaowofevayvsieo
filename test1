local function loadAnim(myChar, animId, freezeAt, freeze)
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHum then return nil end
    local track
    pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(animId)
        track = myHum:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track.TimePosition = freezeAt or 0
        if freeze then track:AdjustSpeed(0) end
    end)
    return track
end

local function makeWallToggle(tab, label, cfg)
    local conn              = nil
    local enabled           = false
    local track             = nil
    local lastChar          = nil
    local up                = cfg.up       or 0
    local forward           = cfg.forward  or 0
    local side              = cfg.side     or 0
    local tiltX             = cfg.tiltX    or 0
    local tiltY             = cfg.tiltY    or 0
    local tiltZ             = cfg.tiltZ    or 0
    local faceBack          = cfg.faceBack or false
    local noCollide         = (cfg.noCollide ~= false)
    local spinSpeed         = cfg.spinSpeed
    local fakeChar          = nil
    local fakeAnimTracks    = {}
    local renderConn        = nil
    local transparencyConn  = nil
    local camConn           = nil
    local realChar          = nil
    local savedCamSubject   = nil
    local respawning        = false
    local savedTracks       = {}
    local targetDiedConn    = nil
    local targetRemovedConn = nil
    local targetRespawnConn = nil
    local lastFakeCFrame    = nil
    local deathHandled      = false
    local controls          = nil

    pcall(function()
        local PM = require(weldLocal:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
        controls = PM:GetControls()
    end)

    local function loadEmote(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local hi = (4096^3*1024)+(999^2*516158)+(37^4*43)-(123^3*7)+(8888*9)-314159-66^4-47471589
        savedTracks = {}
        for _, t in pairs(hum:GetPlayingAnimationTracks()) do
            table.insert(savedTracks, {track=t, speed=t.Speed, timePosition=t.TimePosition})
            t:Stop()
        end
        local as = char:FindFirstChild("Animate")
        if as then as.Disabled = true end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. hi
        local t = hum:LoadAnimation(anim)
        t:Play(); t:AdjustSpeed(0); t.TimePosition = 1678*0.00000323
        return t
    end

    local function restoreTracks(char)
        if not char then return end
        local as = char:FindFirstChild("Animate")
        if as then as.Disabled = false end
        for _, saved in pairs(savedTracks) do
            if saved.track and not saved.track.IsPlaying then
                saved.track:Play()
                saved.track:AdjustSpeed(saved.speed)
                saved.track.TimePosition = saved.timePosition
            end
        end
        savedTracks = {}
    end

    local function getCharAnims(char)
        local animate = char:FindFirstChild("Animate")
        if not animate then return {} end
        local function ga(name)
            local f = animate:FindFirstChild(name)
            if f then
                local a = f:FindFirstChildWhichIsA("Animation")
                if a then return a.AnimationId end
            end
        end
        return {Idle=ga("idle"), Walk=ga("walk"), Run=ga("run"), Jump=ga("jump"), Fall=ga("fall")}
    end

    local function stopFakeAnims()
        for _, t in pairs(fakeAnimTracks) do
            if t and t.IsPlaying then t:Stop(0.1) end
        end
    end

    local function cleanupFakeChar()
        if renderConn       then renderConn:Disconnect();       renderConn       = nil end
        if transparencyConn then transparencyConn:Disconnect(); transparencyConn = nil end
        if camConn          then camConn:Disconnect();          camConn          = nil end
        fakeAnimTracks = {}
        if fakeChar then fakeChar:Destroy(); fakeChar = nil end
        realChar = nil
    end

    local function teleportToFake(onDone)
        local cf = nil
        if fakeChar then
            local fr = fakeChar:FindFirstChild("HumanoidRootPart")
            if fr then cf = fr.CFrame end
        end
        if not cf then cf = lastFakeCFrame end
        if not cf then if onDone then onDone() end; return end
        task.spawn(function()
            for _ = 1, 5 do
                local mc = weldLocal.Character
                local mr = mc and mc:FindFirstChild("HumanoidRootPart")
                if mr then
                    mr.CFrame = cf
                    mr.AssemblyLinearVelocity  = Vector3.zero
                    mr.AssemblyAngularVelocity = Vector3.zero
                    break
                end
                task.wait(0.05)
            end
            if onDone then onDone() end
        end)
    end

    local function destroyFakeChar()
        if camConn then camConn:Disconnect(); camConn = nil end
        local camera = workspace.CurrentCamera
        if savedCamSubject then
            camera.CameraSubject = savedCamSubject; savedCamSubject = nil
        else
            local rc = weldLocal.Character
            local rh = rc and rc:FindFirstChild("Humanoid")
            if rh then camera.CameraSubject = rh end
        end
        if fakeChar and realChar then
            local fr = fakeChar:FindFirstChild("HumanoidRootPart")
            local rr = realChar:FindFirstChild("HumanoidRootPart")
            if fr and rr then rr.CFrame = fr.CFrame end
        end
        restoreTracks(realChar)
        cleanupFakeChar()
    end

    local connectTargetDied

    local function spawnFakeChar()
        local char = weldLocal.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        realChar = char; char.Archivable = true
        fakeChar = char:Clone()
        fakeChar.Name = "WallClone"
        fakeChar.Parent = workspace
        local fakeHum  = fakeChar:FindFirstChild("Humanoid")
        local fakeRoot = fakeChar:FindFirstChild("HumanoidRootPart")
        if not fakeHum or not fakeRoot then return end
        for _, v in pairs(fakeChar:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                v.Anchored   = false
                v.CanCollide = (v.Name == "HumanoidRootPart")
                if v.Name == "HumanoidRootPart" then v.Transparency = 1 end
            end
        end
        local ca = fakeChar:FindFirstChild("Animate")
        if ca then ca.Disabled = true end
        local rr = char:FindFirstChild("HumanoidRootPart")
        if rr then fakeRoot.CFrame = rr.CFrame end
        local charAnims = getCharAnims(char)
        local function LA(id)
            if not id then return nil end
            local a = Instance.new("Animation"); a.AnimationId = id
            return fakeHum:LoadAnimation(a)
        end
        fakeAnimTracks.Idle = LA(charAnims.Idle)
        fakeAnimTracks.Walk = LA(charAnims.Walk)
        fakeAnimTracks.Run  = LA(charAnims.Run)
        fakeAnimTracks.Jump = LA(charAnims.Jump)
        fakeAnimTracks.Fall = LA(charAnims.Fall)
        if fakeAnimTracks.Idle then fakeAnimTracks.Idle:Play() end
        local camera = workspace.CurrentCamera
        savedCamSubject      = camera.CameraSubject
        camera.CameraSubject = fakeHum
        local camOverrideAllowed = true
        camConn = camera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
            if not fakeChar or not camOverrideAllowed then return end
            local fh = fakeChar:FindFirstChild("Humanoid")
            if not fh then return end
            -- Only re-assert if the new subject isn't from a BasePart/Humanoid we don't own
            local newSubject = camera.CameraSubject
            if newSubject == fh then return end
            -- Brief cooldown so external scripts can coexist without loop-crashing
            camOverrideAllowed = false
            task.delay(0.1, function()
                camOverrideAllowed = true
                if not fakeChar then return end
                local fh2 = fakeChar:FindFirstChild("Humanoid")
                if fh2 then camera.CameraSubject = fh2 end
            end)
        end)
        fakeHum.StateChanged:Connect(function(_, ns)
            if ns == Enum.HumanoidStateType.Jumping then
                stopFakeAnims(); if fakeAnimTracks.Jump then fakeAnimTracks.Jump:Play() end
            elseif ns == Enum.HumanoidStateType.Freefall then
                stopFakeAnims(); if fakeAnimTracks.Fall then fakeAnimTracks.Fall:Play() end
            elseif ns == Enum.HumanoidStateType.Landed then
                stopFakeAnims(); if fakeAnimTracks.Idle then fakeAnimTracks.Idle:Play() end
            end
        end)
        transparencyConn = RunService.RenderStepped:Connect(function()
            if not fakeChar then return end
            local cam = workspace.CurrentCamera
            local fh  = fakeChar:FindFirstChild("Head")
            local inFP = fh and cam and (cam.CFrame.Position - fh.Position).Magnitude < 2.5
            for _, part in pairs(fakeChar:GetDescendants()) do
                if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Name ~= "HumanoidRootPart" then
                    part.LocalTransparencyModifier = inFP and 1 or 0
                end
            end
        end)
        renderConn = RunService.RenderStepped:Connect(function()
            if not fakeChar or not fakeHum or not fakeRoot then return end
            local UIS = game:GetService("UserInputService")
            local iv  = Vector3.zero
            if controls then
                iv = controls:GetMoveVector()
            else
                if UIS:IsKeyDown(Enum.KeyCode.W) then iv += Vector3.new(0,0,-1) end
                if UIS:IsKeyDown(Enum.KeyCode.S) then iv += Vector3.new(0,0,1) end
                if UIS:IsKeyDown(Enum.KeyCode.A) then iv += Vector3.new(-1,0,0) end
                if UIS:IsKeyDown(Enum.KeyCode.D) then iv += Vector3.new(1,0,0) end
            end
            local cs = fakeHum:GetState()
            if UIS:IsKeyDown(Enum.KeyCode.Space) and cs ~= Enum.HumanoidStateType.Jumping and cs ~= Enum.HumanoidStateType.Freefall then
                fakeHum.Jump = true
            end
            local camCF = workspace.CurrentCamera.CFrame
            local fd = (camCF.RightVector * iv.X) + (camCF.LookVector * -iv.Z)
            fd = Vector3.new(fd.X, 0, fd.Z)
            local grounded = cs == Enum.HumanoidStateType.Running or cs == Enum.HumanoidStateType.RunningNoPhysics
            if fd.Magnitude > 0.01 then
                fakeHum:Move(fd.Unit, false)
                if grounded and fakeAnimTracks.Run and not fakeAnimTracks.Run.IsPlaying then
                    stopFakeAnims(); fakeAnimTracks.Run:Play(0.1)
                end
            else
                fakeHum:Move(Vector3.zero, false)
                if grounded and fakeAnimTracks.Idle and not fakeAnimTracks.Idle.IsPlaying then
                    stopFakeAnims(); fakeAnimTracks.Idle:Play(0.1)
                end
            end
            if fakeRoot then lastFakeCFrame = fakeRoot.CFrame end
        end)
    end

    connectTargetDied = function(tgtChar)
        if targetDiedConn    then targetDiedConn:Disconnect();    targetDiedConn    = nil end
        if targetRemovedConn then targetRemovedConn:Disconnect(); targetRemovedConn = nil end
        if not tgtChar then return end
        local tgtHum = tgtChar:FindFirstChildOfClass("Humanoid")
        if not tgtHum then return end
        deathHandled = false
        local function handleDeath()
            if not enabled or deathHandled then return end
            deathHandled = true
            if targetDiedConn    then targetDiedConn:Disconnect();    targetDiedConn    = nil end
            if targetRemovedConn then targetRemovedConn:Disconnect(); targetRemovedConn = nil end
            respawning = true
            if fakeChar then
                local fr = fakeChar:FindFirstChild("HumanoidRootPart")
                if fr then lastFakeCFrame = fr.CFrame end
            end
            teleportToFake(function()
                destroyFakeChar()
                if track then track:Stop(); track:Destroy(); track = nil end
                savedTracks = {}
                if not selectedTarget then
                    enabled = false
                    activeFlingCount = math.max(0, activeFlingCount - 1)
                    cleanupToggle(conn, track, noCollide)
                    conn = nil; lastChar = nil; respawning = false; lastFakeCFrame = nil
                    return
                end
                if targetRespawnConn then targetRespawnConn:Disconnect(); targetRespawnConn = nil end
                targetRespawnConn = selectedTarget.CharacterAdded:Connect(function(newChar)
                    if targetRespawnConn then targetRespawnConn:Disconnect(); targetRespawnConn = nil end
                    if not enabled then respawning = false; return end
                    task.wait(0.8)
                    if not enabled then respawning = false; return end
                    local mc = weldLocal.Character
                    if mc then lastChar = mc; track = loadEmote(mc); spawnFakeChar() end
                    connectTargetDied(newChar)
                    respawning = false
                end)
            end)
        end
        targetDiedConn = tgtHum.Died:Connect(handleDeath)
        targetRemovedConn = tgtChar.AncestryChanged:Connect(function(_, np)
            if np == nil then handleDeath() end
        end)
    end

    tab:AddToggle({
        Label   = label,
        Default = false,
        Callback = function(state)
            enabled = state
            if not enabled then
                activeFlingCount = math.max(0, activeFlingCount - 1)
                cleanupToggle(conn, track, noCollide)
                conn = nil; track = nil; lastChar = nil
                respawning = false; lastFakeCFrame = nil; deathHandled = false
                if targetDiedConn    then targetDiedConn:Disconnect();    targetDiedConn    = nil end
                if targetRemovedConn then targetRemovedConn:Disconnect(); targetRemovedConn = nil end
                if targetRespawnConn then targetRespawnConn:Disconnect(); targetRespawnConn = nil end
                destroyFakeChar()
                return
            end
            if not selectedTarget then return end
            activeFlingCount = activeFlingCount + 1
            local initChar = weldLocal.Character
            if initChar then lastChar = initChar; track = loadEmote(initChar); spawnFakeChar() end
            connectTargetDied(selectedTarget.Character)
            conn = weldRun.Heartbeat:Connect(function()
                if not enabled or respawning then return end
                if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                    teleportToFake(function()
                        enabled = false
                        activeFlingCount = math.max(0, activeFlingCount - 1)
                        cleanupToggle(conn, track, noCollide)
                        conn = nil; track = nil; lastChar = nil
                        respawning = false; lastFakeCFrame = nil; deathHandled = false
                        if targetDiedConn    then targetDiedConn:Disconnect();    targetDiedConn    = nil end
                        if targetRemovedConn then targetRemovedConn:Disconnect(); targetRemovedConn = nil end
                        if targetRespawnConn then targetRespawnConn:Disconnect(); targetRespawnConn = nil end
                        destroyFakeChar()
                    end)
                    return
                end
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot then return end
                local tgtChar = selectedTarget.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not tgtChar or not tgtRoot then return end
                if myChar ~= lastChar then
                    lastChar = myChar; respawning = true
                    cleanupFakeChar()
                    local nh = myChar:FindFirstChild("Humanoid")
                    if nh then workspace.CurrentCamera.CameraSubject = nh; savedCamSubject = nh end
                    if track then track:Stop(); track:Destroy(); track = nil end
                    savedTracks = {}
                    connectTargetDied(tgtChar)
                    task.spawn(function()
                        task.wait(0.5)
                        if not enabled then return end
                        track = loadEmote(myChar); spawnFakeChar(); respawning = false
                    end)
                    return
                end
                pcall(function()
                    for _, part in ipairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") and noCollide then part.CanCollide = false end
                    end
                    local hum = myChar:FindFirstChildOfClass("Humanoid")
                    local animator = hum and hum:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                            if t ~= track then t:Stop(0) end
                        end
                    end
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    local yaw = faceBack and (tgtYaw + math.pi) or tgtYaw
                    local cf = CFrame.new(tgtRoot.Position) * CFrame.Angles(0, yaw, 0) * CFrame.new(side, up, -forward)
                    if spinSpeed then cf = cf * CFrame.Angles(0, os.clock() * spinSpeed, 0) end
                    cf = cf * CFrame.Angles(math.rad(tiltX), math.rad(tiltY), math.rad(tiltZ))
                    myRoot.CFrame = cf
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
        end,
    })
end

local function makeSimpleToggle(tab, label, cfg)
    local conn      = nil
    local enabled   = false
    local track     = nil
    local lastChar  = nil
    local up        = cfg.up       or 0
    local forward   = cfg.forward  or 0
    local side      = cfg.side     or 0
    local tiltX     = cfg.tiltX    or 0
    local tiltY     = cfg.tiltY    or 0
    local tiltZ     = cfg.tiltZ    or 0
    local faceBack  = cfg.faceBack or false
    local noCollide = (cfg.noCollide == true)
    local freezeAt  = cfg.freezeAt or 0
    local animId    = cfg.animId   or 0
    local useHead   = cfg.useHead  or false

    tab:AddToggle({
        Label   = label,
        Default = false,
        Callback = function(state)
            enabled = state
            if not enabled then
                cleanupToggle(conn, track, noCollide)
                conn = nil; track = nil; lastChar = nil
                return
            end
            if not selectedTarget then return end
            conn = weldRun.Heartbeat:Connect(function()
                if not enabled then return end
                if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                    enabled = false
                    cleanupToggle(conn, track, noCollide)
                    conn = nil; track = nil; lastChar = nil
                    return
                end
                local partName = useHead and "Head" or "HumanoidRootPart"
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild(partName)
                if not myChar or not myRoot then return end
                local tgtChar = selectedTarget.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild(partName)
                if not tgtChar or not tgtRoot then return end
                if myChar ~= lastChar then
                    lastChar = myChar
                    if track then track:Stop(); track:Destroy() end
                    track = loadAnim(myChar, animId, freezeAt, true)
                end
                pcall(function()
                    for _, part in ipairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") and noCollide then part.CanCollide = false end
                    end
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    local yaw = faceBack and (tgtYaw + math.pi) or tgtYaw
                    myRoot.CFrame = CFrame.new(tgtRoot.Position) * CFrame.Angles(0, yaw, 0)
                        * CFrame.new(side, up, -forward)
                        * CFrame.Angles(math.rad(tiltX), math.rad(tiltY), math.rad(tiltZ))
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
        end,
    })
end

local function makeOscillatingToggle(tab, label, cfg)
    local conn       = nil
    local enabled    = false
    local track      = nil
    local lastChar   = nil
    local up         = cfg.up        or 0
    local forward    = cfg.forward   or 0
    local side       = cfg.side      or 0
    local tiltX      = cfg.tiltX     or 0
    local tiltY      = cfg.tiltY     or 0
    local tiltZ      = cfg.tiltZ     or 0
    local faceBack   = cfg.faceBack  or false
    local noCollide  = (cfg.noCollide == true)
    local freezeAt   = cfg.freezeAt  or 0
    local animId     = cfg.animId    or 0
    local swingAmp   = cfg.swingAmp  or 3
    local swingSpeed = cfg.swingSpeed or 1
    local swingClock = 0

    tab:AddToggle({
        Label   = label,
        Default = false,
        Callback = function(state)
            enabled = state
            swingClock = 0
            if not enabled then
                cleanupToggle(conn, track, noCollide)
                conn = nil; track = nil; lastChar = nil
                return
            end
            if not selectedTarget then return end
            conn = weldRun.Heartbeat:Connect(function(dt)
                if not enabled then return end
                if not selectedTarget or not weldPlayers:FindFirstChild(selectedTarget.Name) then
                    enabled = false
                    cleanupToggle(conn, track, noCollide)
                    conn = nil; track = nil; lastChar = nil
                    return
                end
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot then return end
                local tgtChar = selectedTarget.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not tgtChar or not tgtRoot then return end
                if myChar ~= lastChar then
                    lastChar = myChar
                    if track then track:Stop(); track:Destroy() end
                    track = loadAnim(myChar, animId, freezeAt, true)
                end
                swingClock = swingClock + dt
                local swingOffset = forward + math.sin(swingClock * swingSpeed * math.pi * 2) * swingAmp
                pcall(function()
                    for _, part in ipairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") and noCollide then part.CanCollide = false end
                    end
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    local yaw = faceBack and (tgtYaw + math.pi) or tgtYaw
                    myRoot.CFrame = CFrame.new(tgtRoot.Position) * CFrame.Angles(0, yaw, 0)
                        * CFrame.new(side, up, -swingOffset)
                        * CFrame.Angles(math.rad(tiltX), math.rad(tiltY), math.rad(tiltZ))
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
        end,
    })
end

