-----------------------------
-- CONFIG
-----------------------------
local ANIMATION_ID = 70883871260184
local FREEZE_AFTER_SECONDS = 0.04
local REFRESH_INTERVAL = 1.5  -- How often (seconds) to re-trigger for other clients

-- MOVEMENT SPEEDS
local BASE_WALK_SPEED = 16
local SPRINT_SPEED = 30

-----------------------------
-- SERVICES
-----------------------------
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

-----------------------------
-- CHARACTER
-----------------------------
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local animator = humanoid:WaitForChild("Animator")

-----------------------------
-- PLAY & FREEZE
-----------------------------
local track  -- kept in outer scope so the refresh loop can control it

local function playAndFreeze()
	if ANIMATION_ID == 0 then return end

	-- Stop & destroy old track if one exists
	if track then
		track:Stop()
		track:Destroy()
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. ANIMATION_ID

	track = animator:LoadAnimation(anim)
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Action
	track:Play()

	task.delay(FREEZE_AFTER_SECONDS, function()
		if track and track.IsPlaying then
			track:AdjustSpeed(0)  -- Freeze at desired pose
		end
	end)
end

-- Refresh loop: re-plays every REFRESH_INTERVAL seconds so
-- other clients keep receiving the replication signal
task.spawn(function()
	while true do
		playAndFreeze()
		task.wait(REFRESH_INTERVAL)
	end
end)

-----------------------------
-- SPRINT INPUT
-----------------------------
humanoid.WalkSpeed = BASE_WALK_SPEED

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.LeftShift then
		humanoid.WalkSpeed = SPRINT_SPEED
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		humanoid.WalkSpeed = BASE_WALK_SPEED
	end
end)
