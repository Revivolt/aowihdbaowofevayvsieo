            if not root then return end
            if value then
                applyStateOverrides(char)
                setNoclip(char, true)
                lockedY  = root.Position.Y - 5
                isLocked = true
                root.CFrame = CFrame.new(root.Position.X, lockedY, root.Position.Z)
                root.AssemblyLinearVelocity  = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                hbConn = RunService.Heartbeat:Connect(function()
                    if not root or not root.Parent then stopAll(); return end
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local anim = hum:FindFirstChildOfClass("Animator")
                        if anim then
                            for _, t in ipairs(anim:GetPlayingAnimationTracks()) do t:Stop(0) end
                        end
                    end
                    if isLocked and lockedY ~= nil then
                        local pos = root.Position
                        if math.abs(pos.Y - lockedY) > 0.01 then
                            root.CFrame = CFrame.new(pos.X, lockedY, pos.Z)
                        end
                        local v = root.AssemblyLinearVelocity
                        root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                    end
                    oldV = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = oldV * 0 + Vector3.new(0, -9e9, 0)
                end)
                rdConn = RunService.RenderStepped:Connect(function()
                    if not root or not root.Parent then return end
                    root.AssemblyLinearVelocity = oldV
                end)
                stConn = RunService.Stepped:Connect(function()
                    if not root or not root.Parent then return end
                    root.AssemblyLinearVelocity = oldV + Vector3.new(0, 0.1, 0)
                end)
            else
                isLocked = false; lockedY = nil
                stopAll()
                setNoclip(char, false)
                removeStateOverrides(char)
                root.CFrame = CFrame.new(root.Position)
            end
        end,
    })
end



