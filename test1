-- EmoteFreeze.lua
-- Place inside StarterCharacterScripts (LocalScript)
-- Plays animation 80120791952773, stops all other tracks,
-- then freezes the emote exactly 3 seconds in.

local ANIM_ID      = "rbxassetid://80120791952773"
local FREEZE_AT    = 3        -- seconds into the animation to freeze
local FADE_TIME    = 0.1      -- crossfade time when stopping other tracks

-- ── Helpers ──────────────────────────────────────────────────────────────────

local Players       = game:GetService("Players")
local RunService    = game:GetService("RunService")

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local animator  = humanoid:WaitForChild("Animator")

-- Wait a frame so the default Animate script can load its tracks first
RunService.Heartbeat:Wait()

-- ── Step 1 – Kill every currently-playing track ──────────────────────────────

local function stopAllTracks()
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        track:Stop(FADE_TIME)
    end
end

stopAllTracks()

-- ── Step 2 – Disable the Humanoid's built-in Animate script ──────────────────
-- The Animate LocalScript lives in the character and continuously feeds
-- idle/walk/run/fall tracks back in.  Disabling it keeps things quiet.

local animateScript = character:FindFirstChild("Animate")
if animateScript then
    animateScript.Disabled = true
end

-- ── Step 3 – Load and play the emote ─────────────────────────────────────────

local emoteAnim       = Instance.new("Animation")
emoteAnim.AnimationId = ANIM_ID

local emoteTrack = animator:LoadAnimation(emoteAnim)
emoteTrack.Priority  = Enum.AnimationPriority.Action4   -- highest built-in priority
emoteTrack.Looped    = false

emoteTrack:Play(FADE_TIME)

-- ── Step 4 – If anything sneaks in after play, kill it immediately ────────────

local guardConn = animator.AnimationPlayed:Connect(function(newTrack)
    if newTrack ~= emoteTrack then
        newTrack:Stop(0)
    end
end)

-- ── Step 5 – Freeze (pause) the track at FREEZE_AT seconds ───────────────────

task.delay(FREEZE_AT, function()
    if emoteTrack.IsPlaying then
        emoteTrack:AdjustSpeed(0)   -- speed = 0  →  animation is visually frozen
                                    -- but the track stays "playing" so no other
                                    -- track can override it
    end

    -- The guard connection is no longer needed after we freeze
    guardConn:Disconnect()
end)
