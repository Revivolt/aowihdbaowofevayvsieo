local function setupInvisibility()
          local lplayer    = weldPlayers.LocalPlayer
          local UIS        = game:GetService("UserInputService")
          local RunService = game:GetService("RunService")
          local Players    = game:GetService("Players")
          local humanoid, rootPart
          local toggleOn   = false
          local invisConn  = nil
          local shiftLockConn = nil
          local proximityConn = nil

          local virtualHRPPos = Vector3.new()

          local shiftLockActive = false
          local cameraYaw   = 0
          local cameraPitch = 0
          -- target yaw/pitch we smooth toward (set LOOK_SMOOTHNESS = 1 to disable)
          local targetYaw   = 0
          local targetPitch = 0

          local SHIFT_LOCK_OFFSET = Vector3.new(1.75, 0, 0)
          local SENSITIVITY = 0.4

          local cameraDistance = 12
          local targetDistance = 12
          local zoomInitialized = false
          local MIN_ZOOM = 0.5
          local MAX_ZOOM = 128
          local ZOOM_STEP = 3

          -- Smoothing now expressed as a per-second response rate so feel is
          -- identical at any framerate. Higher = snappier.
          local ZOOM_RESPONSE = 14
          local LOOK_RESPONSE = 30
          local LOOK_SMOOTHNESS = 1.0

          local FIRST_PERSON_THRESHOLD = 1.0
          local FIRST_PERSON_HYSTERESIS = 0.25
          local inFirstPerson = false

          -- Camera collision: pull in when a wall blocks the view.
          local CAMERA_COLLISION = true
          local CAMERA_COLLISION_RADIUS = 0.5

          local isMB2Down = false
          local pendingReleaseConn = nil

          -- ===== Mode selection =====
          -- "Method 1" = old simple -200000 teleport.
          -- "Method 2" = new proximity/drop/pulsing method.
          local MODE_OLD = "Normal"
          local MODE_NEW = "Anti-Bang"
          local mode = MODE_NEW

          -- ===== Proximity-based drop adjustment (Method 2 only) =====
          local PROXIMITY_RADIUS = 25            -- studs around the detection point
          local DROP_FAR  = -300                 -- default drop value
          local DROP_NEAR = -800                 -- drop value when a player is close
          local NEAR_HOLD = 0.22                 -- seconds to hold -500 before reverting
          local drop      = DROP_FAR             -- current drop value used by startInvis()
          local switching = false                -- re-entrancy guard for the 0.1s transitions
          local pulsing   = false                -- true while a -500 pulse is in progress

          -- Fixed detection point: where the HRP teleports during the invis cycle.
          local DETECT_POINT = Vector3.new(0, -300, -200000)

          -- Forward declarations so switchDrop / startProximityWatcher can call startInvis.
          local startInvis
          local startProximityWatcher

          local function clearPendingRelease()
              if pendingReleaseConn then
                  pendingReleaseConn:Disconnect()
                  pendingReleaseConn = nil
              end
          end

          local function updateChar()
              local character = lplayer.Character or lplayer.CharacterAdded:Wait()
              humanoid = character:WaitForChild("Humanoid")
              rootPart = character:WaitForChild("HumanoidRootPart")
          end
          updateChar()

          local function setCharacterFirstPerson(firstPerson)
              local char = lplayer.Character
              if not char then return end
              for _, part in ipairs(char:GetDescendants()) do
                  if part:IsA("BasePart") or part:IsA("Decal") then
                      part.LocalTransparencyModifier = firstPerson and 1 or 0
                  end
              end
              local clone = workspace:FindFirstChild("NanClone")
              if clone then
                  for _, part in ipairs(clone:GetDescendants()) do
                      if (part:IsA("BasePart") or part:IsA("Decal"))
                      and part.Name ~= "HumanoidRootPart" then
                          part.LocalTransparencyModifier = firstPerson and 1 or 0
                      end
                  end
              end
          end

          -- Builds the raycast params that ignore our own character + clone so the
          -- camera collision check doesn't snap onto ourselves.
          local function getCollisionParams()
              local params = RaycastParams.new()
              params.FilterType = Enum.RaycastFilterType.Exclude
              local filter = {}
              if lplayer.Character then table.insert(filter, lplayer.Character) end
              local clone = workspace:FindFirstChild("NanClone")
              if clone then table.insert(filter, clone) end
              params.FilterDescendantsInstances = filter
              params.IgnoreWater = true
              return params
          end

          -- Given the subject (pivot) point and the desired far camera position,
          -- returns a possibly-closer position if geometry is in the way.
          local function resolveCameraCollision(subjectPos, desiredPos)
              if not CAMERA_COLLISION then return desiredPos end
              local dir = desiredPos - subjectPos
              local dist = dir.Magnitude
              if dist < 0.001 then return desiredPos end
              local result = workspace:Raycast(subjectPos, dir, getCollisionParams())
              if result then
                  local hitDist = (result.Position - subjectPos).Magnitude
                  local clamped = math.max(hitDist - CAMERA_COLLISION_RADIUS, MIN_ZOOM)
                  return subjectPos + dir.Unit * clamped
              end
              return desiredPos
          end

          local function startCustomShiftLock()
              if shiftLockConn then shiftLockConn:Disconnect() end

              local camCF = workspace.CurrentCamera.CFrame
              local lookVec = camCF.LookVector
              cameraYaw   = math.atan2(-lookVec.X, -lookVec.Z)
              cameraPitch = math.asin(lookVec.Y)
              targetYaw   = cameraYaw
              targetPitch = cameraPitch

              -- Re-measure the live camera distance on every engage so zoom changes
              -- made while NOT shift-locked are respected. Only fall back to the
              -- stored distance when the reading is unreliable -- either ~0, OR we
              -- were already in first person (where the measured distance is just the
              -- subject-height offset, not a real zoom, and would cause a tiny pop).
              do
                  local cam = workspace.CurrentCamera
                  local referencePos = virtualHRPPos
                  if referencePos.Magnitude < 0.01 and rootPart then
                      referencePos = rootPart.Position
                  end
                  local measuredDist = (cam.CFrame.Position - referencePos).Magnitude

                  -- We consider the reading untrustworthy if we already know we're in
                  -- first person, or the stored zoom is at/below the threshold.
                  local wasFirstPerson = inFirstPerson
                      or cameraDistance <= FIRST_PERSON_THRESHOLD

                  if not wasFirstPerson and measuredDist > FIRST_PERSON_THRESHOLD then
                      -- Trustworthy reading -- adopt the camera's current zoom.
                      cameraDistance = math.clamp(measuredDist, MIN_ZOOM, MAX_ZOOM)
                  elseif not zoomInitialized then
                      -- First ever engage and reading is unreliable: clamp what we got.
                      cameraDistance = math.clamp(measuredDist, MIN_ZOOM, MAX_ZOOM)
                  end
                  -- else: keep the stored cameraDistance (genuine first-person re-engage)
                  zoomInitialized = true
              end
              targetDistance = cameraDistance

              shiftLockConn = RunService.RenderStepped:Connect(function(dt)
                  if not toggleOn or not shiftLockActive then return end

                  local cam = workspace.CurrentCamera

                  -- Accumulate raw look into targets, then smooth toward them.
                  local delta = UIS:GetMouseDelta()
                  targetYaw   = targetYaw - math.rad(delta.X * SENSITIVITY)
                  targetPitch = math.clamp(
                      targetPitch - math.rad(delta.Y * SENSITIVITY),
                      math.rad(-75), math.rad(75)
                  )

                  if LOOK_SMOOTHNESS >= 1.0 then
                      cameraYaw   = targetYaw
                      cameraPitch = targetPitch
                  else
                      local lookAlpha = 1 - math.exp(-LOOK_RESPONSE * dt)
                      cameraYaw   = cameraYaw   + (targetYaw   - cameraYaw)   * lookAlpha
                      cameraPitch = cameraPitch + (targetPitch - cameraPitch) * lookAlpha
                  end

                  -- Frame-rate independent zoom lerp.
                  local zoomAlpha = 1 - math.exp(-ZOOM_RESPONSE * dt)
                  cameraDistance = cameraDistance + (targetDistance - cameraDistance) * zoomAlpha

                  -- First-person with hysteresis so we don't flicker at the boundary.
                  if inFirstPerson then
                      if cameraDistance > FIRST_PERSON_THRESHOLD + FIRST_PERSON_HYSTERESIS then
                          inFirstPerson = false
                      end
                  else
                      if cameraDistance <= FIRST_PERSON_THRESHOLD then
                          inFirstPerson = true
                      end
                  end
                  setCharacterFirstPerson(inFirstPerson)

                  local rotation = CFrame.Angles(0, cameraYaw, 0) * CFrame.Angles(cameraPitch, 0, 0)
                  local subjectPos = virtualHRPPos + Vector3.new(0, 1.5, 0)

                  local camPos
                  if inFirstPerson then
                      camPos = subjectPos
                  else
                      -- Collapse the shoulder offset to 0 as we near first person so
                      -- there's no sideways pop on the transition.
                      local offsetBlend = math.clamp(
                          (cameraDistance - FIRST_PERSON_THRESHOLD) /
                          math.max(FIRST_PERSON_HYSTERESIS, 0.001),
                          0, 1
                      )
                      local shoulderPos = subjectPos
                          + rotation:VectorToWorldSpace(SHIFT_LOCK_OFFSET * offsetBlend)
                      local desired = shoulderPos - rotation.LookVector * cameraDistance
                      camPos = resolveCameraCollision(subjectPos, desired)
                  end

                  cam.CFrame = CFrame.new(camPos) * rotation

                  if rootPart and rootPart.Parent then
                      local hrpCF = rootPart.CFrame
                      rootPart.CFrame = CFrame.new(hrpCF.Position) * CFrame.Angles(0, cameraYaw, 0)
                  end
              end)
          end

          local function stopCustomShiftLock()
              if shiftLockConn then shiftLockConn:Disconnect(); shiftLockConn = nil end
              setCharacterFirstPerson(false)
              inFirstPerson = false
          end

          -- Sync our custom zoom into Roblox's default camera so disengaging shift
          -- lock doesn't snap (or slide) the camera back to its old internal zoom.
          local function syncZoomToDefaultCamera()
              pcall(function()
                  local minSave = lplayer.CameraMinZoomDistance
                  local maxSave = lplayer.CameraMaxZoomDistance
                  lplayer.CameraMinZoomDistance = cameraDistance
                  lplayer.CameraMaxZoomDistance = cameraDistance
                  task.spawn(function()
                      RunService.RenderStepped:Wait()
                      RunService.RenderStepped:Wait()
                      lplayer.CameraMinZoomDistance = minSave
                      lplayer.CameraMaxZoomDistance = maxSave
                  end)
              end)
          end

          UIS.InputBegan:Connect(function(input)
              if input.UserInputType == Enum.UserInputType.MouseButton2 then
                  isMB2Down = true
              end
          end)
          UIS.InputEnded:Connect(function(input)
              if input.UserInputType == Enum.UserInputType.MouseButton2 then
                  isMB2Down = false
              end
          end)

          UIS.InputChanged:Connect(function(input, gameProcessed)
              if gameProcessed then return end
              if not (toggleOn and shiftLockActive) then return end
              if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end

              targetDistance = math.clamp(
                  targetDistance - input.Position.Z * ZOOM_STEP,
                  MIN_ZOOM, MAX_ZOOM
              )
          end)

          UIS.InputBegan:Connect(function(input, gameProcessed)
              if gameProcessed then return end
              if not toggleOn then return end
              if input.KeyCode ~= Enum.KeyCode.LeftShift
              and input.KeyCode ~= Enum.KeyCode.RightShift then return end

              if shiftLockActive then
                  -- Settle the zoom lerp instantly so the pinned CFrame and the
                  -- synced zoom describe the same distance (fixes zoom-out slide).
                  cameraDistance = targetDistance
                  cameraYaw   = targetYaw
                  cameraPitch = targetPitch

                  -- Rebuild the camera CFrame from the settled distance, not the
                  -- mid-lerp camera, so position and zoom agree exactly.
                  local rotation = CFrame.Angles(0, cameraYaw, 0) * CFrame.Angles(cameraPitch, 0, 0)
                  local subjectPos = virtualHRPPos + Vector3.new(0, 1.5, 0)
                  local finalCamCF
                  if cameraDistance <= FIRST_PERSON_THRESHOLD then
                      finalCamCF = CFrame.new(subjectPos) * rotation
                  else
                      local offsetBlend = math.clamp(
                          (cameraDistance - FIRST_PERSON_THRESHOLD) /
                          math.max(FIRST_PERSON_HYSTERESIS, 0.001),
                          0, 1
                      )
                      local shoulderPos = subjectPos
                          + rotation:VectorToWorldSpace(SHIFT_LOCK_OFFSET * offsetBlend)
                      local desired = shoulderPos - rotation.LookVector * cameraDistance
                      finalCamCF = CFrame.new(resolveCameraCollision(subjectPos, desired)) * rotation
                  end

                  shiftLockActive = false
                  stopCustomShiftLock()
                  workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                  workspace.CurrentCamera.CFrame = finalCamCF

                  syncZoomToDefaultCamera()

                  clearPendingRelease()
                  if isMB2Down then
                      UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                      pendingReleaseConn = UIS.InputEnded:Connect(function(rel)
                          if rel.UserInputType == Enum.UserInputType.MouseButton2 then
                              clearPendingRelease()
                              if not shiftLockActive then
                                  UIS.MouseBehavior = Enum.MouseBehavior.Default
                              end
                          end
                      end)
                  else
                      UIS.MouseBehavior = Enum.MouseBehavior.Default
                  end
              else
                  clearPendingRelease()
                  shiftLockActive = true
                  workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
                  UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
                  startCustomShiftLock()
              end
          end)

          -- startInvis is forward-declared above; assign to it here. It branches on
          -- the selected mode: Method 1 is the simple relative -200000 teleport with
          -- no destroy-plane / drop handling; Method 2 is the absolute drop teleport
          -- driven by the proximity `drop` value.
          startInvis = function()
              if invisConn then invisConn:Disconnect() end
              local busy = false

              invisConn = RunService.Heartbeat:Connect(function()
                  if busy or not toggleOn then return end

                  if not (rootPart and humanoid and rootPart.Parent) then
                      updateChar()
                      return
                  end

                  busy = true

                  local originalCFrame = rootPart.CFrame
                  local originalPos    = originalCFrame.Position

                  virtualHRPPos = originalPos

                  if mode == MODE_OLD then
                      -- ===== Method 1: simple relative drop, no destroy-plane work.
                      local teleportCFrame = originalCFrame * CFrame.new(0, -200000, 0)
                      rootPart.CFrame = teleportCFrame

                      if not shiftLockActive then
                          humanoid.CameraOffset = teleportCFrame:ToObjectSpace(
                              CFrame.new(originalPos)
                          ).Position
                      end

                      RunService.RenderStepped:Wait()

                      if rootPart and rootPart.Parent then
                          local currentRotation = rootPart.CFrame.Rotation
                          rootPart.CFrame = currentRotation + originalPos
                      end
                      if humanoid and not shiftLockActive then
                          humanoid.CameraOffset = Vector3.new(0, 0, 0)
                      end
                  else
                      -- ===== Method 2: absolute drop using the proximity `drop` value.
                      local savedDestroy = workspace.FallenPartsDestroyHeight
                      workspace.FallenPartsDestroyHeight = -1000

                      local teleportCFrame = CFrame.new(0, drop, -200000)
                      rootPart.CFrame = teleportCFrame

                      if not shiftLockActive then
                          humanoid.CameraOffset = teleportCFrame:ToObjectSpace(
                              CFrame.new(originalPos)
                          ).Position
                      end

                      RunService.RenderStepped:Wait()

                      if rootPart and rootPart.Parent then
                          local currentRotation = rootPart.CFrame.Rotation
                          rootPart.CFrame = currentRotation + originalPos
                      end
                      if humanoid and not shiftLockActive then
                          humanoid.CameraOffset = Vector3.new(0, 0, 0)
                      end
                      workspace.FallenPartsDestroyHeight = savedDestroy
                  end

                  busy = false
              end)
          end

          -- Pause invis, change the drop value, reconnect after 0.1s.
          local function switchDrop(newDrop)
              if switching then return end
              if drop == newDrop then return end
              switching = true
              if invisConn then invisConn:Disconnect(); invisConn = nil end
              task.delay(0.1, function()
                  drop = newDrop
                  if toggleOn then startInvis() end
                  switching = false
              end)
          end

          -- Pulse to -500 for NEAR_HOLD seconds, then revert to -300. The watcher
          -- re-scans after the pulse completes, so it re-pulses if a player is
          -- still in range -- no latching, no waiting for death.
          local function pulseNear()
              if pulsing or switching then return end
              pulsing = true
              switchDrop(DROP_NEAR)
              task.delay(NEAR_HOLD, function()
                  if not toggleOn then
                      pulsing = false
                      return
                  end
                  switchDrop(DROP_FAR)
                  pulsing = false
              end)
          end

          -- startProximityWatcher is forward-declared above; assign to it here.
          -- Only meaningful in Method 2; it bails out immediately in Method 1.
          startProximityWatcher = function()
              if proximityConn then proximityConn:Disconnect() end
              proximityConn = RunService.Heartbeat:Connect(function()
                  if not toggleOn then return end
                  if mode ~= MODE_NEW then return end
                  -- A pulse is already running or a drop swap is in flight; wait it out.
                  if pulsing or switching then return end

                  -- Detection is measured against the FIXED teleport point. Any
                  -- player whose HumanoidRootPart comes within PROXIMITY_RADIUS of
                  -- this point triggers a -500 pulse.
                  for _, plr in ipairs(Players:GetPlayers()) do
                      if plr ~= lplayer and plr.Character then
                          local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                          local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                          if hum and hrp and hum.Health > 0 then
                              if (hrp.Position - DETECT_POINT).Magnitude <= PROXIMITY_RADIUS then
                                  pulseNear()
                                  break
                              end
                          end
                      end
                  end
              end)
          end

          -- Start whichever pieces the current mode needs.
          local function startForMode()
              startInvis()
              if mode == MODE_NEW then
                  startProximityWatcher()
              end
          end

          local function stopInvis()
              if invisConn then invisConn:Disconnect(); invisConn = nil end

              -- Proximity cleanup (Method 2).
              if proximityConn then proximityConn:Disconnect(); proximityConn = nil end
              switching = false
              pulsing   = false
              drop = DROP_FAR

              stopCustomShiftLock()
              clearPendingRelease()
              if shiftLockActive then
                  UIS.MouseBehavior = Enum.MouseBehavior.Default
              end
              shiftLockActive = false
              zoomInitialized = false
              if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
                  workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
              end
              if humanoid then humanoid.CameraOffset = Vector3.new(0, 0, 0) end
              pcall(function()
                  lplayer.DevEnableMouseLock = true
              end)
          end

          lplayer.CharacterAdded:Connect(function(character)
              humanoid = character:WaitForChild("Humanoid")
              rootPart = character:WaitForChild("HumanoidRootPart")
              if toggleOn then
                  startForMode()
              end
          end)

          -- Mode dropdown: switching while invis is ON cleanly stops the running
          -- method and restarts with the newly selected one.
          TabTrolling:AddDropdown({
              Label    = "Invis Mode",
              Options  = {MODE_OLD, MODE_NEW},
              Default  = MODE_NEW,
              Callback = function(value)
                  if value ~= MODE_OLD and value ~= MODE_NEW then return end
                  if value == mode then return end

                  if toggleOn then
                      -- Tear down the current method's connections, then re-arm.
                      if invisConn then invisConn:Disconnect(); invisConn = nil end
                      if proximityConn then proximityConn:Disconnect(); proximityConn = nil end
                      switching = false
                      pulsing   = false
                      drop = DROP_FAR
                      mode = value
                      updateChar()
                      startForMode()
                  else
                      mode = value
                  end
              end,
          })

          TabTrolling:AddToggle({
              Label   = "Invisibility",
              Default = false,
              Callback = function(value)
                  toggleOn = value
                  if value then
                      updateChar()
                      pcall(function()
                          lplayer.DevEnableMouseLock = false
                          if rootPart then
                              sethiddenproperty(rootPart, "PhysicsRepRootPart", rootPart)
                          end
                      end)
                      startForMode()
                  else
                      stopInvis()
                  end
              end,
          })

          return {
              isOn = function() return toggleOn end,
              reapply = function()
                  if not toggleOn then return end
                  updateChar()
                  startForMode()
              end,
          }
      end

      local invisSystem = setupInvisibility()

local function setupNanSystem()
    local nanFakeChar         = nil
    local nanFakeAnimTracks   = {}
    local nanRenderConn       = nil
    local nanTransparencyConn = nil
    local nanCamConn          = nil
    local nanRealChar         = nil
    local nanSavedCamSubject  = nil
    local nanSavedTracks      = {}
    local nanLastFakeCFrame   = nil
    local nanControls         = nil
    local VOID_THRESHOLD      = -100
    local lastSafePosition    = nil
    local voidSafetyConn      = nil

    -- Builds a rotation CFrame from a Vector3 of DEGREES (X, Y, Z).
    -- Used by both fling paths so they stay identical.
    local function nanRotCFrame(v)
        return CFrame.Angles(math.rad(v.X), math.rad(v.Y), math.rad(v.Z))
    end

    -- Per-option config: edit waits, offsets, and rotation for each option here.
    --   TWO-PHASE FLING:
    --   Phase 1 (the HOLD): your character moves to offset1 and waits there for
    --     wait1 seconds. Positioning only -- no fling power is applied yet.
    --   Phase 2 (the FLING): your character moves to offset and the actual fling
    --     (power + physics rep) is applied for wait seconds.
    --
    --   offset1  = first CFrame your character goes to, in the target's local space.
    --   wait1    = seconds to hold at offset1 before phase two.
    --   offset   = second/final CFrame (the original fling offset).
    --   wait     = seconds to apply the fling at offset.
    --   rotation = Vector3 of DEGREES (X, Y, Z) applied to YOUR character, relative
    --              to the target's facing. Used in BOTH phases.
    local nanFlingConfig = {
        Regular = {
            power    = Vector3.new(0, 0, 0),
            offset1  = CFrame.new(0, 4, 0),          -- phase 1: go here first
            wait1    = 1,                            -- phase 1: hold for 1 second
            offset   = CFrame.new(0, 0, 0),          -- phase 2: original behavior
            wait     = 0.02,                          -- phase 2: fling for 0.5s
            rotation = Vector3.new(-90, 0, 0),       -- degrees: X, Y, Z
        },
        Void = {
            power    = Vector3.new(0, -30000, 0),
            offset1  = CFrame.new(0, 0, 0),          -- phase 1: go here first
            wait1    = 0,                            -- phase 1: hold for 1 second
            offset   = CFrame.new(0, 1, 0),          -- phase 2
            wait     = 0.5,                          -- phase 2: fling for 0.5s
            rotation = Vector3.new(-90, 0, 0),       -- degrees: X, Y, Z
        },
        Suspend = {
            power    = Vector3.new(9e9, 9e9, 9e9),
            offset1  = CFrame.new(0, 0, 0),          -- phase 1: go here first
            wait1    = 0,                            -- phase 1: hold for 1 second
            offset   = CFrame.new(0, 0, 0),          -- phase 2
            wait     = 0.5,                          -- phase 2: fling for 0.5s
            rotation = Vector3.new(0, 0, 0),         -- degrees: X, Y, Z
        },
    }

    -- Live values both doFling functions read. Initialized to the dropdown's
    -- default ("Regular") so the button works before the dropdown is touched.
    local nanFlingPower    = nanFlingConfig.Regular.power
    local nanFlingOffset1  = nanFlingConfig.Regular.offset1
    local nanFlingWait1    = nanFlingConfig.Regular.wait1
    local nanFlingOffset   = nanFlingConfig.Regular.offset
    local nanFlingWait     = nanFlingConfig.Regular.wait
    local nanFlingRotation = nanFlingConfig.Regular.rotation

    pcall(function()
        local PM = require(weldLocal:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
        nanControls = PM:GetControls()
    end)

    TabTrolling:AddDropdown({
        Label    = "Fling Power",
        Options  = {"Regular", "Void", "Suspend"},
        Default  = "Regular",
        Callback = function(value)
            local cfg = nanFlingConfig[value]
            if not cfg then return end
            nanFlingPower    = cfg.power
            nanFlingOffset1  = cfg.offset1
            nanFlingWait1    = cfg.wait1
            nanFlingOffset   = cfg.offset
            nanFlingWait     = cfg.wait
            nanFlingRotation = cfg.rotation
        end,
    })

    local function nanStartVoidSafety()
        if voidSafetyConn then return end
        voidSafetyConn = RunService.Heartbeat:Connect(function()
            local mc = weldLocal.Character
            local mr = mc and mc:FindFirstChild("HumanoidRootPart")
            if not mr then return end
            local pos = mr.Position

            -- Let invisibility's deep teleport pass through untouched.
            if invisSystem.isOn() and pos.Y < -150000 then
                return
            end

            if pos.Y > VOID_THRESHOLD then
                lastSafePosition = mr.CFrame
            else
                if lastSafePosition then
                    mr.CFrame = lastSafePosition
                    mr.AssemblyLinearVelocity  = Vector3.zero
                    mr.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    end

    local function nanResetPhysicsRep()
        local mc = weldLocal.Character
        local mr = mc and mc:FindFirstChild("HumanoidRootPart")
        if mr then
            pcall(function()
                sethiddenproperty(mr, "PhysicsRepRootPart", mr)
            end)
        end
    end

    local function nanStopVoidSafety()
        if voidSafetyConn then
            voidSafetyConn:Disconnect()
            voidSafetyConn = nil
        end
    end

    local function nanGetCharAnims(char)
        local animate = char:FindFirstChild("Animate")
        if not animate then return {} end
        local function ga(name)
            local f = animate:FindFirstChild(name)
            if f then
                local a = f:FindFirstChildWhichIsA("Animation")
                if a then return a.AnimationId end
            end
        end
        return {Idle=ga("idle"), Walk=ga("walk"), Run=ga("run"), Jump=ga("jump"), Fall=ga("fall")}
    end

    local function nanStopFakeAnims()
        for _, t in pairs(nanFakeAnimTracks) do
            if t and t.IsPlaying then t:Stop(0.1) end
        end
    end

    local function nanCleanupFakeChar()
        if nanRenderConn        then nanRenderConn:Disconnect();        nanRenderConn        = nil end
        if nanTransparencyConn  then nanTransparencyConn:Disconnect();  nanTransparencyConn  = nil end
        if nanCamConn           then nanCamConn:Disconnect();           nanCamConn           = nil end
        nanFakeAnimTracks = {}
        if nanFakeChar then nanFakeChar:Destroy(); nanFakeChar = nil end
        nanRealChar = nil
    end

    -- INTEGRATED: respects invisSystem state when restoring tracks
    local function nanRestoreTracks(char)
        if not char then return end
        if invisSystem.isOn() then
            -- Invisibility is active — don't restore normal tracks, just reapply invis emotes
            invisSystem.reapply()
            nanSavedTracks = {}
            return
        end
        local as = char:FindFirstChild("Animate")
        if as then as.Disabled = false end
        for _, saved in pairs(nanSavedTracks) do
            if saved.track and not saved.track.IsPlaying then
                saved.track:Play()
                saved.track:AdjustSpeed(saved.speed)
                saved.track.TimePosition = saved.timePosition
            end
        end
        nanSavedTracks = {}
    end

    local function nanTeleportToFake(onDone)
        local cf = nil
        if nanFakeChar then
            local fr = nanFakeChar:FindFirstChild("HumanoidRootPart")
            if fr then cf = fr.CFrame end
        end
        if not cf then cf = nanLastFakeCFrame end
        if not cf then if onDone then onDone() end; return end

        local mc = weldLocal.Character
        if mc then
            local hum = mc:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                hum.Sit = false
                hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            for _, part in ipairs(mc:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        local frameCount = 0
        local teleConn
        teleConn = RunService.Heartbeat:Connect(function()
            frameCount += 1
            local mc2 = weldLocal.Character
            local mr = mc2 and mc2:FindFirstChild("HumanoidRootPart")
            local hum = mc2 and mc2:FindFirstChildOfClass("Humanoid")
            if hum and hum.PlatformStand then
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            if mr then
                mr.CFrame = cf
                mr.AssemblyLinearVelocity  = Vector3.zero
                mr.AssemblyAngularVelocity = Vector3.zero
            end
            if frameCount >= 10 then
                teleConn:Disconnect()
                if onDone then onDone() end
            end
        end)
    end

    local function nanDestroyFakeChar()
        if nanCamConn then nanCamConn:Disconnect(); nanCamConn = nil end
        local camera = workspace.CurrentCamera

        -- patch C: only restore the saved subject if it's still alive (has a Parent).
        -- A dead/destroyed humanoid has Parent = nil, and setting CameraSubject to it
        -- detaches the camera — that's what causes "camera into the void" after a fling
        -- that killed and respawned the character.
        if nanSavedCamSubject and nanSavedCamSubject.Parent then
            camera.CameraSubject = nanSavedCamSubject
        else
            local rc = weldLocal.Character
            local rh = rc and rc:FindFirstChildOfClass("Humanoid")
            if rh then camera.CameraSubject = rh end
        end
        nanSavedCamSubject = nil

        if nanFakeChar and nanRealChar then
            local fr = nanFakeChar:FindFirstChild("HumanoidRootPart")
            local rr = nanRealChar:FindFirstChild("HumanoidRootPart")
            if fr and rr then rr.CFrame = fr.CFrame end
        end
        nanRestoreTracks(nanRealChar)
        nanCleanupFakeChar()
    end

    local function nanSpawnFakeChar()
        local char = weldLocal.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        nanRealChar = char; char.Archivable = true
        nanFakeChar = char:Clone()
        nanFakeChar.Name = "NanClone"
        nanFakeChar.Parent = workspace
        local fakeHum  = nanFakeChar:FindFirstChild("Humanoid")
        local fakeRoot = nanFakeChar:FindFirstChild("HumanoidRootPart")
        if not fakeHum or not fakeRoot then return end
        for _, v in pairs(nanFakeChar:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("Script") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                v.Anchored   = false
                v.CanCollide = (v.Name == "HumanoidRootPart")
                if v.Name == "HumanoidRootPart" then v.Transparency = 1 end
            end
        end
        local ca = nanFakeChar:FindFirstChild("Animate")
        if ca then ca.Disabled = true end
        local rr = char:FindFirstChild("HumanoidRootPart")
        if rr then fakeRoot.CFrame = rr.CFrame end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            nanSavedTracks = {}
            for _, t in pairs(hum:GetPlayingAnimationTracks()) do
                table.insert(nanSavedTracks, {track=t, speed=t.Speed, timePosition=t.TimePosition})
                t:Stop()
            end
            local as = char:FindFirstChild("Animate")
            if as then as.Disabled = true end
        end
        -- INTEGRATED: if invisibility is on, don't save normal tracks for later restoration
        if invisSystem.isOn() then
            nanSavedTracks = {}
        end
        local charAnims = nanGetCharAnims(char)
        local function LA(id)
            if not id then return nil end
            local a = Instance.new("Animation"); a.AnimationId = id
            return fakeHum:LoadAnimation(a)
        end
        nanFakeAnimTracks.Idle = LA(charAnims.Idle)
        nanFakeAnimTracks.Walk = LA(charAnims.Walk)
        nanFakeAnimTracks.Run  = LA(charAnims.Run)
        nanFakeAnimTracks.Jump = LA(charAnims.Jump)
        nanFakeAnimTracks.Fall = LA(charAnims.Fall)
        if nanFakeAnimTracks.Idle then nanFakeAnimTracks.Idle:Play() end
        local camera = workspace.CurrentCamera
        nanSavedCamSubject   = camera.CameraSubject
        camera.CameraSubject = fakeHum
        local camOverrideAllowed = true
        nanCamConn = camera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
            if not nanFakeChar or not camOverrideAllowed then return end
            local fh = nanFakeChar:FindFirstChild("Humanoid")
            if not fh then return end
            local newSubject = camera.CameraSubject
            if newSubject == fh then return end
            camOverrideAllowed = false
            task.delay(0.1, function()
                camOverrideAllowed = true
                if not nanFakeChar then return end
                local fh2 = nanFakeChar:FindFirstChild("Humanoid")
                if fh2 then camera.CameraSubject = fh2 end
            end)
        end)
        fakeHum.StateChanged:Connect(function(_, ns)
            if ns == Enum.HumanoidStateType.Jumping then
                nanStopFakeAnims(); if nanFakeAnimTracks.Jump then nanFakeAnimTracks.Jump:Play() end
            elseif ns == Enum.HumanoidStateType.Freefall then
                nanStopFakeAnims(); if nanFakeAnimTracks.Fall then nanFakeAnimTracks.Fall:Play() end
            elseif ns == Enum.HumanoidStateType.Landed then
                nanStopFakeAnims(); if nanFakeAnimTracks.Idle then nanFakeAnimTracks.Idle:Play() end
            end
        end)
        nanTransparencyConn = RunService.RenderStepped:Connect(function()
            if not nanFakeChar then return end
            local cam = workspace.CurrentCamera
            local fh  = nanFakeChar:FindFirstChild("Head")
            local inFP = fh and cam and (cam.CFrame.Position - fh.Position).Magnitude < 2.5
            for _, part in pairs(nanFakeChar:GetDescendants()) do
                if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Name ~= "HumanoidRootPart" then
                    part.LocalTransparencyModifier = inFP and 1 or 0
                end
            end
        end)
        nanRenderConn = RunService.RenderStepped:Connect(function()
            if not nanFakeChar or not fakeHum or not fakeRoot then return end
            local UIS = game:GetService("UserInputService")
            local iv  = Vector3.zero
            if nanControls then
                iv = nanControls:GetMoveVector()
            else
                if UIS:IsKeyDown(Enum.KeyCode.W) then iv += Vector3.new(0,0,-1) end
                if UIS:IsKeyDown(Enum.KeyCode.S) then iv += Vector3.new(0,0,1) end
                if UIS:IsKeyDown(Enum.KeyCode.A) then iv += Vector3.new(-1,0,0) end
                if UIS:IsKeyDown(Enum.KeyCode.D) then iv += Vector3.new(1,0,0) end
            end
            local cs = fakeHum:GetState()
            if UIS:IsKeyDown(Enum.KeyCode.Space) and cs ~= Enum.HumanoidStateType.Jumping and cs ~= Enum.HumanoidStateType.Freefall then
                fakeHum.Jump = true
            end
            local camCF = workspace.CurrentCamera.CFrame
            local fd = (camCF.RightVector * iv.X) + (camCF.LookVector * -iv.Z)
            fd = Vector3.new(fd.X, 0, fd.Z)
            local grounded = cs == Enum.HumanoidStateType.Running or cs == Enum.HumanoidStateType.RunningNoPhysics
            if fd.Magnitude > 0.01 then
                fakeHum:Move(fd.Unit, false)
                if grounded and nanFakeAnimTracks.Run and not nanFakeAnimTracks.Run.IsPlaying then
                    nanStopFakeAnims(); nanFakeAnimTracks.Run:Play(0.1)
                end
            else
                fakeHum:Move(Vector3.zero, false)
                if grounded and nanFakeAnimTracks.Idle and not nanFakeAnimTracks.Idle.IsPlaying then
                    nanStopFakeAnims(); nanFakeAnimTracks.Idle:Play(0.1)
                end
            end
            if fakeRoot then nanLastFakeCFrame = fakeRoot.CFrame end
        end)
        -- INTEGRATED: if invisibility is active, reapply its emotes right now so they
        -- play for the entire duration of the fling, not just after it finishes.
        if invisSystem.isOn() then
            invisSystem.reapply()
        end
    end

    local function nanSetupNoCollide()
        if not nanFakeChar then return end
        local myChar = weldLocal.Character
        if not myChar then return end
        for _, fakePart in ipairs(nanFakeChar:GetDescendants()) do
            if fakePart:IsA("BasePart") then
                for _, realPart in ipairs(myChar:GetDescendants()) do
                    if realPart:IsA("BasePart") then
                        local noCollide = Instance.new("NoCollisionConstraint")
                        noCollide.Part0 = fakePart
                        noCollide.Part1 = realPart
                        noCollide.Parent = fakePart
                    end
                end
            end
        end
    end

    local function nanDisableCollideWithWorld()
        local myChar = weldLocal.Character
        if not myChar then return end
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    local function nanRestoreCollide()
        local myChar = weldLocal.Character
        if not myChar then return end
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = (part.Name == "HumanoidRootPart")
            end
        end
    end

    TabTrolling:AddButton({
        Label    = "Fling",
        Callback = function()
            if nanTarget == "" then return end
            local targets = {}
            if nanTarget == "-" then
                for _, plr in ipairs(weldPlayers:GetPlayers()) do
                    if plr ~= weldLocal then table.insert(targets, plr) end
                end
            else
                for _, plr in ipairs(weldPlayers:GetPlayers()) do
                    if plr ~= weldLocal
                    and (plr.Name:lower():find(nanTarget:lower())
                         or (plr.DisplayName and plr.DisplayName:lower():find(nanTarget:lower()))) then
                        table.insert(targets, plr); break
                    end
                end
            end

            if nanFakeChar then
                local fr = nanFakeChar:FindFirstChild("HumanoidRootPart")
                if fr then nanLastFakeCFrame = fr.CFrame end
            end
            if not nanFakeChar then
                nanSpawnFakeChar()
                nanSetupNoCollide()
            end

            -- PHASE 1: move to offset1 and hold there (positioning only, no power).
            local function doHold(target)
                local holdConn
                holdConn = weldRun.Heartbeat:Connect(function()
                    local myChar = weldLocal.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local tgtChar = target.Character
                    local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                    if not myChar or not myRoot or not tgtChar or not tgtRoot then return end
                    pcall(function()
                        nanDisableCollideWithWorld()
                        local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                        myRoot.CFrame = CFrame.new(tgtRoot.Position)
                            * CFrame.Angles(0, tgtYaw, 0)
                            * nanFlingOffset1
                            * nanRotCFrame(nanFlingRotation)
                        myRoot.AssemblyLinearVelocity  = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                    end)
                end)
                task.wait(nanFlingWait1)
                holdConn:Disconnect()
            end

            -- PHASE 2: move to offset and apply the actual fling power.
            local function doFling(target)
                local flingConn
                activeFlingCount = activeFlingCount + 1
                flingConn = weldRun.Heartbeat:Connect(function()
                    local myChar = weldLocal.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local tgtChar = target.Character
                    local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                    if not myChar or not myRoot or not tgtChar or not tgtRoot then return end
                    pcall(function()
                        nanDisableCollideWithWorld()
                        local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                        myRoot.CFrame = CFrame.new(tgtRoot.Position)
                            * CFrame.Angles(0, tgtYaw, 0)
                            * nanFlingOffset
                            * nanRotCFrame(nanFlingRotation)
                        myRoot.Velocity    = nanFlingPower
                        myRoot.RotVelocity = nanFlingPower
                        sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                    end)
                end)
                task.wait(nanFlingWait)
                flingConn:Disconnect()
                activeFlingCount = math.max(0, activeFlingCount - 1)
            end

            local function returnToFake()
                nanRestoreCollide()
                nanResetPhysicsRep()
                local mc = weldLocal.Character
                if mc then
                    local hum = mc:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.PlatformStand = false
                        hum.Sit = false
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end
                    for _, part in ipairs(mc:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.AssemblyLinearVelocity  = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
                local done = false
                nanTeleportToFake(function() done = true end)
                local waited = 0
                while not done and waited < 2 do
                    task.wait(0.05); waited += 0.05
                end
                nanDestroyFakeChar()
                nanLastFakeCFrame = nil
            end

            nanStartVoidSafety()
            for _, target in ipairs(targets) do
                doHold(target)
                doFling(target)
                task.wait(0.3)
            end

            returnToFake()
            nanStopVoidSafety()
        end,
    })

    do
        local caEnabled  = false
        local caLoopTask = nil

        local function caCleanupAndReturn()
            nanRestoreCollide()
            nanResetPhysicsRep()
            local mc = weldLocal.Character
            if mc then
                local hum = mc:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    hum.Sit = false
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
                for _, part in ipairs(mc:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.AssemblyLinearVelocity  = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
            if nanFakeChar then
                local fr = nanFakeChar:FindFirstChild("HumanoidRootPart")
                if fr then nanLastFakeCFrame = fr.CFrame end
            end
            local done = false
            nanTeleportToFake(function() done = true end)
            local waited = 0
            while not done and waited < 2 do
                task.wait(0.05); waited += 0.05
            end
            nanDestroyFakeChar()
            nanLastFakeCFrame = nil
        end

        local function caGetTargets()
            local targets = {}
            if nanTarget == "" then return targets end
            if nanTarget == "-" then
                for _, plr in ipairs(weldPlayers:GetPlayers()) do
                    if plr ~= weldLocal then table.insert(targets, plr) end
                end
            else
                for _, plr in ipairs(weldPlayers:GetPlayers()) do
                    if plr ~= weldLocal
                    and (plr.Name:lower():find(nanTarget:lower())
                         or (plr.DisplayName and plr.DisplayName:lower():find(nanTarget:lower()))) then
                        table.insert(targets, plr); break
                    end
                end
            end
            return targets
        end

        local function caIsTouchingPart(char)
            if not char then return false end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return false end
            local state = hum:GetState()
            return state == Enum.HumanoidStateType.Running
                or state == Enum.HumanoidStateType.RunningNoPhysics
                or state == Enum.HumanoidStateType.Climbing
                or state == Enum.HumanoidStateType.Swimming
                or state == Enum.HumanoidStateType.Seated
        end

        local function caGetValidTargets()
            local valid = {}
            for _, plr in ipairs(caGetTargets()) do
                local tc = plr.Character
                local tr = tc and tc:FindFirstChild("HumanoidRootPart")
                if not tr then continue end
                if caIsTouchingPart(tc) then
                    table.insert(valid, plr)
                end
            end
            return valid
        end

        -- PHASE 1: move to offset1 and hold there (positioning only, no power).
        local function doHold(target)
            if not caEnabled then return end
            local holdConn
            holdConn = weldRun.Heartbeat:Connect(function()
                if not caEnabled then
                    holdConn:Disconnect()
                    return
                end
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local tgtChar = target.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot or not tgtChar or not tgtRoot then return end
                pcall(function()
                    nanDisableCollideWithWorld()
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    myRoot.CFrame = CFrame.new(tgtRoot.Position)
                        * CFrame.Angles(0, tgtYaw, 0)
                        * nanFlingOffset1
                        * nanRotCFrame(nanFlingRotation)
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end)
            task.wait(nanFlingWait1)
            holdConn:Disconnect()
        end

        -- PHASE 2: move to offset and apply the actual fling power.
        local function doFling(target)
            if not caEnabled then return end
            local flingConn
            activeFlingCount = activeFlingCount + 1
            flingConn = weldRun.Heartbeat:Connect(function()
                if not caEnabled then
                    flingConn:Disconnect()
                    activeFlingCount = math.max(0, activeFlingCount - 1)
                    return
                end
                local myChar = weldLocal.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local tgtChar = target.Character
                local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
                if not myChar or not myRoot or not tgtChar or not tgtRoot then return end
                pcall(function()
                    nanDisableCollideWithWorld()
                    local _, tgtYaw, _ = tgtRoot.CFrame:ToEulerAnglesYXZ()
                    myRoot.CFrame = CFrame.new(tgtRoot.Position)
                        * CFrame.Angles(0, tgtYaw, 0)
                        * nanFlingOffset
                        * nanRotCFrame(nanFlingRotation)
                    myRoot.Velocity    = nanFlingPower
                    myRoot.RotVelocity = nanFlingPower
                    sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                end)
            end)
            task.wait(nanFlingWait)
            flingConn:Disconnect()
            activeFlingCount = math.max(0, activeFlingCount - 1)
        end

        TabTrolling:AddToggle({
            Label    = "Loop Fling",
            Default  = false,
            Callback = function(state)
                caEnabled = state
                if not caEnabled then
                    nanStopVoidSafety()
                    if caLoopTask then task.cancel(caLoopTask); caLoopTask = nil end
                    caCleanupAndReturn()
                    return
                end

                nanStopVoidSafety()
                caLoopTask = task.spawn(function()
                    while caEnabled do
                        if nanTarget == "" then task.wait(0.1); continue end

                        local valid = caGetValidTargets()
                        if #valid == 0 then task.wait(0.1); continue end

                        local target = valid[math.random(1, #valid)]

                        if nanFakeChar then
                            local fr = nanFakeChar:FindFirstChild("HumanoidRootPart")
                            if fr then nanLastFakeCFrame = fr.CFrame end
                        end
                        if not nanFakeChar then
                            nanSpawnFakeChar()
                            nanSetupNoCollide()
                        end

                        doHold(target)

                        if not caEnabled then break end

                        doFling(target)

                        if not caEnabled then break end

                        nanRestoreCollide()
                        nanResetPhysicsRep()
                        local mc = weldLocal.Character
                        if mc then
                            local hum = mc:FindFirstChildOfClass("Humanoid")
                            if hum then
                                hum.PlatformStand = false
                                hum.Sit = false
                                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                            end
                            for _, part in ipairs(mc:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.AssemblyLinearVelocity  = Vector3.zero
                                    part.AssemblyAngularVelocity = Vector3.zero
                                end
                            end
                        end

                        local done = false
                        nanTeleportToFake(function() done = true end)
                        local waited = 0
                        while not done and waited < 2 do
                            task.wait(0.05); waited += 0.05
                        end
                        nanDestroyFakeChar()
                        nanLastFakeCFrame = nil
                    end
                end)
            end,
        })
    end
end
