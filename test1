-----------------------------
-- CONFIG
-----------------------------
local ANIMATION_ID = 70883871260184
local FREEZE_AFTER_SECONDS = 0.04
local NUDGE_INTERVAL = 2  -- How often to ping other clients (seconds)

-- MOVEMENT SPEEDS
local BASE_WALK_SPEED = 16
local SPRINT_SPEED = 30

-----------------------------
-- SERVICES
-----------------------------
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

-----------------------------
-- CHARACTER
-----------------------------
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local animator = humanoid:WaitForChild("Animator")

-----------------------------
-- PLAY & FREEZE
-----------------------------
local function playAndFreeze()
	if ANIMATION_ID == 0 then return end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. ANIMATION_ID

	local track = animator:LoadAnimation(anim)
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Action
	track:Play()

	task.delay(FREEZE_AFTER_SECONDS, function()
		if not (track and track.IsPlaying) then return end

		track:AdjustSpeed(0) -- Freeze at the pose

		-- Nudge loop: toggles speed by a value so small it's invisible,
		-- but enough to force replication to other clients without any snap
		task.spawn(function()
			while track and track.IsPlaying do
				task.wait(NUDGE_INTERVAL)
				track:AdjustSpeed(0.00001) -- sub-pixel movement, invisible
				task.wait(0.1)
				track:AdjustSpeed(0)       -- freeze again
			end
		end)
	end)
end

-----------------------------
-- SPRINT INPUT
-----------------------------
humanoid.WalkSpeed = BASE_WALK_SPEED

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.LeftShift then
		humanoid.WalkSpeed = SPRINT_SPEED
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		humanoid.WalkSpeed = BASE_WALK_SPEED
	end
end)

-----------------------------
-- START
-----------------------------
playAndFreeze()
