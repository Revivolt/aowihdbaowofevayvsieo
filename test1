local function cleanupToggle(conn, trk, noCollide)
    if conn then conn:Disconnect() end
    if trk  then trk:Stop(); trk:Destroy() end
    local mc = weldLocal.Character
    if mc then
        for _, part in ipairs(mc:GetDescendants()) do
