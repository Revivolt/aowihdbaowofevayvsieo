do
    local caConn     = nil
    local caEnabled  = false
    local HOVER_UP   = -80
    local CLOSE_DIST = 25
    local BELOW_OFF  = -1
    local NEARBY_DUR = 0.5
    local latchRoot  = nil
    local latchTime  = 0

    local function stopAura()
        activeFlingCount = math.max(0, activeFlingCount - 1)
        if caConn then caConn:Disconnect(); caConn = nil end
    end

    local function findNearby(tgtRoot)
        local closest, closestDist = nil, CLOSE_DIST
        for _, plr in ipairs(weldPlayers:GetPlayers()) do
            if plr == weldLocal or plr == selectedTarget then continue end
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            local dist = (root.Position - tgtRoot.Position).Magnitude
            if dist < closestDist then closestDist = dist; closest = root end
        end
        return closest
    end

    local function startAura()
        if caConn then caConn:Disconnect(); caConn = nil end
        latchRoot = nil; latchTime = 0
        activeFlingCount = activeFlingCount + 1
        caConn = weldRun.Heartbeat:Connect(function()
            if not caEnabled then return end
            if not selectedTarget then return end
            local myChar = weldLocal.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myChar or not myRoot then return end
            local tgtChar = selectedTarget.Character
            local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
            if not tgtChar or not tgtRoot then return end
            pcall(function()
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                local now = tick()
                if latchRoot then
                    if (now - latchTime) >= NEARBY_DUR then latchRoot = nil; latchTime = 0 end
                end
                if not latchRoot then
                    local found = findNearby(tgtRoot)
                    if found then latchRoot = found; latchTime = now end
                end
                local anchorRoot = latchRoot or tgtRoot
                local offsetY    = latchRoot and BELOW_OFF or HOVER_UP
                myRoot.CFrame    = CFrame.new(anchorRoot.Position + Vector3.new(0, offsetY, 0))
                myRoot.Velocity    = Vector3.new(500, 500, 500)
                myRoot.RotVelocity = Vector3.new(500, 500, 500)
                sethiddenproperty(myRoot, "PhysicsRepRootPart", anchorRoot)
            end)
        end)
    end

    TabAbuse:AddToggle({
        Label   = "Fling Aura",
        Default = false,
        Callback = function(state)
            caEnabled = state
            if not caEnabled then
                stopAura(); latchRoot = nil; latchTime = 0
                return
            end
            if not selectedTarget then return end
            startAura()
        end,
    })
end

