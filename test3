    end
end

-- ──────────────────────────────────────────────────────────────
-- 12. MESSAGE EXPIRY SWEEP
--     Every EXPIRE_CHECK seconds:
--       • age >= (MSG_LIFETIME - WARN_BEFORE): dim text to Muted
--       • age >= MSG_LIFETIME:                 fade out + destroy row
-- ──────────────────────────────────────────────────────────────
local WARN_AT = MSG_LIFETIME - WARN_BEFORE

task.spawn(function()
    while true do
        task.wait(EXPIRE_CHECK)
        local now = os.time()

        for frame, epoch in pairs(rowRegistry) do
            if not frame or not frame.Parent then
                rowRegistry[frame] = nil
                continue
            end

            local age = now - epoch

            if age >= MSG_LIFETIME then
                rowRegistry[frame] = nil
                for _, child in ipairs(frame:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        tw(child, {TextTransparency = 1}, FADE)
                    end
                end
                local t = TweenService:Create(frame, FADE, {BackgroundTransparency = 1})
                t:Play()
                t.Completed:Once(function()
                    if frame and frame.Parent then frame:Destroy() end
                end)

            elseif age >= WARN_AT then
                for _, child in ipairs(frame:GetDescendants()) do
                    if child:IsA("TextLabel") and child.TextColor3 ~= C.Muted then
                        tw(child, {TextColor3 = C.Muted}, FADE)
                    end
                end
            end
        end
    end
end)

-- ──────────────────────────────────────────────────────────────
-- 13. OPEN / CLOSE WINDOW
--     The window is positioned relative to the toggle button's
--     current position so it always appears attached to it.
-- ──────────────────────────────────────────────────────────────
local function getWinPos()
    -- Place the window 6px below the toggle button
    local tp = Toggle.Position
    return UDim2.new(tp.X.Scale, tp.X.Offset, tp.Y.Scale, tp.Y.Offset + 50)
end

local function openChat()
    isOpen        = true
    unread        = 0
    Badge.Visible = false
    Win.Position  = getWinPos()
    Win.Size      = UDim2.new(0, WIN_W, 0, 0)
    Win.Visible   = true
    tw(Win, {Size = UDim2.new(0, WIN_W, 0, WIN_H)}, SMOOTH)
    task.wait(0.1)
    Input:CaptureFocus()
end

local function closeChat()
    isOpen = false
    Input:ReleaseFocus()
    tw(Win, {Size = UDim2.new(0, WIN_W, 0, 0)}, SMOOTH)
    task.delay(0.25, function()
        if not isOpen then Win.Visible = false end
    end)
end

-- Toggle click — only fires when it wasn't a drag (toggleMoved guard)
Toggle.MouseButton1Click:Connect(function()
    if toggleMoved then return end
    if isOpen then closeChat() else openChat() end
end)

CloseBtn.MouseButton1Click:Connect(closeChat)

-- ──────────────────────────────────────────────────────────────
-- 14. SEND MESSAGE
-- ──────────────────────────────────────────────────────────────
local sending = false

local function doSend()
    if sending then return end
    local raw = Input.Text:match("^%s*(.-)%s*$")
    if raw == "" then return end
    local text = raw:sub(1, MAX_MSG_LEN)
    Input.Text = ""
    sending    = true
    task.spawn(function()
        local ok, err = postMessage(LocalPlayer.Name, text)
        sending = false
        if not ok then
            addMsg("System", "Send failed: " .. tostring(err), true)
        end
    end)
end

SendBtn.MouseButton1Click:Connect(doSend)
Input.FocusLost:Connect(function(enter) if enter then doSend() end end)

