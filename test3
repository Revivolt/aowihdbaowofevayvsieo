-- Draggable toggle logic
local toggleDragging, toggleDragStart, toggleStartPos, toggleMoved =
      false, nil, nil, false

Toggle.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = true; toggleMoved = false
        toggleDragStart = i.Position; toggleStartPos = Toggle.Position
    end
end)
Toggle.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = false
        task.defer(function() toggleMoved = false end)
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if not toggleDragging then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement
    and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = i.Position - toggleDragStart
    if not toggleMoved and
       (math.abs(d.X) > DRAG_THRESHOLD or math.abs(d.Y) > DRAG_THRESHOLD) then
        toggleMoved = true
    end
    if toggleMoved then
        local vp = game.Workspace.CurrentCamera.ViewportSize
        Toggle.Position = UDim2.new(0,
            math.clamp(toggleStartPos.X.Offset + d.X, 0, vp.X - Toggle.AbsoluteSize.X),
            0,
            math.clamp(toggleStartPos.Y.Offset + d.Y, 0, vp.Y - Toggle.AbsoluteSize.Y))
    end
end)

