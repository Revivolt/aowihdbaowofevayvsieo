-- ──────────────────────────────────────────────────────────────
-- 19. SEND MESSAGE
-- ──────────────────────────────────────────────────────────────
local sending = false

local function doSend()
    if sending then return end
    local raw = Input.Text:match("^%s*(.-)%s*$")
    if raw == "" then return end
    local text = raw:sub(1, MAX_MSG_LEN)
    Input.Text = ""
    sending    = true
    task.spawn(function()
        local ok, err = postMessage(LocalPlayer.Name, text, activeChannel)
        sending = false
        if not ok then
            addMsg("System", "Send failed: " .. tostring(err), true, nil, nil, activeChannel)
        end
        -- Poll will pick up our own message and dedup it by id
    end)
end

SendBtn.MouseButton1Click:Connect(doSend)
Input.FocusLost:Connect(function(enter) if enter then doSend() end end)

-- ──────────────────────────────────────────────────────────────
-- 20. DRAGGABLE CHAT WINDOW  (grab header to move)
-- ──────────────────────────────────────────────────────────────
do
    local dragging, dragStart, startPos = false, nil, nil

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = Win.Position
        end
    end)
    Header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = input.Position - dragStart
        Win.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end)
end

-- ──────────────────────────────────────────────────────────────
-- 21. KEYBOARD SHORTCUT  — / to open
-- ──────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Slash and not isOpen then
        openChat()
        task.defer(function()
            Input.Text           = "/"
            Input.CursorPosition = 2
        end)
    end
end)

