-- ─────────────────────────────────────────────
-- STATE
-- ─────────────────────────────────────────────
local isOpen = false
local unreadCount = 0
local messageCount = 0

-- ─────────────────────────────────────────────
-- OPEN / CLOSE
-- ─────────────────────────────────────────────
local function openChat()
    isOpen = true
    ChatWindow.Visible = true
    ChatWindow.Size = UDim2.new(0, CONFIG.WindowWidth, 0, 0)
    tween(ChatWindow, SMOOTH, { Size = UDim2.new(0, CONFIG.WindowWidth, 0, CONFIG.WindowHeight) })
    unreadCount = 0
    UnreadBadge.Visible = false
    task.wait(0.1)
    ChatInput:CaptureFocus()
end

local function closeChat()
    isOpen = false
    tween(ChatWindow, SMOOTH, { Size = UDim2.new(0, CONFIG.WindowWidth, 0, 0) })
    task.wait(0.25)
    if not isOpen then
        ChatWindow.Visible = false
    end
    ChatInput:ReleaseFocus()
end

ToggleBtn.MouseButton1Click:Connect(function()
    if isOpen then
        closeChat()
    else
        openChat()
    end
end)

CloseBtn.MouseButton1Click:Connect(closeChat)

-- ─────────────────────────────────────────────
-- ADD MESSAGE TO SCROLL FRAME
-- ─────────────────────────────────────────────
local function addMessage(sender, message, color)
    messageCount += 1

    -- Trim old messages
    local children = ScrollFrame:GetChildren()
    local msgChildren = {}
    for _, c in ipairs(children) do
        if c:IsA("Frame") then
            table.insert(msgChildren, c)
        end
    end
    if #msgChildren >= CONFIG.MaxMessages then
        msgChildren[1]:Destroy()
    end

    local msgColor = color or CONFIG.TextColor
    local senderColor = (sender == "System") and CONFIG.SystemColor or CONFIG.SenderColor

    local Row = Instance.new("Frame")
    Row.Name = "Msg_" .. messageCount
    Row.Size = UDim2.new(1, -4, 0, 0)
    Row.AutomaticSize = Enum.AutomaticSize.Y
    Row.BackgroundTransparency = 1
    Row.LayoutOrder = messageCount
    Row.ZIndex = 17
    Row.Parent = ScrollFrame

    local RowPad = Instance.new("UIPadding")
    RowPad.PaddingLeft = UDim.new(0, 4)
    RowPad.PaddingRight = UDim.new(0, 4)
    RowPad.Parent = Row

    local RowLayout = Instance.new("UIListLayout")
    RowLayout.FillDirection = Enum.FillDirection.Horizontal
    RowLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    RowLayout.Padding = UDim.new(0, 4)
    RowLayout.Parent = Row

    -- Sender tag
    local SenderLabel = Instance.new("TextLabel")
    SenderLabel.AutomaticSize = Enum.AutomaticSize.X
    SenderLabel.Size = UDim2.new(0, 0, 0, 18)
    SenderLabel.BackgroundTransparency = 1
    SenderLabel.Text = sender .. ":"
    SenderLabel.TextSize = 12
    SenderLabel.Font = Enum.Font.GothamBold
    SenderLabel.TextColor3 = senderColor
    SenderLabel.TextXAlignment = Enum.TextXAlignment.Left
    SenderLabel.TextYAlignment = Enum.TextYAlignment.Top
    SenderLabel.ZIndex = 18
    SenderLabel.Parent = Row

    -- Message body
    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.AutomaticSize = Enum.AutomaticSize.Y
    MsgLabel.Size = UDim2.new(1, -80, 0, 0) -- flex remaining width
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.Text = message
    MsgLabel.TextSize = 13
    MsgLabel.Font = CONFIG.ChatFont
    MsgLabel.TextColor3 = msgColor
    MsgLabel.TextWrapped = true
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.TextYAlignment = Enum.TextYAlignment.Top
    MsgLabel.ZIndex = 18
    MsgLabel.Parent = Row

    -- Auto-scroll to bottom
    task.defer(function()
        ScrollFrame.CanvasPosition = Vector2.new(0, math.huge)
    end)

    -- Unread badge
    if not isOpen then
        unreadCount += 1
        UnreadBadge.Visible = true
        UnreadLabel.Text = tostring(math.min(unreadCount, 99))
    end
end

-- ─────────────────────────────────────────────
-- SEND MESSAGE
-- ─────────────────────────────────────────────
local function sendMessage()
    local text = ChatInput.Text
    if text == "" or text:match("^%s*$") then return end
    ChatInput.Text = ""

    -- Use TextChatService to actually send (modern Roblox)
    local success, err = pcall(function()
        local channel = TextChatService:FindFirstChild("TextChannels")
        if channel then
            local general = channel:FindFirstChild("RBXGeneral")
            if general then
                general:SendAsync(text)
                return
            end
        end
        -- Fallback: legacy chat
        local Chat = game:GetService("Chat")
        Chat:Chat(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head"), text)
    end)

    if not success then
        -- Display locally if send fails
        addMessage(LocalPlayer.Name, text, CONFIG.TextColor)
    end
end

SendBtn.MouseButton1Click:Connect(sendMessage)

ChatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        sendMessage()
    end
end)

-- ─────────────────────────────────────────────
-- RECEIVE MESSAGES VIA TextChatService
-- ─────────────────────────────────────────────
local function connectTextChatService()
    local channels = TextChatService:WaitForChild("TextChannels", 5)
    if not channels then return end

    for _, channel in ipairs(channels:GetChildren()) do
        if channel:IsA("TextChannel") then
            channel.MessageReceived:Connect(function(msg)
                local sender = "Unknown"
                if msg.TextSource then
                    local plr = Players:GetPlayerByUserId(msg.TextSource.UserId)
                    if plr then
                        sender = plr.Name
                    end
                end
                addMessage(sender, msg.Text)
            end)
        end
    end

    -- Also watch for new channels added at runtime
    channels.ChildAdded:Connect(function(channel)
        if channel:IsA("TextChannel") then
            task.wait() -- yield until channel is ready
            channel.MessageReceived:Connect(function(msg)
                local sender = "Unknown"
                if msg.TextSource then
                    local plr = Players:GetPlayerByUserId(msg.TextSource.UserId)
                    if plr then
                        sender = plr.Name
                    end
                end
                addMessage(sender, msg.Text)
            end)
        end
    end)
end

-- Legacy chat fallback
local function connectLegacyChat()
    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(message)
            addMessage(player.Name, message)
        end)
    end)
    for _, player in ipairs(Players:GetPlayers()) do
        player.Chatted:Connect(function(message)
            addMessage(player.Name, message)
        end)
    end
end

-- Try modern first, fall back to legacy
local ok = pcall(connectTextChatService)
if not ok then
    connectLegacyChat()
end

