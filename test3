-- 13. CLEAR SCROLL + RELOAD FOR CHANNEL SWITCH
-- ──────────────────────────────────────────────────────────────
local function clearMessages()
    for _, child in ipairs(Scroll:GetChildren()) do
        if child:IsA("Frame") then
            rowRegistry[child] = nil
            child:Destroy()
        end
    end
    order = 0
end

