-- 6. SUPABASE REST LAYER
-- ──────────────────────────────────────────────────────────────────
local REST = SUPABASE_URL .. "/rest/v1"
local HDRS = {
    ["apikey"]        = SUPABASE_ANON_KEY,
    ["Authorization"] = "Bearer " .. SUPABASE_ANON_KEY,
    ["Content-Type"]  = "application/json",
    ["Prefer"]        = "return=minimal",
}

local function request(path, method, body, extraHeaders)
    local headers = {}
    for k,v in pairs(HDRS) do headers[k] = v end
    if extraHeaders then
        for k,v in pairs(extraHeaders) do headers[k] = v end
    end
    local ok, res = pcall(function()
        return HttpService:RequestAsync({
            Url     = REST .. path,
            Method  = method or "GET",
            Headers = headers,
            Body    = body and HttpService:JSONEncode(body) or nil,
        })
    end)
    if not ok then return nil, "network: " .. tostring(res) end
    if res.StatusCode >= 400 then
        return nil, "HTTP " .. res.StatusCode .. ": " .. tostring(res.Body)
    end
    if method == "POST" or method == "DELETE" or method == "PATCH" then
        return true, nil
    end
    local jok, parsed = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not jok then return nil, "JSON decode error" end
    return parsed, nil
end

-- ── Messages ──────────────────────────────────────────────────
local function fetchHistory(channel)
    local filter = "&channel=eq." .. channel
    if channel == "server" then
        filter = filter .. "&server_id=eq." .. SERVER_ID
    end
    return request(
        "/messages?select=id,channel,server_id,username,content,created_at"
        .. "&order=created_at.asc&limit=" .. HISTORY_LIMIT .. filter, "GET")
end

local function fetchSince(lastId, channel)
    local filter = "&channel=eq." .. channel
    if channel == "server" then
        filter = filter .. "&server_id=eq." .. SERVER_ID
    end
    return request(
        "/messages?select=id,channel,server_id,username,content,created_at"
        .. "&order=id.asc&id=gt." .. lastId .. filter, "GET")
end

local function postMessage(username, content, channel)
    return request("/messages", "POST", {
        channel   = channel,
        server_id = (channel == "server") and SERVER_ID or "global",
        username  = username,
        content   = content,
    })
end

-- ── Players presence ──────────────────────────────────────────
-- Upsert: insert or update our row, bumping last_seen to now()
local function heartbeat()
    return request("/players", "POST",
        { username = LocalPlayer.Name, server_id = SERVER_ID, place_id = PLACE_ID },
        { ["Prefer"] = "resolution=merge-duplicates" }
    )
end

-- Remove our row when we leave
local function removePresence()
    pcall(function()
        request("/players?username=eq." .. LocalPlayer.Name, "DELETE")
    end)
end

-- Fetch all online players (last_seen within 45 s — pg_cron removes stale ones)
local function fetchPlayers()
    return request("/players?select=username,server_id,place_id&order=username.asc", "GET")
end

-- Fetch players in the same game (same place_id) across ALL servers
local function fetchGamePlayers()
    return request(
        "/players?select=username,server_id,place_id"
        .. "&place_id=eq." .. PLACE_ID
        .. "&order=username.asc",
        "GET"
    )
end

