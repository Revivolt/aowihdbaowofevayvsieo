-- ──────────────────────────────────────────────────────────────────
-- 5. ISO-8601 → Unix epoch (UTC-corrected)
-- ──────────────────────────────────────────────────────────────────
local function isoToEpoch(s)
    if not s then return os.time() end
    local Y,Mo,D,h,m,sec = s:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
    if not Y then return os.time() end
    local localT = os.time({
        year=tonumber(Y), month=tonumber(Mo), day=tonumber(D),
        hour=tonumber(h), min=tonumber(m),    sec=tonumber(sec), isdst=false,
    })
    return localT - os.difftime(os.time(), os.time(os.date("!*t", os.time())))
end

