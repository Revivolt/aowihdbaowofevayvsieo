    StatusTxt.Text       = txt
    StatusTxt.TextColor3 = textCol or C.Muted
    Dot.BackgroundColor3 = dotCol  or C.Muted
end

-- ──────────────────────────────────────────────────────────────
-- 16. MAIN CONNECTION + POLL LOOP
-- ──────────────────────────────────────────────────────────────
task.spawn(function()
    task.wait(1)
    setStatus("connecting...", C.Muted, C.Muted)

    local hist, err = fetchHistory()
    if not hist then
        setStatus("offline", C.Error, C.Error)
        addMsg("System",
            "Could not reach Supabase — check SUPABASE_URL and SUPABASE_ANON_KEY.", true)
        return
    end

    for _, row in ipairs(hist) do
        addMsg(row.username or "?", row.content or "", false, row.id, row.created_at)
    end

    setStatus("live", C.Online, C.Online)

    while true do
        task.wait(POLL_INTERVAL)
        local rows, _ = fetchSince(lastId)
        if rows then
            for _, row in ipairs(rows) do
                addMsg(row.username or "?", row.content or "", false, row.id, row.created_at)
            end
        end
    end
end)

-- ──────────────────────────────────────────────────────────────
-- 17. DRAGGABLE CHAT WINDOW  (grab the header bar)
-- ──────────────────────────────────────────────────────────────
do
    local dragging, dragStart, startPos = false, nil, nil

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = Win.Position
        end
    end)

    Header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = input.Position - dragStart
        Win.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end)
end

-- ──────────────────────────────────────────────────────────────
-- 18. KEYBOARD SHORTCUT  — press / to open
-- ──────────────────────────────────────────────────────────────
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Slash and not isOpen then
        openChat()
        task.defer(function()
            Input.Text           = "/"
            Input.CursorPosition = 2
        end)
    end
end)
