local function corner(p, px) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,px or 10) c.Parent=p end
local function stroke(p, col, th) local s=Instance.new("UIStroke") s.Color=col or C.Border s.Thickness=th or 1 s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border s.Parent=p end

local function nameColor(name)
    local n = 0
    for i = 1, #name do n = n + string.byte(name, i) end
    return C.Names[(n % #C.Names) + 1]
end

-- ───────────────────────────────────────────────────
-- Supabase REST helpers
-- ───────────────────────────────────────────────────
local REST = SUPABASE_URL .. "/rest/v1"
local HDRS = {
    ["apikey"]        = SUPABASE_ANON_KEY,
    ["Authorization"] = "Bearer " .. SUPABASE_ANON_KEY,
    ["Content-Type"]  = "application/json",
    ["Prefer"]        = "return=minimal",
}

local function request(path, method, body)
    local ok, res = pcall(function()
        return HttpService:RequestAsync({
            Url    = REST .. path,
            Method = method or "GET",
            Headers = HDRS,
            Body   = body and HttpService:JSONEncode(body) or nil,
        })
    end)
    if not ok then return nil, "network: " .. tostring(res) end
    if res.StatusCode >= 400 then return nil, "HTTP "..res.StatusCode..": "..res.Body end
    if method == "POST" then return true, nil end
    local jok, parsed = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not jok then return nil, "json error" end
    return parsed, nil
end

local function fetchHistory()
    return request(
        "/messages?select=id,username,content,created_at"
        .."&order=created_at.asc&limit="..HISTORY_LIMIT,
        "GET"
    )
end

local function fetchSince(lastId)
    return request(
        "/messages?select=id,username,content"
        .."&order=id.asc&id=gt."..lastId,
        "GET"
    )
end

local function postMessage(username, content)
    return request("/messages", "POST", {username=username, content=content})
end

