-- Supabase table setup (run in Supabase SQL editor):
--
--   create table messages (
--     id         bigint generated always as identity primary key,
--     username   text not null,
--     content    text not null,
--     created_at timestamptz default now()
--   );
--   alter table messages enable row level security;
--   create policy "read"   on messages for select using (true);
--   create policy "insert" on messages for insert with check (true);
--
-- Then enable Realtime on the "messages" table:
--   Supabase Dashboard → Database → Replication → check "messages"

