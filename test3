-- ──────────────────────────────────────────────────────────────
-- 12. ADD MESSAGE ROW
--     scope: "server" | "global" — only shown when tab matches
-- ──────────────────────────────────────────────────────────────
local function addMsg(sender, text, isSystem, dbId, createdAt, scope)
    scope = scope or "global"

    -- Only show rows for the active channel
    if scope ~= activeChannel then return end

    local state = ch[scope]

    -- Deduplicate by database id
    if dbId then
        if state.seenIds[dbId] then return end
        state.seenIds[dbId] = true
        if dbId > state.lastId then state.lastId = dbId end
    end

    local epoch = createdAt and isoToEpoch(createdAt) or os.time()
    if (os.time() - epoch) >= MSG_LIFETIME then return end

    order += 1

    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, -6, 0, 0)
    row.AutomaticSize          = Enum.AutomaticSize.Y
    row.BackgroundTransparency = 1
    row.LayoutOrder            = order
    row.ZIndex                 = 17
    row.Parent                 = Scroll

    rowRegistry[row] = epoch

    local rowPad = Instance.new("UIPadding")
    rowPad.PaddingLeft  = UDim.new(0, 4)
    rowPad.PaddingRight = UDim.new(0, 4)
    rowPad.Parent       = row

    local rowLayout = Instance.new("UIListLayout")
    rowLayout.FillDirection     = Enum.FillDirection.Horizontal
    rowLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    rowLayout.Padding           = UDim.new(0, 5)
    rowLayout.Parent            = row

    local nameLabel = Instance.new("TextLabel")
    nameLabel.AutomaticSize          = Enum.AutomaticSize.XY
    nameLabel.Size                   = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text                   = (isSystem and "●" or sender) .. ":"
    nameLabel.TextSize               = 12
    nameLabel.Font                   = Enum.Font.GothamBold
    nameLabel.TextColor3             = isSystem and C.Muted or nameColor(sender)
    nameLabel.TextXAlignment         = Enum.TextXAlignment.Left
    nameLabel.TextYAlignment         = Enum.TextYAlignment.Top
    nameLabel.ZIndex                 = 18
    nameLabel.LayoutOrder            = 1
    nameLabel.Parent                 = row

    local msgLabel = Instance.new("TextLabel")
    msgLabel.AutomaticSize          = Enum.AutomaticSize.Y
    msgLabel.Size                   = UDim2.new(1, -96, 0, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text                   = text
    msgLabel.TextSize               = 13
    msgLabel.Font                   = Enum.Font.Gotham
    msgLabel.TextColor3             = isSystem and C.System or C.Text
    msgLabel.TextWrapped            = true
    msgLabel.TextXAlignment         = Enum.TextXAlignment.Left
    msgLabel.TextYAlignment         = Enum.TextYAlignment.Top
    msgLabel.ZIndex                 = 18
    msgLabel.LayoutOrder            = 2
    msgLabel.Parent                 = row

    task.defer(function()
        Scroll.CanvasPosition = Vector2.new(0, math.huge)
    end)

    if not isOpen then
        unread       += 1
        Badge.Visible = true
        BadgeTxt.Text = tostring(math.min(unread, 99))
    end
end

