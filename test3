local function refreshTabVisuals()
    local tabs = {
        server  = ServerTab,
        global  = GlobalTab,
        players = PlayersTab,
        game    = GameTab,
    }
    for id, btn in pairs(tabs) do
        if id == activeChannel then
            tw(btn, {BackgroundColor3 = C.TabActive,   TextColor3 = C.Text})
        else
            tw(btn, {BackgroundColor3 = C.TabInactive, TextColor3 = C.Muted})
        end
    end
    -- Show/hide the correct scrolling area and input bar
    local isPlayersList = (activeChannel == "players" or activeChannel == "game")
    Scroll.Visible        = not isPlayersList
    PlayersScroll.Visible = isPlayersList
    InputRow.Visible      = not isPlayersList
    if activeChannel == "server" then
        Input.PlaceholderText = "Message this server..."
    elseif activeChannel == "global" then
        Input.PlaceholderText = "Message everyone..."
    end
end

