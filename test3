-- ── Draggable toggle ─────────────────────────────────────────
local toggleDragging  = false
local toggleDragStart = nil
local toggleStartPos  = nil
local toggleMoved     = false

Toggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging  = true
        toggleMoved     = false
        toggleDragStart = input.Position
        toggleStartPos  = Toggle.Position
    end
end)

Toggle.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = false
        task.defer(function() toggleMoved = false end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not toggleDragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = input.Position - toggleDragStart

    if not toggleMoved and (math.abs(delta.X) > DRAG_THRESHOLD
                        or  math.abs(delta.Y) > DRAG_THRESHOLD) then
        toggleMoved = true
    end

    if toggleMoved then
        local vp   = game.Workspace.CurrentCamera.ViewportSize
        local btnW = Toggle.AbsoluteSize.X
        local btnH = Toggle.AbsoluteSize.Y
        Toggle.Position = UDim2.new(0,
            math.clamp(toggleStartPos.X.Offset + delta.X, 0, vp.X - btnW),
            0,
            math.clamp(toggleStartPos.Y.Offset + delta.Y, 0, vp.Y - btnH)
        )
    end
end)

