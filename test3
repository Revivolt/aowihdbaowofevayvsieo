-- ──────────────────────────────────────────────────────────────
-- 15. LOAD CHANNEL  (history + starts poll if first load)
-- ──────────────────────────────────────────────────────────────
local pollThread = nil   -- current coroutine running the poll loop

local function loadChannel(channel)
    -- Cancel previous poll
    if pollThread then
        task.cancel(pollThread)
        pollThread = nil
    end

    clearMessages()
    activeChannel = channel
    refreshTabVisuals()

    local state = ch[channel]

    setStatus("loading...", C.Muted, C.Muted)

    task.spawn(function()
        if not state.loaded then
            local hist, err = fetchHistory(channel)
            if not hist then
                setStatus("offline", C.Error, C.Error)
                addMsg("System", "Could not load messages: " .. tostring(err), true, nil, nil, channel)
                return
            end
            for _, row in ipairs(hist) do
                addMsg(row.username or "?", row.content or "", false,
                    row.id, row.created_at, channel)
            end
            state.loaded = true
        end

        setStatus("live", C.Online, C.Online)

        -- Poll loop for this channel
        pollThread = task.spawn(function()
            while true do
                task.wait(POLL_INTERVAL)
                local rows, _ = fetchSince(state.lastId, channel)
                if rows then
                    for _, row in ipairs(rows) do
                        if row.id > state.lastId then
                            state.lastId = row.id
                        end
                        addMsg(row.username or "?", row.content or "", false,
                            row.id, row.created_at, channel)
                    end
                end
            end
        end)
    end)
end

-- ──────────────────────────────────────────────────────────────
-- 16. MESSAGE EXPIRY SWEEP
-- ──────────────────────────────────────────────────────────────
local WARN_AT = MSG_LIFETIME - WARN_BEFORE

task.spawn(function()
    while true do
        task.wait(EXPIRE_CHECK)
        local now = os.time()
        for frame, epoch in pairs(rowRegistry) do
            if not frame or not frame.Parent then
                rowRegistry[frame] = nil
                continue
            end
            local age = now - epoch
            if age >= MSG_LIFETIME then
                rowRegistry[frame] = nil
                for _, child in ipairs(frame:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        tw(child, {TextTransparency = 1}, FADE)
                    end
                end
                local t = TweenService:Create(frame, FADE, {BackgroundTransparency = 1})
                t:Play()
                t.Completed:Once(function()
                    if frame and frame.Parent then frame:Destroy() end
                end)
            elseif age >= WARN_AT then
                for _, child in ipairs(frame:GetDescendants()) do
                    if child:IsA("TextLabel") and child.TextColor3 ~= C.Muted then
                        tw(child, {TextColor3 = C.Muted}, FADE)
                    end
                end
            end
        end
    end
end)

-- ──────────────────────────────────────────────────────────────
-- 17. OPEN / CLOSE WINDOW
-- ──────────────────────────────────────────────────────────────
local function getWinPos()
    local tp = Toggle.Position
    return UDim2.new(tp.X.Scale, tp.X.Offset, tp.Y.Scale, tp.Y.Offset + 50)
end

local function openChat()
    isOpen        = true
    unread        = 0
    Badge.Visible = false
    Win.Position  = getWinPos()
    Win.Size      = UDim2.new(0, WIN_W, 0, 0)
    Win.Visible   = true
    tw(Win, {Size = UDim2.new(0, WIN_W, 0, WIN_H)}, SMOOTH)
    -- Load the active channel on first open
    if not ch[activeChannel].loaded or pollThread == nil then
        task.wait(0.05)
        loadChannel(activeChannel)
    end
    task.wait(0.1)
    Input:CaptureFocus()
end

local function closeChat()
    isOpen = false
    Input:ReleaseFocus()
    tw(Win, {Size = UDim2.new(0, WIN_W, 0, 0)}, SMOOTH)
    task.delay(0.25, function()
        if not isOpen then Win.Visible = false end
    end)
end

Toggle.MouseButton1Click:Connect(function()
    if toggleMoved then return end
    if isOpen then closeChat() else openChat() end
end)

