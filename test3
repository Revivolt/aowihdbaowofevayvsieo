-- ──────────────────────────────────────────────────────────────
-- 8a. DRAGGABLE TOGGLE BUTTON
--     Tracks how far the cursor moves while held.
--     If the total delta is under DRAG_THRESHOLD px it counts as a
--     click and the chat opens.  If it's over the threshold the
--     button repositions and the chat does NOT open.
-- ──────────────────────────────────────────────────────────────
local toggleDragging  = false
local toggleDragStart = nil   -- Vector3 cursor position on press
local toggleStartPos  = nil   -- UDim2 position of Toggle on press
local toggleMoved     = false -- true once the button has been dragged past threshold

Toggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging  = true
        toggleMoved     = false
        toggleDragStart = input.Position
        toggleStartPos  = Toggle.Position
    end
end)

Toggle.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        toggleDragging = false
        -- toggleMoved is read by MouseButton1Click; reset after a frame
        task.defer(function() toggleMoved = false end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not toggleDragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = input.Position - toggleDragStart

    if not toggleMoved and (math.abs(delta.X) > DRAG_THRESHOLD
                        or  math.abs(delta.Y) > DRAG_THRESHOLD) then
        toggleMoved = true
    end

    if toggleMoved then
        -- Clamp inside the screen viewport
        local vp     = game.Workspace.CurrentCamera.ViewportSize
        local btnW   = Toggle.AbsoluteSize.X
        local btnH   = Toggle.AbsoluteSize.Y
        local newX   = math.clamp(toggleStartPos.X.Offset + delta.X, 0, vp.X - btnW)
        local newY   = math.clamp(toggleStartPos.Y.Offset + delta.Y, 0, vp.Y - btnH)
        Toggle.Position = UDim2.new(0, newX, 0, newY)
    end
end)

-- Override the click signal: only open/close if the button wasn't dragged
Toggle.MouseButton1Click:Connect(function()
    if toggleMoved then return end   -- was a drag, not a click
    -- handled in section 13 (openChat / closeChat)
end)

