-- ───────────────────────────────────────────────────
-- State
-- ───────────────────────────────────────────────────
local isOpen   = false
local unread   = 0
local order    = 0
local seenIds  = {}
local lastId   = 0
local connected = false

-- ───────────────────────────────────────────────────
-- Add a message row to the scroll frame
-- ───────────────────────────────────────────────────
local function addMsg(sender, text, system, id)
    -- Deduplicate by database id
    if id then
        if seenIds[id] then return end
        seenIds[id] = true
        if id > lastId then lastId = id end
    end

    -- Trim if over 100 messages
    local kids = {}
    for _, c in ipairs(Scroll:GetChildren()) do
        if c:IsA("Frame") then table.insert(kids, c) end
    end
    if #kids >= 100 then kids[1]:Destroy() end

    order += 1

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 0)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.BackgroundTransparency = 1
    row.LayoutOrder = order
    row.ZIndex = 17
    row.Parent = Scroll

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft  = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = row

    local lay = Instance.new("UIListLayout")
    lay.FillDirection = Enum.FillDirection.Horizontal
    lay.VerticalAlignment = Enum.VerticalAlignment.Top
    lay.Padding = UDim.new(0, 5)
    lay.Parent = row

    -- Name label
    local nl = Instance.new("TextLabel")
    nl.AutomaticSize = Enum.AutomaticSize.XY
    nl.Size = UDim2.new(0, 0, 0, 0)
    nl.BackgroundTransparency = 1
    nl.Text = (system and "●" or sender) .. ":"
    nl.TextSize = 12
    nl.Font = Enum.Font.GothamBold
    nl.TextColor3 = system and C.Muted or nameColor(sender)
    nl.TextXAlignment = Enum.TextXAlignment.Left
    nl.TextYAlignment = Enum.TextYAlignment.Top
    nl.ZIndex = 18
    nl.LayoutOrder = 1
    nl.Parent = row

    -- Message label
    local ml = Instance.new("TextLabel")
    ml.AutomaticSize = Enum.AutomaticSize.Y
    ml.Size = UDim2.new(1, -96, 0, 0)
    ml.BackgroundTransparency = 1
    ml.Text = text
    ml.TextSize = 13
    ml.Font = Enum.Font.Gotham
    ml.TextColor3 = system and C.System or C.Text
    ml.TextWrapped = true
    ml.TextXAlignment = Enum.TextXAlignment.Left
    ml.TextYAlignment = Enum.TextYAlignment.Top
    ml.ZIndex = 18
    ml.LayoutOrder = 2
    ml.Parent = row

    -- Auto-scroll
    task.defer(function() Scroll.CanvasPosition = Vector2.new(0, math.huge) end)

    -- Unread counter (only when window is closed)
    if not isOpen then
        unread += 1
        Badge.Visible = true
        BadgeTxt.Text = tostring(math.min(unread, 99))
    end
end

-- ───────────────────────────────────────────────────
-- Open / Close
-- ───────────────────────────────────────────────────
local function openChat()
    isOpen = true
    unread = 0
    Badge.Visible = false
    Win.Size = UDim2.new(0, W, 0, 0)
    Win.Visible = true
    tw(Win, {Size = UDim2.new(0, W, 0, H)}, SMOOTH)
    task.wait(0.1)
    Input:CaptureFocus()
end

local function closeChat()
    isOpen = false
    Input:ReleaseFocus()
    tw(Win, {Size = UDim2.new(0, W, 0, 0)}, SMOOTH)
    task.delay(0.25, function()
        if not isOpen then Win.Visible = false end
    end)
end

Toggle.MouseButton1Click:Connect(function()
    if isOpen then closeChat() else openChat() end
end)
CloseBtn.MouseButton1Click:Connect(closeChat)

-- ───────────────────────────────────────────────────
-- Send
-- ───────────────────────────────────────────────────
local sending = false
local function doSend()
    if sending then return end
    local raw = Input.Text:match("^%s*(.-)%s*$")
    if raw == "" then return end
    local text = raw:sub(1, MAX_MSG_LEN)
    Input.Text = ""
    sending = true
    task.spawn(function()
        local ok, err = postMessage(LocalPlayer.Name, text)
        sending = false
        if not ok then
            addMsg("System", "Send failed: " .. tostring(err), true)
        end
        -- poll will pick up our own message and dedup it
    end)
end

SendBtn.MouseButton1Click:Connect(doSend)
Input.FocusLost:Connect(function(enter) if enter then doSend() end end)

-- ───────────────────────────────────────────────────
-- Poll loop  (fetches only rows newer than lastId)
-- ───────────────────────────────────────────────────
local function setStatus(txt, color, dotColor)
    StatusTxt.Text  = txt
    StatusTxt.TextColor3 = color or C.Muted
    Dot.BackgroundColor3 = dotColor or C.Muted
end

task.spawn(function()
    task.wait(1)

    -- Load history
    setStatus("connecting...", C.Muted, C.Muted)
    local hist, err = fetchHistory()
    if not hist then
        setStatus("offline", C.Error, C.Error)
        addMsg("System", "Could not reach Supabase. Check SUPABASE_URL and SUPABASE_ANON_KEY.", true)
        return
    end

    for _, row in ipairs(hist) do
        addMsg(row.username or "?", row.content or "", false, row.id)
    end
    setStatus("live", C.Online, C.Online)
    connected = true

    -- Poll for new messages
    while true do
        task.wait(POLL_INTERVAL)
        local rows, _ = fetchSince(lastId)
        if rows then
            for _, row in ipairs(rows) do
                addMsg(row.username or "?", row.content or "", false, row.id)
            end
        end
    end
end)

-- ───────────────────────────────────────────────────
-- Draggable window (grab header)
-- ───────────────────────────────────────────────────
do
    local drag, ds, sp = false, nil, nil
    Header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag=true ds=i.Position sp=Win.Position
        end
    end)
    Header.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - ds
            Win.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X, sp.Y.Scale, sp.Y.Offset+d.Y)
        end
    end)
end

