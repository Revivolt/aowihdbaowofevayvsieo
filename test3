    nl.TextSize=12; nl.Font=Enum.Font.GothamBold
    nl.TextColor3=isSystem and C.Muted or nameColor(sender)
    nl.TextXAlignment=Enum.TextXAlignment.Left
    nl.TextYAlignment=Enum.TextYAlignment.Top
    nl.ZIndex=18; nl.LayoutOrder=1; nl.Parent=row

    local ml=Instance.new("TextLabel")
    ml.AutomaticSize=Enum.AutomaticSize.Y; ml.Size=UDim2.new(1,-96,0,0)
    ml.BackgroundTransparency=1; ml.Text=text; ml.TextSize=13
    ml.Font=Enum.Font.Gotham
    ml.TextColor3=isSystem and C.System or C.Text
    ml.TextWrapped=true
    ml.TextXAlignment=Enum.TextXAlignment.Left
    ml.TextYAlignment=Enum.TextYAlignment.Top
    ml.ZIndex=18; ml.LayoutOrder=2; ml.Parent=row

    task.defer(function() Scroll.CanvasPosition=Vector2.new(0,math.huge) end)
end

-- ──────────────────────────────────────────────────────────────────
-- 14. ADD MESSAGE  (dedup → cache → render if active tab)
-- ──────────────────────────────────────────────────────────────────
local function addMsg(sender, text, isSystem, dbId, createdAt, scope)
    scope = scope or "global"
    local state = ch[scope]
    if dbId then
        if state.seenIds[dbId] then return end
        state.seenIds[dbId] = true
        if dbId > state.lastId then state.lastId = dbId end
    end
    local epoch = createdAt and isoToEpoch(createdAt) or os.time()
    if (os.time() - epoch) >= MSG_LIFETIME then return end

    table.insert(state.cache, {
        sender=sender, text=text, isSystem=isSystem,
        dbId=dbId, createdAt=createdAt, epoch=epoch,
    })

    if scope ~= activeChannel then return end
    renderRow(sender, text, isSystem, epoch)

    if not isOpen then
        unread += 1; Badge.Visible=true
        BadgeTxt.Text=tostring(math.min(unread,99))
    end
end

-- ──────────────────────────────────────────────────────────────────
-- 15. CLEAR SCROLL DOM  (cache untouched)
-- ──────────────────────────────────────────────────────────────────
local function clearScrollDOM()
    for _, c in ipairs(Scroll:GetChildren()) do
        if c:IsA("Frame") then rowRegistry[c]=nil; c:Destroy() end
    end
    order = 0
end

local function renderCacheForChannel(channel)
    local state = ch[channel]
    local now, fresh = os.time(), {}
    for _, e in ipairs(state.cache) do
        if (now - e.epoch) < MSG_LIFETIME then table.insert(fresh, e) end
    end
    state.cache = fresh
    for _, e in ipairs(fresh) do
        renderRow(e.sender, e.text, e.isSystem, e.epoch)
    end
end

-- ──────────────────────────────────────────────────────────────────
-- 16. PLAYERS TAB — render player list
-- ──────────────────────────────────────────────────────────────────
local function clearPlayersDOM()
    for _, c in ipairs(PlayersScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end

local function renderPlayers(list, mode)
    clearPlayersDOM()
    if not list or #list == 0 then
        -- Empty state label
        local lbl = Instance.new("TextLabel")
        lbl.Size=UDim2.new(1,0,0,40); lbl.BackgroundTransparency=1
        lbl.Text = (mode == "game") and "No other players in this game right now." or "No players online right now."
        lbl.TextSize=12; lbl.Font=Enum.Font.Gotham
        lbl.TextColor3=C.Muted; lbl.ZIndex=17
        lbl.Parent=PlayersScroll
        return
    end

    local n = 0
    for _, p in ipairs(list) do
        n += 1
        local isSelf     = (p.username == LocalPlayer.Name)
        local isSameServ = (p.server_id == SERVER_ID)

        local card = Instance.new("Frame")
        card.Size             = UDim2.new(1, -4, 0, 38)
        card.BackgroundColor3 = C.Elevated
        card.LayoutOrder      = n
        card.ZIndex           = 17
        card.Parent           = PlayersScroll
        corner(card, 8)
        stroke(card, C.Border)

        -- Coloured avatar dot
        local dot = Instance.new("Frame")
        dot.Size             = UDim2.new(0, 8, 0, 8)
        dot.Position         = UDim2.new(0, 12, 0.5, 0)
        dot.AnchorPoint      = Vector2.new(0, 0.5)
        dot.BackgroundColor3 = nameColor(p.username)
        dot.ZIndex           = 18
        dot.Parent           = card
        corner(dot, 4)

        -- Username
        local uname = Instance.new("TextLabel")
        uname.Size                   = UDim2.new(1, -130, 1, 0)
        uname.Position               = UDim2.new(0, 26, 0, 0)
        uname.BackgroundTransparency = 1
        uname.Text                   = p.username .. (isSelf and " (you)" or "")
        uname.TextSize               = 13
        uname.Font                   = Enum.Font.GothamBold
        uname.TextColor3             = isSelf and C.Muted or C.Text
        uname.TextXAlignment         = Enum.TextXAlignment.Left
        uname.ZIndex                 = 18
        uname.Parent                 = card

        -- Server badge
        local badge = Instance.new("TextLabel")
        badge.Size                   = UDim2.new(0, 70, 0, 18)
        badge.Position               = UDim2.new(1, -128, 0.5, 0)
        badge.AnchorPoint            = Vector2.new(0, 0.5)
        badge.BackgroundColor3       = isSameServ and C.Elevated or Color3.fromRGB(28,28,40)
        badge.Text                   = isSameServ and "This server" or "Other server"
        badge.TextSize               = 10
        badge.Font                   = Enum.Font.Gotham
        badge.TextColor3             = isSameServ and C.Online or C.Muted
        badge.ZIndex                 = 18
        badge.Parent                 = card
        corner(badge, 4)
        stroke(badge, isSameServ and C.Online or C.Border, 1)

        -- Join button
        local joinBtn = Instance.new("TextButton")
        joinBtn.Size             = UDim2.new(0, 46, 0, 24)
        joinBtn.Position         = UDim2.new(1, -52, 0.5, 0)
        joinBtn.AnchorPoint      = Vector2.new(0, 0.5)
        joinBtn.AutoButtonColor  = false
        joinBtn.ZIndex           = 18
        joinBtn.Parent           = card
        corner(joinBtn, 6)

        if isSelf then
            -- Can't join yourself
            joinBtn.Text             = "You"
            joinBtn.TextSize         = 11
            joinBtn.Font             = Enum.Font.Gotham
            joinBtn.TextColor3       = C.Muted
            joinBtn.BackgroundColor3 = C.JoinBtnSelf
            stroke(joinBtn, C.Border)
        elseif isSameServ then
            -- Already here
            joinBtn.Text             = "Here"
            joinBtn.TextSize         = 11
            joinBtn.Font             = Enum.Font.Gotham
            joinBtn.TextColor3       = C.Online
            joinBtn.BackgroundColor3 = C.JoinBtnSelf
            stroke(joinBtn, C.Online, 1)
        else
            -- Different server — show Join button
            joinBtn.Text             = "Join"
            joinBtn.TextSize         = 11
            joinBtn.Font             = Enum.Font.GothamBold
            joinBtn.TextColor3       = Color3.new(1,1,1)
            joinBtn.BackgroundColor3 = C.JoinBtn
            stroke(joinBtn, C.Border)

            local targetServerId = p.server_id
            local targetPlaceId  = tonumber(p.place_id) or game.PlaceId

            joinBtn.MouseEnter:Connect(function()
                tw(joinBtn, {BackgroundColor3 = C.JoinBtnHi})
            end)
            joinBtn.MouseLeave:Connect(function()
                tw(joinBtn, {BackgroundColor3 = C.JoinBtn})
            end)
            joinBtn.MouseButton1Click:Connect(function()
                -- Disable button to prevent double-click
                joinBtn.Text             = "..."
                joinBtn.BackgroundColor3 = C.Elevated

                local ok, err = pcall(function()
                    TeleportService:TeleportToPlaceInstance(
                        targetPlaceId,
                        targetServerId,
                        LocalPlayer
                    )
                end)
                if not ok then
                    joinBtn.Text             = "Fail"
                    joinBtn.TextColor3       = C.Error
                    joinBtn.BackgroundColor3 = Color3.fromRGB(50,20,20)
                    task.delay(2, function()
                        joinBtn.Text             = "Join"
                        joinBtn.TextColor3       = Color3.new(1,1,1)
                        joinBtn.BackgroundColor3 = C.JoinBtn
                    end)
                end
            end)
        end
    end
end

-- ──────────────────────────────────────────────────────────────────
-- 17. LOAD CHANNEL  (chat) or refresh players list
-- ──────────────────────────────────────────────────────────────────
local function loadChannel(channel)
    -- Cancel previous chat poll
    if pollThread then
        task.cancel(pollThread)
        pollThread = nil
    end

    activeChannel = channel
    refreshTabVisuals()

    -- ── Players / Game tabs ──────────────────────────────────
    if channel == "players" or channel == "game" then
        setStatus("loading...", C.Muted, C.Muted)
        clearPlayersDOM()
        task.spawn(function()
            local list, err = (channel == "game") and fetchGamePlayers() or fetchPlayers()
            if not list then
                setStatus("offline", C.Error, C.Error)
                local lbl = Instance.new("TextLabel")
                lbl.Size=UDim2.new(1,0,0,40); lbl.BackgroundTransparency=1
                lbl.Text="Could not load players: " .. tostring(err)
                lbl.TextSize=11; lbl.Font=Enum.Font.Gotham
                lbl.TextColor3=C.Error; lbl.TextWrapped=true; lbl.ZIndex=17
                lbl.Parent=PlayersScroll
                return
            end
            renderPlayers(list, channel)
            local label = (channel == "game")
                and (tostring(#list) .. " in this game")
                or  (tostring(#list) .. " online")
            setStatus(label, C.Online, C.Online)
        end)
        return
    end

    -- ── Chat tabs ─────────────────────────────────────────────
    clearScrollDOM()
    local state = ch[channel]

    if state.loaded then
        renderCacheForChannel(channel)
        setStatus("live", C.Online, C.Online)
    else
        setStatus("loading...", C.Muted, C.Muted)
        task.spawn(function()
            local hist, err = fetchHistory(channel)
            if not hist then
                setStatus("offline", C.Error, C.Error)
                addMsg("System", "Could not load: "..tostring(err), true, nil, nil, channel)
                return
            end
            for _, row in ipairs(hist) do
                addMsg(row.username or "?", row.content or "", false,
                    row.id, row.created_at, channel)
            end
            state.loaded = true
            setStatus("live", C.Online, C.Online)
        end)
    end

    pollThread = task.spawn(function()
        if not state.loaded then task.wait(1) end
        while true do
            task.wait(POLL_INTERVAL)
            if activeChannel ~= channel then return end
            local rows, _ = fetchSince(state.lastId, channel)
            if rows then
                for _, row in ipairs(rows) do
                    if row.id > state.lastId then state.lastId = row.id end
                    addMsg(row.username or "?", row.content or "", false,
                        row.id, row.created_at, channel)
                end
            end
        end
    end)
end

-- ──────────────────────────────────────────────────────────────────
-- 18. MESSAGE EXPIRY SWEEP
-- ──────────────────────────────────────────────────────────────────
local WARN_AT = MSG_LIFETIME - WARN_BEFORE

task.spawn(function()
    while true do
        task.wait(EXPIRE_CHECK)
        local now = os.time()
        for frame, epoch in pairs(rowRegistry) do
            if not frame or not frame.Parent then
                rowRegistry[frame] = nil; continue
            end
            local age = now - epoch
            if age >= MSG_LIFETIME then
                rowRegistry[frame] = nil
                for _, child in ipairs(frame:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        tw(child, {TextTransparency=1}, FADE)
                    end
                end
                local t = TweenService:Create(frame, FADE, {BackgroundTransparency=1})
                t:Play()
                t.Completed:Once(function()
                    if frame and frame.Parent then frame:Destroy() end
                end)
            elseif age >= WARN_AT then
                for _, child in ipairs(frame:GetDescendants()) do
                    if child:IsA("TextLabel") and child.TextColor3 ~= C.Muted then
                        tw(child, {TextColor3=C.Muted}, FADE)
                    end
                end
            end
        end
    end
end)

-- ──────────────────────────────────────────────────────────────────
-- 19. OPEN / CLOSE WINDOW
-- ──────────────────────────────────────────────────────────────────
local function getWinPos()
    local tp = Toggle.Position
    return UDim2.new(tp.X.Scale, tp.X.Offset, tp.Y.Scale, tp.Y.Offset + 50)
end

local function openChat()
    isOpen = true; unread = 0; Badge.Visible = false
    Win.Position = getWinPos()
    Win.Size     = UDim2.new(0, WIN_W, 0, 0)
    Win.Visible  = true
    tw(Win, {Size = UDim2.new(0, WIN_W, 0, WIN_H)}, SMOOTH)
    if activeChannel ~= "players" and
       (not ch[activeChannel].loaded or pollThread == nil) then
        task.wait(0.05)
        loadChannel(activeChannel)
    end
    task.wait(0.1)
    if activeChannel ~= "players" then Input:CaptureFocus() end
end

local function closeChat()
    isOpen = false
    Input:ReleaseFocus()
    tw(Win, {Size = UDim2.new(0, WIN_W, 0, 0)}, SMOOTH)
    task.delay(0.25, function()
        if not isOpen then Win.Visible = false end
    end)
end

Toggle.MouseButton1Click:Connect(function()
    if toggleMoved then return end
    if isOpen then closeChat() else openChat() end
end)

