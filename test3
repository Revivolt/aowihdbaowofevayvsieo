-- 6. SUPABASE REST LAYER
-- ──────────────────────────────────────────────────────────────
local REST_BASE = SUPABASE_URL .. "/rest/v1"
local HEADERS   = {
    ["apikey"]        = SUPABASE_ANON_KEY,
    ["Authorization"] = "Bearer " .. SUPABASE_ANON_KEY,
    ["Content-Type"]  = "application/json",
    ["Prefer"]        = "return=minimal",
}

local function request(path, method, body)
    local ok, res = pcall(function()
        return HttpService:RequestAsync({
            Url     = REST_BASE .. path,
            Method  = method or "GET",
            Headers = HEADERS,
            Body    = body and HttpService:JSONEncode(body) or nil,
        })
    end)
    if not ok then return nil, "network: " .. tostring(res) end
    if res.StatusCode >= 400 then
        return nil, "HTTP " .. res.StatusCode .. ": " .. tostring(res.Body)
    end
    if method == "POST" or method == "DELETE" then return true, nil end
    local jok, parsed = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not jok then return nil, "JSON decode error" end
    return parsed, nil
end

-- Fetch history for a channel.
-- Server channel: filter by channel='server' AND server_id=<SERVER_ID>
-- Global channel: filter by channel='global' only (all servers)
local function fetchHistory(channel)
    local filter = "&channel=eq." .. channel
    if channel == "server" then
        filter = filter .. "&server_id=eq." .. SERVER_ID
    end
    return request(
        "/messages?select=id,channel,server_id,username,content,created_at"
            .. "&order=created_at.asc"
            .. "&limit=" .. HISTORY_LIMIT
            .. filter,
        "GET"
    )
end

local function fetchSince(lastId, channel)
    local filter = "&channel=eq." .. channel
    if channel == "server" then
        filter = filter .. "&server_id=eq." .. SERVER_ID
    end
    return request(
        "/messages?select=id,channel,server_id,username,content,created_at"
            .. "&order=id.asc"
            .. "&id=gt." .. lastId
            .. filter,
        "GET"
    )
end

-- Post a message — stamps channel and server_id correctly.
-- Server messages carry the real JobId; global messages use "global" as server_id
-- so the column is never empty, but only server rows are ever filtered by it.
local function postMessage(username, content, channel)
    return request("/messages", "POST", {
        channel   = channel,
        server_id = (channel == "server") and SERVER_ID or "global",
        username  = username,
        content   = content,
    })
end

