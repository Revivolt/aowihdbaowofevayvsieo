-- test

local Players          = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer  = Players.LocalPlayer

-- ─── Config ───────────────────────────────────────────────────────────────────
local SPAWN_NAMES   = { Spawn = true, PlayerSpawn = true }
local REMOTE_PATH   = { "Remotes", "Gameplay", "TeleportToPart" }
local SPAWNS_FOLDER = "Spawns"
-- ──────────────────────────────────────────────────────────────────────────────

local lockedSpawn   = nil
local active        = false
local connections   = {}
local hookedFolders = {}

-- ─── Helpers ──────────────────────────────────────────────────────────────────
local function isSpawnPart(obj)
    return obj:IsA("BasePart") and SPAWN_NAMES[obj.Name]
end

local function teleportChar(char, spawn)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = spawn.CFrame * CFrame.new(0, spawn.Size.Y / 2 + 3, 0)
end

local function teleportAllToSpawn(spawn)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            teleportChar(player.Character, spawn)
        end
    end
end

-- ─── Core spawn handler (only called from ChildAdded) ─────────────────────────
local function handleNewSpawn(obj)
    if not active then return end
    if not isSpawnPart(obj) then return end

    if lockedSpawn == nil then
        -- first one in → lock it, teleport self
        lockedSpawn = obj
        print("[SpawnLock] Locked:", obj:GetFullName())
        local char = LocalPlayer.Character
        if char then teleportChar(char, obj) end
    else
        -- any subsequent one → delete immediately
        if obj ~= lockedSpawn then
            obj:Destroy()
            print("[SpawnLock] Deleted extra:", obj.Name)
        end
    end
end

-- ─── Hook a Spawns folder (ChildAdded only, no GetChildren scan) ──────────────
local function hookSpawnsFolder(folder)
    if hookedFolders[folder] then return end
    hookedFolders[folder] = true

    local conn = folder.ChildAdded:Connect(function(child)
        task.defer(handleNewSpawn, child)
    end)
    table.insert(connections, conn)
end

-- ─── Watch workspace for new maps (ChildAdded only) ───────────────────────────
local function startWatching()
    -- top-level: new map added to workspace
    local wsConn = workspace.ChildAdded:Connect(function(map)
        if not active then return end

        -- case 1: Spawns folder already exists on the map when it arrives
        local sf = map:FindFirstChild(SPAWNS_FOLDER)
        if sf then
            hookSpawnsFolder(sf)
            return
        end

        -- case 2: Spawns folder arrives slightly after the map itself
        local innerConn
        innerConn = map.ChildAdded:Connect(function(child)
            if not active then
                innerConn:Disconnect()
                return
            end
            if child.Name == SPAWNS_FOLDER then
                hookSpawnsFolder(child)
                innerConn:Disconnect()
            end
        end)
        table.insert(connections, innerConn)
    end)
    table.insert(connections, wsConn)
end

-- ─── Hook TeleportToPart remote ───────────────────────────────────────────────
local function hookRemote()
    local node = ReplicatedStorage
    for _, step in ipairs(REMOTE_PATH) do
        node = node:WaitForChild(step, 10)
        if not node then
            warn("[SpawnLock] Remote not found at step:", step)
            return
        end
    end

    local conn = node.OnClientEvent:Connect(function(_targetPart)
        if not active or not lockedSpawn then return end
        print("[SpawnLock] Intercepted TeleportToPart → redirecting to locked spawn")
        teleportAllToSpawn(lockedSpawn)
    end)
    table.insert(connections, conn)
end

-- ─── Cleanup ──────────────────────────────────────────────────────────────────
local function cleanup()
    for _, c in ipairs(connections) do
        c:Disconnect()
    end
    connections   = {}
    hookedFolders = {}
    lockedSpawn   = nil
end

-- ─── GUI ──────────────────────────────────────────────────────────────────────
local screenGui = Instance.new("ScreenGui")
screenGui.Name           = "SpawnLockGui"
screenGui.ResetOnSpawn   = false
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent         = LocalPlayer.PlayerGui

local frame = Instance.new("Frame")
frame.Size             = UDim2.new(0, 180, 0, 48)
frame.Position         = UDim2.new(0, 12, 0, 12)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
frame.BorderSizePixel  = 0
frame.Active           = true
frame.Draggable        = true
frame.Parent           = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent       = frame

local stroke = Instance.new("UIStroke")
stroke.Color     = Color3.fromRGB(80, 80, 100)
stroke.Thickness = 1
stroke.Parent    = frame

local btn = Instance.new("TextButton")
btn.Size               = UDim2.new(1, 0, 1, 0)
btn.BackgroundTransparency = 1
btn.Font               = Enum.Font.GothamBold
btn.TextSize           = 14
btn.TextColor3         = Color3.fromRGB(220, 220, 220)
btn.Text               = "[OFF]  Spawn Lock"
btn.Parent             = frame

local function setActive(state)
    active = state
    if state then
        btn.Text       = "[ON]   Spawn Lock"
        btn.TextColor3 = Color3.fromRGB(100, 255, 140)
        stroke.Color   = Color3.fromRGB(100, 255, 140)
        startWatching()
        hookRemote()
    else
        btn.Text       = "[OFF]  Spawn Lock"
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        stroke.Color   = Color3.fromRGB(80, 80, 100)
        cleanup()
    end
end

btn.MouseButton1Click:Connect(function()
    setActive(not active)
end)
