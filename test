-- Movement toggles (Infinite Jump, Speed Boosts, Movement Breaker)
-- Each call creates its own isolated conn + isEnabled so toggling one never affects another
local function createMoveToggle(name, tpOffset)
    local movConn2   = nil
    local isEnabled2 = false
    MainTab:CreateToggle({
        Name         = name,
        CurrentValue = false,
        Callback = function(state)
            isEnabled2 = state
            if movConn2 then movConn2:Disconnect() movConn2 = nil end
            if not selectedTarget then return end
            if not isEnabled2 then
                glueB.glue(selectedTarget, false)
                return
            end
            movConn2 = glueRunB.Heartbeat:Connect(function()
                if not isEnabled2 then return end
                glueB.tp(selectedTarget, tpOffset)
                glueB.glue(selectedTarget, true)
            end)
        end,
    })
end

