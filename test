-- Glue / TP helpers (instance A)
local glueRunA = game:GetService("RunService")
local glueLocalA = game:GetService("Players").LocalPlayer
local glueA = {}

function glueA.glue(target, attach)
    local myChar = glueLocalA.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    sethiddenproperty(myRoot, "PhysicsRepRootPart",
        attach and target.Character.HumanoidRootPart or myRoot)
end

function glueA.tp(target, offset)
    offset = offset or CFrame.new()
    local myChar = glueLocalA.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myRoot and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        myRoot.CFrame   = target.Character.HumanoidRootPart.CFrame * offset
        myRoot.Velocity = Vector3.zero
    end
end

