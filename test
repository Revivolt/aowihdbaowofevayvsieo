--   Tab 4 – Other Stuff
-- ============================================================
local OtherTab = Window:CreateTab("Other Stuff", 4483362458)

OtherTab:CreateButton({
    Name = "Anti Fling",
    Callback = function()
        local svcPlayers    = game:GetService("Players")
        local svcRun        = game:GetService("RunService")
        local svcStarterGui = game:GetService("StarterGui")
        local svcSound      = game:GetService("SoundService")

        local self       = svcPlayers.LocalPlayer
        local SPEED_THRESHOLD = 67
        local TIME_WINDOW     = 0.5

        local normalProps  = PhysicalProperties.new(0.7, 0.3, 0.5)
        local zeroProps    = PhysicalProperties.new(0, 0, 0)
        local isActive     = true
        local flingTimers  = {}
        local blacklist    = {}

        local alertSound = Instance.new("Sound", svcSound)
        alertSound.SoundId = "rbxassetid://9086208751"
        alertSound.Volume  = 1

        local function notify(msg)
            svcStarterGui:SetCore("SendNotification", {
                Title    = "Rexy's Anti Fling",
                Text     = msg,
                Duration = 4,
            })
            alertSound:Play()
            print("[REX] " .. msg)
        end

        local function setCollision(character, state)
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide              = state
                    part.CustomPhysicalProperties = state and normalProps or zeroProps
                    if not state then
                        part.AssemblyLinearVelocity  = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end

        local function findPlayer(query)
            query = (tostring(query or "")):lower()
            for _, plr in ipairs(svcPlayers:GetPlayers()) do
                local name    = plr.Name:lower()
                local display = (plr.DisplayName or plr.Name):lower()
                if name == query or display == query
                or name:sub(1, #query) == query or display:sub(1, #query) == query then
                    return plr
                end
            end
        end

        svcRun.RenderStepped:Connect(function(dt)
            if not isActive then return end
            for _, plr in ipairs(svcPlayers:GetPlayers()) do
                if plr ~= self then
                    local char = plr.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        -- Check if any OTHER player is already flying (mass fling)
                        local otherFlying = false
                        for _, other in ipairs(svcPlayers:GetPlayers()) do
                            if other ~= plr then
                                local oChar = other.Character
                                local oRoot = oChar and oChar:FindFirstChild("HumanoidRootPart")
                                if oRoot and oRoot.AssemblyLinearVelocity.Magnitude > SPEED_THRESHOLD then
                                    otherFlying = true
                                    break
                                end
                            end
                        end

                        if root.AssemblyLinearVelocity.Magnitude > SPEED_THRESHOLD and not otherFlying then
                            flingTimers[plr] = (flingTimers[plr] or 0) + dt
                        else
                            flingTimers[plr] = 0
                        end

                        if flingTimers[plr] >= TIME_WINDOW and not blacklist[plr] then
                            blacklist[plr] = true
                            setCollision(char, false)
                            notify(plr.Name .. " is flinging! Type 'unanti " .. plr.Name .. "' to restore collision.")
                        end

                        if blacklist[plr] then
                            for _, part in ipairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.AssemblyLinearVelocity  = Vector3.zero
                                    part.AssemblyAngularVelocity = Vector3.zero
                                end
                            end
                        end
                    end
                end
            end
        end)

        self.Chatted:Connect(function(msg)
            msg = msg:lower()
            if msg:sub(1, 7) == "unanti " then
                local target = findPlayer(msg:sub(8))
                if target and blacklist[target] then
                    local char = target.Character
                    if char then
                        setCollision(char, true)
                        blacklist[target] = nil
                        notify("Collision restored for " .. target.Name)
                    end
                end
            elseif msg:sub(1, 4) == "!bl " then
                local target = findPlayer(msg:sub(5))
                if target and not blacklist[target] then
                    local char = target.Character
                    if char then
                        setCollision(char, false)
                        blacklist[target] = true
                        notify(target.Name .. " manually blacklisted for no-collision!")
                    end
                end
            elseif msg == "disableanti" then
                isActive = false
                notify("Rexy's Anti Fling Disabled")
            elseif msg == "enableanti" then
                isActive = true
                notify("Rexy's Anti Fling Enabled")
            end
        end)

        notify("Rexy's Anti Fling Loaded!")
        notify("Use '!bl <username>' to blacklist, 'unanti <username>' to restore, 'enableanti'/'disableanti' to toggle.")
    end,
})
