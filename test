local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart    = Character:WaitForChild("HumanoidRootPart")
local Humanoid    = Character:WaitForChild("Humanoid")

local killY           = -80
local maxY            = 5000
local speedThreshold  = 350
local lastSafePos     = nil
local antiMoveLock    = false
local activeFlingCount = 0

task.delay(1, function()
    if RootPart then
        lastSafePos = RootPart.Position
    end
end)

RunService.Heartbeat:Connect(function()
    if not RootPart then return end
    local pos = RootPart.Position
    if pos.Y > -10 and pos.Y < maxY
    and RootPart.AssemblyLinearVelocity.Magnitude < speedThreshold then
        lastSafePos = pos
    end
end)

RunService.Heartbeat:Connect(function()
    if antiMoveLock then return end
    if not lastSafePos then return end
    if activeFlingCount > 0 then return end
    antiMoveLock = true

    local pos  = RootPart.Position
    local vel  = RootPart.AssemblyLinearVelocity.Magnitude
    local velY = RootPart.AssemblyLinearVelocity.Y

    local function reset(target)
        RootPart.CFrame                 = CFrame.new(target)
        RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        Humanoid.Health                 = Humanoid.MaxHealth
        antiMoveLock = false
    end

    if vel > speedThreshold or math.abs(velY) > 350 then
        reset(lastSafePos)
    elseif pos.Y > maxY then
        reset(lastSafePos)
    elseif pos.Y < killY then
        RootPart.CFrame                 = CFrame.new(lastSafePos.X, math.max(lastSafePos.Y + 5, 10), lastSafePos.Z)
        RootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        Humanoid.Health                 = Humanoid.MaxHealth
        antiMoveLock = false
    else
        antiMoveLock = false
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character    = newChar
    RootPart     = Character:WaitForChild("HumanoidRootPart")
    Humanoid     = Character:WaitForChild("Humanoid")
    antiMoveLock = false
    lastSafePos  = nil
    task.delay(1, function()
        if RootPart then
            lastSafePos = RootPart.Position
        end
    end)
end)

