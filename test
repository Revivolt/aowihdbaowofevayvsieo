-- MM2 ESP — LocalScript in StarterPlayerScripts
-- Reads roles from Gameplay.Fade remote, draws BillboardGui name tags

local Players       = game:GetService("Players")
local RunService    = game:GetService("RunService")
local LocalPlayer   = Players.LocalPlayer
local PlayerGui     = LocalPlayer:WaitForChild("PlayerGui")

-- ──────────────────────────────────────────
-- Config
-- ──────────────────────────────────────────

local ROLE_COLORS = {
    Innocent = Color3.fromRGB(80,  220, 100),   -- green
    Sheriff  = Color3.fromRGB(80,  160, 255),   -- blue
    Murderer = Color3.fromRGB(255, 70,  70),    -- red
    Hero     = Color3.fromRGB(255, 220, 50),    -- yellow
}
local DEFAULT_COLOR = Color3.fromRGB(200, 200, 200)

local ESP_SIZE   = UDim2.new(0, 120, 0, 28)
local ESP_OFFSET = Vector3.new(0, 3.2, 0)  -- studs above head

-- ──────────────────────────────────────────
-- State
-- ──────────────────────────────────────────

local espEnabled  = true
local roleMap     = {}   -- [username] = roleString
local billboards  = {}   -- [Player]   = BillboardGui

-- ──────────────────────────────────────────
-- Toggle GUI
-- ──────────────────────────────────────────

local screenGui = Instance.new("ScreenGui")
screenGui.Name           = "MM2_ESP"
screenGui.ResetOnSpawn   = false
screenGui.DisplayOrder   = 999
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent         = PlayerGui

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size             = UDim2.new(0, 110, 0, 36)
toggleBtn.Position         = UDim2.new(0, 16, 0, 16)
toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 160, 90)
toggleBtn.TextColor3       = Color3.fromRGB(255, 255, 255)
toggleBtn.Text             = "ESP  ON"
toggleBtn.Font             = Enum.Font.GothamBold
toggleBtn.TextSize         = 14
toggleBtn.BorderSizePixel  = 0
toggleBtn.Active           = true
toggleBtn.Draggable        = true
toggleBtn.Parent           = screenGui

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent       = toggleBtn

local btnStroke = Instance.new("UIStroke")
btnStroke.Color     = Color3.fromRGB(255, 255, 255)
btnStroke.Thickness = 1
btnStroke.Transparency = 0.7
btnStroke.Parent    = toggleBtn

local dot = Instance.new("Frame")
dot.Size             = UDim2.new(0, 10, 0, 10)
dot.Position         = UDim2.new(0, 10, 0.5, -5)
dot.BackgroundColor3 = Color3.fromRGB(120, 255, 160)
dot.BorderSizePixel  = 0
dot.Parent           = toggleBtn
local dotCorner = Instance.new("UICorner")
dotCorner.CornerRadius = UDim.new(1, 0)
dotCorner.Parent = dot

-- ──────────────────────────────────────────
-- Billboard helpers
-- ──────────────────────────────────────────

local function getColor(username)
    local role = roleMap[username]
    if role then
        return ROLE_COLORS[role] or DEFAULT_COLOR, role or "?"
    end
    return DEFAULT_COLOR, "?"
end

local function makeLabel(text, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size                 = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                 = text
    lbl.TextColor3           = color
    lbl.TextStrokeColor3     = Color3.fromRGB(0, 0, 0)
    lbl.TextStrokeTransparency = 0.4
    lbl.Font                 = Enum.Font.GothamBold
    lbl.TextSize             = 14
    lbl.TextScaled           = false
    return lbl
end

local function createBillboard(player)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    -- remove old one if exists
    if billboards[player] then
        billboards[player]:Destroy()
        billboards[player] = nil
    end

    local color, role = getColor(player.Name)

    local bb = Instance.new("BillboardGui")
    bb.Name            = "ESP_Tag"
    bb.Size            = ESP_SIZE
    bb.StudsOffset     = ESP_OFFSET
    bb.AlwaysOnTop     = true
    bb.LightInfluence  = 0
    bb.MaxDistance     = 200
    bb.Adornee         = head
    bb.Parent          = head

    -- background pill
    local bg = Instance.new("Frame")
    bg.Size             = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.45
    bg.BorderSizePixel  = 0
    bg.Parent           = bb
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 6)
    bgCorner.Parent = bg

    -- colored left accent bar
    local accent = Instance.new("Frame")
    accent.Size             = UDim2.new(0, 4, 1, 0)
    accent.BackgroundColor3 = color
    accent.BorderSizePixel  = 0
    accent.Parent           = bg
    local accentCorner = Instance.new("UICorner")
    accentCorner.CornerRadius = UDim.new(0, 3)
    accentCorner.Parent = accent

    -- name label
    local nameLabel = makeLabel(player.Name, color)
    nameLabel.Position       = UDim2.new(0, 10, 0, 0)
    nameLabel.Size           = UDim2.new(1, -10, 0.6, 0)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent         = bg

    -- role label
    local roleLabel = makeLabel(role, Color3.fromRGB(210, 210, 210))
    roleLabel.Position       = UDim2.new(0, 10, 0.55, 0)
    roleLabel.Size           = UDim2.new(1, -10, 0.45, 0)
    roleLabel.TextSize       = 11
    roleLabel.TextXAlignment = Enum.TextXAlignment.Left
    roleLabel.Parent         = bg

    bb.Enabled = espEnabled
    billboards[player] = bb
end

local function removeBillboard(player)
    if billboards[player] then
        billboards[player]:Destroy()
        billboards[player] = nil
    end
end

local function refreshAllBillboards()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createBillboard(player)
        end
    end
end

-- ──────────────────────────────────────────
-- Toggle logic
-- ──────────────────────────────────────────

local function setESP(enabled)
    espEnabled = enabled
    for _, bb in pairs(billboards) do
        bb.Enabled = enabled
    end
    if enabled then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 160, 90)
        toggleBtn.Text             = "ESP  ON"
        dot.BackgroundColor3       = Color3.fromRGB(120, 255, 160)
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
        toggleBtn.Text             = "ESP  OFF"
        dot.BackgroundColor3       = Color3.fromRGB(255, 100, 100)
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    setESP(not espEnabled)
end)

-- ──────────────────────────────────────────
-- Remote hook — read Gameplay.Fade payload
-- ──────────────────────────────────────────

local hooked = {}

local function hookFadeRemote(remote)
    if hooked[remote] then return end
    hooked[remote] = true

    remote.OnClientEvent:Connect(function(data)
        if type(data) ~= "table" then return end
        -- data = { [username] = { Role=..., ... }, ... }
        for username, info in pairs(data) do
            if type(info) == "table" and info.Role then
                roleMap[username] = info.Role
            end
        end
        -- rebuild all tags with fresh role colors
        refreshAllBillboards()
    end)
end

local function scanForFade(container)
    for _, obj in ipairs(container:GetDescendants()) do
        if obj.ClassName == "RemoteEvent" and obj.Name == "Fade" then
            hookFadeRemote(obj)
        end
    end
    container.DescendantAdded:Connect(function(obj)
        if obj.ClassName == "RemoteEvent" and obj.Name == "Fade" then
            hookFadeRemote(obj)
        end
    end)
end

scanForFade(game)

-- ──────────────────────────────────────────
-- Player lifecycle
-- ──────────────────────────────────────────

local function onCharacterAdded(player, char)
    char:WaitForChild("Head", 10)
    createBillboard(player)
end

local function onPlayerAdded(player)
    if player == LocalPlayer then return end
    if player.Character then
        onCharacterAdded(player, player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        onCharacterAdded(player, char)
    end)
    player.CharacterRemoving:Connect(function()
        removeBillboard(player)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(removeBillboard)

-- ──────────────────────────────────────────
-- Heartbeat: keep tags on respawned chars
-- ──────────────────────────────────────────

RunService.Heartbeat:Connect(function()
    if not espEnabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head and not billboards[player] then
                createBillboard(player)
            end
        end
    end
end)
