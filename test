-- Generic weld toggle factory
local function createWeldToggle(name, offset, killTarget)
    local conn      = nil
    local savedCF   = nil
    local isEnabled = false
    MainTab:CreateToggle({
        Name         = name,
        CurrentValue = false,
        Callback = function(state)
            isEnabled = state

            if not selectedTarget then return end
            local myChar  = weldLocal.Character or weldLocal.CharacterAdded:Wait()
            local myRoot  = myChar:WaitForChild("HumanoidRootPart")
            local tgtRoot = selectedTarget.Character:WaitForChild("HumanoidRootPart")

            if not isEnabled then
                activeFlingCount = math.max(0, activeFlingCount - 1)
                if conn then conn:Disconnect() conn = nil end
                if savedCF then
                    myRoot.CFrame      = savedCF
                    myRoot.Velocity    = Vector3.zero
                    myRoot.RotVelocity = Vector3.zero
                    savedCF = nil
                end
                return
            end

            activeFlingCount = activeFlingCount + 1
            savedCF = myRoot.CFrame
            conn = weldRun.Heartbeat:Connect(function()
                if not isEnabled then return end
                myRoot.CFrame       = CFrame.new(tgtRoot.Position + offset) * CFrame.Angles(-math.pi / 2, 0, 0)
                myRoot.Velocity     = offset.Magnitude > 0 and Vector3.new(500, 500, 500) or Vector3.zero
                myRoot.RotVelocity  = offset.Magnitude > 0 and Vector3.new(500, 500, 500) or Vector3.zero
                sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
                if killTarget then
                    task.wait(0.5)
                    local hum = myChar:FindFirstChildOfClass("Humanoid")
                    if hum then hum.Health = 0 end
                end
            end)
        end,
    })
end

