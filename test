                    gsSavedCF = nil
                end
                pcall(function() MainTab:SetToggle("GODSPEED Rocket Target", false) end)
            end)
            gsConn = weldRun.Heartbeat:Connect(function()
                if not gsActive then return end
                if not tgtRoot.Parent then return end
                local aim = tgtRoot.Position + Vector3.new(0, -3, 0)
                myRoot.CFrame      = CFrame.new(aim, aim + Vector3.new(0, 1, 0))
                myRoot.Velocity    = Vector3.new(0, 5000, 0)
                myRoot.RotVelocity = Vector3.zero
                pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", tgtRoot)
            end)
        end,
    })
end

