-- Spin Trap: orbits your character around the target using a time-based
-- rotating offset. Character stays upright, always faces the target, and
-- has noclip (CanCollide forced off every frame so the engine can't re-enable it).
do
    local spinConn    = nil
    local spinSavedCF = nil
    local spinEnabled = false
    local SPIN_RADIUS = 10
    local SPIN_SPEED  = 10

    MainTab:CreateToggle({
        Name         = "Fling Aura",
        CurrentValue = false,
        Callback = function(state)
            spinEnabled = state
            if not selectedTarget then return end
            local myChar  = weldLocal.Character or weldLocal.CharacterAdded:Wait()
            local myRoot  = myChar:WaitForChild("HumanoidRootPart")
            local tgtRoot = selectedTarget.Character:WaitForChild("HumanoidRootPart")

            if not spinEnabled then
                activeFlingCount = math.max(0, activeFlingCount - 1)
                if spinConn then spinConn:Disconnect() spinConn = nil end
                if spinSavedCF then
                    myRoot.CFrame      = spinSavedCF
                    myRoot.Velocity    = Vector3.zero
                    myRoot.RotVelocity = Vector3.zero
                    spinSavedCF = nil
                end
                -- Restore collision on all parts once on disable
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
                pcall(sethiddenproperty, myRoot, "PhysicsRepRootPart", myRoot)
                return
            end

            activeFlingCount = activeFlingCount + 1
            spinSavedCF = myRoot.CFrame
            spinConn = weldRun.Heartbeat:Connect(function()
                if not spinEnabled then return end

                -- Force CanCollide off every frame so Roblox can't re-enable it
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end

                local angle    = tick() * SPIN_SPEED
                local tgtPos   = tgtRoot.Position
                local worldPos = tgtPos + Vector3.new(
                    math.cos(angle) * SPIN_RADIUS,
                    0,
                    math.sin(angle) * SPIN_RADIUS
                )
                local lookAt = Vector3.new(tgtPos.X, worldPos.Y, tgtPos.Z)
                myRoot.CFrame      = CFrame.new(worldPos, lookAt)
                myRoot.Velocity    = Vector3.new(500, 500, 500)
                myRoot.RotVelocity = Vector3.new(500, 500, 500)
                sethiddenproperty(myRoot, "PhysicsRepRootPart", tgtRoot)
            end)
        end,
    })
end

